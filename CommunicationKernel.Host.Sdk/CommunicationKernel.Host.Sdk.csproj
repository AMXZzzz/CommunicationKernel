<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       文件: CommunicationKernel.Host.Sdk.csproj
       层级: Host.Sdk — 连 Host.App 的 gRPC 客户端
       作用: 所有 UI（WPF / Blazor / 第三方）共用的 Host.App 访问库。

       为什么独立成库：
         此前 WPF 与 Web 各持一份客户端封装。Web 那份长期落后——
         缺 RegisterRoute、RemoveRoute、QueryProtocols，DTO 也各定义一遍。
         proto 已经收敛到单一来源，客户端封装没有理由再分裂两份。

       目标框架 net8.0（非 -windows）：
         Blazor、控制台、树莓派上的上位机都要能引用它。
       ======================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CommunicationKernel.Host.Sdk</AssemblyName>
    <RootNamespace>CommunicationKernel.Host.Sdk</RootNamespace>
    <IsPackable>true</IsPackable>

    <!-- 打包库必须生成 XML 文档：消费者只能通过 IntelliSense 了解这些 API，
         没有文档时连 length 的单位是字节还是寄存器都无从得知。
         必须写在工程内而非 Directory.Build.targets——后者导入得太晚，
         SDK 那时已经决定不生成文档了。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CommunicationKernel.Host.Sdk</PackageId>
    <Description>CommunicationKernel Host.App 的 gRPC 客户端。供上位机（WPF / Blazor / 控制台）远程注册路由与读写 PLC，内置断线重连与调用截止时间。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 只依赖 Logging.Abstractions：本库不选择日志实现，交由宿主决定 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 解决方案根目录下的唯一 proto，GrpcServices=Client 只生成客户端 stub -->
    <Protobuf Include="..\Protos\V1\engine_host.proto"
              ProtoRoot=".."
              GrpcServices="Client"
              Link="Protos\V1\engine_host.proto" />
  </ItemGroup>

</Project>
