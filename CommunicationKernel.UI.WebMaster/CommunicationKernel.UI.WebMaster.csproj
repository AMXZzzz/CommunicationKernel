<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- ========================================================================
       文件: CommunicationKernel.UI.WebMaster.csproj
       层级: UI 层 — Blazor Server Web 客户端
       作用: 本进程内嵌 EngineRuntime，通过 Blazor Server 提供浏览器监控界面。
             形态 A：不必再单独启动 EngineHostingServiceApp。WPF 远端场景仍用 EngineHostingServiceApp。

       不用 Microsoft.NET.Sdk.Web：
         Web SDK 会把项目登记成 ASP.NET 控制台宿主。Visual Studio F5 /
         `dotnet run` 必定再开一个黑窗口，WinExe + FreeConsole 都拆不掉
         （窗口属于 VS / dotnet.exe，不是本进程）。
         改用 Razor SDK + ASP.NET 共享框架后，VS 按 Windows 应用启动，不再配控制台。
       ======================================================================== -->

  <PropertyGroup>
    <!-- TreatWarningsAsErrors 由 Directory.Build.props 继承 -->
    <AssemblyName>CommunicationKernel.UI.WebMaster</AssemblyName>
    <RootNamespace>CommunicationKernel.UI.WebMaster</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>wwwroot\app.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>

    <!--
      WinExe：直接运行 exe 时不分配控制台窗口。
      进程改在右下角托盘驻留——关浏览器不等于退出，退出走托盘菜单。

      代价与补偿：
        没有控制台，启动失败会变成"什么都不发生"。因此 Program.cs 里
        用 try/catch 兜住整个启动流程，失败时写日志文件并弹一个消息框。
        没有那段兜底就不该开 WinExe——静默失败比黑框糟糕得多。

      托盘依赖 WinForms，因此本项目是 Windows 专用（net8.0-windows）。
      现场 Linux / 树莓派跑的是 EngineHostingServiceApp，Web 上位机留在办公室电脑上。
    -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内嵌 Kestrel / Blazor，但不走 Web SDK（避免 VS 配控制台）。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌引擎：UI 只经 IHostClient 访问，不引用具体协议类型。 -->
    <ProjectReference Include="..\CommunicationKernel.Core.EngineRuntime\CommunicationKernel.Core.EngineRuntime.csproj" />
    <!-- DTO / JsonFileStore / ValueCodec。远端 gRPC HostClient 仍给 WPF 用。 -->
    <ProjectReference Include="..\CommunicationKernel.EngineHost.Sdk\CommunicationKernel.EngineHost.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    把 wwwroot 一并复制到生成目录。

    默认行为下 wwwroot 只在 publish 时进产物，build 不复制——
    因为 `dotnet run` 的 ContentRoot 是项目目录，静态文件从源码原地取。
    但直接双击 bin 里的 exe 时 ContentRoot 变成 bin 目录，
    此时找不到 wwwroot，启动日志里只有一行
    "The WebRootPath was not found ... Static files may be unavailable"，
    界面照常打开却完全没有样式——看着像 CSS 写坏了，很难联想到是路径问题。

    本项目是 WinExe（双击即用）的操作员工具，"生成完就能双击跑"
    必须成立，因此补上这条。publish 路径不受影响，那边本来就是对的。
  -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 插件只建立构建顺序，不产生编译期引用，UI 不得使用插件类型。 -->
  <ItemGroup>
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Modbus\CommunicationKernel.Plugins.Protocol.Modbus.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Panasonic\CommunicationKernel.Plugins.Protocol.Panasonic.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Siemens.S7\CommunicationKernel.Plugins.Protocol.Siemens.S7.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Transport.Tcp\CommunicationKernel.Plugins.Transport.Tcp.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Transport.SerialPort\CommunicationKernel.Plugins.Transport.SerialPort.csproj" />
    <ProjectReference Include="@(PluginProject)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun" />
  </ItemGroup>

  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <MSBuild Projects="@(PluginProject)"
             Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_PluginAssembly)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="已部署 @(_PluginAssembly->Count()) 个插件到 $(OutDir)plugins" />
  </Target>

  <Target Name="CopyPluginThirdPartyDeps"
          AfterTargets="CopyPluginsToOutput"
          Outputs="%(_PluginAssembly.Identity)">
    <ItemGroup>
      <_PluginDep Remove="@(_PluginDep)" />
      <_PluginRuntimeAsset Remove="@(_PluginRuntimeAsset)" />
      <_PluginDepsJson Remove="@(_PluginDepsJson)" />
      <_PluginDep Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)*.dll"
                  Exclude="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Core.Abstractions.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Communication.Protocol.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Communication.Transport.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Plugin.Context.dll" />
      <_PluginDepsJson Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)%(_PluginAssembly.Filename).deps.json" />
      <_PluginRuntimeAsset Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginDep)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginDepsJson)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_PluginDepsJson.FullPath)')" />
    <Copy SourceFiles="@(_PluginRuntimeAsset)"
          DestinationFiles="@(_PluginRuntimeAsset->'$(OutDir)plugins\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPluginsToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_DeployedPluginFile Include="$(OutDir)plugins\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployedPluginFile)"
          DestinationFiles="@(_DeployedPluginFile->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
