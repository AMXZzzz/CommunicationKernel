<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- ========================================================================
       文件: CommunicationKernel.UI.WebMaster.csproj
       层级: UI 层 — Blazor Server Web 客户端
       作用: 本进程带上 Hosting.App（引擎 + gRPC），Blazor UI 经 Hosting.Sdk 连回环。
             不必再单独启动 Hosting.App.exe。树莓派无界面场景仍用独立 Hosting.App。

       不用 Microsoft.NET.Sdk.Web：
         Web SDK 会把项目登记成 ASP.NET 控制台宿主。Visual Studio F5 /
         `dotnet run` 必定再开一个黑窗口，WinExe + FreeConsole 都拆不掉
         （窗口属于 VS / dotnet.exe，不是本进程）。
         改用 Razor SDK + ASP.NET 共享框架后，VS 按 Windows 应用启动，不再配控制台。
       ======================================================================== -->

  <PropertyGroup>
    <!-- TreatWarningsAsErrors 由 Directory.Build.props 继承 -->
    <AssemblyName>CommunicationKernel.UI.WebMaster</AssemblyName>
    <RootNamespace>CommunicationKernel.UI.WebMaster</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>wwwroot\app.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>

    <!--
      WinExe：直接运行 exe 时不分配控制台窗口。
      进程改在右下角托盘驻留——关浏览器不等于退出，退出走托盘菜单。

      代价与补偿：
        没有控制台，启动失败会变成"什么都不发生"。因此 Program.cs 里
        用 try/catch 兜住整个启动流程，失败时写日志文件并弹一个消息框。
        没有那段兜底就不该开 WinExe——静默失败比黑框糟糕得多。

      托盘依赖 WinForms，因此本项目是 Windows 专用（net8.0-windows）。
      现场 Linux / 树莓派无界面时跑独立的 Hosting.App；本机有界面时开 WebMaster 即可。
    -->
    <OutputType>WinExe</OutputType>

    <!--
      允许自包含发布引用 Hosting.App。

      Hosting.App 走 Microsoft.NET.Sdk.Web，OutputType 默认是 Exe（它要能在树莓派
      上独立跑）。而本项目以 SelfContained=true 发布时，SDK 会报 NETSDK1150
      拦下「自包含应用引用非自包含可执行文件」——VS 里表现为一句无关的
      "未能找到元数据文件 ...\obj\Release\net8.0\win-x64\ref\...dll"，
      因为编译在生成 ref 程序集之前就被拦停了，很难联想到真正的原因。

      这条校验防的是「把被引用的 exe 也当 exe 分发」：那个 apphost 是框架依赖的，
      混进自包含产物里跑不起来。本项目不属于这种情况——
      我们只用 Hosting.App 的程序集（引擎 + gRPC 端点），入口点在本项目的 Main.cs，
      Hosting.App 的入口从不执行。

      不改成让 Hosting.App 自包含：那会要求它任何时候都带 RID，
      连不带 RID 的 dotnet build 都做不了。
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内嵌 Kestrel / Blazor，但不走 Web SDK（避免 VS 配控制台）。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本进程带上 Hosting.App（引擎+gRPC）。UI 只经 Hosting.Sdk 访问。 -->
    <ProjectReference Include="..\CommunicationKernel.Hosting.App\CommunicationKernel.Hosting.App.csproj">
      <ExcludeAssets>contentfiles;build;analyzers</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\CommunicationKernel.Hosting.Sdk\CommunicationKernel.Hosting.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK 已默认包含 appsettings.json，只改复制行为，不要再 Include。 -->
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    把 wwwroot 一并复制到生成目录。

    默认行为下 wwwroot 只在 publish 时进产物，build 不复制——
    因为 `dotnet run` 的 ContentRoot 是项目目录，静态文件从源码原地取。
    但直接双击 bin 里的 exe 时 ContentRoot 变成 bin 目录，
    此时找不到 wwwroot，启动日志里只有一行
    "The WebRootPath was not found ... Static files may be unavailable"，
    界面照常打开却完全没有样式——看着像 CSS 写坏了，很难联想到是路径问题。

    本项目是 WinExe（双击即用）的操作员工具，"生成完就能双击跑"
    必须成立，因此补上这条。publish 路径不受影响，那边本来就是对的。
  -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 插件只建立构建顺序，不产生编译期引用，UI 不得使用插件类型。 -->
  <ItemGroup>
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Modbus\CommunicationKernel.Plugins.Protocol.Modbus.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Panasonic\CommunicationKernel.Plugins.Protocol.Panasonic.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Siemens.S7\CommunicationKernel.Plugins.Protocol.Siemens.S7.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Transport.Tcp\CommunicationKernel.Plugins.Transport.Tcp.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Transport.SerialPort\CommunicationKernel.Plugins.Transport.SerialPort.csproj" />
    <ProjectReference Include="@(PluginProject)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun" />
  </ItemGroup>

  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <MSBuild Projects="@(PluginProject)"
             Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_PluginAssembly)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="已部署 @(_PluginAssembly->Count()) 个插件到 $(OutDir)plugins" />
  </Target>

  <Target Name="CopyPluginThirdPartyDeps"
          AfterTargets="CopyPluginsToOutput"
          Outputs="%(_PluginAssembly.Identity)">
    <ItemGroup>
      <_PluginDep Remove="@(_PluginDep)" />
      <_PluginRuntimeAsset Remove="@(_PluginRuntimeAsset)" />
      <_PluginDepsJson Remove="@(_PluginDepsJson)" />
      <_PluginDep Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)*.dll"
                  Exclude="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Core.Abstractions.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Core.Protocol.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Core.Transport.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Plugin.Context.dll" />
      <_PluginDepsJson Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)%(_PluginAssembly.Filename).deps.json" />
      <_PluginRuntimeAsset Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginDep)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginDepsJson)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_PluginDepsJson.FullPath)')" />
    <Copy SourceFiles="@(_PluginRuntimeAsset)"
          DestinationFiles="@(_PluginRuntimeAsset->'$(OutDir)plugins\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    发布时剔除 Hosting.App 带过来的 appsettings.json。

    Hosting.App 是本项目的 ProjectReference，它自己那份 appsettings.json 会随引用
    流进本项目的发布集合，与本项目同名文件撞成 NETSDK1152（同一相对路径两个来源）。

    只在 publish 出现：build 阶段 MSBuild 遇到同名直接取本项目那份，
    已验证 bin 里落的就是 WebMaster 的版本，所以这里剔除的是「本来也没在用」的那份。

    剔除它是安全的，不是压掉报错了事：
      · WebMaster 的 appsettings.json 自带 EngineRuntime 全部键，不依赖那份补充；
      · Hosting.App 那份里唯一多出来的 Kestrel:Endpoints 段本进程用不上——
        监听地址由 Main.cs 的 ConfigureKestrel 直接给定。

    不用 ErrorOnDuplicatePublishOutputFiles=false：那是把冲突检查整个关掉，
    以后真出现别的同名文件也会被静默吞掉，只能靠运气决定发布出去的是哪一份。
  -->
  <!--
    发布时剔除 Hosting.App 的 apphost 及其配套文件。

    本项目自包含发布时，Hosting.App.dll 已经打进单文件 exe，但 SDK 仍会把
    被引用项目的 apphost（Hosting.App.exe）连同 runtimeconfig.json / deps.json
    一起复制过来。它们指向的那个 .dll 并不在旁边，是三个孤儿文件：

      · Hosting.App.exe 是「框架依赖」的，而自包含产物的前提正是目标机器没装 .NET，
        双击它只会弹「必须安装 .NET」——恰好出现在一个号称免安装的包里；
      · 操作员看到两个 exe，很可能以为那个才是"引擎"，点错了还查不出原因。

    独立部署 Hosting.App（树莓派/无界面场景）走它自己的发布配置，不受这里影响。
  -->
  <Target Name="RemoveReferencedAppHostFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'CommunicationKernel.Hosting.App.exe'
                     Or '%(ResolvedFileToPublish.RelativePath)' == 'CommunicationKernel.Hosting.App.runtimeconfig.json'
                     Or '%(ResolvedFileToPublish.RelativePath)' == 'CommunicationKernel.Hosting.App.deps.json'" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveReferencedAppSettingsFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json'
                     And '%(ResolvedFileToPublish.FullPath)' != '$(MSBuildProjectDirectory)\appsettings.json'" />
    </ItemGroup>
  </Target>

  <Target Name="CopyPluginsToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_DeployedPluginFile Include="$(OutDir)plugins\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployedPluginFile)"
          DestinationFiles="@(_DeployedPluginFile->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
