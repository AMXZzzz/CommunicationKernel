{
  // ---------------------------------------------------------------------------
  // 文件: UI.WebMaster/appsettings.json
  // 层级: UI 层 — Blazor Server
  // 作用: Web 自己听哪个端口，以及去连哪台 Host.App。两件事不是同一个地址。
  //
  // 改浏览器端口：改下面的 Web:ListenPort，保存后重启 Web。
  // 禁止填 5000——那是 Host.App 的 gRPC 口。
  // 系统设置页改的端口写入本 exe 旁 config/web-listen.json，优先级高于本文件。
  // 不要改 Host.App:Address 的 5000。
  // ---------------------------------------------------------------------------
  "Web": {
    "ListenPort": 64000
  },
  "Host.App": {
    // 「去连 Host」的 gRPC 地址，不是浏览器打开的地址。不要改成 64000。
    "Address": "http://localhost:5000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
