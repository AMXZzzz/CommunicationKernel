{
  // ---------------------------------------------------------------------------
  // 文件: UI.WebMaster/appsettings.json
  // 层级: UI 层 — Blazor Server（形态 A：本进程内嵌引擎）
  // 作用: Web 监听端口 + 引擎插件目录。不再连接远端 EngineHost.App。
  //
  // 改浏览器端口：改 Web:ListenPort，保存后重启。
  // 系统设置页改的端口写入本 exe 旁 config/web-listen.json，优先级更高。
  // ---------------------------------------------------------------------------
  "Web": {
    "ListenPort": 64000
  },
  "EngineRuntime": {
    "PluginDirectory": "plugins",
    "DefaultSerialMinIoIntervalMs": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
