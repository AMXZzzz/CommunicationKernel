@* -----------------------------------------------------------------------------
   文件: Components/Pages/SettingsPage.razor
   层级: UI 层 — 系统设置
   作用: 保存并切换 Host.App 地址；立即重建 gRPC 通道，不必重启进程。
         「测试连接」用临时客户端探测输入框地址，不碰当前会话。
   ----------------------------------------------------------------------------- *@

@page "/settings"
@inject HostSession Session
@inject WebSettingsStore Settings
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>系统设置 — CommunicationKernel</PageTitle>

<div class="page page-set">
    <div class="toolbar">
        <h2 class="page-title">系统设置</h2>
        <div class="toolbar-right">
            <span class="toolbar-count">Host @Session.HostVersion</span>
        </div>
    </div>

    <div class="page-body">
    <div class="settings-card">
        <h3>Host.App 连接</h3>
        <p class="setting-hint">仅本端保存，与 WPF 无关：@Settings.FilePath</p>

        <label>gRPC 地址</label>
        <input @bind="_address" placeholder="http://192.168.1.20:5000" />

        <div class="form-actions">
            <button class="btn ghost" type="button" @onclick="TestAsync" disabled="@_busy">
                @(_busy ? "请稍候…" : "测试连接")
            </button>
            <button class="btn primary" type="button" @onclick="SaveAsync" disabled="@_busy">保存并切换</button>
        </div>

        <div class="connect-status @_statusClass" style="margin-top:12px">@_status</div>
        <div class="setting-hint">当前会话：@Session.Address · Host @Session.HostVersion · 路由 @Session.RouteCount</div>
    </div>

    <div class="settings-card">
        <h3>本机 Web 地址</h3>
        <p class="setting-hint">当前实际监听 @_listenPort。也可直接改项目里 appsettings.json 的 Web:ListenPort。改完必须重启 Web。文件：@Settings.ListenFilePath</p>
        <label>监听端口</label>
        <input @bind="_portText" placeholder="64000" inputmode="numeric" />
        <div class="form-actions">
            <button class="btn primary" type="button" @onclick="SavePort" disabled="@_busy">保存端口</button>
        </div>
        <div class="connect-status @_portStatusClass" style="margin-top:12px">@_portStatus</div>
        <label>本机浏览器</label>
        <input readonly value="http://localhost:@_listenPort" />
        <label style="margin-top:12px">同一 WiFi 的手机</label>
        @if (_phoneUrls.Count == 0)
        {
            <p class="setting-hint">没找到局域网 IPv4。确认电脑已连 WiFi 后刷新本页。</p>
        }
        else
        {
            @foreach (string url in _phoneUrls)
            {
                <input readonly value="@url" style="margin-bottom:8px" />
            }
        }
        <p class="setting-hint">5000 是 Host.App 的 gRPC 口，不能填。Host 地址在上面单独配。</p>
    </div>

    <div class="settings-card">
        <h3>关于</h3>
        <p class="setting-desc">CommunicationKernel Web 上位机</p>
        <p class="setting-hint">Blazor Server · 只持有 route_id · 协议清单来自宿主插件 · 串口枚举发生在宿主机器 · 设备/变量落在本机，Host 重启后对账恢复</p>
    </div>
    </div>
</div>

@code {
    /// <summary>地址输入框的当前文本；与会话地址分开，未保存前不影响实际连接。</summary>
    private string _address = string.Empty;
    /// <summary>是否有探测或保存在途，用于禁用按钮防重复提交。</summary>
    private bool _busy;
    /// <summary>状态行文案，反映最近一次测试或保存的结果。</summary>
    private string _status = "未测试";
    /// <summary>状态行的 CSS 类，与 _status 配套变化。</summary>
    private string _statusClass = "status-muted";

    /// <summary>当前 Web 监听端口，用来拼手机地址。</summary>
    private int _listenPort = LanAccess.DefaultPort;
    /// <summary>端口输入框文本，未保存前不影响实际监听。</summary>
    private string _portText = LanAccess.DefaultPort.ToString();
    /// <summary>保存端口后的提示。</summary>
    private string _portStatus = "未保存过则使用 64000";
    /// <summary>端口状态行 CSS。</summary>
    private string _portStatusClass = "status-muted";
    /// <summary>同一 WiFi 下手机该打开的 http 地址。</summary>
    private IReadOnlyList<string> _phoneUrls = Array.Empty<string>();

    /// <summary>用当前会话状态初始化表单与状态行，并订阅后续变化。</summary>
    protected override void OnInitialized()
    {
        _address = Session.Address;
        _status = Session.Online ? "已连接" : "当前离线";
        _statusClass = Session.Online ? "status-ok" : "status-muted";
        if (Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out Uri? uri) && uri.Port > 0)
            _listenPort = uri.Port;
        _portText = WebSettingsStore.TryReadSavedPort(out int saved)
            ? saved.ToString()
            : _listenPort.ToString();
        _phoneUrls = LanAccess.PhoneUrls(_listenPort);
        Session.Changed += OnChanged;
    }

    /// <summary>会话状态变化时重绘；事件来自后台线程，必须经 InvokeAsync 切回。</summary>
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// 测试输入框里的地址是否可连接，<b>不</b>切换当前会话。
    /// </summary>
    /// <remarks>
    /// 走 <c>ProbeAddressAsync</c> 用临时客户端探测。若改用当前会话去探，
    /// 测的是旧地址——那正是「测试通过、保存后却连不上」的来源。
    /// </remarks>
    private async Task TestAsync()
    {
        if (string.IsNullOrWhiteSpace(_address))
        {
            _status = "地址不能为空";
            _statusClass = "status-error";
            return;
        }
        _busy = true;
        _status = "探测中…";
        _statusClass = "status-warn";
        try
        {
            var (ok, version, count) = await Session.ProbeAddressAsync(_address.Trim()).ConfigureAwait(true);
            if (ok)
            {
                _status = "可连接 · " + count + " 条路由 · " + version;
                _statusClass = "status-ok";
            }
            else
            {
                _status = "无响应: " + _address.Trim();
                _statusClass = "status-error";
            }
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// 保存地址并切换会话到新地址。
    /// </summary>
    /// <remarks>
    /// 保存成功但新地址无响应时给 warn 而非 error：地址已经写进磁盘了，
    /// 报成红色会让操作员以为没存上而反复重试。
    /// 现场先配地址、后接网线是常见顺序。
    /// </remarks>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_address))
        {
            _status = "地址不能为空";
            _statusClass = "status-error";
            return;
        }
        _busy = true;
        try
        {
            await Session.SwitchAddressAsync(_address.Trim()).ConfigureAwait(true);
            _status = Session.Online
                ? "已切换并连上 · " + Session.RouteCount + " 条路由"
                : "地址已保存，但新地址暂无响应";
            _statusClass = Session.Online ? "status-ok" : "status-warn";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _statusClass = "status-error";
        }
        finally { _busy = false; }
    }

    /// <summary>保存 Web 监听端口。不能在运行中换口，所以只落盘并提示重启。</summary>
    private void SavePort()
    {
        if (!int.TryParse(_portText.Trim(), out int port))
        {
            _portStatus = "请输入数字端口";
            _portStatusClass = "status-error";
            return;
        }
        if (port == WebSettingsStore.HostPort)
        {
            _portStatus = "5000 是 Host.App 的端口，Web 不能占用";
            _portStatusClass = "status-error";
            return;
        }
        if (!WebSettingsStore.IsAllowedPort(port))
        {
            _portStatus = "端口必须在 1024–65535";
            _portStatusClass = "status-error";
            return;
        }
        try
        {
            Settings.SaveListenPort(port);
            _portStatus = port == _listenPort
                ? "已保存，当前就是这个端口"
                : "已保存。请关掉 Web 再打开，之后用 http://localhost:" + port;
            _portStatusClass = port == _listenPort ? "status-ok" : "status-warn";
        }
        catch (Exception ex)
        {
            _portStatus = ex.Message;
            _portStatusClass = "status-error";
        }
    }

    /// <summary>退订会话事件；Session 是单例，漏退会泄漏本组件。</summary>
    public void Dispose() => Session.Changed -= OnChanged;
}
