@* -----------------------------------------------------------------------------
   文件: Components/Pages/SettingsPage.razor
   层级: UI 层 — 系统设置
   作用: 查看内嵌引擎状态；修改本机 Web 监听端口。
   ----------------------------------------------------------------------------- *@

@page "/settings"
@inject EngineSession Session
@inject WebSettingsStore Settings
@inject WebProxySettingsStore Proxy
@inject WebAuthStore Auth
@inject WebTunnelSettingsStore Tunnel
@inject FrpcHost Frpc
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>系统设置 — CommunicationKernel</PageTitle>

<div class="page page-set">
    <div class="toolbar">
        <h2 class="page-title">系统设置</h2>
        <div class="toolbar-right">
            <span class="toolbar-count">Engine @Session.HostVersion</span>
        </div>
    </div>

    <div class="page-body">
    <div class="settings-card">
        <h3>通讯引擎</h3>
        <p class="setting-hint">本进程已带上 Hosting.App（gRPC 默认 :5000）。不必再开独立 exe。WPF 可连本机 http://127.0.0.1:5000。协议插件在 exe 旁 plugins。</p>
        <div class="connect-status @(Session.Online ? "status-ok" : "status-error")">
            @(Session.Online ? "引擎在线 · " + Session.RouteCount + " 条路由 · " + Session.HostVersion : "引擎未就绪")
        </div>
    </div>

    <div class="settings-card">
        <h3>本机 Web 地址</h3>
        <p class="setting-hint">当前实际监听 @_listenPort。也可直接改项目里 appsettings.json 的 Web:ListenPort。改完必须重启 Web。文件：@Settings.ListenFilePath</p>
        <label>监听端口</label>
        <input @bind="_portText" placeholder="64000" inputmode="numeric" />
        <div class="form-actions">
            <button class="btn primary" type="button" @onclick="SavePort">保存端口</button>
        </div>
        <div class="connect-status @_portStatusClass" style="margin-top:12px">@_portStatus</div>
        <label>本机浏览器</label>
        <input readonly value="http://localhost:@_listenPort" />
        <label style="margin-top:12px">同一 WiFi 的手机</label>
        @if (_phoneUrls.Count == 0)
        {
            <p class="setting-hint">没找到局域网 IPv4。确认电脑已连 WiFi 后刷新本页。</p>
        }
        else
        {
            @foreach (string url in _phoneUrls)
            {
                <input readonly value="@url" style="margin-bottom:8px" />
            }
        }
        <p class="setting-hint">不要填 5000。那是本进程 gRPC（Hosting.App）的口，给 WPF 用。</p>
    </div>

    <div class="settings-card">
        <h3>访问口令</h3>
        <p class="setting-hint">
            设了口令后，打开界面要先登录。留空即不需要登录（本机/局域网默认如此）。
            改完必须重启 Web。文件：@Auth.FilePath
        </p>

        <div class="connect-status @(_authEnabled ? "status-ok" : "status-warn")">
            @(_authEnabled ? "已启用登录" : "未设口令 · 任何能访问本地址的人都能操作")
        </div>

        <label style="margin-top:12px">新口令（至少 @WebAuthStore.MinPasswordLength 位）</label>
        <input type="password" @bind="_pwd1" autocomplete="new-password" />

        <label>再输一次</label>
        <input type="password" @bind="_pwd2" autocomplete="new-password" />

        <div class="form-actions">
            <button class="btn primary" type="button" @onclick="SavePassword">保存口令</button>
            @if (_authEnabled)
            {
                <button class="btn danger" type="button" @onclick="ClearPassword">取消登录</button>
            }
        </div>
        <div class="connect-status @_authStatusClass" style="margin-top:12px">@_authStatus</div>

        @* 忘记口令必须有一条不依赖界面的出路——设了口令又忘了就进不来了，
           而现场没有第二个入口。 *@
        <p class="setting-hint">
            忘记口令：删掉 <span class="mono">config/web-auth.json</span> 再重启即可恢复免登录。
        </p>
        <p class="setting-hint">
            这只是一道门槛，没有多用户与权限分级。对外暴露时，
            反向代理上的 Basic Auth / IP 白名单仍然要加——两者叠加，不是二选一。
        </p>
    </div>

    <div class="settings-card">
        <h3>外地访问（反向代理）</h3>
        <p class="setting-hint">
            公网机（1Panel / 宝塔 / nginx）做 HTTPS 中转、经隧道转到本机时开启。
            本机与同一 WiFi 访问<b>不需要</b>开。改完必须重启 Web。文件：@Proxy.FilePath
        </p>

        @* 警告放在界面上而不是只写在文档里：开这个开关的人多半正准备
           把界面挂到公网，暴露面这件事必须在他动手前看到。 *@
        @if (!_authEnabled)
        {
            <div class="status-msg status-error" style="margin:12px 0">
                <b>还没设访问口令。</b>挂到公网后，任何拿到网址的人都能读写现场 PLC 寄存器。
                请先到上面「访问口令」设一个，并在反向代理上再加一层 Basic Auth 或 IP 白名单。
            </div>
        }
        else
        {
            <div class="status-msg status-warn" style="margin:12px 0">
                已设访问口令。仍<b>建议</b>在反向代理上叠加 Basic Auth 或来源 IP 白名单——
                应用内的口令只是一道门槛，没有多用户、没有审计。
                另外确认 gRPC 的 <span class="mono">:5000</span> 没有一并暴露出去，那个口没有任何认证。
            </div>
        }

        <label class="inline-check">
            <input type="checkbox" checked="@_proxyEnabled" @onchange="e => _proxyEnabled = e.Value is true" />
            启用反向代理支持
        </label>

        <label class="inline-check @(_proxyEnabled ? null : "disabled")">
            <input type="checkbox" checked="@_proxyForceHttps" disabled="@(!_proxyEnabled)"
                   @onchange="e => _proxyForceHttps = e.Value is true" />
            强制 HTTPS（http 访问自动跳转，并下发 HSTS 30 天）
        </label>
        @if (!_proxyEnabled)
        {
            @* 硬联锁而非仅提示：证书在公网机上，本进程没有 HTTPS 侦听器。
               不开反代就没有 X-Forwarded-Proto，每个请求都会被判成明文而无限重定向，
               到那时连设置页都打不开，只能去删配置文件。 *@
            <p class="setting-hint">需先启用上面的「反向代理支持」才能开启——本进程自身不监听 HTTPS。</p>
        }
        else if (_proxyForceHttps)
        {
            <div class="status-msg status-warn" style="margin-top:8px">
                HSTS 会被浏览器<b>缓存 30 天且无法远程撤销</b>。
                确认公网机的证书有效再开；证书过期或以后要退回 http 时，
                访问过的浏览器需要手动清除 HSTS 记录才能打开。
            </div>
        }

        <label>子路径（可空）</label>
        <input @bind="_proxyPathBase" placeholder="反代到 https://例子.com/ck/ 时填 /ck；根路径留空" />

        <label>可信代理 IP（可空，每行一个）</label>
        <textarea rows="3" @bind="_proxyTrusted"
                  placeholder="留空表示不校验来源。此时必须保证本端口只对反代开放"></textarea>

        <div class="form-actions">
            <button class="btn primary" type="button" @onclick="SaveProxy">保存代理设置</button>
        </div>
        <div class="connect-status @_proxyStatusClass" style="margin-top:12px">@_proxyStatus</div>

        <p class="setting-hint">
            不开这个开关时，经 HTTPS 反代访问会出现「页面能打开、按钮全都没反应」——
            Blazor 的实时线路按明文协议回连，被浏览器当混合内容拦掉了。
        </p>
    </div>

    <div class="settings-card">
        <h3>内网穿透（frpc）</h3>
        <p class="setting-hint">
            让公网服务器能连到本机，配合上面的反向代理实现外地访问。
            公网机上仍需自行部署 <span class="mono">frps</span>——隧道两头都要有。
            改完必须重启 Web。文件：@Tunnel.FilePath
        </p>

        @if (!WebTunnelSettingsStore.FrpcPresent)
        {
            @* frpc.exe 刻意不随包分发：内网穿透工具被杀软报毒是常态，
               打进安装包会连累整个 WebMaster 被拦。改由用户自行放置，
               我们只负责生成配置、托管进程、显示状态。 *@
            <div class="status-msg status-warn" style="margin:12px 0">
                <b>未检测到 @WebTunnelSettingsStore.FrpcFileName。</b>
                本程序不附带穿透工具（会被杀软误报，可能连累整个软件被拦）。
                请自行到
                <span class="mono">@WebTunnelSettingsStore.FrpcDownloadUrl</span>
                下载对应版本，把 <span class="mono">@WebTunnelSettingsStore.FrpcFileName</span>
                放到本程序 exe 所在目录，再重启。
            </div>
            <label>应放置到</label>
            <input readonly value="@WebTunnelSettingsStore.FrpcPath" />
        }
        else
        {
            <div class="connect-status @_tunnelStatusClass">
                @_tunnelRuntimeStatus
            </div>

            <label class="inline-check" style="margin-top:12px">
                <input type="checkbox" checked="@_tunnelEnabled"
                       @onchange="e => _tunnelEnabled = e.Value is true" />
                启用内网穿透
            </label>

            <label>服务器地址</label>
            <input @bind="_tunnelAddr" placeholder="公网 IP 或域名" />

            <label>服务器端口（frps 的 bindPort）</label>
            <input type="number" @bind="_tunnelPort" placeholder="7000" inputmode="numeric" />

            <label>Token（与 frps 的 auth.token 相同）</label>
            <input type="password" @bind="_tunnelToken" autocomplete="off" />

            <label>远端端口（公网机上反代指向它）</label>
            <input type="number" @bind="_tunnelRemotePort" placeholder="16400" inputmode="numeric" />

            <div class="form-actions">
                <button class="btn primary" type="button" @onclick="SaveTunnel">保存穿透设置</button>
            </div>
            <div class="connect-status @_tunnelStatusClass" style="margin-top:12px">@_tunnelStatus</div>

            <div class="status-msg status-warn" style="margin-top:12px">
                开启后本机会<b>主动向公网建立长连接</b>，界面即可从外网访问。
                请确认已设访问口令，且公网机上只把远端端口反代给 Nginx、
                <b>不要</b>在安全组里对外开放。
            </div>
        }
    </div>

    <div class="settings-card">
        <h3>关于</h3>
        <p class="setting-desc">CommunicationKernel Web 上位机</p>
        <p class="setting-hint">Blazor Server · 本进程带 Hosting.App · UI 经 Hosting.Sdk 回环 · 设备/变量落在 exe 旁 config/</p>
    </div>
    </div>
</div>

@code {
    /// <summary>
    /// 当前<b>实际</b>监听的端口。
    /// </summary>
    /// <remarks>
    /// 取自浏览器地址栏（Nav.BaseUri）而不是配置文件——
    /// 改过端口但还没重启时，配置里是新值、实际跑的是旧值，
    /// 拿配置当"当前"会让提示语与现实矛盾。
    /// </remarks>
    private int _listenPort = LanAccess.DefaultPort;
    /// <summary>输入框文本。与 <see cref="_listenPort"/> 分开：未保存前不影响实际监听。</summary>
    private string _portText = LanAccess.DefaultPort.ToString();
    /// <summary>端口设置的状态行文案。</summary>
    private string _portStatus = "未保存过则使用 64000";
    /// <summary>状态行样式类，与 <see cref="_portStatus"/> 配套变化。</summary>
    private string _portStatusClass = "status-muted";
    /// <summary>可供手机/平板访问的局域网地址清单，按本机网卡枚举得出。</summary>
    private IReadOnlyList<string> _phoneUrls = Array.Empty<string>();

    /// <summary>读出实际端口与已保存端口，并算出局域网访问地址。</summary>
    protected override void OnInitialized()
    {
        if (Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out Uri? uri) && uri.Port > 0)
            _listenPort = uri.Port;
        _portText = WebSettingsStore.TryReadSavedPort(out int saved)
            ? saved.ToString()
            : _listenPort.ToString();
        _phoneUrls = LanAccess.PhoneUrls(_listenPort);
        LoadProxyIntoForm();

        LoadTunnelIntoForm();

        _authEnabled = Auth.IsEnabled;
        _authStatus = _authEnabled ? "已设口令" : "未设口令";
        _authStatusClass = _authEnabled ? "status-ok" : "status-muted";
        Session.Changed += OnChanged;
    }

    /// <summary>会话状态变化时重绘；事件来自后台线程，必须经 InvokeAsync 切回。</summary>
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// 校验并保存监听端口。
    /// </summary>
    /// <remarks>
    /// <para>三道校验，顺序即优先级：</para>
    /// <list type="number">
    ///   <item>不是数字——直接拦。</item>
    ///   <item><b>不能是 5000</b>：那是独立宿主 Hosting.App 的端口。
    ///         WebMaster 内嵌了宿主，两者都绑 5000 会互相抢，
    ///         而冲突要到下次启动才暴露，那时已经看不出是这里改的。</item>
    ///   <item>必须在 1024–65535：1024 以下是特权端口，普通用户绑不上。</item>
    /// </list>
    /// <para>
    /// 端口<b>改了要重启才生效</b>——Kestrel 的监听在启动时就绑定了。
    /// 因此保存成功时按"是否与当前端口相同"给不同措辞：相同给 ok，
    /// 不同给 warn 并明确提示要重开，否则用户会以为已经切过去了。
    /// </para>
    /// </remarks>
    private void SavePort()
    {
        if (!int.TryParse(_portText.Trim(), out int port))
        {
            _portStatus = "请输入数字端口";
            _portStatusClass = "status-error";
            return;
        }
        if (port == WebSettingsStore.HostPort)
        {
            _portStatus = "5000 留给独立宿主 Hosting.App，Web 不能占用";
            _portStatusClass = "status-error";
            return;
        }
        if (!WebSettingsStore.IsAllowedPort(port))
        {
            _portStatus = "端口必须在 1024–65535";
            _portStatusClass = "status-error";
            return;
        }
        try
        {
            Settings.SaveListenPort(port);
            _portStatus = port == _listenPort
                ? "已保存，当前就是这个端口"
                : "已保存。请关掉 Web 再打开，之后用 http://localhost:" + port;
            _portStatusClass = port == _listenPort ? "status-ok" : "status-warn";
        }
        catch (Exception ex)
        {
            _portStatus = ex.Message;
            _portStatusClass = "status-error";
        }
    }

    // ========================================================================
    // 访问口令
    // ========================================================================

    /// <summary>当前是否已设口令。</summary>
    private bool _authEnabled;

    /// <summary>表单：新口令。</summary>
    private string _pwd1 = string.Empty;

    /// <summary>表单：确认口令。</summary>
    private string _pwd2 = string.Empty;

    /// <summary>口令设置的状态行文案。</summary>
    private string _authStatus = string.Empty;

    /// <summary>口令状态行的样式类。</summary>
    private string _authStatusClass = "status-muted";

    /// <summary>
    /// 设置或修改口令。
    /// </summary>
    /// <remarks>
    /// 两次输入必须一致——口令是密文输入，打错一个字符自己看不出来，
    /// 而设完重启就进不去了，只能去删配置文件。确认框是这里最值钱的一道校验。
    /// </remarks>
    private void SavePassword()
    {
        if (_pwd1.Length < WebAuthStore.MinPasswordLength)
        {
            _authStatus = $"口令至少 {WebAuthStore.MinPasswordLength} 位";
            _authStatusClass = "status-error";
            return;
        }

        if (_pwd1 != _pwd2)
        {
            _authStatus = "两次输入不一致";
            _authStatusClass = "status-error";
            return;
        }

        try
        {
            Auth.SetPassword(_pwd1);

            // 立刻清掉内存里的明文，别让它跟着组件状态留在服务端
            _pwd1 = string.Empty;
            _pwd2 = string.Empty;

            _authEnabled = true;
            _authStatus = "已保存。请退出 Web 再打开，之后访问需要登录。";
            _authStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _authStatus = ex.Message;
            _authStatusClass = "status-error";
        }
    }

    /// <summary>清除口令，恢复免登录。</summary>
    private void ClearPassword()
    {
        try
        {
            Auth.ClearPassword();
            _authEnabled = false;
            _authStatus = "已取消登录。请退出 Web 再打开生效。";
            _authStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _authStatus = ex.Message;
            _authStatusClass = "status-error";
        }
    }

    // ========================================================================
    // 内网穿透
    // ========================================================================

    /// <summary>表单：是否启用穿透。</summary>
    private bool _tunnelEnabled;

    /// <summary>表单：公网服务器地址。</summary>
    private string _tunnelAddr = string.Empty;

    /// <summary>表单：frps 的 bindPort。</summary>
    private int _tunnelPort = 7000;

    /// <summary>表单：与 frps 相同的 token。</summary>
    private string _tunnelToken = string.Empty;

    /// <summary>表单：在公网机上暴露的端口。</summary>
    private int _tunnelRemotePort = 16400;

    /// <summary>保存操作的状态行文案。</summary>
    private string _tunnelStatus = string.Empty;

    /// <summary>状态行样式类。</summary>
    private string _tunnelStatusClass = "status-muted";

    /// <summary>当前隧道的运行状态，来自 <see cref="FrpcHost"/>。</summary>
    private string _tunnelRuntimeStatus = "未启动";

    /// <summary>把已保存的穿透设置读进表单，并取一次运行状态。</summary>
    private void LoadTunnelIntoForm()
    {
        WebTunnelSettings t = WebTunnelSettingsStore.Load();

        _tunnelEnabled = t.Enabled;
        _tunnelAddr = t.ServerAddr;
        _tunnelPort = t.ServerPort;
        _tunnelRemotePort = t.RemotePort;

        // token 回填到密码框：不回填的话，用户改别的项再保存就会把 token 清空
        _tunnelToken = t.Token;

        _tunnelRuntimeStatus = "隧道：" + Frpc.Status;
        _tunnelStatusClass = Frpc.Connected ? "status-ok"
            : t.Enabled ? "status-warn" : "status-muted";
    }

    /// <summary>校验并保存穿透设置。</summary>
    /// <remarks>
    /// 启用时才校验必填项：只是先把服务器地址存下来、暂不启用，是合理的用法，
    /// 这时候拦着不让存反而碍事。
    /// </remarks>
    private void SaveTunnel()
    {
        if (_tunnelEnabled)
        {
            if (string.IsNullOrWhiteSpace(_tunnelAddr))
            {
                _tunnelStatus = "请填服务器地址";
                _tunnelStatusClass = "status-error";
                return;
            }

            if (string.IsNullOrWhiteSpace(_tunnelToken))
            {
                _tunnelStatus = "请填 token（要与服务器 frps 的 auth.token 相同）";
                _tunnelStatusClass = "status-error";
                return;
            }

            if (_tunnelPort is < 1 or > 65535 || _tunnelRemotePort is < 1 or > 65535)
            {
                _tunnelStatus = "端口必须在 1–65535";
                _tunnelStatusClass = "status-error";
                return;
            }
        }

        try
        {
            Tunnel.Save(new WebTunnelSettings(
                _tunnelEnabled, _tunnelAddr.Trim(), _tunnelPort, _tunnelToken, _tunnelRemotePort));

            _tunnelStatus = _tunnelEnabled
                ? "已保存。请退出 Web 再打开，隧道才会建立。"
                : "已保存（未启用）。请退出 Web 再打开生效。";
            _tunnelStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _tunnelStatus = ex.Message;
            _tunnelStatusClass = "status-error";
        }
    }

    // ========================================================================
    // 反向代理
    // ========================================================================

    /// <summary>表单：是否启用反代支持。</summary>
    private bool _proxyEnabled;

    /// <summary>表单：子路径前缀，保存时会规范化成 /xxx。</summary>
    private string _proxyPathBase = string.Empty;

    /// <summary>表单：是否强制 HTTPS。仅在启用反代时可用，见界面上的联锁说明。</summary>
    private bool _proxyForceHttps;

    /// <summary>表单：可信代理 IP，界面上每行一个。</summary>
    private string _proxyTrusted = string.Empty;

    /// <summary>代理设置的状态行文案。</summary>
    private string _proxyStatus = "未启用";

    /// <summary>代理状态行的样式类。</summary>
    private string _proxyStatusClass = "status-muted";

    /// <summary>把已保存的反代设置读进表单。</summary>
    private void LoadProxyIntoForm()
    {
        WebProxySettings p = WebProxySettingsStore.Load();

        _proxyEnabled = p.Enabled;
        _proxyPathBase = p.PathBase;
        _proxyForceHttps = p.ForceHttps;
        _proxyTrusted = string.Join(Environment.NewLine, p.TrustedProxies);

        _proxyStatus = p.Enabled ? "已启用（重启后生效的配置见上）" : "未启用";
        _proxyStatusClass = p.Enabled ? "status-ok" : "status-muted";
    }

    /// <summary>
    /// 保存反代设置。
    /// </summary>
    /// <remarks>
    /// 中间件管线在启动时就装配好了，改完必须重启——因此提示语统一写「重启后生效」，
    /// 不能只说「已保存」，否则用户会以为立刻就能用。
    /// </remarks>
    private void SaveProxy()
    {
        try
        {
            // 每行一个 IP，允许用逗号分隔；空行与空白一律丢掉
            string[] proxies = _proxyTrusted
                .Split(new[] { '\r', '\n', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => s.Length > 0)
                .ToArray();

            // 先校验再落盘：写进去一个解析不了的 IP，启动时只会在日志里
            // 留一行警告然后被忽略，用户在界面上看不出哪里错了
            string? bad = proxies.FirstOrDefault(s => !System.Net.IPAddress.TryParse(s, out _));
            if (bad is not null)
            {
                _proxyStatus = "不是合法的 IP：" + bad;
                _proxyStatusClass = "status-error";
                return;
            }

            Proxy.Save(new WebProxySettings(
                _proxyEnabled,
                proxies,
                WebProxySettings.NormalizePathBase(_proxyPathBase),
                _proxyEnabled && _proxyForceHttps));

            // 回读一次，让界面显示规范化之后的值（例如 ck/ → /ck）
            LoadProxyIntoForm();

            _proxyStatus = _proxyEnabled
                ? "已保存并启用。请退出 Web 再打开才生效。"
                : "已保存（未启用）。请退出 Web 再打开才生效。";
            _proxyStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _proxyStatus = ex.Message;
            _proxyStatusClass = "status-error";
        }
    }

    /// <summary>退订会话事件；Session 是单例，漏退会泄漏本组件。</summary>
    public void Dispose() => Session.Changed -= OnChanged;
}
