@* -----------------------------------------------------------------------------
   文件: Components/Pages/SettingsPage.razor
   层级: UI 层 — 系统设置
   作用: 查看内嵌引擎状态；修改本机 Web 监听端口。
   ----------------------------------------------------------------------------- *@

@page "/settings"
@inject EngineSession Session
@inject WebSettingsStore Settings
@inject WebProxySettingsStore Proxy
@inject WebAuthStore Auth
@inject WebTunnelSettingsStore Tunnel
@inject FrpcHost Frpc
@inject WebRuntimeInfo Runtime
@implements IDisposable

<PageTitle>系统设置 — CommunicationKernel</PageTitle>

<div class="page page-set">
    <div class="toolbar">
        <h2 class="page-title">系统设置</h2>
        @* 这句必须在页头而不是埋进某一节：本页所有配置都落在 config/ 下的
           独立 json 里，而"改完要不要重启"因节而异——先把规则讲清楚，
           下面每节右上角的胶囊再各自标注自己属于哪一种。 *@
        <span class="hint">配置落盘于 <span class="mono">config/*.json</span>；标「需重启」的项要重启 Web 服务后才生效</span>
        <span class="spacer"></span>
        <span class="toolbar-count">Engine @Session.HostVersion</span>
    </div>

    <div class="page-body flush">
        <div class="set-layout">

            @* 左栏既是导航也是总览：每节右侧的胶囊直接写出该节当前的状态。
               原来六张卡片竖着堆，"口令开没开、穿透就不就绪"这些要滚到底才知道，
               而它们恰恰是安全上最要紧的两条。 *@
            <aside class="set-nav">
                <div class="set-nav-hd">设置项</div>
                @foreach (SetSection s in Sections)
                {
                    <button type="button" class="@(_section == s.Id ? "active" : null)"
                            @onclick="() => _section = s.Id">
                        <span class="body">
                            <span class="t">@s.Title</span>
                            <span class="s">@s.Sub</span>
                        </span>
                        @* 「关于」没有状态可报，胶囊整个不渲染。
                           渲染成空胶囊会在那一行留一个空边框方块，
                           看起来像状态没读出来。 *@
                        @if (s.Pill.Length > 0)
                        {
                            <span class="pill @s.PillClass">@s.Pill</span>
                        }
                    </button>
                }
            </aside>

            <main class="set-content">

                @* ---------------------------------------------------------------
                   通讯引擎
                   --------------------------------------------------------------- *@
                @if (_section == "engine")
                {
                    <section class="set-sec">
                        <div class="sec-hd">
                            <h3>通讯引擎</h3>
                            <span class="desc">同进程内的 Hosting.App，不必再开独立 exe</span>
                            <span class="pill @(Session.Online ? "on" : "warn")">@(Session.Online ? "在线" : "未就绪")</span>
                        </div>
                        <div class="sec-body">
                            <div class="kv-strip">
                                <div>
                                    <div class="k">状态</div>
                                    <div class="v small"><span class="led @(Session.Online ? "on" : null)"></span>@(Session.Online ? "在线" : "未就绪")</div>
                                </div>
                                <div><div class="k">版本</div><div class="v small">@Session.HostVersion</div></div>
                                <div><div class="k">路由</div><div class="v">@Session.RouteCount</div></div>
                                <div><div class="k">gRPC</div><div class="v small">127.0.0.1:5000</div></div>
                            </div>
                            <div class="notice info">
                                协议插件放在 exe 旁的 <span class="mono">plugins</span> 目录；
                                WPF 上位机连本机 <span class="mono">http://127.0.0.1:5000</span> 即可，
                                <b>不需要</b>另外启动 Hosting.App。
                            </div>
                            <div class="actions">
                                <span class="msg"></span>
                                <div class="right"><a class="btn ghost" href="/devices">查看路由 →</a></div>
                            </div>
                        </div>
                    </section>
                }

                @* ---------------------------------------------------------------
                   本机 Web 地址
                   --------------------------------------------------------------- *@
                @if (_section == "listen")
                {
                    <section class="set-sec">
                        <div class="sec-hd">
                            <h3>本机 Web 地址</h3>
                            <span class="desc mono" title="@Settings.ListenFilePath">@WebPaths.Short(Settings.ListenFilePath)</span>
                            <span class="pill restart">需重启</span>
                        </div>
                        <div class="sec-body">
                            <div class="row">
                                <label for="set-port">监听端口</label>
                                <div class="inline">
                                    <input id="set-port" class="mono" @bind="_portText" placeholder="64000" inputmode="numeric" />
                                    <button class="btn primary" type="button" @onclick="SavePort">保存</button>
                                </div>
                                <span class="help">当前实际监听 <b class="mono">@_listenPort</b>。5000 已被本进程的 gRPC 占用，不能填。</span>
                            </div>
                            <div class="row">
                                <label>本机浏览器</label>
                                <div class="url-list">
                                    <div class="url"><span class="led on"></span><code>http://localhost:@_listenPort</code></div>
                                </div>
                                <span class="help">这台机器上自己打开用的地址</span>
                            </div>
                            <div class="row top">
                                <label>同一 WiFi 的手机</label>
                                @if (_phoneUrls.Count == 0)
                                {
                                    <div class="notice info">没找到局域网 IPv4。确认电脑已连 WiFi 后刷新本页。</div>
                                }
                                else
                                {
                                    <div class="url-list">
                                        @foreach (string url in _phoneUrls)
                                        {
                                            <div class="url"><span class="led on"></span><code>@url</code></div>
                                        }
                                    </div>
                                }
                                <span class="help">按本机网卡枚举。手机连同一个 WiFi 后直接输这个地址</span>
                            </div>
                            <div class="actions">
                                <span class="msg @_portStatusClass">@_portStatus</span>
                            </div>
                        </div>
                    </section>
                }

                @* ---------------------------------------------------------------
                   访问口令
                   --------------------------------------------------------------- *@
                @if (_section == "auth")
                {
                    <section class="set-sec">
                        <div class="sec-hd">
                            <h3>访问口令</h3>
                            <span class="desc mono" title="@Auth.FilePath">@WebPaths.Short(Auth.FilePath)</span>
                            <span class="pill @(_authEnabled ? "on" : "off")">@(_authEnabled ? "已启用" : "关闭")</span>
                        </div>
                        <div class="sec-body">
                            @if (!_authEnabled)
                            {
                                <div class="notice warn">
                                    当前<b>不需要登录</b>：任何能访问本地址的人都能读写现场 PLC 寄存器。
                                    本机或可信局域网内这样用没问题；一旦要经反代或穿透对外暴露，请先设一个。
                                </div>
                            }
                            <div class="row">
                                <label for="pwd1">新口令</label>
                                <input id="pwd1" type="password" @bind="_pwd1" autocomplete="new-password" />
                                <span class="help">至少 @WebAuthStore.MinPasswordLength 位。只保存盐 + 哈希，不保存明文</span>
                            </div>
                            <div class="row">
                                <label for="pwd2">再输一次</label>
                                <input id="pwd2" type="password" @bind="_pwd2" autocomplete="new-password" />
                                <span class="help"></span>
                            </div>
                            <div class="actions">
                                <span class="msg @_authStatusClass">@_authStatus</span>
                                <div class="right">
                                    @if (_authEnabled)
                                    {
                                        <button class="btn ghost danger" type="button" @onclick="ClearPassword">取消登录</button>
                                    }
                                    <button class="btn primary" type="button" @onclick="SavePassword">保存口令</button>
                                </div>
                            </div>
                            @* 忘记口令必须有一条不依赖界面的出路——设了口令又忘了就进不来了，
                               而现场没有第二个入口。 *@
                            <div class="notice info">
                                <b>忘记口令：</b>删掉 <span class="mono">config/web-auth.json</span> 再重启即可恢复免登录。
                                <br />
                                这只是一道门槛，没有多用户与权限分级。对外暴露时，反向代理上的
                                Basic Auth / IP 白名单仍然要加——两者叠加，不是二选一。
                            </div>
                        </div>
                    </section>
                }

                @* ---------------------------------------------------------------
                   反向代理
                   --------------------------------------------------------------- *@
                @if (_section == "proxy")
                {
                    <section class="set-sec">
                        <div class="sec-hd">
                            <h3>外地访问（反向代理）</h3>
                            <span class="desc mono" title="@Proxy.FilePath">@WebPaths.Short(Proxy.FilePath)</span>
                            <span class="pill restart">需重启</span>
                        </div>
                        <div class="sec-body">
                            @* 警告放在界面上而不是只写在文档里：开这个开关的人多半正准备
                               把界面挂到公网，暴露面这件事必须在他动手前看到。 *@
                            @if (!_authEnabled)
                            {
                                <div class="notice err">
                                    <b>还没设访问口令。</b>挂到公网后，任何拿到网址的人都能读写现场 PLC 寄存器。
                                    请先到「访问口令」设一个，并在反向代理上再加一层 Basic Auth 或 IP 白名单。
                                </div>
                            }
                            else
                            {
                                <div class="notice warn">
                                    已设访问口令。仍<b>建议</b>在反向代理上叠加 Basic Auth 或来源 IP 白名单——
                                    应用内的口令只是一道门槛，没有多用户、没有审计。
                                    另外确认 gRPC 的 <span class="mono">:5000</span> 没有一并暴露出去，那个口没有任何认证。
                                </div>
                            }

                            <div class="row">
                                <label>启用反代支持</label>
                                <button type="button" class="switch @(_proxyEnabled ? "on" : null)"
                                        role="switch" aria-checked="@_proxyEnabled"
                                        @onclick="() => _proxyEnabled = !_proxyEnabled">
                                    <i></i><span>@(_proxyEnabled ? "已启用" : "关闭")</span>
                                </button>
                                <span class="help">开启后读取 X-Forwarded-* 头，仅信任下方列表里的代理 IP</span>
                            </div>

                            <div class="row">
                                <label>强制 HTTPS</label>
                                @* 硬联锁而非仅提示：证书在公网机上，本进程没有 HTTPS 侦听器。
                                   不开反代就没有 X-Forwarded-Proto，每个请求都会被判成明文而无限重定向，
                                   到那时连设置页都打不开，只能去删配置文件。 *@
                                <button type="button" class="switch @(_proxyForceHttps ? "on" : null)"
                                        role="switch" aria-checked="@_proxyForceHttps" disabled="@(!_proxyEnabled)"
                                        @onclick="() => _proxyForceHttps = !_proxyForceHttps">
                                    <i></i><span>@(_proxyForceHttps ? "已开启" : "关闭")</span>
                                </button>
                                <span class="help">
                                    @if (!_proxyEnabled)
                                    {
                                        @:需先启用上面的「反代支持」——本进程自身不监听 HTTPS。
                                    }
                                    else
                                    {
                                        @:http 访问自动跳转，并下发 HSTS 30 天。
                                    }
                                </span>
                            </div>

                            @if (_proxyEnabled && _proxyForceHttps)
                            {
                                <div class="notice warn">
                                    HSTS 会被浏览器<b>缓存 30 天且无法远程撤销</b>。
                                    确认公网机的证书有效再开；证书过期或以后要退回 http 时，
                                    访问过的浏览器需要手动清除 HSTS 记录才能打开。
                                </div>
                            }

                            <div class="row">
                                <label for="pb">子路径前缀</label>
                                <input id="pb" class="mono" @bind="_proxyPathBase" placeholder="/ck" />
                                <span class="help">反代到 <span class="mono">https://例子.com/ck/</span> 时填 <span class="mono">/ck</span>；根路径留空</span>
                            </div>

                            <div class="row top">
                                <label for="tp">可信代理 IP</label>
                                @* 占位符要真的换行，用 C# 字符串而不是 &#10; 实体：
                                   Razor 会把属性值里的实体原样转义输出，占位符里就会
                                   直白地印出「&#10;」这五个字符。 *@
                                <textarea id="tp" rows="3" class="mono" @bind="_proxyTrusted"
                                          placeholder="@("127.0.0.1" + "\n" + "10.0.0.5")"></textarea>
                                <span class="help">每行一个。留空表示不校验来源，此时必须保证本端口只对反代开放</span>
                            </div>

                            <div class="actions">
                                <span class="msg @_proxyStatusClass">@_proxyStatus</span>
                                <div class="right">
                                    <button class="btn primary" type="button" @onclick="SaveProxy">保存</button>
                                </div>
                            </div>

                            <div class="notice info">
                                不开这个开关时，经 HTTPS 反代访问会出现「页面能打开、按钮全都没反应」——
                                Blazor 的实时线路按明文协议回连，被浏览器当混合内容拦掉了。
                            </div>
                        </div>
                    </section>
                }

                @* ---------------------------------------------------------------
                   内网穿透
                   --------------------------------------------------------------- *@
                @if (_section == "tunnel")
                {
                    <section class="set-sec">
                        <div class="sec-hd">
                            <h3>内网穿透（frpc）</h3>
                            <span class="desc mono" title="@Tunnel.FilePath">@WebPaths.Short(Tunnel.FilePath)</span>
                            <span class="pill restart">需重启</span>
                        </div>
                        <div class="sec-body">
                            @if (!WebTunnelSettingsStore.FrpcPresent)
                            {
                                @* frpc.exe 刻意不随包分发：内网穿透工具被杀软报毒是常态，
                                   打进安装包会连累整个 WebMaster 被拦。改由用户自行放置，
                                   我们只负责生成配置、托管进程、显示状态。 *@
                                <div class="notice warn">
                                    <b>未检测到 @WebTunnelSettingsStore.FrpcFileName。</b>
                                    本程序不附带穿透工具（会被杀软误报，可能连累整个软件被拦）。
                                    请自行到 <span class="mono">@WebTunnelSettingsStore.FrpcDownloadUrl</span>
                                    下载对应版本，放到下面这个位置，再重启。
                                </div>
                                <div class="row">
                                    <label>应放置到</label>
                                    <input readonly class="mono" value="@WebTunnelSettingsStore.FrpcPath" />
                                    <span class="help">即本程序 exe 所在目录</span>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <label>启用穿透</label>
                                    <button type="button" class="switch @(_tunnelEnabled ? "on" : null)"
                                            role="switch" aria-checked="@_tunnelEnabled"
                                            @onclick="() => _tunnelEnabled = !_tunnelEnabled">
                                        <i></i><span>@(_tunnelEnabled ? "已启用" : "关闭")</span>
                                    </button>
                                    <span class="help">开启前请先设好「访问口令」——穿透一通，界面就在公网上了</span>
                                </div>
                                <div class="row">
                                    <label for="sa">服务器地址</label>
                                    <input id="sa" class="mono" @bind="_tunnelAddr" placeholder="frps.example.com" />
                                    <span class="help">frps 所在的公网 IP 或域名</span>
                                </div>
                                <div class="row">
                                    <label for="sp">服务器端口</label>
                                    <input id="sp" type="number" class="mono" @bind="_tunnelPort" placeholder="7000" inputmode="numeric" />
                                    <span class="help">frps 的 <span class="mono">bindPort</span></span>
                                </div>
                                <div class="row">
                                    <label for="tk">Token</label>
                                    <input id="tk" type="password" @bind="_tunnelToken" autocomplete="off" />
                                    <span class="help">与 frps 的 <span class="mono">auth.token</span> 一致</span>
                                </div>
                                <div class="row">
                                    <label for="rp">远端端口</label>
                                    <input id="rp" type="number" class="mono" @bind="_tunnelRemotePort" placeholder="16400" inputmode="numeric" />
                                    <span class="help">公网机上把反代指向它</span>
                                </div>
                                <div class="row top">
                                    <label>运行状态</label>
                                    <div class="status-box">
                                        <span class="k">进程</span><span class="v">@_tunnelRuntimeStatus</span>
                                    </div>
                                    <span class="help">由 FrpcHost 托管；异常退出会在此显示最后一行输出</span>
                                </div>
                                <div class="actions">
                                    <span class="msg @_tunnelStatusClass">@_tunnelStatus</span>
                                    <div class="right">
                                        <button class="btn primary" type="button" @onclick="SaveTunnel">保存</button>
                                    </div>
                                </div>
                                <div class="notice warn">
                                    开启后本机会<b>主动向公网建立长连接</b>，界面即可从外网访问。
                                    请确认已设访问口令，且公网机上只把远端端口反代给 Nginx、
                                    <b>不要</b>在安全组里对外开放。
                                </div>
                            }
                        </div>
                    </section>
                }

                @* ---------------------------------------------------------------
                   关于
                   --------------------------------------------------------------- *@
                @if (_section == "about")
                {
                    <section class="set-sec">
                        <div class="sec-hd">
                            <h3>关于</h3>
                            <span class="desc">CommunicationKernel Web 上位机</span>
                        </div>
                        <div class="sec-body">
                            <div class="kv-strip">
                                <div><div class="k">界面</div><div class="v small">Blazor Server</div></div>
                                <div><div class="k">引擎</div><div class="v small">同进程 Hosting.App</div></div>
                                <div><div class="k">调用</div><div class="v small">Hosting.Sdk 回环</div></div>
                                <div><div class="k">版本</div><div class="v small">@Session.HostVersion</div></div>
                            </div>
                            <div class="notice info">
                                设备与变量配置落在 exe 旁的 <span class="mono">config/</span> 目录；
                                协议插件在 <span class="mono">plugins/</span>。备份这两个目录即可迁移整套配置。
                            </div>
                        </div>
                    </section>
                }

            </main>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// 当前显示的设置节。
    /// </summary>
    /// <remarks>
    /// 一次只渲染一节，而不是把六节竖着堆起来靠滚动找。
    /// 堆叠版整页近两屏，最要紧的两条（口令开没开、穿透就不就绪）在最下面，
    /// 不滚到底根本不知道；现在它们作为胶囊常驻左栏，进页面就能看见。
    /// </remarks>
    private string _section = "engine";

    /// <summary>左栏一项：标题、副标题，以及右侧那颗状态胶囊。</summary>
    /// <param name="Id">节标识，与 <see cref="_section"/> 比对。</param>
    /// <param name="Title">节名。</param>
    /// <param name="Sub">副标题，写这一节到底管什么。</param>
    /// <param name="Pill">胶囊文字，即该节的当前状态。</param>
    /// <param name="PillClass">胶囊配色类：on 绿 / off 灰 / warn 琥珀 / restart 琥珀。</param>
    private sealed record SetSection(string Id, string Title, string Sub, string Pill, string PillClass);

    /// <summary>
    /// 左栏的节清单，胶囊内容按当前状态实时算。
    /// </summary>
    /// <remarks>
    /// 每次渲染重建。这几个状态都来自已在内存里的字段，代价可以忽略；
    /// 换成缓存反而会在保存口令、隧道启停之后忘记刷新，
    /// 显示出一个和实际相反的状态——那比多算一遍危险得多。
    /// </remarks>
    private List<SetSection> Sections => new()
    {
        new("engine", "通讯引擎", "Hosting.App · gRPC",
            Session.Online ? "在线" : "未就绪", Session.Online ? "on" : "warn"),
        new("listen", "本机 Web 地址", "监听端口 · 手机访问",
            ":" + _listenPort, "restart"),
        new("auth", "访问口令", "登录门槛",
            _authEnabled ? "已启用" : "关闭", _authEnabled ? "on" : "off"),
        new("proxy", "反向代理", "子路径 · HTTPS · 可信代理",
            _proxyEnabled ? "已启用" : "关闭", _proxyEnabled ? "restart" : "off"),
        new("tunnel", "内网穿透", "frpc 隧道",
            TunnelPill, TunnelPillClass),
        new("about", "关于", "版本与目录", string.Empty, "off"),
    };

    /// <summary>穿透节的胶囊文字。</summary>
    /// <remarks>
    /// 「未就绪」与「关闭」必须分开：前者是缺 frpc.exe，去下载；
    /// 后者是有工具但没开，去打开开关。合成一句会让人在错误的方向上排查。
    /// </remarks>
    private string TunnelPill => !WebTunnelSettingsStore.FrpcPresent
        ? "未就绪"
        : _tunnelEnabled ? "已启用" : "关闭";

    /// <summary>穿透节胶囊的配色类，与 <see cref="TunnelPill"/> 配套。</summary>
    private string TunnelPillClass => !WebTunnelSettingsStore.FrpcPresent
        ? "warn"
        : _tunnelEnabled ? "on" : "off";

    /// <summary>
    /// 当前<b>实际</b>监听的端口。
    /// </summary>
    /// <remarks>
    /// 取自启动时解析出的真实值（<see cref="WebRuntimeInfo"/>），
    /// 既不是配置文件也不是浏览器地址栏：
    /// <list type="bullet">
    /// <item>配置文件——改过端口但还没重启时，配置是新值、实际跑的是旧值；</item>
    /// <item>浏览器地址栏（<c>Nav.BaseUri</c>）——本机直连时碰巧对，
    /// 但经反向代理访问拿到的是<b>代理</b>的端口。曾经就是这么写的，
    /// 于是手机经 https 打开时页面显示"当前实际监听 443"，
    /// 局域网地址也拼成 <c>192.168.x.x:443</c> 这种不存在的地址，
    /// 而端口输入框被预填成 443——顺手一保存，下次启动就去绑 443 了。</item>
    /// </list>
    /// </remarks>
    private int _listenPort = LanAccess.DefaultPort;
    /// <summary>输入框文本。与 <see cref="_listenPort"/> 分开：未保存前不影响实际监听。</summary>
    private string _portText = LanAccess.DefaultPort.ToString();
    /// <summary>端口设置的状态行文案。</summary>
    private string _portStatus = "未保存过则使用 64000";
    /// <summary>状态行样式类，与 <see cref="_portStatus"/> 配套变化。</summary>
    private string _portStatusClass = "status-muted";
    /// <summary>可供手机/平板访问的局域网地址清单，按本机网卡枚举得出。</summary>
    private IReadOnlyList<string> _phoneUrls = Array.Empty<string>();

    /// <summary>读出实际端口与已保存端口，并算出局域网访问地址。</summary>
    protected override void OnInitialized()
    {
        _listenPort = Runtime.ListenPort;
        _portText = WebSettingsStore.TryReadSavedPort(out int saved)
            ? saved.ToString()
            : _listenPort.ToString();
        _phoneUrls = LanAccess.PhoneUrls(_listenPort);
        LoadProxyIntoForm();

        LoadTunnelIntoForm();

        _authEnabled = Auth.IsEnabled;
        _authStatus = _authEnabled ? "已设口令" : "未设口令";
        _authStatusClass = _authEnabled ? "status-ok" : "status-muted";
        Session.Changed += OnChanged;
        Frpc.Changed += OnTunnelChanged;
    }

    /// <summary>会话状态变化时重绘；事件来自后台线程，必须经 InvokeAsync 切回。</summary>
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// frpc 状态变化：刷新状态行并重绘。
    /// </summary>
    /// <remarks>
    /// 事件来自 frpc 的输出回调线程，必须经 <c>InvokeAsync</c> 切回渲染上下文。
    /// </remarks>
    private void OnTunnelChanged() => _ = InvokeAsync(() =>
    {
        RefreshTunnelStatus();
        StateHasChanged();
    });

    /// <summary>
    /// 只刷新隧道的运行状态显示。
    /// </summary>
    /// <remarks>
    /// <b>刻意不复用 <see cref="LoadTunnelIntoForm"/></b>：那个方法会把地址/端口/Token
    /// 从磁盘重新灌进表单，而本方法在 frpc 每次状态变化时都会被调用——
    /// 用户正在输入的内容会被无声冲掉。
    /// <para>
    /// 样式不看设置文件而是从状态文案反推：只要 frpc 被启动过，Status 就不是「未启动」。
    /// 这样本方法完全自足，不必再去读一次磁盘。
    /// </para>
    /// </remarks>
    private void RefreshTunnelStatus()
    {
        _tunnelRuntimeStatus = "隧道：" + Frpc.Status;
        _tunnelStatusClass = Frpc.Connected ? "status-ok"
            : Frpc.Status == "未启动" ? "status-muted"
            : "status-warn";
    }

    /// <summary>
    /// 校验并保存监听端口。
    /// </summary>
    /// <remarks>
    /// <para>三道校验，顺序即优先级：</para>
    /// <list type="number">
    ///   <item>不是数字——直接拦。</item>
    ///   <item><b>不能是 5000</b>：那是独立宿主 Hosting.App 的端口。
    ///         WebMaster 内嵌了宿主，两者都绑 5000 会互相抢，
    ///         而冲突要到下次启动才暴露，那时已经看不出是这里改的。</item>
    ///   <item>必须在 1024–65535：1024 以下是特权端口，普通用户绑不上。</item>
    /// </list>
    /// <para>
    /// 端口<b>改了要重启才生效</b>——Kestrel 的监听在启动时就绑定了。
    /// 因此保存成功时按"是否与当前端口相同"给不同措辞：相同给 ok，
    /// 不同给 warn 并明确提示要重开，否则用户会以为已经切过去了。
    /// </para>
    /// </remarks>
    private void SavePort()
    {
        if (!int.TryParse(_portText.Trim(), out int port))
        {
            _portStatus = "请输入数字端口";
            _portStatusClass = "status-error";
            return;
        }
        if (port == WebSettingsStore.HostPort)
        {
            _portStatus = "5000 留给独立宿主 Hosting.App，Web 不能占用";
            _portStatusClass = "status-error";
            return;
        }
        if (!WebSettingsStore.IsAllowedPort(port))
        {
            _portStatus = "端口必须在 1024–65535";
            _portStatusClass = "status-error";
            return;
        }
        try
        {
            Settings.SaveListenPort(port);
            _portStatus = port == _listenPort
                ? "已保存，当前就是这个端口"
                : "已保存。请关掉 Web 再打开，之后用 http://localhost:" + port;
            _portStatusClass = port == _listenPort ? "status-ok" : "status-warn";
        }
        catch (Exception ex)
        {
            _portStatus = ex.Message;
            _portStatusClass = "status-error";
        }
    }

    // ========================================================================
    // 访问口令
    // ========================================================================

    /// <summary>当前是否已设口令。</summary>
    private bool _authEnabled;

    /// <summary>表单：新口令。</summary>
    private string _pwd1 = string.Empty;

    /// <summary>表单：确认口令。</summary>
    private string _pwd2 = string.Empty;

    /// <summary>口令设置的状态行文案。</summary>
    private string _authStatus = string.Empty;

    /// <summary>口令状态行的样式类。</summary>
    private string _authStatusClass = "status-muted";

    /// <summary>
    /// 设置或修改口令。
    /// </summary>
    /// <remarks>
    /// 两次输入必须一致——口令是密文输入，打错一个字符自己看不出来，
    /// 而设完重启就进不去了，只能去删配置文件。确认框是这里最值钱的一道校验。
    /// </remarks>
    private void SavePassword()
    {
        if (_pwd1.Length < WebAuthStore.MinPasswordLength)
        {
            _authStatus = $"口令至少 {WebAuthStore.MinPasswordLength} 位";
            _authStatusClass = "status-error";
            return;
        }

        if (_pwd1 != _pwd2)
        {
            _authStatus = "两次输入不一致";
            _authStatusClass = "status-error";
            return;
        }

        try
        {
            Auth.SetPassword(_pwd1);

            // 立刻清掉内存里的明文，别让它跟着组件状态留在服务端
            _pwd1 = string.Empty;
            _pwd2 = string.Empty;

            _authEnabled = true;
            _authStatus = "已保存。请退出 Web 再打开，之后访问需要登录。";
            _authStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _authStatus = ex.Message;
            _authStatusClass = "status-error";
        }
    }

    /// <summary>清除口令，恢复免登录。</summary>
    private void ClearPassword()
    {
        try
        {
            Auth.ClearPassword();
            _authEnabled = false;
            _authStatus = "已取消登录。请退出 Web 再打开生效。";
            _authStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _authStatus = ex.Message;
            _authStatusClass = "status-error";
        }
    }

    // ========================================================================
    // 内网穿透
    // ========================================================================

    /// <summary>表单：是否启用穿透。</summary>
    private bool _tunnelEnabled;

    /// <summary>表单：公网服务器地址。</summary>
    private string _tunnelAddr = string.Empty;

    /// <summary>表单：frps 的 bindPort。</summary>
    private int _tunnelPort = 7000;

    /// <summary>表单：与 frps 相同的 token。</summary>
    private string _tunnelToken = string.Empty;

    /// <summary>表单：在公网机上暴露的端口。</summary>
    private int _tunnelRemotePort = 16400;

    /// <summary>保存操作的状态行文案。</summary>
    private string _tunnelStatus = string.Empty;

    /// <summary>状态行样式类。</summary>
    private string _tunnelStatusClass = "status-muted";

    /// <summary>当前隧道的运行状态，来自 <see cref="FrpcHost"/>。</summary>
    private string _tunnelRuntimeStatus = "未启动";

    /// <summary>把已保存的穿透设置读进表单，并取一次运行状态。</summary>
    private void LoadTunnelIntoForm()
    {
        WebTunnelSettings t = WebTunnelSettingsStore.Load();

        _tunnelEnabled = t.Enabled;
        _tunnelAddr = t.ServerAddr;
        _tunnelPort = t.ServerPort;
        _tunnelRemotePort = t.RemotePort;

        // token 回填到密码框：不回填的话，用户改别的项再保存就会把 token 清空
        _tunnelToken = t.Token;

        RefreshTunnelStatus();
    }

    /// <summary>校验并保存穿透设置。</summary>
    /// <remarks>
    /// 启用时才校验必填项：只是先把服务器地址存下来、暂不启用，是合理的用法，
    /// 这时候拦着不让存反而碍事。
    /// </remarks>
    private void SaveTunnel()
    {
        if (_tunnelEnabled)
        {
            if (string.IsNullOrWhiteSpace(_tunnelAddr))
            {
                _tunnelStatus = "请填服务器地址";
                _tunnelStatusClass = "status-error";
                return;
            }

            if (string.IsNullOrWhiteSpace(_tunnelToken))
            {
                _tunnelStatus = "请填 token（要与服务器 frps 的 auth.token 相同）";
                _tunnelStatusClass = "status-error";
                return;
            }

            if (_tunnelPort is < 1 or > 65535 || _tunnelRemotePort is < 1 or > 65535)
            {
                _tunnelStatus = "端口必须在 1–65535";
                _tunnelStatusClass = "status-error";
                return;
            }
        }

        try
        {
            Tunnel.Save(new WebTunnelSettings(
                _tunnelEnabled, _tunnelAddr.Trim(), _tunnelPort, _tunnelToken, _tunnelRemotePort));

            _tunnelStatus = _tunnelEnabled
                ? "已保存。请退出 Web 再打开，隧道才会建立。"
                : "已保存（未启用）。请退出 Web 再打开生效。";
            _tunnelStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _tunnelStatus = ex.Message;
            _tunnelStatusClass = "status-error";
        }
    }

    // ========================================================================
    // 反向代理
    // ========================================================================

    /// <summary>表单：是否启用反代支持。</summary>
    private bool _proxyEnabled;

    /// <summary>表单：子路径前缀，保存时会规范化成 /xxx。</summary>
    private string _proxyPathBase = string.Empty;

    /// <summary>表单：是否强制 HTTPS。仅在启用反代时可用，见界面上的联锁说明。</summary>
    private bool _proxyForceHttps;

    /// <summary>表单：可信代理 IP，界面上每行一个。</summary>
    private string _proxyTrusted = string.Empty;

    /// <summary>代理设置的状态行文案。</summary>
    private string _proxyStatus = "未启用";

    /// <summary>代理状态行的样式类。</summary>
    private string _proxyStatusClass = "status-muted";

    /// <summary>把已保存的反代设置读进表单。</summary>
    private void LoadProxyIntoForm()
    {
        WebProxySettings p = WebProxySettingsStore.Load();

        _proxyEnabled = p.Enabled;
        _proxyPathBase = p.PathBase;
        _proxyForceHttps = p.ForceHttps;
        _proxyTrusted = string.Join(Environment.NewLine, p.TrustedProxies);

        _proxyStatus = p.Enabled ? "已启用（重启后生效的配置见上）" : "未启用";
        _proxyStatusClass = p.Enabled ? "status-ok" : "status-muted";
    }

    /// <summary>
    /// 保存反代设置。
    /// </summary>
    /// <remarks>
    /// 中间件管线在启动时就装配好了，改完必须重启——因此提示语统一写「重启后生效」，
    /// 不能只说「已保存」，否则用户会以为立刻就能用。
    /// </remarks>
    private void SaveProxy()
    {
        try
        {
            // 每行一个 IP，允许用逗号分隔；空行与空白一律丢掉
            string[] proxies = _proxyTrusted
                .Split(new[] { '\r', '\n', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => s.Length > 0)
                .ToArray();

            // 先校验再落盘：写进去一个解析不了的 IP，启动时只会在日志里
            // 留一行警告然后被忽略，用户在界面上看不出哪里错了
            string? bad = proxies.FirstOrDefault(s => !System.Net.IPAddress.TryParse(s, out _));
            if (bad is not null)
            {
                _proxyStatus = "不是合法的 IP：" + bad;
                _proxyStatusClass = "status-error";
                return;
            }

            Proxy.Save(new WebProxySettings(
                _proxyEnabled,
                proxies,
                WebProxySettings.NormalizePathBase(_proxyPathBase),
                _proxyEnabled && _proxyForceHttps));

            // 回读一次，让界面显示规范化之后的值（例如 ck/ → /ck）
            LoadProxyIntoForm();

            _proxyStatus = _proxyEnabled
                ? "已保存并启用。请退出 Web 再打开才生效。"
                : "已保存（未启用）。请退出 Web 再打开才生效。";
            _proxyStatusClass = "status-warn";
        }
        catch (Exception ex)
        {
            _proxyStatus = ex.Message;
            _proxyStatusClass = "status-error";
        }
    }

    /// <summary>退订会话事件；Session 是单例，漏退会泄漏本组件。</summary>
    public void Dispose()
    {
        Session.Changed -= OnChanged;

        // FrpcHost 是单例，生命周期远长于本组件。漏退订会让已销毁的组件
        // 继续收到状态变化并调 StateHasChanged，每次切页泄漏一个组件实例。
        Frpc.Changed -= OnTunnelChanged;
    }
}
