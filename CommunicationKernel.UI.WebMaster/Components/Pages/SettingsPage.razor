@* -----------------------------------------------------------------------------
   文件: Components/Pages/SettingsPage.razor
   层级: UI 层 — 系统设置
   作用: 查看内嵌引擎状态；修改本机 Web 监听端口。
   ----------------------------------------------------------------------------- *@

@page "/settings"
@inject EngineSession Session
@inject WebSettingsStore Settings
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>系统设置 — CommunicationKernel</PageTitle>

<div class="page page-set">
    <div class="toolbar">
        <h2 class="page-title">系统设置</h2>
        <div class="toolbar-right">
            <span class="toolbar-count">Engine @Session.HostVersion</span>
        </div>
    </div>

    <div class="page-body">
    <div class="settings-card">
        <h3>通讯引擎</h3>
        <p class="setting-hint">已内嵌在本进程，不必再启动 Hosting.App。协议插件在 exe 旁的 plugins 目录。</p>
        <div class="connect-status @(Session.Online ? "status-ok" : "status-error")">
            @(Session.Online ? "引擎在线 · " + Session.RouteCount + " 条路由 · " + Session.HostVersion : "引擎未就绪")
        </div>
    </div>

    <div class="settings-card">
        <h3>本机 Web 地址</h3>
        <p class="setting-hint">当前实际监听 @_listenPort。也可直接改项目里 appsettings.json 的 Web:ListenPort。改完必须重启 Web。文件：@Settings.ListenFilePath</p>
        <label>监听端口</label>
        <input @bind="_portText" placeholder="64000" inputmode="numeric" />
        <div class="form-actions">
            <button class="btn primary" type="button" @onclick="SavePort">保存端口</button>
        </div>
        <div class="connect-status @_portStatusClass" style="margin-top:12px">@_portStatus</div>
        <label>本机浏览器</label>
        <input readonly value="http://localhost:@_listenPort" />
        <label style="margin-top:12px">同一 WiFi 的手机</label>
        @if (_phoneUrls.Count == 0)
        {
            <p class="setting-hint">没找到局域网 IPv4。确认电脑已连 WiFi 后刷新本页。</p>
        }
        else
        {
            @foreach (string url in _phoneUrls)
            {
                <input readonly value="@url" style="margin-bottom:8px" />
            }
        }
        <p class="setting-hint">不要填 5000。那是独立宿主 Hosting.App 的口，给 WPF 远端场景用。</p>
    </div>

    <div class="settings-card">
        <h3>关于</h3>
        <p class="setting-desc">CommunicationKernel Web 上位机</p>
        <p class="setting-hint">Blazor Server · 本进程内嵌 EngineRuntime · 只持有 route_id · 协议来自 plugins · 设备/变量落在本机 exe 旁 config/</p>
    </div>
    </div>
</div>

@code {
    private int _listenPort = LanAccess.DefaultPort;
    private string _portText = LanAccess.DefaultPort.ToString();
    private string _portStatus = "未保存过则使用 64000";
    private string _portStatusClass = "status-muted";
    private IReadOnlyList<string> _phoneUrls = Array.Empty<string>();

    protected override void OnInitialized()
    {
        if (Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out Uri? uri) && uri.Port > 0)
            _listenPort = uri.Port;
        _portText = WebSettingsStore.TryReadSavedPort(out int saved)
            ? saved.ToString()
            : _listenPort.ToString();
        _phoneUrls = LanAccess.PhoneUrls(_listenPort);
        Session.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void SavePort()
    {
        if (!int.TryParse(_portText.Trim(), out int port))
        {
            _portStatus = "请输入数字端口";
            _portStatusClass = "status-error";
            return;
        }
        if (port == WebSettingsStore.HostPort)
        {
            _portStatus = "5000 留给独立宿主 Hosting.App，Web 不能占用";
            _portStatusClass = "status-error";
            return;
        }
        if (!WebSettingsStore.IsAllowedPort(port))
        {
            _portStatus = "端口必须在 1024–65535";
            _portStatusClass = "status-error";
            return;
        }
        try
        {
            Settings.SaveListenPort(port);
            _portStatus = port == _listenPort
                ? "已保存，当前就是这个端口"
                : "已保存。请关掉 Web 再打开，之后用 http://localhost:" + port;
            _portStatusClass = port == _listenPort ? "status-ok" : "status-warn";
        }
        catch (Exception ex)
        {
            _portStatus = ex.Message;
            _portStatusClass = "status-error";
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
