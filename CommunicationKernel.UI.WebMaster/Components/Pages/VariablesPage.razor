@* -----------------------------------------------------------------------------
   文件: Components/Pages/VariablesPage.razor
   层级: UI 层 — 变量配置
   作用: 本地变量表 + gRPC 读写/轮询。地址原样下发，UI 不解析协议格式。
   ----------------------------------------------------------------------------- *@

@page "/variables"
@inject EngineSession Session
@inject WebVariableStore Store
@inject WebDeviceStore Devices
@inject AppLogStore Log
@inject IWebVariableService Variables
@inject WebTemplateStore Templates
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>变量配置 — CommunicationKernel</PageTitle>

<div class="page page-var">
    <div class="toolbar">
        <h2 class="page-title">变量配置</h2>
        @* 工具栏只放页面级操作。「添加变量」作用于当前选中的设备，
           已移进右侧面板底部——与模板页的「＋ 添加功能」同一处理。
           放在这里会和「导入/导出」并排，看不出它加到哪台设备上。 *@
        <button class="btn primary" type="button" @onclick="ReadVisibleAsync" disabled="@(_busy || Visible.Count == 0 || !Session.Online)">批量读取</button>
        @* 换 PLC 型号时用：设备记录改协议，变量只需重写地址 *@
        <button class="btn ghost" type="button" @onclick="OpenRewrite"
                disabled="@(_busy || Store.GetAll().Count == 0)">
            批量改地址
        </button>
        <button class="btn ghost" type="button" @onclick="Export">导出 JSON</button>
        <label class="btn ghost file-btn">
            导入
            <InputFile OnChange="OnImportFilePicked" accept=".json,application/json" />
        </label>
        @if (!string.IsNullOrEmpty(_filterRoute)) {
            <span class="toolbar-count">模板</span>
            <select class="toolbar-select" @bind="_bindTemplateId" @bind:after="ApplySelectedTemplate">
                <option value="">（不使用模板）</option>
                @foreach (WebDeviceTemplate t in Templates.GetAll()) {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
            @* 必须有这个按钮：下拉框只在「选中项变化」时才套用，
               而它一进页面就被 InferTemplateFromRows 预置成当前模板，
               再点同一项不算变化，改过的模板永远推不下来。 *@
            <button class="btn ghost" type="button" @onclick="ApplySelectedTemplate"
                    disabled="@(_busy || string.IsNullOrEmpty(_bindTemplateId))"
                    title="模板改过名称/类型/备注后，点这里把改动同步到本设备的变量">
                重新同步模板
            </button>
        }
        <div class="toolbar-right">
            @* 始终渲染，只切可见性：条件渲染会让工具栏总宽度在「处理中…」出现的
               瞬间变化，flex 随之重新分配，左侧的模板下拉与按钮会向左闪一下再回位。
               点一次「读」闪一次，看起来像界面出了故障。 *@
            <span class="busy-hint @(_busy ? null : "hidden")">处理中…</span>
            <span class="toolbar-count">@Visible.Count 个变量</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_banner)) {
        @* 横幅在分栏之上通栏显示：分栏内部各自滚动，放进去会被滚走看不见 *@
        <div class="status-msg banner-strip @_bannerClass">@_banner</div>
    }

    <div class="page-body flush">
        <div class="var-layout">
            <aside class="device-panel">
                <div class="panel-hd">设备 <span class="count">@RouteChoices.Count</span></div>

                @* 用 string.Empty 而不是 ""：特性由双引号界定，参数里再写双引号
                   会让 Razor 在第一个引号处截断特性值，解析成无参调用。 *@
                <button class="dev @(_filterRoute.Length == 0 ? "active" : null)" type="button"
                        @onclick="() => SelectRoute(string.Empty)">
                    <span class="led none"></span>
                    <span class="body">
                        <span class="t">全部</span>
                        <span class="s">@Store.GetAll().Count 条变量 · @Store.GetAll().Count(v => v.Polling) 轮询</span>
                    </span>
                    <span class="cnt"></span>
                </button>

                @foreach (RouteChoice r in RouteChoices) {
                    <button class="dev @(_filterRoute == r.RouteId ? "active" : null) @(Session.IsRouteOnline(r.RouteId) ? "on" : null) @(r.Orphan ? "orphan" : null)"
                            type="button" @onclick="() => SelectRoute(r.RouteId)"
                            title="@(r.Orphan ? "残留：设备配置已删除，只剩这些变量还挂在路由 " + r.RouteId + " 名下" : r.Name)">
                        <span class="led"></span>
                        <span class="body">
                            <span class="t">
                                @r.Name
                                @* 孤儿要一眼看得出来：不标的话它和正常设备长得几乎一样，
                                   只是少了副标题——而"少了点什么"是最不容易被注意到的差别。 *@
                                @if (r.Orphan) {
                                    <span class="tag warn">残留</span>
                                }
                            </span>
                            @* 副标题带上端点：同一协议下挂多台时，光看协议名分不出是哪台 *@
                            <span class="s">
                                @if (r.Orphan) {
                                    @:设备已删除
                                } else {
                                    @r.ProtocolId@(EndpointOf(r.RouteId) is { Length: > 0 } ep ? " · " + ep : "")
                                }
                            </span>
                        </span>
                        @* 只显示变量数。错误数曾并在这里（「4 · 2 错」），去掉了：
                           设备离线时它下面每条变量都会报错，这个数字就等同于变量总数，
                           既不提供新信息，又把一个正常的离线状态渲染成一片红。
                           要看哪条错，用右侧的「有错误」筛选。 *@
                        <span class="cnt">@CountOf(r.RouteId)</span>
                    </button>
                }

                @* 设备的增删改在设备管理页，这里给一个去处，省得操作员在导航栏来回找 *@
                <div class="devs-ft">
                    <a class="btn ghost" href="/devices">管理设备 →</a>
                </div>
            </aside>

            <section class="var-panel var-detail">
                @* 面板头：当前范围 + 概要 + 搜索 + 分段筛选。
                   概要里的「站号 / 字节序」来自设备配置，放在这儿是因为它们决定
                   下面这张表怎么解释读回来的字节——值不对时第一个要核的就是它们。 *@
                <div class="vars-hd">
                    <span class="title">@ScopeTitle</span>
                    <span class="ep">@ScopeMeta</span>
                    <input class="vars-search" placeholder="搜索名称 / 地址" aria-label="搜索变量"
                           @bind="_search" @bind:event="oninput" />
                    <div class="seg">
                        <button type="button" class="@(_view == VarView.All ? "on" : null)"
                                @onclick="() => _view = VarView.All">全部</button>
                        <button type="button" class="@(_view == VarView.Polling ? "on" : null)"
                                @onclick="() => _view = VarView.Polling">轮询中</button>
                        <button type="button" class="@(_view == VarView.Error ? "on" : null)"
                                @onclick="() => _view = VarView.Error">有错误</button>
                    </div>
                </div>

                @* 残留路由的清理入口。

                   没有这一条时，清掉一批残留变量的唯一办法是把顶部「模板」下拉
                   切到「（不使用模板）」——因为残留下来的行几乎都是模板生成的，
                   行尾的「删」是灰的。那条路径既猜不到，名字听起来也不像是在删东西。

                   而且它只删模板行：手工加的那几条会留下来，路由依旧残留在左栏，
                   看起来像是没删干净。所以这里给的是「整条路由全清」。 *@
                @if (CurrentIsOrphan) {
                    <div class="orphan-bar">
                        <span>
                            <b>残留路由。</b>设备 <span class="mono">@_filterRoute</span> 的配置已经删掉了，
                            只剩这 @CountOf(_filterRoute) 条变量还挂在它名下——它们不会被轮询，也读写不了。
                        </span>
                        <button class="btn ghost danger" type="button" @onclick="AskPurgeRoute">清空这些变量</button>
                    </div>
                }

                @if (Visible.Count == 0) {
                    <div class="empty-state">
                        <div class="empty-hint">@EmptyHint</div>
                    </div>
                } else {
                    <div class="tbl-wrap">
                        <table class="var-table">
                            <colgroup>
                                <col style="width:19%" /><col style="width:10%" /><col style="width:9%" />
                                <col style="width:6%" /><col style="width:15%" /><col style="width:7%" />
                                <col style="width:14%" /><col style="width:8%" /><col style="width:12%" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>名称</th>
                                    <th>地址</th>
                                    <th>类型</th>
                                    <th class="r">字节</th>
                                    <th class="r">当前值</th>
                                    <th class="r">刷新</th>
                                    <th>写入</th>
                                    <th>轮询</th>
                                    <th class="r">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (WebVariable row in Visible) {
                                    <tr>
                                        <td class="name" data-label="名称" title="@row.Note">
                                            @row.Name
                                            @* 模板徽标取代原来行尾那个「锁」按钮：来源标在名字旁边，
                                               视线不用横跨整行才知道这条能不能删 *@
                                            @if (row.FromTemplate) {
                                                <span class="tpl" title="来自模板「@TemplateNameOf(row.TemplateId)」，不能单条删除">@TemplateNameOf(row.TemplateId)</span>
                                            }
                                        </td>
                                        <td class="mono" data-label="地址">@row.Address</td>
                                        <td data-label="类型">
                                            <span class="type @TypeClass(row.DataType)">@row.DataType</span>
                                            @* 配了小数位就必须标出来：值显示成 50.4 时，看不出
                                               设备里存的是 50.4 还是 504——而排查时这两个数差十倍 *@
                                            @if (VariableScale.IsActive(row.DataType, row.Decimals)) {
                                                <span class="dec" title="@VariableScale.Hint(row.DataType, row.Decimals)">.@row.Decimals</span>
                                            }
                                        </td>
                                        <td class="mono r" data-label="字节">@row.Length</td>

                                        @* 值单元格：错误红、未读灰、陈旧灰、正常亮。
                                           单位小一号跟在数字后面，不参与对齐 *@
                                        <td class="val @ValueClass(row)" data-label="当前值"
                                            title="@(row.LastUpdated.Length > 0 ? "最近读取 " + row.LastUpdated : "尚未读取")">
                                            @row.DisplayValue
                                            @if (!row.IsError && row.Unit.Length > 0 && row.DisplayValue != "--") {
                                                <span class="u">@row.Unit</span>
                                            }
                                        </td>

                                        @* 刷新年龄：值本身正确但已是十几秒前的，与读失败一样危险，
                                           而前者不会标红——只能靠这一列暴露 *@
                                        <td class="age @(IsStale(row) ? "old" : null)" data-label="刷新">@AgeText(row)</td>

                                        <td data-label="写入">
                                            @* 只读变量（测量值）禁用写入：往输出频率、输出电流这类
                                               PLC 算出来的值里写数没有意义，严重时会被设备当成
                                               非法参数而报警停机 *@
                                            <div class="w">
                                                <input @bind="row.WriteText"
                                                       placeholder="@WritePlaceholder(row)"
                                                       title="@WritePlaceholder(row)"
                                                       disabled="@(!row.CanWrite)" />
                                                <button class="btn-sm primary" type="button"
                                                        title="@(row.CanWrite ? "写入" : "该变量为只读，不能写入")"
                                                        @onclick="() => WriteAsync(row)"
                                                        disabled="@(_busy || !Session.Online || !row.CanWrite)">写</button>
                                            </div>
                                        </td>

                                        @* 轮询开关直接显示周期：勾选框只能表达开/关，
                                           而现场真正要核对的是「这条多久读一次」 *@
                                        <td data-label="轮询">
                                            @* 只写点位不能轮询：PLC 收到脉冲就动作并自行清零，
                                               回读恒为 0，开轮询只会得到一列假数据 *@
                                            <button class="btn-sm toggle @(row.Polling && row.CanRead ? "on" : null)" type="button"
                                                    disabled="@(!row.CanRead)"
                                                    title="@(!row.CanRead ? "只写点位无法轮询" : row.Polling ? "轮询中，点击停止" : "已停止，点击开始")"
                                                    @onclick="() => TogglePoll(row)">@(row.CanRead ? row.ScanRateMs.ToString() : "—")</button>
                                        </td>

                                        <td class="ops" data-label="操作">
                                            <button class="btn-sm" type="button" @onclick="() => ReadAsync(row)"
                                                    title="@(row.CanRead ? "读取" : "该变量为只写，读不出有效值")"
                                                    disabled="@(_busy || !Session.Online || !row.CanRead)">读</button>
                                            <button class="btn-sm" type="button" @onclick="() => OpenEdit(row)"
                                                    disabled="@_busy">编辑</button>
                                            @* 模板行的「删」置灰而非隐藏：隐藏会让这一行少一个按钮，
                                               「读」「编辑」随之右移，整列参差不齐，扫视时很难对位。
                                               灰按钮既占住位置，也把「这条为什么删不了」说清楚。 *@
                                            <button class="btn-sm @(row.FromTemplate ? null : "danger")" type="button"
                                                    disabled="@row.FromTemplate"
                                                    title="@(row.FromTemplate
                                                        ? "来自模板「" + TemplateNameOf(row.TemplateId) + "」，删了下次同步又会回来。要整套去掉请把上方模板选成「（不使用模板）」"
                                                        : "删除该变量")"
                                                    @onclick="() => AskRemove(row)">删</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }

                @* 底部条在<b>空表时也要在</b>：一台设备还没有任何变量时，
                   它是唯一的添加入口。图例则只在有行时才有意义，单独判断。 *@
                <div class="vars-ft">
                    @if (Visible.Count > 0) {
                        <span>● 轮询开 / ○ 关，数字为周期 ms</span>
                        <span>模板生成的变量无「删」，到模板页维护</span>
                        <span>刷新超过 @StaleSeconds 秒变黄 = 值已陈旧</span>
                    }
                    <button class="btn primary push" type="button" @onclick="OpenAdd"
                            title="@(string.IsNullOrEmpty(_filterRoute)
                                ? "新变量的所属设备在表单里选"
                                : "添加到「" + ScopeTitle + "」")">＋ 添加变量</button>
                </div>
            </section>
        </div>
    </div>

    @if (_showForm) {
        <div class="add-form-overlay" @onclick="CloseForm">
            <div class="add-form" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>@(IsEditing ? "编辑变量" : "添加变量")</h3>
                    <button class="close-btn" type="button" @onclick="CloseForm">×</button>
                </div>
                <label>名称 *</label>
                <input @bind="_name" placeholder="传送带速度" />
                <label>路由 ID *</label>
                @if (RouteChoices.Count > 0) {
                    <select @bind="_routeId">
                        @foreach (RouteChoice r in RouteChoices) {
                            <option value="@r.RouteId">@r.Name</option>
                        }
                    </select>
                } else {
                    <input @bind="_routeId" placeholder="先到设备管理注册路由" />
                }
                <label>地址 *</label>
                <input @bind="_address" placeholder="由协议插件解释，例如 40001 / DB1.DBW0" />
                <label>数据类型</label>
                <select @bind="_dataType" @bind:after="OnTypeChanged">
                    @foreach (string t in DataTypes) {
                        <option value="@t">@t — @TypeHint(t)</option>
                    }
                </select>

                <label>
                    读取字节数
                    @if (!ValueCodec.IsVariableLength(_dataType)) {
                        <span class="label-note">（由类型决定）</span>
                    }
                </label>
                <input type="number" @bind="_length" min="1" />
                @if (ValueCodec.IsVariableLength(_dataType)) {
                    @* 只有 String / Hex 需要操作员自己定长度：
                       PLC 里那段文本区域多大，只有现场知道 *@
                    <p class="hint-line">
                        @(_dataType == "String"
                            ? "按设备里那段文本区域的实际字节数填。读回后遇 NUL 即截断。"
                            : "按需要读取的字节数填，原样以十六进制显示。")
                    </p>
                }
                @* 小数位只对整数类型出现。Float / Double 自带小数，再配一个「小数位」
                   会被理解成「保留几位显示」——那是格式化，和这里的换算是两回事；
                   Bool / String / Hex 更没有小数可言。 *@
                @if (VariableScale.Supports(_dataType)) {
                    <label>
                        小数位
                        @if (_editingFromTemplate) {
                            <span class="label-note">（由模板维护）</span>
                        } else {
                            <span class="label-note">（0 = 不换算）</span>
                        }
                    </label>
                    <select @bind="_decimals" disabled="@_editingFromTemplate">
                        @for (int d = 0; d <= VariableScale.MaxDecimals; d++) {
                            <option value="@d">@DecimalsLabel(d)</option>
                        }
                    </select>
                    @if (_decimals > 0) {
                        @* 举个具体的数比讲规则有用：现场看一眼就知道自己填对没有 *@
                        <p class="hint-line">
                            设备里存整数，界面按工程量显示与输入。
                            读回 <span class="mono">@ScaleExampleRaw()</span> 显示为
                            <span class="mono">@ScaleExampleDisplay()</span>；
                            输入 <span class="mono">@ScaleExampleDisplay()</span> 写下去的是
                            <span class="mono">@ScaleExampleRaw()</span>。
                            多填的位数按四舍五入处理。
                        </p>
                    }
                }
                <label>扫描周期 (ms)</label>
                <input type="number" @bind="_scan" min="200" />

                <label>
                    读写方向
                    @if (_editingFromTemplate) {
                        <span class="label-note">（由模板维护）</span>
                    }
                </label>
                @* 模板行的方向归模板所有，理由同下面的备注：
                   这里改了，下次「重新同步模板」会被覆盖。 *@
                <select @bind="_access" disabled="@_editingFromTemplate">
                    @foreach (VariableAccess a in VariableAccessInfo.All) {
                        <option value="@a">@VariableAccessInfo.Label(a) — @AccessHint(a)</option>
                    }
                </select>

                <label>
                    备注
                    @if (_editingFromTemplate) {
                        <span class="label-note">（由模板维护）</span>
                    }
                </label>
                @* 模板行的备注归模板所有：这里改了，下次「重新同步模板」会被覆盖。
                   与其让人白填一次再莫名其妙丢掉，不如直接置灰并指路到模板页。 *@
                <input @bind="_note" placeholder="选填，例如 用途或量程"
                       readonly="@_editingFromTemplate"
                       title="@(_editingFromTemplate ? "该变量来自模板，备注请到「模板」页修改" : null)" />
                @if (_editingFromTemplate) {
                    <p class="hint-line">
                        本行来自模板，名称/类型/长度/备注都由模板维护。
                        要改备注请到「模板」页改，再回本页点「重新同步模板」。
                    </p>
                }
                @* 字节序不在这里配：它是设备属性，同一台 PLC 的所有变量共用一套排列。
                   放到变量上会让操作员逐条去改，还容易改出彼此矛盾的配置。 *@
                <p class="hint-line">
                    数值按所属设备的字节序解释（当前 <b>@CurrentByteOrder</b>）。要改到「设备管理」里改。
                </p>

                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="CloseForm">取消</button>
                    <button class="btn primary" type="button" @onclick="Save">@(IsEditing ? "保存" : "添加")</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_exportJson)) {
        <div class="add-form-overlay" @onclick="() => _exportJson = string.Empty">
            <div class="add-form wide" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>导出 JSON</h3>
                    <button class="close-btn" type="button" @onclick="() => _exportJson = string.Empty">×</button>
                </div>
                <textarea class="export-box" readonly>@_exportJson</textarea>
                @* 文本框只解决「看一眼」。真要留底得存成文件——
                   几百个变量靠鼠标框选复制既容易漏选，也丢了文件名和日期。 *@
                <div class="form-ft">
                    <span class="form-ft-hint">@_exportJson.Length 个字符</span>
                    <button class="btn ghost" type="button" @onclick="CopyExportAsync">复制</button>
                    <button class="btn primary" type="button" @onclick="DownloadExportAsync">下载文件</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingRemove is not null) {
        <div class="add-form-overlay center" @onclick="() => _pendingRemove = null">
            <div class="add-form confirm-box" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>删除变量</h3>
                    <button class="close-btn" type="button" @onclick="() => _pendingRemove = null">×</button>
                </div>
                <p>删除 <span class="mono">@_pendingRemove.Name</span>（@_pendingRemove.RouteId @_pendingRemove.Address）。只影响本机配置。</p>
                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="() => _pendingRemove = null">取消</button>
                    <button class="btn danger" type="button" @onclick="ConfirmRemove">确认删除</button>
                </div>
            </div>
        </div>
    }

    @* ================= 清空残留路由确认 ================= *@
    @* 比解除模板那个更狠：那个只删模板行，这个把该路由名下的全部变量都删掉，
       包括手工加的、包括已经填好地址的。所以要单独说清楚。 *@
    @if (_pendingPurge > 0) {
        <div class="add-form-overlay center" @onclick="CancelPurgeRoute">
            <div class="add-form confirm-box" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>清空残留变量</h3>
                    <button class="close-btn" type="button" @onclick="CancelPurgeRoute">×</button>
                </div>
                <p>
                    将删除路由 <span class="mono">@_filterRoute</span> 名下的全部
                    <span class="mono">@_pendingPurge</span> 条变量，模板行与手工添加的都在内。
                </p>
                <p class="setting-hint">
                    这条路由已经没有对应的设备配置，这些变量不会被轮询、也无法读写。
                    此操作不可恢复；想留个底的话先用工具栏的「导出 JSON」。
                </p>
                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="CancelPurgeRoute">取消</button>
                    <button class="btn danger" type="button" @onclick="ConfirmPurgeRoute">确认清空</button>
                </div>
            </div>
        </div>
    }

    @* ================= 解除模板确认 ================= *@
    @if (_pendingDetach is not null) {
        @* 点遮罩等同取消，同样要把下拉框拨回去，否则界面和数据对不上 *@
        <div class="add-form-overlay center" @onclick="CancelDetachTemplate">
            <div class="add-form confirm-box" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>不使用模板</h3>
                    <button class="close-btn" type="button" @onclick="CancelDetachTemplate">×</button>
                </div>
                <p>
                    将删除本设备由模板生成的 <span class="mono">@_pendingDetach.Count</span> 条变量。
                </p>
                @if (_pendingDetach.WithAddress > 0) {
                    @* 地址是本机独有信息，模板里没有，删了就找不回来——必须单独点出来 *@
                    <p class="status-msg status-warn">
                        其中 <span class="mono">@_pendingDetach.WithAddress</span> 条已经填了地址，
                        会一并删除。地址不属于模板，删掉无法从模板恢复。
                    </p>
                }
                <p class="hint">只影响本机配置，不改动模板本身，也不影响其它设备。</p>
                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="CancelDetachTemplate">取消</button>
                    <button class="btn danger" type="button" @onclick="ConfirmDetachTemplate">确认删除</button>
                </div>
            </div>
        </div>
    }

    @* ================= 批量改地址 ================= *@
    @if (_showRewrite) {
        <div class="add-form-overlay" @onclick="CloseRewrite">
            <div class="add-form wide" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>批量改地址</h3>
                    <button class="close-btn" type="button" @onclick="CloseRewrite">×</button>
                </div>

                <p class="hint-line">
                    换 PLC 型号时用：变量名、类型、周期都不动，只把地址从一种体系换到另一种。
                    <b>不会校验新地址是否合法</b>——地址语法属于协议，对不对以连接后能否读到为准。
                </p>

                <label>作用范围</label>
                <select @bind="_rewriteScope" @bind:after="RefreshRewritePreview">
                    <option value="">全部设备（@Store.GetAll().Count 条变量）</option>
                    @foreach (RouteChoice r in RouteChoices) {
                        <option value="@r.RouteId">@r.Name（@CountOf(r.RouteId) 条）</option>
                    }
                </select>

                <label>查找</label>
                <input @bind="_rewriteFind" @bind:event="oninput" @bind:after="RefreshRewritePreview"
                       placeholder="@(_rewriteRegex ? "正则，例如 ^4000(\\d)" : "例如 40")" />

                <label>替换为</label>
                <input @bind="_rewriteTo" @bind:event="oninput" @bind:after="RefreshRewritePreview"
                       placeholder="@(_rewriteRegex ? "可用 $1 引用捕获组，例如 DB1.DBW$1" : "例如 DB1.DBW")" />

                <label class="inline-check">
                    <input type="checkbox" checked="@_rewriteRegex"
                           @onchange="OnRewriteRegexToggled" />
                    使用正则表达式
                </label>

                @if (!string.IsNullOrEmpty(_rewriteError)) {
                    <div class="status-msg status-error">@_rewriteError</div>
                } else if (_rewriteFind.Length > 0) {
                    @if (_rewritePreview.Count == 0) {
                        <div class="status-msg status-warn">没有匹配到任何地址。</div>
                    } else {
                        <div class="status-msg status-info">将改动 @_rewritePreview.Count 条：</div>
                        <div class="preview-box">
                            <table class="data-table">
                                <thead>
                                    <tr><th>变量</th><th>原地址</th><th>新地址</th></tr>
                                </thead>
                                <tbody>
                                    @* 只渲染前 200 条：几千条变量时整表渲染会把线路撑爆，
                                       而预览的作用是让人确认规则对不对，看头几条就够 *@
                                    @foreach (AddressRewrite c in _rewritePreview.Take(RewritePreviewLimit)) {
                                        <tr>
                                            <td class="name">@c.Name</td>
                                            <td class="mono">@c.OldAddress</td>
                                            <td class="mono val-green">@c.NewAddress</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_rewritePreview.Count > RewritePreviewLimit) {
                                <p class="hint-line">另有 @(_rewritePreview.Count - RewritePreviewLimit) 条未列出，应用时一并生效。</p>
                            }
                        </div>
                    }
                }

                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="CloseRewrite">取消</button>
                    <button class="btn primary" type="button" @onclick="ApplyRewrite"
                            disabled="@(_busy || _rewritePreview.Count == 0 || _rewriteError.Length > 0)">
                        应用（@_rewritePreview.Count 条）
                    </button>
                </div>
            </div>
        </div>
    }

    @* ================= 导入范围选择 ================= *@
    @if (_pendingImportJson is not null) {
        <div class="add-form-overlay center" @onclick="CancelImport">
            <div class="add-form" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>导入变量</h3>
                    <button class="close-btn" type="button" @onclick="CancelImport">×</button>
                </div>

                <p>文件里有 <b>@_pendingImportCount</b> 条变量。选择导入方式：</p>

                <label class="radio-line">
                    <input type="radio" name="impmode" checked="@(_importMode == VariableImportMode.Append)"
                           @onchange="() => _importMode = VariableImportMode.Append" />
                    <span><b>追加</b>到现有表（Id 冲突自动换新）</span>
                </label>

                <label class="radio-line @(string.IsNullOrEmpty(_filterRoute) ? "disabled" : null)">
                    <input type="radio" name="impmode" disabled="@string.IsNullOrEmpty(_filterRoute)"
                           checked="@(_importMode == VariableImportMode.ReplaceRoute)"
                           @onchange="() => _importMode = VariableImportMode.ReplaceRoute" />
                    <span>
                        <b>覆盖本设备</b>的变量
                        @if (string.IsNullOrEmpty(_filterRoute)) {
                            <span class="label-note">（先在左侧选中一台设备）</span>
                        } else {
                            <span class="label-note">（@_filterRoute，现有 @CountOf(_filterRoute) 条将被删除）</span>
                        }
                    </span>
                </label>

                <label class="radio-line">
                    <input type="radio" name="impmode" checked="@(_importMode == VariableImportMode.ReplaceAll)"
                           @onchange="() => _importMode = VariableImportMode.ReplaceAll" />
                    <span><b>清空整张表</b>后导入（现有 @Store.GetAll().Count 条全部删除）</span>
                </label>

                @if (_importMode != VariableImportMode.Append) {
                    <div class="status-msg status-warn">覆盖不可撤销。建议先「导出 JSON」留个底。</div>
                }

                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="CancelImport">取消</button>
                    <button class="btn @(_importMode == VariableImportMode.Append ? "primary" : "danger")"
                            type="button" @onclick="ConfirmImport" disabled="@_busy">
                        @(_importMode == VariableImportMode.Append ? "导入" : "覆盖并导入")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// 可选数据类型，与 <see cref="ValueCodec"/> 支持的类型名一一对应。
    /// </summary>
    /// <remarks>
    /// 顺序按位宽递增，末尾两个是变长类型：
    /// String 是真正的文本（UTF-8、按 NUL 截断），Hex 是原样字节。
    /// 两者曾经在 codec 里是同一套处理，选哪个结果都一样——现已分开。
    /// </remarks>
    private static readonly string[] DataTypes = {
        "Bool",
        "Int16", "UInt16",
        "Int32", "UInt32", "Float",
        "Int64", "UInt64", "Double",
        "String", "Hex",
    };

    /// <summary>各类型的一句话说明，挂在下拉项上避免操作员猜。</summary>
    private static string TypeHint (string type) => type switch {
        "Bool" => "1 字节，非零为 ON",
        "Int16" => "16 位有符号",
        "UInt16" => "16 位无符号",
        "Int32" => "32 位有符号（2 个寄存器）",
        "UInt32" => "32 位无符号（2 个寄存器）",
        "Float" => "32 位浮点（IEEE754）",
        "Int64" => "64 位有符号（4 个寄存器）",
        "UInt64" => "64 位无符号（4 个寄存器）",
        "Double" => "64 位浮点（4 个寄存器）",
        "String" => "文本，按字节数读取、NUL 截断",
        "Hex" => "原样字节，十六进制显示",
        _ => "",
    };

    // ========================================================================
    // 页面状态
    // ========================================================================

    /// <summary>是否有 I/O 在途；为 true 时禁用所有触发 I/O 的按钮，防止重复提交。</summary>
    private bool _busy;

    /// <summary>是否展开新增/编辑表单浮层。</summary>
    private bool _showForm;

    /// <summary>顶部横幅文案；为空表示不显示横幅。</summary>
    private string _banner = string.Empty;

    /// <summary>横幅样式类：status-ok / status-warn / status-error / status-info。</summary>
    private string _bannerClass = "status-info";

    /// <summary>左侧设备筛选选中的路由 Id；空字符串表示「全部」。</summary>
    private string _filterRoute = string.Empty;
    private string _bindTemplateId = string.Empty;

    /// <summary>导出面板里待复制的 JSON 文本。</summary>
    private string _exportJson = string.Empty;

    /// <summary>
    /// 等待二次确认删除的变量；为 null 表示当前没有待确认的删除。
    /// </summary>
    /// <remarks>
    /// 删除变量不可撤销，且变量表可能是现场花很久整理出来的，
    /// 因此不直接删，先置入本字段由确认框接管。
    /// </remarks>
    private WebVariable? _pendingRemove;

    /// <summary>
    /// 等待二次确认的「解除模板」；为 null 表示没有待确认的解除。
    /// </summary>
    /// <remarks>
    /// 内容是待删模板行的条数与其中已填地址的条数，
    /// 确认框据此把「会丢掉多少已填地址」明写出来。
    /// </remarks>
    private TemplateRowSummary? _pendingDetach;

    // ========================================================================
    // 表单字段
    // ========================================================================

    /// <summary>表单：变量显示名。</summary>
    private string _name = string.Empty;

    /// <summary>表单：所属路由 Id。</summary>
    private string _routeId = string.Empty;

    /// <summary>表单：设备地址，原样下发给协议插件，本页不解析其格式。</summary>
    private string _address = string.Empty;

    /// <summary>表单：数据类型，取值见 <c>DataTypes</c>。</summary>
    private string _dataType = "Int16";

    /// <summary>表单：读取字节数。定长类型由 <c>OnTypeChanged</c> 自动带出。</summary>
    private int _length = 2;

    /// <summary>表单：备注。模板行只读，见 <see cref="_editingFromTemplate"/>。</summary>
    private string _note = string.Empty;

    /// <summary>
    /// 当前编辑的是否为模板行。
    /// </summary>
    /// <remarks>
    /// 模板行的名称/类型/长度/备注都由模板维护，在本页改了会被下一次
    /// 「重新同步模板」覆盖。表单据此把备注置灰并给出指路说明，
    /// 避免让人白填一次再莫名其妙丢掉。
    /// </remarks>
    private bool _editingFromTemplate;

    /// <summary>行内写入框的占位文字。</summary>
    /// <remarks>
    /// 配了小数位的点位要把分辨率写出来。写「值」的话，操作员按整数填 504，
    /// 实际写下去的是 5040——这类错在读回之前完全看不出来。
    /// </remarks>
    private static string WritePlaceholder(WebVariable row)
    {
        if (!row.CanWrite) return "只读";

        return VariableScale.IsActive(row.DataType, row.Decimals)
            ? "值 · " + row.Decimals + " 位小数"
            : "值";
    }

    /// <summary>表单：小数位。0 表示不换算，详见 <see cref="VariableScale"/>。</summary>
    private int _decimals;

    /// <summary>小数位下拉的文案。</summary>
    private static string DecimalsLabel(int d) =>
        d == 0 ? "0 — 不换算，按整数显示" : d + " 位 — 设备里存 ×" + VariableScale.Factor(d).ToString("0");

    /// <summary>换算说明里那个「原始整数」示例。</summary>
    /// <remarks>
    /// 用 50.4 这类具体的数举例，而不是讲「除以 10 的 n 次方」：
    /// 现场看一眼就能对照自己手里的图纸，规则讲得再准也要在脑子里换算一遍。
    /// </remarks>
    private string ScaleExampleRaw() =>
        (504 * (int)(VariableScale.Factor(_decimals) / 10)).ToString();

    /// <summary>换算说明里那个「显示值」示例，与 <see cref="ScaleExampleRaw"/> 配对。</summary>
    private string ScaleExampleDisplay() =>
        VariableScale.Display(ScaleExampleRaw(), _dataType, _decimals);

    /// <summary>表单：轮询扫描周期（毫秒）。</summary>
    private int _scan = 1000;

    /// <summary>表单：读写方向。</summary>
    private VariableAccess _access = VariableAccess.ReadWrite;

    /// <summary>下拉里跟在方向后面的一句说明，帮操作员选对。</summary>
    private static string AccessHint(VariableAccess a) => a switch {
        VariableAccess.ReadOnly => "测量值，例如输出频率、报警码",
        VariableAccess.WriteOnly => "脉冲指令，回读无意义，不参与轮询",
        _ => "默认，可读可写",
    };

    // ========================================================================
    // 派生视图数据
    // ========================================================================

    /// <summary>
    /// 当前应显示的变量行：未选筛选时为全部，否则按路由 Id 过滤。
    /// </summary>
    private IReadOnlyList<WebVariable> Visible
    {
        get
        {
            IEnumerable<WebVariable> q = Store.GetAll();

            if (!string.IsNullOrEmpty(_filterRoute))
                q = q.Where(v => string.Equals(v.RouteId, _filterRoute, StringComparison.OrdinalIgnoreCase));

            // 名称与地址一起搜：现场既会按功能名找（"频率给定"），
            // 也会拿着 PLC 程序里的地址反查（"40001"），两种都得中
            if (_search.Length > 0)
            {
                string k = _search.Trim();
                q = q.Where(v =>
                    v.Name.Contains(k, StringComparison.OrdinalIgnoreCase) ||
                    v.Address.Contains(k, StringComparison.OrdinalIgnoreCase));
            }

            q = _view switch
            {
                VarView.Polling => q.Where(v => v.Polling),
                VarView.Error => q.Where(v => v.IsError),
                _ => q,
            };

            return q.ToList();
        }
    }

    /// <summary>右侧表格的筛选视图。</summary>
    private enum VarView { All, Polling, Error }

    /// <summary>当前筛选视图。</summary>
    private VarView _view = VarView.All;

    /// <summary>名称 / 地址搜索关键字。</summary>
    private string _search = string.Empty;

    /// <summary>超过这么多秒未刷新即视为陈旧。</summary>
    /// <remarks>
    /// 取 10 秒：最长的常用扫描周期是 5 秒，留一倍余量。
    /// 定得太短会让正常的慢周期变量一直标黄，警示就失效了。
    /// </remarks>
    private const int StaleSeconds = 10;

    /// <summary>右侧面板标题：当前看的是哪台设备。</summary>
    private string ScopeTitle =>
        string.IsNullOrEmpty(_filterRoute)
            ? "全部设备"
            : RouteChoices.FirstOrDefault(r => r.RouteId == _filterRoute)?.Name ?? _filterRoute;

    /// <summary>
    /// 标题右侧的概要。
    /// </summary>
    /// <remarks>
    /// 站号与字节序放在这里，是因为它们决定下面这张表<b>怎么解释读回来的字节</b>——
    /// 数值明显不对时，第一个要核的就是这两项，不该逼操作员切到设备页去看。
    /// </remarks>
    private string ScopeMeta
    {
        get
        {
            IReadOnlyList<WebVariable> all = Visible;
            string tail = all.Count + " 变量 · " + all.Count(v => v.Polling) + " 轮询";

            if (string.IsNullOrEmpty(_filterRoute)) return tail;

            WebDeviceRecord? rec = Devices.Get(_filterRoute);
            if (rec is null) return tail;

            string station = string.IsNullOrWhiteSpace(rec.Station) ? "—" : rec.Station;
            return "站 " + station + " · " + rec.ByteOrder + " · " + tail;
        }
    }

    /// <summary>空表时的提示：要区分「本来就没有」与「被筛掉了」。</summary>
    /// <remarks>
    /// 两句话指向的动作不同，不能合并：被筛掉时该做的是清筛选，
    /// 真的没有时该做的是添加。给错了方向，操作员会去清一个本来就空的搜索框。
    /// 后一句直接指下方那个按钮——它就在这段提示底下，不必再解释路由 ID 怎么填。
    /// </remarks>
    private string EmptyHint =>
        _search.Length > 0 || _view != VarView.All
            ? "当前筛选下没有变量。清空搜索或切回「全部」。"
            : string.IsNullOrEmpty(_filterRoute)
                ? "还没有任何变量。先在左栏选一台设备，再用下方「＋ 添加变量」。"
                : "「" + ScopeTitle + "」还没有变量。用下方「＋ 添加变量」，或在上方选一个模板整套套用。";

    /// <summary>某路由的连接端点，供左栏副标题区分同协议的多台设备。</summary>
    private string EndpointOf(string routeId)
    {
        WebDeviceRecord? rec = Devices.Get(routeId);
        if (rec is null) return string.Empty;

        return string.Equals(rec.TransportKind, "Serial", StringComparison.OrdinalIgnoreCase)
            ? rec.SerialPort
            : rec.Address + ":" + rec.Port;
    }

    /// <summary>模板 Id → 显示名；模板已删时退回「模板」二字。</summary>
    private string TemplateNameOf(string templateId)
    {
        WebDeviceTemplate? t = Templates.Get(templateId);
        return t is null || t.Name.Length == 0 ? "模板" : t.Name;
    }

    /// <summary>数据类型 → 徽标配色类名，与寄存器模板页同一套。</summary>
    private static string TypeClass(string dataType) => dataType switch
    {
        "Bool" => "bool",
        "Float" => "float",
        "String" or "Hex" => "str",
        _ => "int",
    };

    /// <summary>值单元格的状态类名。</summary>
    /// <remarks>
    /// 四种状态要分得开：读失败(红) / 从未读(灰) / 已陈旧(灰) / 正常。
    /// 陈旧与正常都是"有值"，但陈旧的那个不能当作现场实况用。
    /// </remarks>
    private static string ValueClass(WebVariable v)
    {
        if (v.IsError) return "err";
        if (v.LastReadAt is null) return "stale";
        return IsStale(v) ? "stale" : string.Empty;
    }

    /// <summary>距上次读取是否已超过 <see cref="StaleSeconds"/>。</summary>
    private static bool IsStale(WebVariable v) =>
        v.LastReadAt is null || (DateTime.Now - v.LastReadAt.Value).TotalSeconds > StaleSeconds;

    /// <summary>刷新年龄文本。</summary>
    /// <remarks>
    /// 1 分钟内给一位小数（能看出轮询周期对不对），超过则退到分钟——
    /// 那时精确到零点几秒已无意义，只需要知道"很久没动了"。
    /// </remarks>
    private static string AgeText(WebVariable v)
    {
        if (v.LastReadAt is null) return "—";

        double s = (DateTime.Now - v.LastReadAt.Value).TotalSeconds;
        if (s < 0) return "0.0s";                        // 系统对时回拨
        if (s < 60) return s.ToString("0.0") + "s";
        if (s < 3600) return (int)(s / 60) + "m";
        return (int)(s / 3600) + "h";
    }

    /// <summary>左侧设备列表与表单下拉框共用的路由候选项。</summary>
    private IReadOnlyList<RouteChoice> RouteChoices => BuildRouteChoices();

    // ========================================================================
    // 生命周期
    // ========================================================================

    /// <summary>
    /// 订阅会话与变量表的变更通知，并给表单选一个默认路由。
    /// </summary>
    /// <remarks>
    /// 两个事件都要订阅：<c>Session.Changed</c> 带来路由上下线，
    /// <c>Store.Changed</c> 带来轮询回填的读值。少订一个就会出现
    /// 「数据变了但界面不动」——而且只在特定操作路径下复现，很难查。
    /// 退订在 <see cref="Dispose"/> 里，漏退会让已销毁的组件继续收事件。
    /// </remarks>
    protected override void OnInitialized () {
        Session.Changed += OnChanged;
        Store.Changed += OnChanged;

        // 「刷新」列的年龄要自己往前走，见 StartAgeTicker 的说明
        StartAgeTicker();

        // 表单默认选中第一条路由，省去操作员每次新增都要手动选
        if (RouteChoices.Count > 0)
            _routeId = RouteChoices[0].RouteId;

        string tid = QueryValue("template");
        if (!string.IsNullOrEmpty(tid)) {
            _bindTemplateId = tid;
            if (RouteChoices.Count > 0 && string.IsNullOrEmpty(_filterRoute))
                _filterRoute = RouteChoices[0].RouteId;
            ApplySelectedTemplate();
        } else {
            InferTemplateFromRows();
        }
    }

    private void SelectRoute (string routeId) {
        _filterRoute = routeId;
        InferTemplateFromRows();
    }

    private void InferTemplateFromRows () {
        if (string.IsNullOrEmpty(_filterRoute)) {
            _bindTemplateId = string.Empty;
            return;
        }
        string? tid = Store.GetAll()
            .FirstOrDefault(v => v.RouteId == _filterRoute && v.FromTemplate)?.TemplateId;
        _bindTemplateId = tid ?? string.Empty;
    }

    /// <summary>
    /// 把当前所选模板同步到当前设备。
    /// </summary>
    /// <remarks>
    /// <para>
    /// 两个入口：下拉框换选项时自动调用，以及工具栏的「重新同步模板」按钮。
    /// <b>后者不能省</b>——下拉框一进页面就被 <see cref="InferTemplateFromRows"/>
    /// 预置成变量行已带的模板，此时再点同一项，<c>@bind</c> 不认为值变了，
    /// 不会触发套用。于是「在模板里补了备注」这类改动永远推不到已套用的设备上。
    /// </para>
    /// <para>
    /// 同步是<b>按功能名对齐</b>的：名称相同的行更新类型/长度/备注，
    /// 模板里新增的补进来，模板里已删掉的从本设备移除。
    /// 地址不属于模板（同一功能在不同 PLC 上地址不同），因此一律保留。
    /// </para>
    /// </remarks>
    private void ApplySelectedTemplate () {
        if (string.IsNullOrEmpty(_filterRoute))
            return;

        // 选了「（不使用模板）」：这不是"什么都不做"，而是要把模板行清掉。
        // 此前这里直接 return，导致套过模板的设备再也去不掉那些行——
        // 行尾是「锁」删不掉，下拉切到不使用又没反应，是个死结。
        if (string.IsNullOrEmpty(_bindTemplateId)) {
            AskDetachTemplate();
            return;
        }

        WebDeviceTemplate? tpl = Templates.Get(_bindTemplateId);
        if (tpl is null) return;

        // 用展开后的清单：模板可能引用了「启停」这类公共模板，
        // 直接传 tpl.Slots 会漏掉引用进来的全部槽位，且不报错
        int n = Store.ApplyTemplate(_filterRoute, tpl, Templates.ResolveSlots(tpl.Id));

        // 报「0 处更新」也要说清楚，否则用户会以为按钮没生效
        _banner = n == 0
            ? "模板「" + tpl.Name + "」与本设备变量已经一致，无需改动。"
            : "已按模板「" + tpl.Name + "」同步 " + n + " 处（名称/类型/长度/备注）。地址不受模板管辖，请在本表填写。";
        _bannerClass = n == 0 ? "status-info" : "status-ok";
    }

    /// <summary>当前选中的是不是一条残留路由（设备配置已删、变量还在）。</summary>
    /// <remarks>
    /// 选「全部」时恒为假：那不是某一条路由，没有「清空这条」可言。
    /// </remarks>
    private bool CurrentIsOrphan =>
        !string.IsNullOrEmpty(_filterRoute) &&
        RouteChoices.FirstOrDefault(r => r.RouteId == _filterRoute)?.Orphan == true;

    /// <summary>待清空的变量条数；大于 0 表示确认框正开着。</summary>
    /// <remarks>
    /// 用条数而不是布尔：确认框里要如实报出会删几条，
    /// 而这个数必须是<b>点按钮那一刻</b>的快照——弹框期间轮询仍在跑，
    /// 现算的话数字会在框里跳。
    /// </remarks>
    private int _pendingPurge;

    /// <summary>请求清空当前残留路由的全部变量。</summary>
    private void AskPurgeRoute() => _pendingPurge = CountOf(_filterRoute);

    /// <summary>确认清空。</summary>
    /// <remarks>
    /// 清完把筛选切回「全部」：那条路由随最后一条变量一起从左栏消失了，
    /// 停在一个已经不存在的选中项上，右侧会是一片空白加一句莫名其妙的提示。
    /// </remarks>
    private void ConfirmPurgeRoute()
    {
        string routeId = _filterRoute;
        int n = Store.RemoveByRoute(routeId);

        _pendingPurge = 0;
        SelectRoute(string.Empty);

        _banner = "已清空残留路由 " + routeId + " 的 " + n + " 条变量。";
        _bannerClass = "status-ok";
    }

    /// <summary>取消清空。</summary>
    private void CancelPurgeRoute() => _pendingPurge = 0;

    /// <summary>
    /// 请求解除当前设备的模板（下拉切到「（不使用模板）」时）。
    /// </summary>
    /// <remarks>
    /// 一定要确认再删：模板行上的地址是操作员一条条填的、模板里没有，
    /// 删掉就没了。下拉框滑一下就静默清空是不能接受的。
    /// <para>
    /// 没有模板行时不弹框——那种情况下「不使用模板」本来就已经成立，
    /// 弹一个"确认删除 0 条"只会让人困惑。
    /// </para>
    /// </remarks>
    private void AskDetachTemplate () {
        TemplateRowSummary s = Store.SummarizeTemplateRows(_filterRoute);
        if (s.Count == 0) {
            // 已经是「不使用模板」的状态，目标已达成，静默即可
            _pendingDetach = null;
            return;
        }

        _pendingDetach = s;
    }

    /// <summary>确认解除模板，删掉本设备全部模板行。</summary>
    private void ConfirmDetachTemplate () {
        int n = Store.DetachTemplate(_filterRoute);
        _pendingDetach = null;

        _banner = "已解除模板，删除 " + n + " 条模板变量。";
        _bannerClass = "status-ok";
    }

    /// <summary>
    /// 取消解除模板。
    /// </summary>
    /// <remarks>
    /// 必须把下拉框拨回原来的模板：<c>@bind</c> 在 <c>@bind:after</c> 之前就已经
    /// 把 <see cref="_bindTemplateId"/> 写成空了，只关掉弹框的话，
    /// 界面显示「不使用模板」而行还在，两边对不上。
    /// </remarks>
    private void CancelDetachTemplate () {
        _pendingDetach = null;
        InferTemplateFromRows();
    }

    private string QueryValue (string key) {
        Uri uri = Nav.ToAbsoluteUri(Nav.Uri);
        string q = uri.Query.TrimStart('?');
        foreach (string part in q.Split('&', StringSplitOptions.RemoveEmptyEntries)) {
            int eq = part.IndexOf('=');
            if (eq <= 0) continue;
            if (!string.Equals(Uri.UnescapeDataString(part[..eq]), key, StringComparison.OrdinalIgnoreCase))
                continue;
            return Uri.UnescapeDataString(part[(eq + 1)..]);
        }
        return string.Empty;
    }

    /// <summary>
    /// 数据源变更时请求重绘。
    /// </summary>
    /// <remarks>
    /// 事件可能在<b>非渲染线程</b>上触发（轮询器在后台线程回填读值），
    /// 因此必须经 <c>InvokeAsync</c> 切回 Blazor 的同步上下文，
    /// 直接调 <c>StateHasChanged</c> 会抛线程异常。
    /// 弃元赋值是有意的：这里不需要等待重绘完成。
    /// </remarks>
    private void OnChanged () => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// 汇总三个来源，构造路由候选列表。
    /// </summary>
    /// <remarks>
    /// <para>三个来源缺一不可，各自覆盖一种现实情况：</para>
    /// <list type="number">
    ///   <item><b>宿主已注册的路由</b>——当前真正能读写的设备。</item>
    ///   <item><b>本地设备配置</b>——已配好但还没连接的设备。变量要能<b>提前</b>配好，
    ///         不能等设备上线才允许录入。这一步同时用本地的显示名覆盖宿主给的
    ///         裸 RouteId，让下拉框显示「一号线主控」而不是「PLC-1」。</item>
    ///   <item><b>变量表里出现过的路由</b>——设备配置被删了但变量还在，
    ///         若不补进来，这些变量在左侧列表里会归属到一个不存在的分组而彻底看不见。</item>
    /// </list>
    /// <para>
    /// 用字典按 RouteId 去重，后写入者覆盖前者，所以顺序即优先级：
    /// 本地名字优先于宿主的裸 Id，而孤儿变量只在前两者都没有时才补位。
    /// 比较器用 <c>OrdinalIgnoreCase</c>：RouteId 在不同来源可能大小写不一致，
    /// 但显然应当算同一条路由。
    /// </para>
    /// </remarks>
    private List<RouteChoice> BuildRouteChoices () {
        Dictionary<string, RouteChoice> map = new(StringComparer.OrdinalIgnoreCase);

        // 来源一：宿主当前登记的路由，此时只有裸 RouteId 可用作显示名
        foreach (RouteDto r in Session.Routes)
            map[r.RouteId] = new RouteChoice(r.RouteId, r.RouteId, r.ProtocolId);

        // 来源二：本地设备配置，提供人类可读的名字；未连接的设备也在这里
        foreach (WebDeviceRecord d in Devices.GetAll()) {
            // 名字留空的设备回落到 RouteId，避免下拉框出现空白项
            string name = string.IsNullOrWhiteSpace(d.Name) ? d.RouteId : d.Name;

            if (map.TryGetValue(d.RouteId, out RouteChoice? existing) && existing is not null)
                // 宿主已有该路由：只替换显示名，保留宿主给的 ProtocolId（那是权威值）
                map[d.RouteId] = existing with { Name = name };
            else
                // 设备已配置但未连接，整条都取自本地
                map[d.RouteId] = new RouteChoice(d.RouteId, name, d.ProtocolId);
        }

        // 来源三：孤儿变量所引用的路由（设备配置已删但变量还在）
        foreach (WebVariable v in Store.GetAll()) {
            if (map.ContainsKey(v.RouteId)) continue;

            // 协议未知，留空字符串；至少让这些变量在左侧有个可见的归属
            map[v.RouteId] = new RouteChoice(v.RouteId, v.RouteId, string.Empty, Orphan: true);
        }

        return map.Values.ToList();
    }

    // ========================================================================
    // 新增 / 编辑
    // ========================================================================

    /// <summary>正在编辑的变量 Id；为空表示当前是「新增」。</summary>
    private string _editingId = string.Empty;

    /// <summary>表单当前处于编辑态还是新增态，决定标题文案与保存行为。</summary>
    private bool IsEditing => !string.IsNullOrEmpty(_editingId);

    /// <summary>打开新增表单，字段清空为默认值。</summary>
    /// <remarks>
    /// 只在 <c>_routeId</c> 为空时才补默认路由——操作员刚在左侧点了某台设备，
    /// 那个选择应当被继承下来，而不是被重置回第一条。
    /// </remarks>
    /// <remarks>
    /// 优先预填<b>当前选中的设备</b>，而不是列表里的第一台。
    /// 按钮就在那台设备的表格里，点它却给出别的设备，是明显的意外行为——
    /// 而且这种错要等到保存之后、变量出现在另一台设备名下才会被发现。
    /// 选的是「全部」时没有上下文，才退回第一台。
    /// </remarks>
    private void OpenAdd () {
        ResetForm();
        _showForm = true;

        if (!string.IsNullOrEmpty(_filterRoute))
            _routeId = _filterRoute;
        else if (RouteChoices.Count > 0)
            _routeId = RouteChoices[0].RouteId;
    }

    /// <summary>打开编辑表单，用已存变量回填。</summary>
    private void OpenEdit (WebVariable row) {
        _editingId = row.Id;
        _name = row.Name;
        _routeId = row.RouteId;
        _address = row.Address;
        _dataType = row.DataType;
        _length = row.Length;
        _decimals = row.Decimals;
        _scan = row.ScanRateMs;
        _access = row.Access;
        _note = row.Note;

        // 记下来源：模板行的备注只读，见表单里的说明
        _editingFromTemplate = row.FromTemplate;

        _showForm = true;
    }

    /// <summary>把表单字段恢复为新增态的默认值。</summary>
    /// <remarks>
    /// 刻意<b>不</b>重置 <c>_routeId</c>：连续录入同一台设备的多个变量是常态，
    /// 每次都清空会逼操作员反复重选。
    /// </remarks>
    private void ResetForm () {
        _editingId = string.Empty;
        _name = string.Empty;
        _address = string.Empty;
        _dataType = "Int16";
        _length = ValueCodec.DefaultLength("Int16");
        _decimals = 0;
        _scan = 1000;
        _access = VariableAccess.ReadWrite;
        _note = string.Empty;

        // 新增态一律不是模板行；漏了这句会把上一次编辑模板行时的只读状态带过来
        _editingFromTemplate = false;
    }

    /// <summary>关闭表单浮层并清空字段，避免下次打开时残留上一次的输入。</summary>
    private void CloseForm () {
        _showForm = false;
        ResetForm();
    }

    /// <summary>
    /// 数据类型改变时自动带出该类型的标准字节数。
    /// </summary>
    /// <remarks>
    /// String 与 Hex 是变长的，<c>DefaultLength</c> 对它们返回一个起始值，
    /// 操作员仍需按现场那段区域的实际大小手工调整。
    /// <para>
    /// 同时把小数位归零：只有整数类型支持换算，切到 Float 后那一项会从表单上
    /// 消失，但值还在——存下去就成了一个看不见却仍在生效的换算。
    /// </para>
    /// </remarks>
    private void OnTypeChanged () {
        _length = ValueCodec.DefaultLength(_dataType);

        if (!VariableScale.Supports(_dataType)) _decimals = 0;
    }

    /// <summary>取某条变量所属设备的字节序；设备无配置时按大端。</summary>
    /// <remarks>
    /// 字节序是设备属性：同一台 PLC 的所有变量共用一套排列。
    /// 挂到变量上会让操作员逐条去改，还容易改出彼此矛盾的配置。
    /// <para>
    /// 查询委托给服务，页面不自己拼装——读写路径已全部走服务，
    /// 这里只剩表单提示文案需要它。
    /// </para>
    /// </remarks>
    private ByteOrder OrderOf (string routeId) =>
        Variables.OrderOf(routeId);

    /// <summary>表单里当前所选路由的字节序，用于提示文案。</summary>
    private string CurrentByteOrder => OrderOf(_routeId).ToString();

    /// <summary>
    /// 校验并保存表单，新增与编辑共用。
    /// </summary>
    /// <remarks>
    /// 变量只写本地，不触碰宿主——它是上位机的配置，不属于 Hosting.App。
    /// 因此本方法是同步的，也不要求 Host 在线。
    /// </remarks>
    private void Save () {
        // 三个必填项：没有名字无法辨认，没有路由和地址则根本无法读写
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_routeId) || string.IsNullOrWhiteSpace(_address)) {
            _banner = "名称、路由、地址为必填";
            _bannerClass = "status-error";
            return;
        }

        if (IsEditing) {
            WebVariable? existing = Store.GetAll().FirstOrDefault(v => v.Id == _editingId);

            // 表单打开期间该变量可能已被另一处删除（同一浏览器多标签页）
            if (existing is null) {
                _banner = "该变量已被删除，无法保存";
                _bannerClass = "status-error";
                CloseForm();
                return;
            }

            // Trim：末尾空格会让 "PLC1" 与 "PLC1 " 被当成两条不同路由
            existing.Name = _name.Trim();
            existing.RouteId = _routeId.Trim();
            existing.Address = _address.Trim();
            existing.DataType = _dataType;

            // 下限保护：长度 0 会被部分协议判为非法请求；
            // 扫描周期过小会让轮询挤占整条链路，200ms 是经验下限
            existing.Length = Math.Max(1, _length);
            // 小数位只对整数类型有意义：类型改成 Float 之后还留着旧值，
            // 表单上看不到（那一项已隐藏），却仍在换算，读出来差十倍
            existing.Decimals = VariableScale.Supports(existing.DataType) ? _decimals : 0;
            existing.ScanRateMs = Math.Max(200, _scan);

            // 模板行的备注与只读标记都归模板所有，本页不写回——
            // 写了也会被下次「重新同步模板」覆盖，白改一次还找不到原因
            if (!_editingFromTemplate) {
                existing.Note = _note.Trim();
                existing.Access = _access;
            }

            // 地址/类型变了，旧的显示值就不再对应当前定义——
            // 留着会让人以为那是刚读回来的新值
            existing.DisplayValue = "--";
            existing.IsError = false;

            Store.Update(existing);
            _banner = "已更新 " + existing.Name;
            _bannerClass = "status-ok";
        } else {
            Store.Add(new WebVariable {
                Name = _name.Trim(),
                RouteId = _routeId.Trim(),
                Address = _address.Trim(),
                DataType = _dataType,
                Length = Math.Max(1, _length),
                Decimals = VariableScale.Supports(_dataType) ? _decimals : 0,
                ScanRateMs = Math.Max(200, _scan),
                Access = _access,
                Note = _note.Trim(),
            });
            _banner = "已添加 " + _name.Trim();
            _bannerClass = "status-ok";
        }

        CloseForm();
    }

    /// <summary>
    /// 切换某条变量的轮询开关，立即落盘。
    /// </summary>
    /// <remarks>
    /// 轮询状态要持久化：现场重启浏览器后，操作员期望原先在轮询的变量继续在轮。
    /// <c>e.Value</c> 是装箱的 object，用 <c>is true</c> 而非强转——
    /// 复选框在某些浏览器上可能回传 null。
    /// </remarks>
    /// <remarks>
    /// 由按钮直接取反，不再走复选框的 ChangeEventArgs：
    /// 那个按钮同时要显示扫描周期，勾选框放不下——而周期恰恰是现场
    /// 最常核对的一项（"这条到底多久读一次"）。
    /// </remarks>
    private void TogglePoll (WebVariable row) {
        row.Polling = !row.Polling;
        Store.Update(row);
    }

    /// <summary>读取单条变量，结果直接回填到表格的「当前值」列。</summary>
    /// <remarks>
    /// 失败时把<b>错误码</b>而非错误描述填进值列，并标红：
    /// 表格那一格很窄，塞完整描述会被截断成看不懂的半句；
    /// 错误码短且可检索，完整描述在通讯日志里。
    /// </remarks>
    private async Task ReadAsync (WebVariable row) {
        // 与写入侧同理：禁用按钮挡不住在方向被改之前就打开着的页面。
        // 只写点位读回来的恒是 0，显示出来会被当成"设备停着"。
        if (!row.CanRead) {
            _banner = row.Name + " 是只写点位，读不出有效值";
            _bannerClass = "status-warn";
            return;
        }

        _busy = true;
        try {
            // 字节序由服务按设备配置取用，页面不再自行传参
            VariableReadOutcome r = await Variables.ReadAsync(row).ConfigureAwait(true);
            if (r.Success)
                Store.ApplyRead(row.Id, r.DisplayValue, false);
            else
                Store.ApplyRead(row.Id, r.ErrorCode, true);
        } finally { _busy = false; }
    }

    /// <summary>把行内输入框的文本写入 PLC。</summary>
    /// <remarks>
    /// 写入成功要记日志：这是<b>会改变现场设备状态</b>的操作，
    /// 事后追查"谁在什么时候改了哪个值"全靠这条记录。读取则不记，否则日志会被轮询淹没。
    /// </remarks>
    private async Task WriteAsync (WebVariable row) {
        // 禁用按钮只是护栏，不是关卡：一个在改成只读之前就打开着的页面，
        // 它渲染出来的按钮仍然是可点的。真正下发之前必须再判一次。
        if (!row.CanWrite) {
            _banner = row.Name + " 是只读变量，不能写入";
            _bannerClass = "status-warn";
            return;
        }

        _busy = true;
        try {
            // 编码失败不会发起 I/O，服务直接返回 PARSE_ERROR
            HostingOperationResult r = await Variables.WriteAsync(row).ConfigureAwait(true);
            if (r.Success) {
                _banner = "写入成功 " + row.Name;
                _bannerClass = "status-ok";
                Log.Info("Variables", "写入 " + row.RouteId + " " + row.Address);
            } else {
                _banner = "写入失败: [" + r.ErrorCode + "] " + r.ErrorMessage;
                _bannerClass = "status-error";
            }
        } finally { _busy = false; }
    }

    /// <summary>批量读取当前可见的全部变量。</summary>
    /// <remarks>
    /// 刻意<b>串行</b>：同一路由的并发读会被 Router 合并或排队，并发发起没有收益；
    /// 而串口设备还有帧间静默要求，并发只会制造超时。
    /// 单条失败不中断整批——现场常有个别地址配错，不该因此读不到其余变量。
    /// </remarks>
    private async Task ReadVisibleAsync () {
        _busy = true;
        int ok = 0;
        try {
            IReadOnlyList<WebVariable> rows = Visible;
            foreach (WebVariable row in rows) {
                VariableReadOutcome r = await Variables.ReadAsync(row).ConfigureAwait(true);
                if (r.Success) {
                    Store.ApplyRead(row.Id, r.DisplayValue, false);
                    ok++;
                } else
                    Store.ApplyRead(row.Id, r.ErrorCode, true);
            }
            _banner = "读取完成 " + ok + "/" + rows.Count;
            _bannerClass = ok == rows.Count ? "status-ok" : "status-warn";
        } finally { _busy = false; }
    }

    /// <summary>把变量表导出为 JSON 文本，显示在浮层里供查看。</summary>
    private void Export () => _exportJson = Store.ExportJson();

    /// <summary>
    /// 把导出内容存成文件。
    /// </summary>
    /// <remarks>
    /// 文件名带日期时间：现场经常在改配置前先导一份，全叫同一个名字的话
    /// 下载目录里几份备份分不出先后，恢复时只能靠猜。
    /// </remarks>
    private async Task DownloadExportAsync ()
    {
        string name = "ck-variables-" + DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".json";
        await JS.InvokeVoidAsync("ck.downloadText", name, _exportJson).ConfigureAwait(true);

        _banner = "已导出 " + name;
        _bannerClass = "status-ok";
        _exportJson = string.Empty;
    }

    /// <summary>复制导出内容到剪贴板。</summary>
    /// <remarks>
    /// 车间多为 http://内网IP 访问，属于非安全上下文，
    /// navigator.clipboard 不存在——JS 侧已有 execCommand 兜底，
    /// 这里据其返回值给出真实结果，不能一律报成功。
    /// </remarks>
    private async Task CopyExportAsync ()
    {
        bool ok = await JS.InvokeAsync<bool>("ck.copyText", _exportJson).ConfigureAwait(true);

        _banner = ok ? "已复制到剪贴板" : "复制失败，请改用「下载文件」";
        _bannerClass = ok ? "status-ok" : "status-warn";
    }

    /// <summary>
    /// 从上传的 JSON 文件导入变量，<b>追加</b>而非替换现有表。
    /// </summary>
    /// <remarks>
    /// <para>
    /// <c>replace: false</c> 是有意的：导入多半是把另一条产线的变量表并进来，
    /// 直接覆盖会静默清空现场好不容易配好的表，且无法撤销。
    /// Id 冲突由 <c>ImportJson</c> 内部重新分配。
    /// </para>
    /// <para>
    /// 512 KB 上限防止超大文件把 Blazor Server 的线路撑爆——
    /// 变量表是人工维护的配置，正常规模远小于此。
    /// </para>
    /// </remarks>
    // ========================================================================
    // 导入
    // ========================================================================

    /// <summary>待导入的 JSON 原文；为 null 表示当前没有待确认的导入。</summary>
    private string? _pendingImportJson;

    /// <summary>待导入文件里的条数，用于确认框文案。</summary>
    private int _pendingImportCount;

    /// <summary>本次导入的覆盖范围，默认追加。</summary>
    private VariableImportMode _importMode = VariableImportMode.Append;

    /// <summary>
    /// 选中文件后先读进内存并弹出范围选择，<b>不</b>立即写入。
    /// </summary>
    /// <remarks>
    /// 覆盖类导入不可撤销，必须让操作员先看清「文件里有多少条、会删掉多少条」再决定。
    /// 这里只读文件、算条数，真正落库在 <see cref="ConfirmImport"/>。
    /// <para>
    /// 512 KB 上限防止超大文件把 Blazor Server 的线路撑爆——
    /// 变量表是人工维护的配置，正常规模远小于此。
    /// </para>
    /// </remarks>
    private async Task OnImportFilePicked (InputFileChangeEventArgs e) {
        try {
            await using Stream stream = e.File.OpenReadStream(512 * 1024);
            using StreamReader reader = new(stream);
            string json = await reader.ReadToEndAsync().ConfigureAwait(true);

            // 先试解析，让「文件根本不是变量表」在选范围之前就暴露
            List<WebVariable>? probe =
                System.Text.Json.JsonSerializer.Deserialize<List<WebVariable>>(
                    json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (probe is null || probe.Count == 0) {
                _banner = "文件里没有变量";
                _bannerClass = "status-warn";
                return;
            }

            _pendingImportJson = json;
            _pendingImportCount = probe.Count;

            // 已选中某台设备时，「覆盖本设备」是换 PLC 场景下的常用选择，默认给它
            _importMode = string.IsNullOrEmpty(_filterRoute)
                ? VariableImportMode.Append
                : VariableImportMode.ReplaceRoute;
        } catch (Exception ex) {
            // 文件损坏、超限、JSON 语法错误对操作员是同一种处置：换个文件重试
            _banner = "读取失败: " + ex.Message;
            _bannerClass = "status-error";
        }
    }

    /// <summary>放弃本次导入。</summary>
    private void CancelImport () {
        _pendingImportJson = null;
        _pendingImportCount = 0;
    }

    /// <summary>按所选范围执行导入。</summary>
    private void ConfirmImport () {
        if (_pendingImportJson is null) return;

        try {
            VariableImportResult r = Store.ImportJson(
                _pendingImportJson, _importMode,
                _importMode == VariableImportMode.ReplaceRoute ? _filterRoute : null);

            string msg = "已导入 " + r.Imported + " 条";
            if (r.Removed > 0) msg += "，覆盖删除 " + r.Removed + " 条";

            // 跳过的条数必须报出来，否则操作员会以为文件有问题
            if (r.SkippedOtherRoute > 0)
                msg += "，跳过 " + r.SkippedOtherRoute + " 条（属于其它设备）";

            _banner = msg;
            _bannerClass = r.Imported > 0 ? "status-ok" : "status-warn";
        } catch (Exception ex) {
            _banner = "导入失败: " + ex.Message;
            _bannerClass = "status-error";
        } finally {
            CancelImport();
        }
    }

    // ========================================================================
    // 批量改地址
    // ========================================================================

    /// <summary>预览表最多渲染多少行。超出部分不渲染但仍会被应用。</summary>
    private const int RewritePreviewLimit = 200;

    /// <summary>是否展开批量改地址弹层。</summary>
    private bool _showRewrite;

    /// <summary>改写范围的路由 Id；空字符串表示全部设备。</summary>
    private string _rewriteScope = string.Empty;

    /// <summary>查找内容。</summary>
    private string _rewriteFind = string.Empty;

    /// <summary>替换为的内容。</summary>
    private string _rewriteTo = string.Empty;

    /// <summary>是否按正则处理。</summary>
    private bool _rewriteRegex;

    /// <summary>预览结果，只含真正会变化的条目。</summary>
    private IReadOnlyList<AddressRewrite> _rewritePreview = Array.Empty<AddressRewrite>();

    /// <summary>预览失败的原因（正则语法错误等）；为空表示无错。</summary>
    private string _rewriteError = string.Empty;

    /// <summary>统计某条路由下的变量数。</summary>
    private int CountOf (string routeId) =>
        Store.GetAll().Count(v => string.Equals(v.RouteId, routeId, StringComparison.OrdinalIgnoreCase));

    /// <summary>打开批量改地址弹层，默认范围取当前左侧筛选。</summary>
    private void OpenRewrite () {
        _rewriteScope = _filterRoute;
        _rewriteFind = string.Empty;
        _rewriteTo = string.Empty;
        _rewriteRegex = false;
        _rewritePreview = Array.Empty<AddressRewrite>();
        _rewriteError = string.Empty;
        _showRewrite = true;
    }

    /// <summary>关闭弹层。</summary>
    private void CloseRewrite () => _showRewrite = false;

    /// <summary>切换正则开关后要重算预览——同一份输入在两种模式下结果完全不同。</summary>
    private void OnRewriteRegexToggled (ChangeEventArgs e) {
        _rewriteRegex = e.Value is true;
        RefreshRewritePreview();
    }

    /// <summary>
    /// 重算预览。输入每变一个字符都会调用。
    /// </summary>
    /// <remarks>
    /// 计算委托给 <see cref="AddressRewriter"/>——它是纯函数且有测试覆盖，
    /// 正则超时、无效捕获组这类边角情况都在那里处理。本页只负责把结果画出来。
    /// </remarks>
    private void RefreshRewritePreview () {
        if (string.IsNullOrEmpty(_rewriteFind)) {
            _rewritePreview = Array.Empty<AddressRewrite>();
            _rewriteError = string.Empty;
            return;
        }

        IEnumerable<WebVariable> scope = Store.GetAll();
        if (!string.IsNullOrEmpty(_rewriteScope))
            scope = scope.Where(v => string.Equals(v.RouteId, _rewriteScope, StringComparison.OrdinalIgnoreCase));

        bool okResult = AddressRewriter.TryPreview(
            scope.Select(v => new AddressCandidate(v.Id, v.Name, v.Address)),
            _rewriteFind, _rewriteTo, _rewriteRegex,
            out IReadOnlyList<AddressRewrite> changes, out string error);

        _rewritePreview = changes;
        _rewriteError = okResult ? string.Empty : (error ?? "预览失败");
    }

    /// <summary>把预览结果落库。</summary>
    /// <remarks>
    /// 一次锁、一次落盘、一次事件——逐条更新会在几百条时把界面刷到卡顿。
    /// 改完清空输入但<b>不关弹层</b>：换 PLC 时往往要连做几轮不同的替换规则。
    /// </remarks>
    private void ApplyRewrite () {
        if (_rewritePreview.Count == 0) return;

        _busy = true;
        try {
            int n = Store.ApplyAddressChanges(
                _rewritePreview.ToDictionary(c => c.Id, c => c.NewAddress, StringComparer.Ordinal));

            _banner = "已改写 " + n + " 条地址。读值已清空，请重新读取验证。";
            _bannerClass = "status-ok";
            Log.Info("Variables", "批量改地址 " + n + " 条（" +
                (string.IsNullOrEmpty(_rewriteScope) ? "全部设备" : _rewriteScope) + "）");

            _rewriteFind = string.Empty;
            _rewriteTo = string.Empty;
            _rewritePreview = Array.Empty<AddressRewrite>();
        } finally { _busy = false; }
    }

    /// <summary>请求删除某条变量。模板行直接拒绝。</summary>
    private void AskRemove (WebVariable row) {
        if (row.FromTemplate) {
            _banner = "「" + row.Name + "」来自模板，不能单条删除——下次同步模板还会加回来。"
                      + "要去掉整套，请把上方的模板选成「（不使用模板）」。";
            _bannerClass = "status-warn";
            return;
        }
        _pendingRemove = row;
    }

    /// <summary>确认删除待删变量。</summary>
    /// <remarks>
    /// 判空不是多余的：确认框弹出期间该变量可能已被另一处删除，
    /// 此时静默返回即可——目标状态（它不存在了）已经达成。
    /// </remarks>
    private void ConfirmRemove () {
        if (_pendingRemove is null || _pendingRemove.FromTemplate) return;

        Store.Remove(_pendingRemove.Id);
        _pendingRemove = null;
    }

    /// <summary>
    /// 退订两个数据源的事件。
    /// </summary>
    /// <remarks>
    /// <c>Session</c> 与 <c>Store</c> 都是进程内单例，生命周期远长于本组件。
    /// 漏退订会让已销毁的组件继续收到事件并调 <c>StateHasChanged</c>，
    /// 表现为控制台报错加内存泄漏——每次页面切换泄漏一个组件实例。
    /// </remarks>
    public void Dispose () {
        Session.Changed -= OnChanged;
        Store.Changed -= OnChanged;
        _ageTimer?.Dispose();
    }

    /// <summary>
    /// 每秒重绘一次，只为让「刷新」列的年龄往前走。
    /// </summary>
    /// <remarks>
    /// <b>不能只靠 Store.Changed。</b>那个事件由轮询回填触发——设备一掉线就
    /// 不再有回填，年龄会冻在最后一次读取的读数上，而那恰恰是最该看见它
    /// 增长的时刻：界面显示 "0.4s" 而实际已经三分钟没读到了。
    /// <para>
    /// 每个电路一个 1 秒定时器，代价可忽略；<see cref="Dispose"/> 里释放，
    /// 漏释放会让已关闭的页面继续每秒唤醒渲染。
    /// </para>
    /// </remarks>
    private System.Threading.Timer? _ageTimer;

    /// <summary>启动年龄计时器。</summary>
    private void StartAgeTicker () =>
        _ageTimer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));

    /// <summary>
    /// 路由候选项：左侧设备列表与表单下拉框共用。
    /// </summary>
    /// <param name="RouteId">路由 Id，作为去重键与提交值。</param>
    /// <param name="Name">显示名；无本地配置时回落为 RouteId。</param>
    /// <param name="ProtocolId">协议 Id，仅用于左侧列表的副标题；来源不明时为空。</param>
    /// <summary>左侧设备列表与表单下拉框共用的一项。</summary>
    /// <param name="RouteId">路由 Id。</param>
    /// <param name="Name">显示名。取不到设备配置时回落为 RouteId 本身。</param>
    /// <param name="ProtocolId">协议 Id。孤儿路由无从得知，为空串。</param>
    /// <param name="Orphan">
    /// 孤儿：宿主没有这条路由，本地也没有对应的设备配置，只有变量还挂在它名下。
    /// 多半是设备被删了而变量没跟着删。
    /// </param>
    private sealed record RouteChoice (string RouteId, string Name, string ProtocolId, bool Orphan = false);
}
