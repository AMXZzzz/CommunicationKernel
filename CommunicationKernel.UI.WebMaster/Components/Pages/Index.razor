@* -----------------------------------------------------------------------------
   文件: Components/Pages/Index.razor
   层级: UI 层 — MES 监控
   作用: 按产线展示工艺流、线内离散设备与活动报警。

   数据来自 IMesDataSource，当前实现是 DemoMesDataSource（演示数据）。
   页面不认识设备表也不认识变量表——产线、工站顺序、点位绑定这些概念
   现在还没有落地，接进来之后换一个数据源实现即可，本文件不用改。

   演示期间页面顶部有一条醒目横幅。它不可省：一屏看起来很真的产量、
   良率、温度，被当成现场读数拿去做判断，后果比界面难看严重得多。
   ----------------------------------------------------------------------------- *@

@page "/"
@inject EngineSession Session
@inject IMesDataSource Mes
@implements IDisposable

<PageTitle>MES 监控 — CommunicationKernel</PageTitle>

@* 一次渲染只取一份快照：下面的汇总、产线、抽屉、弹窗都基于它。
   分别去取会让同一帧里的各处数字来自不同时刻。 *@
@{
    MesSnapshot snap = Mes.Snapshot();
    MesAlarm? detail = snap.Alarms.FirstOrDefault(a => a.Id == _detailId);
}

<div class="page page-mes">
    <div class="toolbar">
        <h2 class="page-title">MES 监控</h2>

        @* 启停控制会往 PLC 写值，在点位绑定做完之前一律禁用。
           保留按钮而不是隐藏：它们是这个页面最终形态的一部分，
           先占住位置，也让人看得出还差哪一块。 *@
        <button class="btn primary" type="button" disabled
                title="需要先在「配置产线」里绑定整线启停点位">开始监控</button>
        <button class="btn ghost" type="button" disabled
                title="需要先在「配置产线」里绑定整线启停点位">停止</button>
        <a class="btn ghost" href="/lines">配置产线</a>

        <span class="spacer"></span>

        <button class="btn-sm" type="button" @onclick="CollapseAll">收起离散设备</button>
        <button class="btn-sm" type="button" @onclick="ExpandAll">展开离散设备</button>
        @* 有未确认报警时才变红：常态下一个红按钮杵在工具栏里，
           真出事时就没人再看它一眼了 *@
        <button class="btn-sm @(snap.ActiveAlarmCount > 0 ? "alarm-open" : null)" type="button"
                @onclick="() => _drawer = true">
            @(snap.ActiveAlarmCount > 0 ? "! 活动报警 " + snap.ActiveAlarmCount : "报警记录 " + snap.Alarms.Count)
        </button>

        @if (Session.Online) {
            @* 脉冲徽标只在真的连着 Host 时出现——离线还闪「实时」是假信号 *@
            <span class="live">实时</span>
        }
        <span class="meta">周期 <b>@snap.PollText</b> · 上次 <b>@snap.LastUpdate</b></span>
    </div>

    <div class="page-body">

        @if (snap.IsDemo) {
            @* 整条横幅通栏、常驻、不可关闭。可关闭的提示等于没有提示：
               关掉之后这一屏就和真实数据长得一模一样了。 *@
            <div class="demo-banner">
                <span class="tagword">演示数据</span>
                <span>
                    本页的产线、工站状态、产量良率与报警<b>全部是写死的样例</b>，不是现场读数。
                    产线划分与点位绑定做完之后，这条横幅会自动消失。
                </span>
            </div>
        }

        <div class="mes-sum">
            <div><div class="k">产线</div><div class="v">@snap.LineCount</div></div>
            <div><div class="k">离散设备</div><div class="v">@snap.SoloCount</div></div>
            <div><div class="k">设备合计</div><div class="v">@snap.DeviceCount</div></div>
            <div><div class="k">运行中</div><div class="v ok">@snap.RunningCount</div></div>
            <div><div class="k">离线</div><div class="v wrn">@snap.OfflineCount</div></div>
            <div class="@(snap.ActiveAlarmCount > 0 ? "alarm" : null)">
                <div class="k">活动报警</div>
                <div class="v @(snap.ActiveAlarmCount > 0 ? "err" : "ok")">@snap.ActiveAlarmCount</div>
            </div>
        </div>

        @foreach (MesLine line in snap.Lines) {
            int lineAlarms = snap.Alarms.Count(a => a.LineName == line.Name && !a.Acked);

            <section class="line @(lineAlarms > 0 ? "alarm" : null)" @key="line.Id">
                <div class="line-hd">
                    <h2>@line.Name</h2>
                    <span class="ctl">控制器 <b>@line.Controller</b> · @line.ControllerEndpoint</span>
                    <span class="state @MesDisplay.Css(line.State)">@MesDisplay.Code(line.State)</span>

                    @* 整线启停同样禁用。这三个按钮一旦生效就是直接往 PLC 写，
                       在没有明确绑定之前让它们可点，等于给误操作开了个口子。 *@
                    <div class="line-ops">
                        <button class="btn ok" type="button" disabled title="未绑定启动点位">▶ 启动</button>
                        <button class="btn stop" type="button" disabled title="未绑定停止点位">■ 停止</button>
                        <button class="btn reset" type="button" disabled title="未绑定复位点位">↺ 复位</button>
                    </div>

                    @if (lineAlarms > 0) {
                        MesAlarm top = snap.Alarms.First(a => a.LineName == line.Name && !a.Acked);
                        <button class="alarm-chip" type="button" @onclick="() => _drawer = true">
                            <span class="ic">!</span>
                            <span class="body">
                                <span class="t">@top.Title</span>
                                <span class="s">@lineAlarms 条活动报警 · 点击处理</span>
                            </span>
                        </button>
                    }
                </div>

                <div class="line-kpi">
                    <span>班次产量<b>@line.Kpi.Output.ToString("N0")</b></span>
                    <span>目标<b>@line.Kpi.Target.ToString("N0")</b></span>
                    <span>良率<b>@line.Kpi.YieldText</b></span>
                    <span>节拍<b>@line.Kpi.CycleText</b></span>
                    <span>停机<b>@line.Kpi.DowntimeText</b></span>
                </div>

                <div class="flow-t">工艺流 · @line.Stations.Count 站</div>
                <div class="flow">
                    @foreach (MesStation st in line.Stations) {
                        <div class="st @MesDisplay.Css(st.State)" @key="st.Id">
                            @if (st.AlarmCount > 0) {
                                <span class="alm" title="@st.AlarmCount 条未确认报警">@st.AlarmCount</span>
                            }
                            <span class="led"></span>
                            <div class="nm">@st.Name</div>
                            <div class="md">@st.Model</div>
                            <div class="stt">@MesDisplay.Code(st.State)</div>
                            @* 主显值那行始终占位：空着时不留高度的话，
                               同一排卡片会高低不齐，工艺流看起来像断了 *@
                            <div class="sub">@(st.SubText.Length > 0 ? st.SubText : "—")</div>
                            <div class="ops">
                                <button class="btn-sm ok" type="button" disabled title="未绑定启动点位">启</button>
                                <button class="btn-sm stop" type="button" disabled title="未绑定停止点位">停</button>
                                <button class="btn-sm reset" type="button" disabled title="未绑定复位点位">复</button>
                            </div>
                        </div>
                    }
                </div>

                @* 离散设备可折叠：它们只是监视，不参与节拍。
                   盯产线的时候这一块是干扰，排查某台变频器时才需要展开。 *@
                <div class="solo @(_collapsed.Contains(line.Id) ? "collapsed" : null)">
                    <div class="solo-hd" @onclick="() => ToggleSolo(line.Id)">
                        <span class="tgl">▼</span>
                        <h3>离散设备</h3>
                        <span class="cnt">@line.Solo.Count</span>
                        <span class="d">归属本线但不在工艺流中的伺服 / 变频器 / 传感器 · 仅监视，值随变量轮询更新</span>
                        <div class="r" @onclick:stopPropagation>
                            @* 离散设备的增删在「产线配置」里做——那边才有真实的设备与变量清单。
                               本页当前是演示数据，就地编辑改不到任何真配置。 *@
                            <a class="btn-sm" href="/lines">＋ 添加设备</a>
                            <a class="btn-sm" href="/lines">编辑</a>
                        </div>
                    </div>

                    <div class="solo-grid">
                        @foreach (MesSoloDevice d in line.Solo) {
                            <div class="dc @(d.Stale ? "stale" : null)" @key="d.Id">
                                <div class="top">
                                    <span class="led" title="@(d.Stale ? "读取失败或超时未更新" : "在线")"></span>
                                    <span class="nm" title="@d.Name">@d.Name</span>
                                    <span class="poll">@d.PollText</span>
                                </div>
                                <div class="md">@d.Meta</div>
                                <div class="vals">
                                    @foreach (MesValue v in d.Values) {
                                        <div class="kv">
                                            <span class="k">@v.Label</span>
                                            <span class="v">
                                                @v.Text
                                                @if (v.Unit.Length > 0) {
                                                    <span class="u">@v.Unit</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <a class="dc add" href="/lines">
                            <span class="plus">＋</span>添加离散设备
                        </a>
                    </div>
                </div>
            </section>
        }

        <div class="mes-hint">
            产线工站与离散设备均来自「设备管理」。离散设备只显示变量值，不参与报警与整线控制；
            绿灯为连接在线，读取失败时灯变灰、数值变灰并标「陈旧」。
        </div>
    </div>

    @* ================= 报警抽屉 ================= *@
    @if (_drawer) {
        @* 抽屉不带遮罩：处理报警时经常要一边看抽屉一边看工艺流上哪一站在闪，
           盖一层黑纱会把那条线索遮掉。 *@
        <aside class="drawer">
            <div class="dr-hd">
                <span class="ic">!</span>
                <div class="body">
                    <div class="t">活动报警</div>
                    <div class="s">
                        共 @snap.Alarms.Count 条 ·
                        严重 @snap.Alarms.Count(a => a.Severity == MesSeverity.Critical) ·
                        预警 @snap.Alarms.Count(a => a.Severity == MesSeverity.Warning)
                    </div>
                </div>
                <button class="x" type="button" @onclick="() => _drawer = false" aria-label="关闭">✕</button>
            </div>

            <div class="dr-list">
                @if (snap.Alarms.Count == 0) {
                    <div class="empty-state"><div class="empty-hint">当前没有报警。</div></div>
                }
                @foreach (MesAlarm a in snap.Alarms) {
                    <div class="al @(a.Severity == MesSeverity.Warning ? "warn" : null) @(a.Acked ? "acked" : null)" @key="a.Id">
                        <div class="t">
                            <i></i>@a.Title
                            @if (a.Acked) {
                                <span class="ack-tag">已确认</span>
                            }
                        </div>
                        <div class="s">@a.LineName · @a.StationName · @a.RaisedAt · 持续 @a.DurationText</div>
                        <div class="ops">
                            <button class="btn danger-fill" type="button" disabled="@a.Acked"
                                    @onclick="() => Ack(a.Id)">@(a.Acked ? "已确认" : "确认")</button>
                            <button class="btn ghost" type="button" @onclick="() => _detailId = a.Id">详情</button>
                        </div>
                    </div>
                }
            </div>

            <div class="dr-ft">
                @* 复位的前提是全部确认：还没人看过就允许复位，等于把报警按掉，
                   下一班接手时什么记录都没有 *@
                <span class="cnt">
                    @(snap.ActiveAlarmCount > 0
                        ? "需全部确认后方可整线复位"
                        : "已全部确认")
                </span>
                <button class="btn ghost" type="button" disabled="@(snap.ActiveAlarmCount == 0)"
                        @onclick="AckAll">全部确认</button>
                <button class="btn primary" type="button" disabled title="未绑定复位点位">↻ 整线复位</button>
            </div>
        </aside>
    }

    @* ================= 报警详情 ================= *@
    @if (detail is not null) {
        <div class="mask" @onclick="() => _detailId = string.Empty">
            <div class="detail" @onclick:stopPropagation>
                <div class="dt-hd">
                    <div class="row">
                        <span class="ic">!</span>
                        <span class="sev @(detail.Severity == MesSeverity.Warning ? "warn" : null)">
                            @MesDisplay.SeverityText(detail.Severity) · @(detail.Acked ? "已确认" : "未确认")
                        </span>
                    </div>
                    <h3>@detail.Title</h3>
                    <div class="when">
                        发生时间 <b>@detail.RaisedAt</b> · 持续 <b>@detail.DurationText</b> · 代码 <b>@detail.Code</b>
                    </div>
                    <button class="x" type="button" @onclick="() => _detailId = string.Empty" aria-label="关闭">✕</button>
                </div>

                <div class="dt-body">
                    <div class="facts">
                        @foreach (MesValue f in detail.Facts) {
                            <div>
                                <div class="k">@f.Label</div>
                                <div class="v @(f.Label == "报警代码" ? "err" : null)">@f.Text</div>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="sec-t">报警描述</div>
                        <div class="desc">@detail.Description</div>
                    </div>

                    <div>
                        <div class="sec-t">关联实时数据</div>
                        <div class="tbl-wrap">
                            <table class="al-table">
                                <thead>
                                    <tr><th>名称</th><th>地址</th><th>当前值</th><th>单位</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (MesRelatedValue r in detail.Related) {
                                        <tr>
                                            <td>@r.Name</td>
                                            <td class="mono">@r.Address</td>
                                            <td class="mono @(r.Abnormal ? "err" : null)">@r.Value</td>
                                            <td>@r.Unit</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <div class="sec-t">处理建议</div>
                        <div class="advice">
                            <ol>
                                @foreach (string s in detail.Advice) {
                                    <li>@s</li>
                                }
                            </ol>
                        </div>
                    </div>

                    <div>
                        <div class="sec-t">事件时间线</div>
                        <ul class="tl">
                            @{ bool first = true; }
                            @foreach (MesTimelineItem t in detail.Timeline) {
                                <li class="@(first ? "first" : null)">
                                    <i></i><span class="t">@t.Time</span><span class="m">@t.Text</span>
                                </li>
                                first = false;
                            }
                        </ul>
                    </div>
                </div>

                <div class="dt-ft">
                    <button class="btn ghost" type="button" @onclick="() => _detailId = string.Empty">关闭</button>
                    <span class="spacer"></span>
                    <button class="btn danger-fill" type="button" disabled="@detail.Acked"
                            @onclick="() => Ack(detail.Id)">@(detail.Acked ? "已确认" : "确认报警")</button>
                    <button class="btn reset" type="button" disabled title="未绑定复位点位">↺ 复位该设备</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>报警抽屉是否展开。</summary>
    private bool _drawer;

    /// <summary>正在看详情的报警 Id；空串表示弹窗关闭。</summary>
    /// <remarks>
    /// 存 Id 而不是对象：确认之后数据源会给出新的快照，
    /// 存着旧对象的话弹窗里还显示「未确认」，而抽屉里已经变了。
    /// </remarks>
    private string _detailId = string.Empty;

    /// <summary>
    /// 已折叠的产线 Id。
    /// </summary>
    /// <remarks>
    /// 存「折叠的」而不是「展开的」：新加一条产线时默认应当是展开的，
    /// 存展开集合的话新产线不在集合里，一出现就是收起状态，看起来像没加上。
    /// </remarks>
    private readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);

    /// <summary>折叠 / 展开某条产线的离散设备区。</summary>
    private void ToggleSolo(string lineId)
    {
        if (!_collapsed.Add(lineId))
            _collapsed.Remove(lineId);
    }

    /// <summary>收起全部产线的离散设备区。</summary>
    private void CollapseAll()
    {
        foreach (MesLine l in Mes.Snapshot().Lines)
            _collapsed.Add(l.Id);
    }

    /// <summary>展开全部产线的离散设备区。</summary>
    private void ExpandAll() => _collapsed.Clear();

    /// <summary>确认一条报警。</summary>
    private void Ack(string alarmId) => Mes.Acknowledge(alarmId);

    /// <summary>
    /// 确认当前全部未确认的报警。
    /// </summary>
    /// <remarks>
    /// 逐条调用而不是给数据源加一个「全确认」方法：这样确认逻辑只有一处，
    /// 将来接真实数据要往设备写确认位时，不必再实现第二条路径。
    /// </remarks>
    private void AckAll()
    {
        foreach (MesAlarm a in Mes.Snapshot().Alarms.Where(a => !a.Acked))
            Mes.Acknowledge(a.Id);
    }

    /// <summary>订阅会话变化，用于「实时」徽标随 Host 上下线切换。</summary>
    protected override void OnInitialized() => Session.Changed += OnChanged;

    /// <summary>会话变化时重绘；事件来自后台线程，必须经 InvokeAsync 切回渲染上下文。</summary>
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>退订会话事件；Session 是单例，漏退会泄漏本组件。</summary>
    public void Dispose() => Session.Changed -= OnChanged;
}
