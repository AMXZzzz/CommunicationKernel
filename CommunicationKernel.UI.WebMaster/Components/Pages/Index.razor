@* -----------------------------------------------------------------------------
   文件: Components/Pages/Index.razor
   层级: UI 层 — MES 监控
   作用: 按产线展示工艺流、线内离散设备与活动报警。

   数据来自 IMesDataSource，实现是 MesDataSource——它把「产线配置」这份编排
   对着变量表里的实时读值算成快照。页面不认识设备表也不认识变量表，
   只认 MesSnapshot 这个形状。

   本页<b>只读</b>：状态、产量、报警都是算出来的，不发任何 I/O。
   启停复位那几个按钮要往 PLC 写，另作一处处理，不在本文件的职责里。
   ----------------------------------------------------------------------------- *@

@page "/"
@inject EngineSession Session
@inject IMesDataSource Mes
@* 下面三个只给「离散设备」弹窗用——那一处要改产线编排，得直接写 web-lines.json。
   页面本身的显示一律走 Mes，不从这三个里取数。 *@
@inject WebLineStore Lines
@inject WebDeviceStore Devices
@inject WebVariableStore Vars
@implements IDisposable

<PageTitle>MES 监控 — CommunicationKernel</PageTitle>

@* 一次渲染只取一份快照：下面的汇总、产线、抽屉、弹窗都基于它。
   分别去取会让同一帧里的各处数字来自不同时刻。 *@
@{
    MesSnapshot snap = Mes.Snapshot();
    MesAlarm? detail = snap.Alarms.FirstOrDefault(a => a.Id == _detailId);
}

<div class="page page-mes">
    <div class="toolbar">
        <h2 class="page-title">MES 监控</h2>

        @* 启停控制会往 PLC 写值，在点位绑定做完之前一律禁用。
           保留按钮而不是隐藏：它们是这个页面最终形态的一部分，
           先占住位置，也让人看得出还差哪一块。 *@
        <button class="btn primary" type="button" disabled
                title="需要先在「配置产线」里绑定整线启停点位">开始监控</button>
        <button class="btn ghost" type="button" disabled
                title="需要先在「配置产线」里绑定整线启停点位">停止</button>
        <a class="btn ghost" href="/lines">配置产线</a>

        <span class="spacer"></span>

        <button class="btn-sm" type="button" @onclick="CollapseAll">收起离散设备</button>
        <button class="btn-sm" type="button" @onclick="ExpandAll">展开离散设备</button>
        @* 有未确认报警时才变红：常态下一个红按钮杵在工具栏里，
           真出事时就没人再看它一眼了 *@
        <button class="btn-sm @(snap.ActiveAlarmCount > 0 ? "alarm-open" : null)" type="button"
                @onclick="() => _drawer = true">
            @(snap.ActiveAlarmCount > 0 ? "! 活动报警 " + snap.ActiveAlarmCount : "报警记录 " + snap.Alarms.Count)
        </button>

        @if (Session.Online) {
            @* 脉冲徽标只在真的连着 Host 时出现——离线还闪「实时」是假信号 *@
            <span class="live">实时</span>
        }
        <span class="meta">周期 <b>@snap.PollText</b> · 上次 <b>@snap.LastUpdate</b></span>
    </div>

    <div class="page-body">

        @* 一条产线都没配时，整页只剩一排 0 和一段与你无关的说明——
           那看起来像系统坏了，而实际是还没开始配。直接给下一步该做什么。 *@
        @if (snap.LineCount == 0) {
            <div class="empty-state">
                <div class="empty-title">还没有产线</div>
                <div class="empty-hint">
                    本页按「产线配置」里的编排显示：哪些设备组成一条线、排第几站、
                    哪个点位代表运行状态。<br />
                    配好之后这里才会出现工艺流、实时读数与报警。
                </div>
                <a class="btn primary" href="/lines">去配置产线</a>
            </div>
        } else {

        <div class="mes-sum">
            <div><div class="k">产线</div><div class="v">@snap.LineCount</div></div>
            <div><div class="k">离散设备</div><div class="v">@snap.SoloCount</div></div>
            <div><div class="k">设备合计</div><div class="v">@snap.DeviceCount</div></div>
            <div><div class="k">运行中</div><div class="v ok">@snap.RunningCount</div></div>
            <div><div class="k">离线</div><div class="v wrn">@snap.OfflineCount</div></div>
            <div class="@(snap.ActiveAlarmCount > 0 ? "alarm" : null)">
                <div class="k">活动报警</div>
                <div class="v @(snap.ActiveAlarmCount > 0 ? "err" : "ok")">@snap.ActiveAlarmCount</div>
            </div>
        </div>

        @foreach (MesLine line in snap.Lines) {
            int lineAlarms = snap.Alarms.Count(a => a.LineName == line.Name && !a.Acked);

            <section class="line @(lineAlarms > 0 ? "alarm" : null)" @key="line.Id">
                <div class="line-hd">
                    <h2>@line.Name</h2>
                    <span class="ctl">控制器 <b>@line.Controller</b> · @line.ControllerEndpoint</span>
                    <span class="state @MesDisplay.Css(line.State)">@MesDisplay.Code(line.State)</span>

                    @* 整线启停同样禁用。这三个按钮一旦生效就是直接往 PLC 写，
                       在没有明确绑定之前让它们可点，等于给误操作开了个口子。 *@
                    <div class="line-ops">
                        <button class="btn ok" type="button" disabled title="未绑定启动点位">▶ 启动</button>
                        <button class="btn stop" type="button" disabled title="未绑定停止点位">■ 停止</button>
                        <button class="btn reset" type="button" disabled title="未绑定复位点位">↺ 复位</button>
                    </div>

                    @if (lineAlarms > 0) {
                        MesAlarm top = snap.Alarms.First(a => a.LineName == line.Name && !a.Acked);
                        <button class="alarm-chip" type="button" @onclick="() => _drawer = true">
                            <span class="ic">!</span>
                            <span class="body">
                                <span class="t">@top.Title</span>
                                <span class="s">@lineAlarms 条活动报警 · 点击处理</span>
                            </span>
                        </button>
                    }
                </div>

                <div class="line-kpi">
                    <span>班次产量<b>@line.Kpi.OutputText</b></span>
                    <span>目标<b>@line.Kpi.TargetText</b></span>
                    <span>良率<b>@line.Kpi.YieldText</b></span>
                    <span>节拍<b>@line.Kpi.CycleText</b></span>
                    <span>停机<b>@line.Kpi.DowntimeText</b></span>
                </div>

                <div class="flow-t">工艺流 · @line.Stations.Count 站</div>
                <div class="flow">
                    @foreach (MesStation st in line.Stations) {
                        <div class="st @MesDisplay.Css(st.State)" @key="st.Id">
                            @if (st.AlarmCount > 0) {
                                <span class="alm" title="@st.AlarmCount 条未确认报警">@st.AlarmCount</span>
                            }
                            <span class="led"></span>
                            <div class="nm">@st.Name</div>
                            <div class="md">@st.Model</div>
                            <div class="stt">@MesDisplay.Code(st.State)</div>
                            @* 主显值那行始终占位：空着时不留高度的话，
                               同一排卡片会高低不齐，工艺流看起来像断了 *@
                            <div class="sub">@(st.SubText.Length > 0 ? st.SubText : "—")</div>
                            <div class="ops">
                                <button class="btn-sm ok" type="button" disabled title="未绑定启动点位">启</button>
                                <button class="btn-sm stop" type="button" disabled title="未绑定停止点位">停</button>
                                <button class="btn-sm reset" type="button" disabled title="未绑定复位点位">复</button>
                            </div>
                        </div>
                    }
                </div>

                @* 离散设备可折叠：它们只是监视，不参与节拍。
                   盯产线的时候这一块是干扰，排查某台变频器时才需要展开。 *@
                <div class="solo @(_collapsed.Contains(line.Id) ? "collapsed" : null)">
                    <div class="solo-hd" @onclick="() => ToggleSolo(line.Id)">
                        <span class="tgl">▼</span>
                        <h3>离散设备</h3>
                        <span class="cnt">@line.Solo.Count</span>
                        <span class="d">归属本线但不在工艺流中的伺服 / 变频器 / 传感器 · 仅监视，值随变量轮询更新</span>
                        <div class="r" @onclick:stopPropagation>
                            @* 离散设备就在这里加——它们只在本页显示读数，配在别处反而要来回跳。
                               改哪一台走那张卡上的 ✎，头部再放一个「编辑」就得先问改的是谁。 *@
                            <button class="btn-sm" type="button"
                                    @onclick="() => OpenSolo(line.Id, null)">＋ 添加设备</button>
                        </div>
                    </div>

                    <div class="solo-grid">
                        @foreach (MesSoloDevice d in line.Solo) {
                            <div class="dc @(d.Stale ? "stale" : null)" @key="d.Id">
                                <div class="top">
                                    <span class="led" title="@(d.Stale ? "读取失败或超时未更新" : "在线")"></span>
                                    <span class="nm" title="@d.Name">@d.Name</span>
                                    <span class="poll">@d.PollText</span>
                                    <button class="ed" type="button" title="编辑显示字段"
                                            @onclick="() => OpenSolo(line.Id, d.Id)">✎</button>
                                </div>
                                <div class="md">@d.Meta</div>
                                <div class="vals">
                                    @foreach (MesValue v in d.Values) {
                                        <div class="kv">
                                            <span class="k">@v.Label</span>
                                            <span class="v">
                                                @v.Text
                                                @if (v.Unit.Length > 0) {
                                                    <span class="u">@v.Unit</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <button class="dc add" type="button"
                                @onclick="() => OpenSolo(line.Id, null)">
                            <span class="plus">＋</span>添加离散设备
                        </button>
                    </div>
                </div>
            </section>
        }

        <div class="mes-hint">
            工站状态取自「产线配置」里绑定的状态点位，读值由变量页的轮询刷新——
            <b>点位没开轮询就读不到值</b>，该站会显示成离线。
            离散设备只显示变量值，不参与报警与整线控制；读取失败，或连着几个扫描周期都没读上来时，
            灯变灰、数值变灰并标「陈旧」。
        </div>

        }
    </div>

    @* ================= 报警抽屉 ================= *@
    @if (_drawer) {
        @* 抽屉不带遮罩：处理报警时经常要一边看抽屉一边看工艺流上哪一站在闪，
           盖一层黑纱会把那条线索遮掉。 *@
        <aside class="drawer">
            <div class="dr-hd">
                <span class="ic">!</span>
                <div class="body">
                    <div class="t">活动报警</div>
                    <div class="s">
                        共 @snap.Alarms.Count 条 ·
                        严重 @snap.Alarms.Count(a => a.Severity == MesSeverity.Critical) ·
                        预警 @snap.Alarms.Count(a => a.Severity == MesSeverity.Warning)
                    </div>
                </div>
                <button class="x" type="button" @onclick="() => _drawer = false" aria-label="关闭">✕</button>
            </div>

            <div class="dr-list">
                @if (snap.Alarms.Count == 0) {
                    <div class="empty-state"><div class="empty-hint">当前没有报警。</div></div>
                }
                @foreach (MesAlarm a in snap.Alarms) {
                    <div class="al @(a.Severity == MesSeverity.Warning ? "warn" : null) @(a.Acked ? "acked" : null)" @key="a.Id">
                        <div class="t">
                            <i></i>@a.Title
                            @if (a.Acked) {
                                <span class="ack-tag">已确认</span>
                            }
                        </div>
                        <div class="s">@a.LineName · @a.StationName · @a.RaisedAt · 持续 @a.DurationText</div>
                        <div class="ops">
                            <button class="btn danger-fill" type="button" disabled="@a.Acked"
                                    @onclick="() => Ack(a.Id)">@(a.Acked ? "已确认" : "确认")</button>
                            <button class="btn ghost" type="button" @onclick="() => _detailId = a.Id">详情</button>
                        </div>
                    </div>
                }
            </div>

            <div class="dr-ft">
                @* 复位的前提是全部确认：还没人看过就允许复位，等于把报警按掉，
                   下一班接手时什么记录都没有 *@
                <span class="cnt">
                    @(snap.ActiveAlarmCount > 0
                        ? "需全部确认后方可整线复位"
                        : "已全部确认")
                </span>
                <button class="btn ghost" type="button" disabled="@(snap.ActiveAlarmCount == 0)"
                        @onclick="AckAll">全部确认</button>
                <button class="btn primary" type="button" disabled title="未绑定复位点位">↻ 整线复位</button>
            </div>
        </aside>
    }

    @* ================= 报警详情 ================= *@
    @if (detail is not null) {
        <div class="mask" @onclick="() => _detailId = string.Empty">
            <div class="detail" @onclick:stopPropagation>
                <div class="dt-hd">
                    <div class="row">
                        <span class="ic">!</span>
                        <span class="sev @(detail.Severity == MesSeverity.Warning ? "warn" : null)">
                            @MesDisplay.SeverityText(detail.Severity) · @(detail.Acked ? "已确认" : "未确认")
                        </span>
                    </div>
                    <h3>@detail.Title</h3>
                    <div class="when">
                        发生时间 <b>@detail.RaisedAt</b> · 持续 <b>@detail.DurationText</b> · 代码 <b>@detail.Code</b>
                    </div>
                    <button class="x" type="button" @onclick="() => _detailId = string.Empty" aria-label="关闭">✕</button>
                </div>

                <div class="dt-body">
                    <div class="facts">
                        @foreach (MesValue f in detail.Facts) {
                            <div>
                                <div class="k">@f.Label</div>
                                <div class="v @(f.Label == "报警代码" ? "err" : null)">@f.Text</div>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="sec-t">报警描述</div>
                        <div class="desc">@detail.Description</div>
                    </div>

                    <div>
                        <div class="sec-t">关联实时数据</div>
                        <div class="tbl-wrap">
                            <table class="al-table">
                                <thead>
                                    <tr><th>名称</th><th>地址</th><th>当前值</th><th>单位</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (MesRelatedValue r in detail.Related) {
                                        <tr>
                                            <td>@r.Name</td>
                                            <td class="mono">@r.Address</td>
                                            <td class="mono @(r.Abnormal ? "err" : null)">@r.Value</td>
                                            <td>@r.Unit</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <div class="sec-t">处理建议</div>
                        <div class="advice">
                            <ol>
                                @foreach (string s in detail.Advice) {
                                    <li>@s</li>
                                }
                            </ol>
                        </div>
                    </div>

                    <div>
                        <div class="sec-t">事件时间线</div>
                        <ul class="tl">
                            @{ bool first = true; }
                            @foreach (MesTimelineItem t in detail.Timeline) {
                                <li class="@(first ? "first" : null)">
                                    <i></i><span class="t">@t.Time</span><span class="m">@t.Text</span>
                                </li>
                                first = false;
                            }
                        </ul>
                    </div>
                </div>

                <div class="dt-ft">
                    <button class="btn ghost" type="button" @onclick="() => _detailId = string.Empty">关闭</button>
                    <span class="spacer"></span>
                    <button class="btn danger-fill" type="button" disabled="@detail.Acked"
                            @onclick="() => Ack(detail.Id)">@(detail.Acked ? "已确认" : "确认报警")</button>
                    <button class="btn reset" type="button" disabled title="未绑定复位点位">↺ 复位该设备</button>
                </div>
            </div>
        </div>
    }

    @* ================= 添加 / 编辑离散设备 ================= *@
    @if (_soloOpen) {
        <div class="add-form-overlay center" @onclick="CloseSolo">
            <div class="add-form solo-dlg" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>@(_soloEditing.Length > 0 ? "编辑离散设备" : "添加离散设备")</h3>
                    <span class="d">@SoloLineName()</span>
                    <button class="close-btn" type="button" @onclick="CloseSolo">×</button>
                </div>

                <div class="solo-bd">
                    <div class="f">
                        <span class="lb"><b>设备</b><span class="req">*</span><span class="opt">名称 / 协议 / 连接继承设备管理</span></span>
                        <select class="mono" value="@_soloRouteId" disabled="@(_soloEditing.Length > 0)"
                                @onchange="e => SoloDeviceChanged(e.Value?.ToString())">
                            <option value="">— 选择设备 —</option>
                            @foreach (WebDeviceRecord d in SoloCandidates()) {
                                <option value="@d.RouteId">@SoloDeviceLabel(d)</option>
                            }
                        </select>
                        @if (_soloEditing.Length == 0 && SoloCandidates().Count == 0) {
                            <span class="lb dim">没有可选设备：本线的设备都已在工艺流或离散列表里了。</span>
                        }
                    </div>

                    <div class="sep"></div>
                    <div class="grp">显示字段 · 4 格 · 来自该设备已配置的变量</div>
                    <div class="slots">
                        @for (int i = 0; i < 4; i++) {
                            int slot = i;
                            <div class="f">
                                <span class="lb"><b>字段 @(slot + 1)</b></span>
                                <select class="mono" value="@_soloFields[slot]"
                                        @onchange="e => _soloFields[slot] = e.Value?.ToString() ?? string.Empty">
                                    <option value="">— 不显示 —</option>
                                    @foreach (WebVariable v in SoloVars()) {
                                        <option value="@v.Id">@SoloVarLabel(v)</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    <div class="sep"></div>
                    <div class="grp">预览 · 值随「变量配置」的轮询周期更新 · 仅监视、无报警、无控制</div>
                    @* 预览里的数值是真读值——本页本来就在显示它们，写死一个占位符
                       反而让人以为这台还没接上。没读到的自然还是 "--"。 *@
                    <div class="pv">
                        <div class="top">
                            <span class="led"></span>
                            <span class="nm">@(_soloRouteId.Length > 0 ? SoloDeviceName(_soloRouteId) : "（未选择设备）")</span>
                            <span class="poll">@SoloPollText()</span>
                        </div>
                        <div class="md">@(_soloRouteId.Length > 0 ? SoloDeviceSub(_soloRouteId) : "—")</div>
                        <div class="vals">
                            @foreach (string vid in _soloFields.Where(x => x.Length > 0)) {
                                WebVariable? v = SoloVarById(vid);
                                <div class="kv">
                                    <span class="k">@(v?.Name ?? vid)</span>
                                    <span class="v">
                                        @(v?.DisplayValue ?? "--")
                                        @if (v is not null && v.Unit.Length > 0) {
                                            <span class="u">@v.Unit</span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        @if (_soloFields.All(x => x.Length == 0)) {
                            <div class="md">还没有选字段，卡片上只会显示名称与连接。</div>
                        }
                    </div>
                </div>

                <div class="form-actions solo-ft">
                    <span class="hint">变量不够？去「变量配置」为该设备补充</span>
                    @if (_soloEditing.Length > 0) {
                        <button class="btn danger" type="button" @onclick="RemoveSolo">移除</button>
                    }
                    <button class="btn ghost" type="button" @onclick="CloseSolo">取消</button>
                    <button class="btn primary" type="button" disabled="@(_soloRouteId.Length == 0)"
                            @onclick="SaveSolo">@(_soloEditing.Length > 0 ? "保存" : "添加")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>报警抽屉是否展开。</summary>
    private bool _drawer;

    /// <summary>正在看详情的报警 Id；空串表示弹窗关闭。</summary>
    /// <remarks>
    /// 存 Id 而不是对象：确认之后数据源会给出新的快照，
    /// 存着旧对象的话弹窗里还显示「未确认」，而抽屉里已经变了。
    /// </remarks>
    private string _detailId = string.Empty;

    /// <summary>
    /// 已折叠的产线 Id。
    /// </summary>
    /// <remarks>
    /// 存「折叠的」而不是「展开的」：新加一条产线时默认应当是展开的，
    /// 存展开集合的话新产线不在集合里，一出现就是收起状态，看起来像没加上。
    /// </remarks>
    private readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);

    /// <summary>折叠 / 展开某条产线的离散设备区。</summary>
    private void ToggleSolo(string lineId)
    {
        if (!_collapsed.Add(lineId))
            _collapsed.Remove(lineId);
    }

    /// <summary>收起全部产线的离散设备区。</summary>
    private void CollapseAll()
    {
        foreach (MesLine l in Mes.Snapshot().Lines)
            _collapsed.Add(l.Id);
    }

    /// <summary>展开全部产线的离散设备区。</summary>
    private void ExpandAll() => _collapsed.Clear();

    /// <summary>确认一条报警。</summary>
    private void Ack(string alarmId) => Mes.Acknowledge(alarmId);

    /// <summary>
    /// 确认当前全部未确认的报警。
    /// </summary>
    /// <remarks>
    /// 逐条调用而不是给数据源加一个「全确认」方法：这样确认逻辑只有一处，
    /// 将来接真实数据要往设备写确认位时，不必再实现第二条路径。
    /// </remarks>
    private void AckAll()
    {
        foreach (MesAlarm a in Mes.Snapshot().Alarms.Where(a => !a.Acked))
            Mes.Acknowledge(a.Id);
    }

    /// <summary>订阅会话变化，用于「实时」徽标随 Host 上下线切换。</summary>
    protected override void OnInitialized() => Session.Changed += OnChanged;

    /// <summary>会话变化时重绘；事件来自后台线程，必须经 InvokeAsync 切回渲染上下文。</summary>
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>退订会话事件；Session 是单例，漏退会泄漏本组件。</summary>
    public void Dispose() => Session.Changed -= OnChanged;

    // ========================================================================
    // 离散设备
    // ========================================================================
    //
    // 入口放在本页而不是「产线配置」：这类设备只在本页显示读数，卡片就在
    // 眼前，改哪一台点哪一张。放到产线配置里要先跳页、再找到那条线，
    // 而那一页讲的是工艺流编排，离散设备本来就不在工艺流上。
    //
    // 这里<b>直接写 web-lines.json</b>——它是产线编排的唯一出处，
    // 本页另存一份的话，两处会各自漂移，而漂移之后没人说得清哪份是准的。

    /// <summary>弹窗是否打开。</summary>
    private bool _soloOpen;

    /// <summary>弹窗所属产线 Id。</summary>
    private string _soloLineId = string.Empty;

    /// <summary>正在编辑的设备路由 Id；空串表示新增。</summary>
    private string _soloEditing = string.Empty;

    /// <summary>弹窗里选中的设备路由。</summary>
    private string _soloRouteId = string.Empty;

    /// <summary>
    /// 弹窗里四个显示字段的变量 Id。
    /// </summary>
    /// <remarks>
    /// 定长四格而不是可变列表：卡片版式就是两行两列，
    /// 用列表的话「删掉第二个」之后剩下的会往前挤，与卡片上的格位对不上。
    /// </remarks>
    private readonly string[] _soloFields = new string[4];

    /// <summary>打开弹窗。<paramref name="routeId"/> 为空表示新增。</summary>
    private void OpenSolo(string lineId, string? routeId)
    {
        _soloLineId = lineId;
        _soloEditing = routeId ?? string.Empty;
        _soloRouteId = _soloEditing;
        Array.Fill(_soloFields, string.Empty);

        // 编辑时回填已选字段；超出四个的忽略——卡片本来也只画四格
        WebSoloDevice? d = SoloOf(_soloEditing);
        if (d is not null)
        {
            for (int i = 0; i < Math.Min(4, d.FieldVariableIds.Count); i++)
                _soloFields[i] = d.FieldVariableIds[i];
        }

        _soloOpen = true;
    }

    /// <summary>关闭弹窗。</summary>
    private void CloseSolo()
    {
        _soloOpen = false;
        _soloEditing = string.Empty;
        _soloRouteId = string.Empty;
    }

    /// <summary>
    /// 弹窗里换了设备。
    /// </summary>
    /// <remarks>
    /// 必须清空四个字段：它们是<b>上一台设备</b>的变量 Id，
    /// 留着的话下拉里选不中（不在新设备的变量里），预览却还画着旧名字。
    /// </remarks>
    private void SoloDeviceChanged(string? routeId)
    {
        _soloRouteId = routeId ?? string.Empty;
        Array.Fill(_soloFields, string.Empty);
    }

    /// <summary>保存并落盘。</summary>
    private void SaveSolo()
    {
        WebLine? line = Lines.Get(_soloLineId);
        if (line is null || _soloRouteId.Length == 0) return;

        List<string> fields = _soloFields.Where(x => x.Length > 0).ToList();
        WebSoloDevice? existing = SoloOf(_soloEditing);

        if (existing is not null)
            existing.FieldVariableIds = fields;
        else
            line.Solo.Add(new WebSoloDevice { RouteId = _soloRouteId, FieldVariableIds = fields });

        Lines.Save();
        CloseSolo();
    }

    /// <summary>把这台设备移出本线。</summary>
    /// <remarks>
    /// 只解除「归属这条线」，不动设备本身——设备管理里那条记录、
    /// 它的变量与轮询都照旧。删设备是另一页的事。
    /// </remarks>
    private void RemoveSolo()
    {
        WebLine? line = Lines.Get(_soloLineId);
        WebSoloDevice? d = SoloOf(_soloEditing);
        if (line is null || d is null) return;

        line.Solo.Remove(d);
        Lines.Save();
        CloseSolo();
    }

    /// <summary>按路由 Id 在当前线里找那台离散设备。</summary>
    private WebSoloDevice? SoloOf(string routeId)
    {
        if (routeId.Length == 0) return null;

        return Lines.Get(_soloLineId)?.Solo
            .FirstOrDefault(x => string.Equals(x.RouteId, routeId, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>弹窗标题下那行产线名。</summary>
    private string SoloLineName()
    {
        WebLine? line = Lines.Get(_soloLineId);
        if (line is null) return string.Empty;

        return line.Name.Length > 0 ? line.Name : line.Id;
    }

    /// <summary>
    /// 可选设备：本线还没用到的那些。
    /// </summary>
    /// <remarks>
    /// 已在工艺流上的排除掉——同一台设备既是工站又是离散设备的话，
    /// 一屏上会出现两张卡画着同一个值，而其中一张不参与报警与控制。
    /// 编辑时把自己加回来，否则下拉是空的。
    /// </remarks>
    private List<WebDeviceRecord> SoloCandidates()
    {
        WebLine? line = Lines.Get(_soloLineId);
        if (line is null) return new List<WebDeviceRecord>();

        HashSet<string> used = new(
            line.Stations.Select(s => s.RouteId).Concat(line.Solo.Select(s => s.RouteId)),
            StringComparer.OrdinalIgnoreCase);

        List<WebDeviceRecord> list = Devices.GetAll()
            .Where(d => !used.Contains(d.RouteId))
            .ToList();

        if (_soloEditing.Length > 0)
        {
            WebDeviceRecord? self = Devices.Get(_soloEditing);
            if (self is not null) list.Insert(0, self);
        }

        return list;
    }

    /// <summary>设备下拉里的一行。</summary>
    private static string SoloDeviceLabel(WebDeviceRecord d) =>
        d.Name + " · " + d.ProtocolId + " · " + d.Endpoint;

    /// <summary>设备显示名；设备已删除时退回路由 Id。</summary>
    private string SoloDeviceName(string routeId) => Devices.Get(routeId)?.Name ?? routeId;

    /// <summary>设备副标题：协议与连接。</summary>
    private string SoloDeviceSub(string routeId)
    {
        WebDeviceRecord? d = Devices.Get(routeId);
        return d is null ? "设备已删除" : d.ProtocolId + " · " + d.Endpoint;
    }

    /// <summary>所选设备的变量。</summary>
    private List<WebVariable> SoloVars() =>
        _soloRouteId.Length == 0
            ? new List<WebVariable>()
            : Vars.GetAll()
                .Where(v => string.Equals(v.RouteId, _soloRouteId, StringComparison.OrdinalIgnoreCase))
                .ToList();

    /// <summary>按 Id 取变量。</summary>
    private WebVariable? SoloVarById(string id) =>
        Vars.GetAll().FirstOrDefault(v => string.Equals(v.Id, id, StringComparison.Ordinal));

    /// <summary>变量下拉里的一行。</summary>
    private static string SoloVarLabel(WebVariable v) =>
        v.Unit.Length > 0 ? v.Name + " · " + v.Address + " · " + v.Unit : v.Name + " · " + v.Address;

    /// <summary>预览里的轮询周期：取所选字段中最快的那个。</summary>
    /// <remarks>
    /// 卡片整体的刷新快慢由最快的那条决定——四个格子各有各的周期，
    /// 但人看到的是「这张卡多久动一次」。
    /// </remarks>
    private string SoloPollText()
    {
        List<WebVariable> picked = _soloFields
            .Where(x => x.Length > 0)
            .Select(SoloVarById)
            .Where(v => v is not null)
            .Select(v => v!)
            .ToList();

        if (picked.Count == 0) return "—";

        int ms = picked.Min(v => v.ScanRateMs);
        return ms >= 1000 ? (ms / 1000.0).ToString("0.#") + " s" : ms + " ms";
    }
}
