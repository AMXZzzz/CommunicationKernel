@* -----------------------------------------------------------------------------
   文件: Components/Pages/TemplatesPage.razor
   层级: UI 层 — 寄存器模板
   作用: 维护设备功能槽（名称 / 类型 / 备注）。地址在变量表按设备填写。
   ----------------------------------------------------------------------------- *@

@page "/templates"
@inject WebTemplateStore Templates
@inject NavigationManager Nav
@inject AppLogStore Log
@inject IJSRuntime JS
@inject WebVariableStore Variables
@implements IDisposable

<PageTitle>寄存器模板 — CommunicationKernel</PageTitle>

<div class="page page-var">
    <div class="toolbar">
        <h2 class="page-title">寄存器模板</h2>
        @* 工具栏只放页面级操作。「+ 功能」改的是当前选中的模板，
           已移进右侧「模板组成 · 自有」那一行——放在它真正影响的地方，
           作用对象才不用猜。 *@
        <button class="btn ghost" type="button" @onclick="AddTemplate">添加模板</button>
        <button class="btn ghost" type="button" @onclick="Export">导出 JSON</button>
        <label class="btn ghost file-btn">
            导入
            <InputFile OnChange="ImportAsync" accept=".json,application/json" />
        </label>
        <button class="btn primary" type="button" @onclick="SyncToVariables" disabled="@(_current is null)">同步到变量表</button>
        <div class="toolbar-right">
            <span class="toolbar-count">@List.Count 个模板</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <div class="status-msg banner-strip @_bannerClass">@_banner</div>
    }

    <div class="page-body flush">
        <div class="var-layout">
            <aside class="device-panel">
                <div class="panel-hd">模板 <span class="count">@List.Count</span></div>
                @foreach (WebDeviceTemplate t in List)
                {
                    <button class="dev-item @(_currentId == t.Id ? "active" : null)" type="button" @onclick="() => Select(t.Id)">
                        <span class="n">@t.Name</span>
                        @* 显示展开后的清单：只列自有槽位的话，一个纯引用组合而成的
                           模板会显示成「空模板」，而它同步下去其实会生成一堆变量。 *@
                        <span class="sub">@SubtitleOf(t)</span>
                    </button>
                }
            </aside>
            <section class="var-panel tpl-detail">
                @if (_current is null)
                {
                    <div class="empty-state"><div class="empty-hint">添加一个模板，只填功能名称和类型。地址到变量页按设备填。</div></div>
                }
                else
                {
                    @* 模板详情。单表 + 来源列：继承与自有排在同一张表里按最终顺序呈现，
                       那正是「同步到设备后会生成什么」的样子。
                       分成两块（自有表 + 合计预览）时，操作员得自己在脑子里合并。 *@
                    <div class="tpl-hd">
                        <input class="tpl-name" value="@_current.Name"
                               @onchange="e => Rename(e.Value?.ToString())" />
                        <span class="tpl-id mono">@ShortId(_current.Id)</span>
                        <span class="tpl-usage">@UsageText</span>
                        <button class="btn-sm danger" type="button" @onclick="AskRemoveTpl">删除模板</button>
                    </div>

                    @* 四个数字是这个模板的「体检指标」。合计字节尤其重要：
                       它决定同步下去要占多少寄存器，配地址前必须心里有数。 *@
                    @* 自有字节与合计字节分开列：
                       改本模板只影响自有那部分，而配地址要按合计留空间。
                       只给一个合计的话，看不出「这次改动会让占用增加多少」。 *@
                    <div class="kv-strip">
                        <div><div class="k">自有功能</div><div class="v">@_current.Slots.Count</div></div>
                        <div><div class="k">继承功能</div><div class="v">@InheritedCount</div></div>
                        <div><div class="k">自有字节</div><div class="v">@OwnBytes</div></div>
                        <div><div class="k">合计字节</div><div class="v">@TotalBytes</div></div>
                        <div><div class="k">引用模板</div><div class="v">@_current.Includes.Count</div></div>
                    </div>

                    @if (UsedByDeviceCount > 0)
                    {
                        @* 讲的是这个模板的现状，属于顶部的事实区。
                           原来摆在最底下、紧贴「添加功能」按钮——一条警告压在
                           主操作下面，读起来像是在警告那个按钮。 *@
                        <div class="tpl-warn">
                            ⚠ 该模板已被 @UsedByDeviceCount 台设备引用；删除功能不会移除已生成的变量。
                        </div>
                    }

                    <div class="tpl-includes-bar">
                        <span class="src">引用：</span>
                        @foreach (string incId in _current.Includes)
                        {
                            <span class="chip">
                                @NameOf(incId)
                                <button class="chip-x" type="button" title="移除该引用"
                                        @onclick="() => RemoveInclude(incId)">✕</button>
                            </span>
                        }

                        @* 引用数量不设上限。候选为空时给出原因，
                           否则下拉直接消失，看起来像「只能引用一个」。 *@
                        @if (Candidates.Count > 0)
                        {
                            <select class="chip add" value="" @onchange="e => AddInclude(e.Value?.ToString())">
                                <option value="">＋ 添加引用</option>
                                @foreach (WebDeviceTemplate c in Candidates)
                                {
                                    <option value="@c.Id">@c.Name（@Templates.ResolveSlots(c.Id).Count 项）</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="src">@NoCandidateReason</span>
                        }
                    </div>

                    <div class="tpl-table-wrap">
                        <table class="tpl-table">
                            @* 定宽列：不写死的话，一进入编辑态单元格换成输入框，
                               各列宽度会按新内容重新分配，整张表跳一下 *@
                            <colgroup>
                                @* 定宽列用 px、可伸缩列用 %，两者加起来正好铺满 880px 的
                                   min-width。原先的 330px + 75%% 在 860px 宽时超出近 120px，
                                   于是每列被等比压窄，表头「字节」都被折成了两行。 *@
                                <col style="width:44px" /><col style="width:21%" /><col style="width:96px" />
                                <col style="width:60px" /><col style="width:76px" /><col style="width:25%" />
                                <col style="width:14%" /><col style="width:120px" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="idx">#</th>
                                    <th>名称</th>
                                    <th>类型</th>
                                    <th class="num">字节</th>
                                    <th class="ro">读写</th>
                                    <th>备注</th>
                                    <th>来源</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNo = 0; }
                                @foreach (ResolvedTemplateSlot r in Resolved)
                                {
                                    rowNo++;
                                    int ownIdx = r.IsOwn ? OwnIndexOf(r.Slot.Name) : -1;
                                    bool editing = r.IsOwn && _editIdx == ownIdx;

                                    <tr class="@(r.IsOwn ? null : "inherited")">
                                        <td class="idx">@rowNo.ToString("00")</td>

                                        @if (editing)
                                        {
                                            @* 就地改这一行，不弹窗：改完立刻能对着上下行看类型是否协调 *@
                                            <td><input class="cell" value="@r.Slot.Name"
                                                       @onchange="e => SetSlot(ownIdx, name: e.Value?.ToString())" /></td>
                                            <td>
                                                <select class="cell" value="@r.Slot.DataType"
                                                        @onchange="e => SetSlot(ownIdx, type: e.Value?.ToString())">
                                                    @foreach (string t in DataTypes)
                                                    {
                                                        <option value="@t">@t</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="num mono">@SlotLength(r.Slot)</td>
                                            <td class="ro">
                                                <select class="cell" value="@r.Slot.Access"
                                                        @onchange="e => SetSlot(ownIdx, access: e.Value?.ToString())">
                                                    @foreach (VariableAccess a in VariableAccessInfo.All)
                                                    {
                                                        <option value="@a">@VariableAccessInfo.Label(a)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="cell" value="@r.Slot.Note" placeholder="说明"
                                                       @onchange="e => SetSlot(ownIdx, note: e.Value?.ToString())" /></td>
                                            <td class="src">自有</td>
                                            <td class="ops">
                                                <button class="btn-sm primary" type="button"
                                                        @onclick="() => _editIdx = -1">完成</button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>@r.Slot.Name</td>
                                            <td><span class="type @TypeClass(r.Slot.DataType)">@r.Slot.DataType</span></td>
                                            <td class="num mono">@SlotLength(r.Slot)</td>
                                            @* 读写方向是设备的固有属性，标在模板上随同步下发，
                                               操作员不必逐台逐条重标一遍 *@
                                            <td class="ro">@VariableAccessInfo.Label(r.Slot.Access)</td>
                                            <td class="note">@r.Slot.Note</td>
                                            <td class="src">@(r.IsOwn ? "自有" : "↳ " + r.SourceTemplateName)</td>
                                            <td class="ops">
                                                @* 继承项这里刻意留空：它在本模板改不了，
                                                   摆一个点了没反应的按钮比没有按钮更糟 *@
                                                @if (r.IsOwn)
                                                {
                                                    <button class="btn-sm" type="button"
                                                            @onclick="() => _editIdx = ownIdx">编辑</button>
                                                    <button class="btn-sm danger" type="button"
                                                            @onclick="() => RemoveSlot(ownIdx)">删除</button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="tpl-foot">
                        <span>同名功能以自有定义为准；地址、字节序、轮询在「变量配置」页按设备填写。</span>
                        <button class="btn primary" type="button" @onclick="AddSlot">＋ 添加功能</button>
                    </div>

                }
            </section>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_exportJson))
    {
        <div class="add-form-overlay" @onclick="() => _exportJson = string.Empty">
            <div class="add-form wide" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>导出模板 JSON</h3>
                    <button class="close-btn" type="button" @onclick="() => _exportJson = string.Empty">×</button>
                </div>
                <textarea class="export-box" readonly>@_exportJson</textarea>
                <div class="form-ft">
                    <span class="form-ft-hint">@_exportJson.Length 个字符</span>
                    <button class="btn ghost" type="button" @onclick="CopyExportAsync">复制</button>
                    <button class="btn primary" type="button" @onclick="DownloadExportAsync">下载文件</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingRemove)
    {
        <div class="add-form-overlay center" @onclick="() => _pendingRemove = false">
            <div class="add-form confirm-box" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>删除模板</h3>
                    <button class="close-btn" type="button" @onclick="() => _pendingRemove = false">×</button>
                </div>
                <p>删除模板不会自动拆掉变量表里已套用的行，那些行会继续锁定，直到再同步其它模板。</p>
                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="() => _pendingRemove = false">取消</button>
                    <button class="btn danger" type="button" @onclick="ConfirmRemoveTpl">确认删除</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] DataTypes = { "Bool", "Int16", "UInt16", "Int32", "UInt32", "Float", "String", "Hex" };

    private IReadOnlyList<WebDeviceTemplate> List => Templates.GetAll();
    private string? _currentId;
    private WebDeviceTemplate? _current;
    private string _banner = string.Empty;
    private string _bannerClass = string.Empty;
    private string _exportJson = string.Empty;
    private bool _pendingRemove;

    protected override void OnInitialized()
    {
        Templates.Changed += OnChanged;
        if (List.Count > 0)
            Select(List[0].Id);
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (_currentId is not null)
            _current = Templates.Get(_currentId);
        StateHasChanged();
    });

    private void Select(string id)
    {
        _currentId = id;
        _current = Templates.Get(id);
    }

    private void Persist()
    {
        if (_current is null) return;
        Templates.Update(_current);
        _current = Templates.Get(_current.Id);
    }

    private void AddTemplate()
    {
        var t = new WebDeviceTemplate
        {
            Name = "新模板",
            Slots = { new WebDeviceTemplateSlot { Name = "启动", DataType = "Bool" } }
        };
        Templates.Add(t);
        Select(t.Id);
    }

    private void AddSlot()
    {
        if (_current is null) return;
        _current.Slots.Add(new WebDeviceTemplateSlot { Name = "新功能", DataType = "Int16" });
        Persist();
    }

    private void RemoveSlot(int i)
    {
        if (_current is null || i < 0 || i >= _current.Slots.Count) return;
        _current.Slots.RemoveAt(i);
        Persist();
    }

    private void SetSlot(
        int i, string? name = null, string? type = null, string? note = null, string? access = null)
    {
        if (_current is null || i < 0 || i >= _current.Slots.Count) return;
        WebDeviceTemplateSlot s = _current.Slots[i];
        if (name is not null) s.Name = name.Trim();
        if (type is not null) s.DataType = type;
        if (note is not null) s.Note = note;
        // 下拉给回的是枚举名字符串；解析失败保持原值，不静默改成可读写
        if (access is not null && Enum.TryParse(access, out VariableAccess parsed)) s.Access = parsed;
        Persist();
    }

    // =========================================================================
    // 模板引用
    // =========================================================================

    /// <summary>正在就地编辑的自有槽位下标；-1 表示无。</summary>
    /// <remarks>
    /// 只允许同时编辑一行：多行同时变成输入框时，表格失去"一眼看完"的价值，
    /// 而这张表最主要的用途正是通读。
    /// </remarks>
    private int _editIdx = -1;

    /// <summary>当前模板展开后的完整功能槽，含来源标记。</summary>
    private IReadOnlyList<ResolvedTemplateSlot> Resolved =>
        _current is null ? Array.Empty<ResolvedTemplateSlot>() : Templates.ResolveDetailed(_current.Id);

    /// <summary>继承来的功能数量（展开总数减去自有数）。</summary>
    private int InheritedCount => Resolved.Count(r => !r.IsOwn);

    /// <summary>
    /// 展开后全部功能占用的字节数。
    /// </summary>
    /// <remarks>
    /// 配地址前必须知道这个数：它决定同步下去要占多少连续寄存器。
    /// 用 <see cref="SlotLength"/> 而非 Slot.Length——定长类型的 Length 字段
    /// 可能是 0（由类型推导），直接求和会少算。
    /// </remarks>
    private int TotalBytes => Resolved.Sum(r => SlotLength(r.Slot));

    /// <summary>本模板自有功能占用的字节数。</summary>
    /// <remarks>
    /// 与 <see cref="TotalBytes"/> 分开显示：在本页能改的只有自有那部分，
    /// 而配地址要按合计留空间。只给合计的话，看不出「这次改动让占用增加了多少」。
    /// <para>
    /// 统计的是<b>展开后仍然生效</b>的自有项：自有被更外层覆盖的情况不存在
    /// （自有已是最外层），但同名自有项重复时以最后一个为准，
    /// 直接对 <c>_current.Slots</c> 求和会重复计。
    /// </para>
    /// </remarks>
    private int OwnBytes => Resolved.Where(r => r.IsOwn).Sum(r => SlotLength(r.Slot));

    /// <summary>本模板已被多少台设备用过（按变量行上的 TemplateId 统计）。</summary>
    /// <remarks>
    /// 统计的是<b>已生成变量</b>的设备数，不是"选了这个模板"的设备数——
    /// 后者没有持久记录。这个数字的用途是提醒「删功能不会回收已生成的变量」，
    /// 因此按变量统计正是需要的口径。
    /// </remarks>
    private int UsedByDeviceCount =>
        _current is null
            ? 0
            : Variables.GetAll()
                .Where(v => string.Equals(v.TemplateId, _current.Id, StringComparison.OrdinalIgnoreCase))
                .Select(v => v.RouteId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

    /// <summary>标题栏右侧的使用情况文案。</summary>
    private string UsageText
    {
        get
        {
            int n = UsedByDeviceCount;
            return n == 0 ? "尚未被设备使用" : "被 " + n + " 台设备使用";
        }
    }

    /// <summary>模板 Id 的短形式，供标题栏显示。</summary>
    /// <remarks>
    /// 32 位十六进制全列出来会把标题挤满，而它的用途只是「和导出的 JSON 对得上」，
    /// 首尾各 4 位足够辨认。
    /// </remarks>
    private static string ShortId(string id)
        => string.IsNullOrEmpty(id) || id.Length <= 12
            ? id
            : id[..4] + "…" + id[^4..];

    /// <summary>某个功能名在自有槽位里的下标；不是自有则返回 -1。</summary>
    private int OwnIndexOf(string name)
        => _current is null
            ? -1
            : _current.Slots.FindIndex(s =>
                string.Equals(s.Name.Trim(), name, StringComparison.OrdinalIgnoreCase));

    /// <summary>数据类型 → 徽标配色类名。</summary>
    /// <remarks>
    /// 按<b>类别</b>着色而非逐个类型：现场扫一列类型时，要分辨的是
    /// 「这是开关量还是模拟量」，而不是 Int16 与 UInt16 的区别。
    /// </remarks>
    private static string TypeClass(string dataType) => dataType switch
    {
        "Bool" => "bool",
        "Float" => "float",
        "String" or "Hex" => "str",
        _ => "int",
    };

    /// <summary>
    /// 可被当前模板引用的候选模板。
    /// </summary>
    /// <remarks>
    /// 排除三类：自己、已经引用过的、以及引用后会成环的。
    /// 让不可选的当场不出现，好过选完再弹一句"不允许"——
    /// 后者要求操作员理解"环引用"是什么，而那不该是现场需要懂的概念。
    /// </remarks>
    private IReadOnlyList<WebDeviceTemplate> Candidates =>
        _current is null
            ? Array.Empty<WebDeviceTemplate>()
            : List.Where(t =>
                  t.Id != _current.Id
                  && !_current.Includes.Contains(t.Id)
                  && !Templates.WouldCreateCycle(_current.Id, t.Id))
              .ToList();

    /// <summary>
    /// 没有可选候选时的说明文字。
    /// </summary>
    /// <remarks>
    /// <b>引用数量本身不设上限</b>，可以同时引用启停、报警、计数等多个模板。
    /// 候选为空只会有两种原因，都要讲清楚——不说的话，操作员看到下拉消失
    /// 会以为"只能引用一个"，从而回去重复抄槽位，正是本功能要消除的做法。
    /// </remarks>
    private string NoCandidateReason
    {
        get
        {
            if (_current is null) return string.Empty;

            // 只有自己一个模板
            if (List.Count <= 1) return "没有其它模板可引用，先「添加模板」";

            // 剩下的都被过滤掉了：要么已引用，要么引用后会成环
            int others = List.Count - 1;
            return _current.Includes.Count >= others
                ? "已引用全部其它模板"
                : "其余模板引用了本模板，再引用回去会形成循环";
        }
    }

    /// <summary>左侧列表的副标题：展开后的功能名，过长时截断。</summary>
    private string SubtitleOf(WebDeviceTemplate t)
    {
        IReadOnlyList<WebDeviceTemplateSlot> all = Templates.ResolveSlots(t.Id);
        if (all.Count == 0) return "空模板";

        // 侧栏只有一行高度，全列出来会被 CSS 截成半个字。
        // 前四项加计数，比截断字符串更容易读。
        string head = string.Join(" / ", all.Take(4).Select(s => s.Name));
        return all.Count > 4 ? head + " … 共 " + all.Count + " 项" : head;
    }

    /// <summary>按 Id 取模板显示名；模板已被删除时给出可辨识的占位。</summary>
    private string NameOf(string id)
        => List.FirstOrDefault(t => t.Id == id)?.Name ?? "(已删除)";

    /// <summary>某个功能名是否来自本模板自有槽位（用于预览着色）。</summary>
    private bool IsOwn(string name)
        => _current is not null
           && _current.Slots.Any(s => string.Equals(s.Name.Trim(), name, StringComparison.OrdinalIgnoreCase));

    /// <summary>添加一个引用。</summary>
    private void AddInclude(string? id)
    {
        if (_current is null || string.IsNullOrWhiteSpace(id)) return;
        if (_current.Includes.Contains(id)) return;

        // 再挡一次环：候选列表已经过滤过，但下拉的值可能来自陈旧的渲染
        if (Templates.WouldCreateCycle(_current.Id, id))
        {
            Log.Warn("Templates", "拒绝会成环的模板引用：" + _current.Name + " → " + NameOf(id));
            return;
        }

        _current.Includes.Add(id);
        Templates.Update(_current);
    }

    /// <summary>移除一个引用。</summary>
    private void RemoveInclude(string id)
    {
        if (_current is null) return;
        _current.Includes.Remove(id);
        Templates.Update(_current);
    }

    private void Rename(string? name)
    {
        if (_current is null || string.IsNullOrWhiteSpace(name)) return;
        _current.Name = name.Trim();
        Persist();
    }

    private static int SlotLength(WebDeviceTemplateSlot s) =>
        ValueCodec.IsVariableLength(s.DataType)
            ? Math.Max(1, s.Length == 0 ? ValueCodec.DefaultLength(s.DataType) : s.Length)
            : ValueCodec.DefaultLength(s.DataType);

    private void AskRemoveTpl() => _pendingRemove = _current is not null;

    private void ConfirmRemoveTpl()
    {
        if (_current is null) return;
        Templates.Remove(_current.Id);
        _pendingRemove = false;
        _current = null;
        _currentId = null;
        if (List.Count > 0) Select(List[0].Id);
    }

    private void Export() => _exportJson = Templates.ExportJson();

    /// <summary>把模板库存成文件。文件名带日期，便于区分多次备份。</summary>
    private async Task DownloadExportAsync()
    {
        string name = "ck-templates-" + DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".json";
        await JS.InvokeVoidAsync("ck.downloadText", name, _exportJson).ConfigureAwait(true);

        _banner = "已导出 " + name;
        _bannerClass = "status-ok";
        _exportJson = string.Empty;
    }

    /// <summary>复制到剪贴板；非安全上下文下由 JS 侧 execCommand 兜底。</summary>
    private async Task CopyExportAsync()
    {
        bool ok = await JS.InvokeAsync<bool>("ck.copyText", _exportJson).ConfigureAwait(true);

        _banner = ok ? "已复制到剪贴板" : "复制失败，请改用「下载文件」";
        _bannerClass = ok ? "status-ok" : "status-warn";
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            await using Stream s = e.File.OpenReadStream(512 * 1024);
            using var reader = new StreamReader(s);
            string json = await reader.ReadToEndAsync();
            int n = Templates.ImportJson(json, replace: false);
            _banner = "已导入 " + n + " 个模板";
            _bannerClass = "status-ok";
            if (List.Count > 0) Select(List[0].Id);
        }
        catch (Exception ex)
        {
            _banner = "导入失败: " + ex.Message;
            _bannerClass = "status-error";
            Log.Error("TemplatesPage", ex.Message);
        }
    }

    private void SyncToVariables()
    {
        if (_current is null) return;
        Nav.NavigateTo("/variables?template=" + Uri.EscapeDataString(_current.Id));
    }

    public void Dispose() => Templates.Changed -= OnChanged;
}
