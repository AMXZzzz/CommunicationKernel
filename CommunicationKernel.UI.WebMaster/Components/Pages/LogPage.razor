@* -----------------------------------------------------------------------------
   文件: Components/Pages/LogPage.razor
   层级: UI 层 — 通讯日志
   作用: 订阅进程内 AppLogStore，不再每次打开页面挂一个 ILoggerProvider。
   ----------------------------------------------------------------------------- *@

@page "/log"
@inject AppLogStore Logs
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>通讯日志 — CommunicationKernel</PageTitle>

@* 整个模板共用这一份：计数、遍历、空判都基于它，避免同一帧内重复过滤快照 *@
@{
    List<AppLogEntry> rows = BuildRows();
}

<div class="page page-log">
    <div class="toolbar">
        <h2 class="page-title">通讯日志</h2>
        <div class="filter-group">
            @foreach (string lvl in new[] { "ALL", "INF", "WRN", "ERR" })
            {
                <button class="btn-filter @(FilterLevel == lvl ? "active" : null)" type="button" @onclick="() => FilterLevel = lvl">@lvl</button>
            }
        </div>
        <input class="search-input" placeholder="搜索…" @bind="FilterText" @bind:event="oninput" />
        <button class="btn ghost" type="button" @onclick="Export">导出</button>
        <button class="btn ghost" type="button" @onclick="Logs.Clear">清空</button>
        <div class="toolbar-right">
            <label class="auto-scroll">
                <input type="checkbox" @bind="AutoScroll" />
                自动滚动
            </label>
            <span class="toolbar-count">@_matchCount 条</span>
        </div>
    </div>

    <div class="page-body">
    <div class="log-area" id="log-area">
        @if (_matchCount > rows.Count)
        {
            @* 说明这里为什么不是全部：不写的话，操作员会以为早先的日志丢了 *@
            <div class="empty-hint">
                共 @_matchCount 条，仅显示最近 @rows.Count 条。需要完整记录请用顶栏「导出」。
            </div>
        }
        @foreach (AppLogEntry entry in rows)
        {
            <div class="log-row">
                <span class="log-time">@entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                <span class="log-level level-@entry.LevelClass">@entry.LevelText</span>
                <span class="log-cat">@entry.Category</span>
                <span class="log-msg level-@entry.LevelClass">@entry.Message</span>
            </div>
        }
        @if (_matchCount == 0)
        {
            <div class="empty-hint">暂无日志。注册路由、读写变量会写到这里。</div>
        }
    </div>
    </div>

    @if (!string.IsNullOrEmpty(_exportText))
    {
        <div class="add-form-overlay" @onclick="() => _exportText = string.Empty">
            <div class="add-form wide" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>导出日志</h3>
                    <button class="close-btn" type="button" @onclick="() => _exportText = string.Empty">×</button>
                </div>
                <textarea class="export-box" readonly>@_exportText</textarea>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>级别筛选，"ALL" 表示不过滤；其余取值与 <c>AppLogEntry.LevelText</c> 一致。</summary>
    private string FilterLevel { get; set; } = "ALL";

    /// <summary>关键字筛选，同时匹配正文与分类。</summary>
    private string FilterText { get; set; } = string.Empty;

    /// <summary>是否在有新日志时自动滚到底部。默认开——现场多是盯着最新的看。</summary>
    private bool AutoScroll { get; set; } = true;

    /// <summary>导出面板里的纯文本日志。</summary>
    private string _exportText = string.Empty;

    /// <summary>
    /// 一次渲染最多输出多少行。
    /// </summary>
    /// <remarks>
    /// 缓冲上限 2000 条，全渲染就是 2000 个 log-row、每行 4 个 span——
    /// 上万个节点的差异要经 SignalR 推到客户端。本机上感觉不出来，
    /// 但经内网穿透用手机看时，切到本页会明显卡一下。
    /// <para>
    /// 日志是"看最近发生了什么"的工具，往上翻几百条已经足够；
    /// 真要全量分析走顶栏的「导出」，那条路不受此限制。
    /// </para>
    /// </remarks>
    private const int MaxRenderRows = 300;

    /// <summary>本次筛选命中的总条数，不受 <see cref="MaxRenderRows"/> 影响。</summary>
    private int _matchCount;

    /// <summary>
    /// 应用两级筛选，返回要渲染的日志行（最多 <see cref="MaxRenderRows"/> 条，取最新的）。
    /// </summary>
    /// <remarks>
    /// <b>每次渲染只调一次</b>，结果存进局部变量给整个模板用。
    /// 此前是个属性，模板里被访问三次（计数、遍历、空判），
    /// 于是每渲染一帧就把 2000 条的快照复制并过滤三遍。
    /// 过滤本身很快，问题在于日志页订阅了变更通知——
    /// 轮询开着时每来一条新日志就重跑一整轮。
    /// <para>
    /// 关键字匹配用 <c>OrdinalIgnoreCase</c>：操作员搜 "plc" 应当能命中 "PLC-1"。
    /// </para>
    /// </remarks>
    /// <returns>按时间升序的日志行，最新的在末尾。</returns>
    private List<AppLogEntry> BuildRows()
    {
        List<AppLogEntry> hit = Logs.Snapshot().Where(e =>
            (FilterLevel == "ALL" || e.LevelText == FilterLevel) &&
            (string.IsNullOrEmpty(FilterText) ||
             e.Message.Contains(FilterText, StringComparison.OrdinalIgnoreCase) ||
             e.Category.Contains(FilterText, StringComparison.OrdinalIgnoreCase))).ToList();

        _matchCount = hit.Count;

        // 取末尾而非开头：快照是时间升序，最新的在后面，
        // 而日志页默认滚到底部看最新——截掉开头才是对的。
        return hit.Count > MaxRenderRows
            ? hit.GetRange(hit.Count - MaxRenderRows, MaxRenderRows)
            : hit;
    }

    /// <summary>订阅日志缓冲的变更通知。</summary>
    protected override void OnInitialized() => Logs.Changed += OnChanged;

    /// <summary>
    /// 有新日志时重绘，并按需滚到底部。
    /// </summary>
    /// <remarks>
    /// <para>
    /// 滚动必须在 <c>StateHasChanged</c> <b>之后</b>：新行还没渲染出来时滚动，
    /// 滚到的是旧的底部，最新几行仍在视口外。
    /// </para>
    /// <para>
    /// JS 调用整体吞掉异常是有意的：Blazor Server 断线或组件正在销毁时
    /// <c>InvokeVoidAsync</c> 会抛，而这只是个滚动效果——
    /// 为它把整条日志链路搞崩不值得。
    /// </para>
    /// </remarks>
    private void OnChanged()
    {
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();

            if (AutoScroll)
            {
                try { await Js.InvokeVoidAsync("ck.scrollToBottom", "log-area"); }
                catch (Exception) { }
            }
        });
    }

    /// <summary>
    /// 把<b>全部</b>日志导出为纯文本，供操作员复制。
    /// </summary>
    /// <remarks>
    /// 刻意导出全量而非当前筛选结果：导出多半是为了发给别人排查，
    /// 只给筛过的片段会漏掉上下文，而现场未必记得自己开着筛选。
    /// 时间戳带毫秒——排查时序问题时秒级精度不够。
    /// </remarks>
    private void Export()
    {
        _exportText = string.Join(
            Environment.NewLine,
            Logs.Snapshot().Select(e =>
                e.Timestamp.ToString("HH:mm:ss.fff") + " " + e.LevelText + " " + e.Category + " " + e.Message));
    }

    /// <summary>退订日志事件；AppLogStore 是单例，漏退会泄漏本组件。</summary>
    public void Dispose() => Logs.Changed -= OnChanged;
}
