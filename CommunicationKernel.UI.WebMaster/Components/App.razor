@* -----------------------------------------------------------------------------
   文件: Components/App.razor
   层级: UI 层 — Blazor 应用根组件
   作用: HTML 骨架。Routes 必须 InteractiveServer，否则布局无法订阅 EngineSession。
         关闭预渲染，避免 OnInitialized 跑两次把会话事件订两份。
   ----------------------------------------------------------------------------- *@
<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#111111" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="renderer" content="webkit" />
    <title>通讯调试工具 — CommunicationKernel</title>
    @* 样式之前先打 is-phone：华为/荣耀常忽略 viewport，按 980px 桌面排版，光靠 CSS 媒体查询不够。 *@
    <script>
        (function () {
            // 判定条件必须与 js/app.js 的 isPhone() 完全一致。
            //
            // 曾经这里多一个 "触摸 && 屏幕短边<=920" 的分支，而 app.js 只认 UA
            // 且用的是 toggle——于是触摸屏笔记本上会：本脚本加 is-phone 并把
            // viewport 改窄 → 闪一下手机布局 → app.js 把类摘掉，
            // 但<b>被改窄的 viewport 留了下来</b>，变成「窄视口 + 桌面类」的畸形状态。
            //
            // 只按 UA 判定不会漏掉真手机：忽略 viewport 的华为/鸿蒙浏览器
            // 本来就带 Huawei/Harmony/HMSCore 标识，UA 这一条已经覆盖。
            var ua = navigator.userAgent || "";
            var minSide = Math.min(screen.width || 9999, screen.height || 9999);
            var mobile = /Android|iPhone|iPod|iPad|Mobile|Huawei|Harmony|HMSCore|MicroMessenger/i.test(ua);
            if (!mobile) return;
            document.documentElement.classList.add("is-phone");
            var meta = document.querySelector('meta[name="viewport"]');
            if (!meta) return;
            var w = minSide > 0 && minSide < 900 ? minSide : "device-width";
            meta.setAttribute("content",
                "width=" + w + ", initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover");
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="app.css?v=4" />
    <link rel="stylesheet" href="CommunicationKernel.UI.WebMaster.styles.css" />
    @* 改动 theme.css 必须同时 +1 这个版本号，否则老浏览器会拿缓存里的旧样式：
       新加的类不生效，表现是"某个元素颜色不对"，而查代码看不出任何问题。 *@
    <link rel="stylesheet" href="css/theme.css?v=40" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    @* 整树交互：布局标题栏 / 侧栏才能跟随 Host 在线状态刷新 *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    @*
        自带断线重连提示。

        页面里出现 id="components-reconnect-modal" 时，blazor.server.js 就用这份
        标记，不再注入它自己那套（含一个用 ::before 画的转圈）。
        上一版只给框架的默认元素套了 flex 布局，结果把那个转圈拉成了椭圆——
        它是伪元素，做了 flex 项就被拉伸填充。自己出标记才能彻底控制外观。

        框架只做一件事：在这个元素上切 components-reconnect-* 类。
        三种状态各自的文案由下面的 CSS 用 display 切换，Razor 不参与。
    *@
    <div id="components-reconnect-modal">
        <div class="ck-reconnect-box">
            <div class="ck-reconnect-spin" aria-hidden="true"></div>

            <div class="ck-reconnect-rejoining">
                <strong>与服务器的连接已断开</strong>
                <p>正在重连，界面暂停刷新。<b>当前显示的是断开前的数据，不代表现场实际状态。</b></p>
            </div>

            <div class="ck-reconnect-failed">
                <strong>重连失败</strong>
                <p>已达最大重试次数。请检查网络后刷新页面。</p>
                <button type="button" class="btn primary" onclick="location.reload()">刷新页面</button>
            </div>

            <div class="ck-reconnect-refused">
                <strong>会话已失效</strong>
                <p>服务器已重启或会话被回收，必须刷新页面重新开始。</p>
                <button type="button" class="btn primary" onclick="location.reload()">刷新页面</button>
            </div>
        </div>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="js/app.js?v=6"></script>
    <div id="blazor-error-ui">
        界面循环出现未处理异常，请刷新页面。
        <a href="" class="reload">刷新</a>
        <a class="dismiss">忽略</a>
    </div>
</body>

</html>
