@* -----------------------------------------------------------------------------
   文件: Components/App.razor
   层级: UI 层 — Blazor 应用根组件
   作用: HTML 骨架。Routes 必须 InteractiveServer，否则布局无法订阅 EngineSession。
         关闭预渲染，避免 OnInitialized 跑两次把会话事件订两份。
   ----------------------------------------------------------------------------- *@
<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111111" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>通讯调试工具 — CommunicationKernel</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="CommunicationKernel.UI.WebMaster.styles.css" />
    <link rel="stylesheet" href="css/theme.css" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    @* 整树交互：布局标题栏 / 侧栏才能跟随 Host 在线状态刷新 *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.server.js"></script>
    <script src="js/app.js"></script>
    <div id="blazor-error-ui">
        界面循环出现未处理异常，请刷新页面。
        <a href="" class="reload">刷新</a>
        <a class="dismiss">忽略</a>
    </div>
</body>

</html>
