  <!-- 路由引擎 -->
  <Project Path="CommunicationKernel.Engine.Router/CommunicationKernel.Engine.Router.csproj" />

  <!-- 宿主进程 + 契约 -->
  <Project Path="CommunicationKernel.EngineHost/CommunicationKernel.Engine.Host.csproj" />

  <!-- 协议插件：Modbus（Core 承载三种变体共用的协议语义） -->
