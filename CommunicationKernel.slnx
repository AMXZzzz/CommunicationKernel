<Solution>
  <!-- 核心抽象 -->
  <Project Path="CommunicationKernel.Core.Abstractions/CommunicationKernel.Core.Abstractions.csproj" />

  <!-- 通信层抽象 -->
  <Project Path="CommunicationKernel.Communication.Protocol/CommunicationKernel.Communication.Protocol.csproj" />
  <Project Path="CommunicationKernel.Communication.Transport/CommunicationKernel.Communication.Transport.csproj" />

  <!-- 插件运行时 -->
  <Project Path="CommunicationKernel.Plugin.Runtime/CommunicationKernel.Plugin.Runtime.csproj" />

  <!-- 路由引擎 -->
  <Project Path="CommunicationKernel.Engine.Router/CommunicationKernel.Engine.Router.csproj" />

  <!-- 引擎：可嵌入的 SDK 核心，不依赖 ASP.NET -->
  <Project Path="CommunicationKernel.Engine/CommunicationKernel.Engine.csproj" />

  <!-- 宿主进程：引擎 + gRPC 端点的薄壳 -->
  <Project Path="CommunicationKernel.Engine.Host/CommunicationKernel.Engine.Host.csproj" />

  <!-- 协议插件：Modbus（单一程序集内含 TCP / RTU / ASCII 三个变体） -->
  <Project Path="CommunicationKernel.Plugins.Modbus/CommunicationKernel.Plugins.Modbus.csproj" />

  <!-- 协议插件：松下 -->
  <Project Path="CommunicationKernel.Plugins.Panasonic/CommunicationKernel.Plugins.Panasonic.csproj" />

  <!-- 协议插件：西门子 -->
  <Project Path="CommunicationKernel.Plugins.Siemens.S7/CommunicationKernel.Plugins.Siemens.S7.csproj" />

  <!-- 传输介质插件 -->
  <Project Path="CommunicationKernel.Plugins.Transport.Tcp/CommunicationKernel.Plugins.Transport.Tcp.csproj" />
  <Project Path="CommunicationKernel.Plugins.Transport.SerialPort/CommunicationKernel.Plugins.Transport.SerialPort.csproj" />

  <!-- 客户端库：WPF 与 Blazor 共用的 EngineHost 访问封装 -->
  <Project Path="CommunicationKernel.Client.Grpc/CommunicationKernel.Client.Grpc.csproj" />

  <!-- 测试 -->
  <Project Path="CommunicationKernel.Tests/CommunicationKernel.Tests.csproj" />

  <!-- UI 客户端 -->
  <Project Path="CommunicationKernel.UI.Wpf/CommunicationKernel.UI.Wpf.csproj" />
  <Project Path="CommunicationKernel.UI.Web/CommunicationKernel.UI.Web.csproj" />
</Solution>
