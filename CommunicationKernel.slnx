  <Project Path="CommunicationKernel.Plugins.Modbus.Tcp/CommunicationKernel.Plugins.Modbus.Tcp.csproj" />
  <Project Path="CommunicationKernel.Plugins.Modbus.Rtu/CommunicationKernel.Plugins.Modbus.Rtu.csproj" />
  <Project Path="CommunicationKernel.Plugins.Modbus.Ascii/CommunicationKernel.Plugins.Modbus.Ascii.csproj" />

  <!-- 协议插件：松下 -->
  <Project Path="CommunicationKernel.Plugins.Panasonic.MewtocolTcp/CommunicationKernel.Plugins.Panasonic.MewtocolTcp.csproj" />

  <!-- 协议插件：西门子 -->
  <Project Path="CommunicationKernel.Plugins.Siemens.S7/CommunicationKernel.Plugins.Siemens.S7.csproj" />

  <!-- 传输介质插件 -->
  <Project Path="CommunicationKernel.Plugins.Transport.Tcp/CommunicationKernel.Plugins.Transport.Tcp.csproj" />
  <Project Path="CommunicationKernel.Plugins.Transport.SerialPort/CommunicationKernel.Plugins.Transport.SerialPort.csproj" />

  <!-- 测试 -->
  <Project Path="CommunicationKernel.Tests/CommunicationKernel.Tests.csproj" />

  <!-- UI 客户端 -->
  <Project Path="CommunicationKernel.UI.Wpf/CommunicationKernel.UI.Wpf.csproj" />
  <Project Path="CommunicationKernel.UI.Web/CommunicationKernel.UI.Web.csproj" />
</Solution>
