<Solution>
  <!-- 核心抽象 -->
  <Project Path="CommunicationKernel.Core.Abstractions/CommunicationKernel.Core.Abstractions.csproj" />

  <!-- 通信层抽象 -->
  <Project Path="CommunicationKernel.Communication.Protocol/CommunicationKernel.Communication.Protocol.csproj" />
  <Project Path="CommunicationKernel.Communication.Transport/CommunicationKernel.Communication.Transport.csproj" />

  <!-- 插件加载器 -->
  <Project Path="CommunicationKernel.Plugin.Loader/CommunicationKernel.Plugin.Loader.csproj" />

  <!-- 路由引擎 -->
  <Project Path="CommunicationKernel.Core.EngineRouter/CommunicationKernel.Core.EngineRouter.csproj" />

  <!-- 通讯内核库（形态 A 直接引用） -->
  <Project Path="CommunicationKernel.Core.EngineRuntime/CommunicationKernel.Core.EngineRuntime.csproj" />

  <!-- 现场宿主进程（形态 B）：托管 Core.EngineRuntime + gRPC -->
  <Project Path="CommunicationKernel.EngineHostingServiceApp/CommunicationKernel.EngineHostingServiceApp.csproj" />

  <!-- 协议插件 -->
  <Project Path="CommunicationKernel.Plugins.Protocol.Modbus/CommunicationKernel.Plugins.Protocol.Modbus.csproj" />
  <Project Path="CommunicationKernel.Plugins.Protocol.Panasonic/CommunicationKernel.Plugins.Protocol.Panasonic.csproj" />
  <Project Path="CommunicationKernel.Plugins.Protocol.Siemens.S7/CommunicationKernel.Plugins.Protocol.Siemens.S7.csproj" />

  <!-- 传输介质插件 -->
  <Project Path="CommunicationKernel.Plugins.Transport.Tcp/CommunicationKernel.Plugins.Transport.Tcp.csproj" />
  <Project Path="CommunicationKernel.Plugins.Transport.SerialPort/CommunicationKernel.Plugins.Transport.SerialPort.csproj" />

  <!-- 连 EngineHostingServiceApp 的客户端 SDK（形态 B 的 UI 引用） -->
  <Project Path="CommunicationKernel.EngineHost.Sdk/CommunicationKernel.EngineHost.Sdk.csproj" />

  <!-- 测试 -->
  <Project Path="CommunicationKernel.Tests/CommunicationKernel.Tests.csproj" />

  <!-- UI 客户端 -->
  <Project Path="CommunicationKernel.UI.Wpf/CommunicationKernel.UI.Wpf.csproj" />
  <Project Path="CommunicationKernel.UI.WebMaster/CommunicationKernel.UI.WebMaster.csproj" />
</Solution>
