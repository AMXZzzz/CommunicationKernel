<Project Sdk="Microsoft.NET.Sdk">

  <!--
    层级: L4 路由分发层
    职责: 按 RouteKey 把读写请求分派到已登记的传输 + 协议组合，自身不含任何协议知识。

    引用纪律 —— 每条引用都必须有实际 using 支撑，禁止"以防万一"式声明：
      Core.Abstractions        OperationResult / KernelErrorCode（错误契约）
      Communication.Transport  ITransportClient（分派目标之一）
      Communication.Protocol   IProtocolCodec（分派目标之一）

    这里刻意不引用 Plugin.Context：路由层接收的是已经实例化好的传输与协议对象，
    "从哪个 DLL 加载出来的"属于上层（Core.EngineRuntime）的组装职责。
    引用它会让路由层在纸面上背负插件加载的知识，而代码里一行都用不到。
  -->
  <PropertyGroup>
    <AssemblyName>CommunicationKernel.Core.EngineRouter</AssemblyName>
    <RootNamespace>CommunicationKernel.Core.EngineRouter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CommunicationKernel.Core.Abstractions\CommunicationKernel.Core.Abstractions.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Communication.Transport\CommunicationKernel.Communication.Transport.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Communication.Protocol\CommunicationKernel.Communication.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
