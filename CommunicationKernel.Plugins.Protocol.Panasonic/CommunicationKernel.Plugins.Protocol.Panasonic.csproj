<Project Sdk="Microsoft.NET.Sdk">

  <!--
    松下 MEWTOCOL-COM 协议插件

    原名 Plugins.Panasonic.MewtocolTcp。改名是因为那个 Tcp 后缀是错的：
    MEWTOCOL-COM 本就是串口协议，既跑 RS-232/485，也经 TCP 转串口透传网关
    跑以太网——SupportedTransports 声明的正是 [Serial, Tcp]。
    名字里钉死 Tcp 会让人以为串口不受支持。
  -->
  <PropertyGroup>
    <RootNamespace>CommunicationKernel.Plugins.Protocol.Panasonic</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CommunicationKernel.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommunicationKernel.Core.Abstractions\CommunicationKernel.Core.Abstractions.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Communication.Protocol\CommunicationKernel.Communication.Protocol.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Communication.Transport\CommunicationKernel.Communication.Transport.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Plugin.Context\CommunicationKernel.Plugin.Context.csproj" />
  </ItemGroup>
</Project>
