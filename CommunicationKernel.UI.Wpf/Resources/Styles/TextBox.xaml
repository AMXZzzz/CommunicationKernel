<!--
    文件: Resources/Styles/TextBox.xaml
    层级: UI 层 — WPF 主题
    作用: 弹窗/表单输入框。颜色与尺寸均引用令牌，不写字面量色值。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      弹窗 / 表单用输入框
      颜色、尺寸均来自 Colors.xaml / Sizes.xaml，本文件不写字面量色值。
    -->
    <Style x:Key="SF.Style.DialogTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource SF.Brush.Bg.App}"
                            BorderBrush="{StaticResource SF.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource SF.Brush.Accent.Default}"/>
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SF.Brush.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource SF.Brush.Accent.Default}"/>
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SF.Brush.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- 行悬停：用途说明 -->
    <Style x:Key="SF.Style.VarRowToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>