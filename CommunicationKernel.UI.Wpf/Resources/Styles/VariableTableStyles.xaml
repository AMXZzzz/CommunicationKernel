<ResourceDictionary x:Class="CommunicationKernel.UI.Wpf.Resources.Styles.VariableTableStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SF.Style.VarHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
    </Style>

    <Style x:Key="SF.Style.VarFooterText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
    </Style>

    <Style x:Key="SF.Style.VarHintToggleBtn" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SF.Style.VarRowPresenter" TargetType="ContentPresenter">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="SF.Style.VarRowBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.RowHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SF.Style.VarTypeBadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataType}" Value="Bool">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Type.Bool.Bg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Int16">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Type.Int16.Bg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Int32">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Type.Int32.Bg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Float">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Type.Float.Bg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Double">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Type.Double.Bg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="String">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Type.String.Bg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SF.Style.VarTypeBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataType}" Value="Bool">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Type.Bool.Fg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Int16">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Type.Int16.Fg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Int32">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Type.Int32.Fg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Float">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Type.Float.Fg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="Double">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Type.Double.Fg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataType}" Value="String">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Type.String.Fg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SF.Style.VarAccessBadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Access.RW.Bg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AccessText}" Value="R">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Access.R.Bg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding AccessText}" Value="W">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Var.Access.W.Bg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SF.Style.VarAccessBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Access.RW.Fg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AccessText}" Value="R">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Access.R.Fg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding AccessText}" Value="W">
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.Access.W.Fg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
