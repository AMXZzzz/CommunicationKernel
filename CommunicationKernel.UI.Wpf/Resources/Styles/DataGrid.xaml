<!--
    文件: Resources/Styles/DataGrid.xaml
    层级: UI 层 — WPF 主题
    作用: 深色 DataGrid。用法 Style="{StaticResource SF.Style.DataGrid}"。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      深色 DataGrid
      使用方式：Style="{StaticResource SF.Style.DataGrid}"
      行/单元格/列头通过 DataGrid.*Style 挂到表格上，避免隐式全局污染。
    -->

    <!-- 列头 -->
    <Style x:Key="SF.Style.DataGrid.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 单元格：去掉系统蓝选中 -->
    <Style x:Key="SF.Style.DataGrid.Cell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 行 -->
    <Style x:Key="SF.Style.DataGrid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 表格整体 -->
    <Style x:Key="SF.Style.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SF.Brush.Bg.App}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource SF.Style.DataGrid.ColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource SF.Style.DataGrid.Cell}"/>
        <Setter Property="RowStyle" Value="{StaticResource SF.Style.DataGrid.Row}"/>
    </Style>

</ResourceDictionary>