<!--
    文件: Resources/Sizes.xaml
    层级: UI 层 — WPF 主题
    作用: 尺寸令牌（与色板分离）。旧 Key SF.ControlsSize.* 保留兼容。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      尺寸资源（与主题色分离，换主题一般不换尺寸）
      命名：SF.Size.<域>.<语义>  /  SF.FontSize.<语义>
      旧 Key（SF.ControlsSize.*）保留兼容，新代码优先用 SF.Size.*
    -->

    <!-- ==================== 主窗口 ==================== -->
    <sys:Double x:Key="SF.Size.MainWindow.Width">1280</sys:Double>
    <sys:Double x:Key="SF.Size.MainWindow.Height">900</sys:Double>
    <!-- 兼容旧 Key -->
    <sys:Double x:Key="SF.ControlsSize.MainWindowsWidth">1280</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.MainWindowsHeight">900</sys:Double>

    <!-- ==================== 导航 / 侧栏 ==================== -->
    <sys:Double x:Key="SF.Size.Nav.Expanded">120</sys:Double>
    <sys:Double x:Key="SF.Size.Nav.Collapsed">40</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.NavBarExpanded">120</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.NavBarCollapsed">40</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.SidebarExpanded">120</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.SidebarCollapsed">40</sys:Double>

    <!-- ==================== 通用按钮 ==================== -->
    <sys:Double x:Key="SF.Size.Button.Width">80</sys:Double>
    <sys:Double x:Key="SF.Size.Button.Height">32</sys:Double>
    <Thickness x:Key="SF.Size.Button.BorderThickness">0</Thickness>
    <sys:Double x:Key="SF.ControlsSize.ButtonWidth">80</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.ButtonHeight">32</sys:Double>
    <Thickness x:Key="SF.ControlsSize.ButtonBorderThickness">0</Thickness>

    <!-- ==================== 设备卡片 ==================== -->
    <sys:Double x:Key="SF.Size.DeviceCard.Width">320</sys:Double>
    <sys:Double x:Key="SF.Size.DeviceCard.Height">200</sys:Double>
    <sys:Double x:Key="SF.Size.DeviceCard.AccentBarWidth">4</sys:Double>
    <sys:Double x:Key="SF.Size.DeviceCard.AccentBarHeight">32</sys:Double>
    <sys:Double x:Key="SF.Size.DeviceCard.StatusLight">10</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.PLCBarWidth">320</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.PLCBarHeight">200</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.AccentBarWidth">4</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.AccentBarHeight">32</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.PlcStatusLightWidth">10</sys:Double>
    <sys:Double x:Key="SF.ControlsSize.PlcStatusLightHeight">10</sys:Double>

    <!-- ==================== 字号 ==================== -->
    <sys:Double x:Key="SF.FontSize.DeviceName">15</sys:Double>
    <sys:Double x:Key="SF.FontSize.PlcModel">12</sys:Double>
    <sys:Double x:Key="SF.FontSize.Details">12</sys:Double>
    <sys:Double x:Key="SF.FontSize.DeviceNameFontSize">15</sys:Double>
    <sys:Double x:Key="SF.FontSize.PlcModelNameFontSize">12</sys:Double>
    <sys:Double x:Key="SF.FontSize.DetailsPanelShowFontSize">12</sys:Double>

    <!-- ==================== 变量表列宽 / 控件 ==================== -->
    <sys:Double x:Key="SF.Size.Var.ColIndex">40</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColName">120</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColAddress">140</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColType">72</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColAccess">52</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColUnit">48</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColCategory">76</sys:Double>
    <sys:Double x:Key="SF.Size.Var.ColAction">64</sys:Double>

    <sys:Double x:Key="SF.Size.Var.WriteBoxWidth">90</sys:Double>
    <sys:Double x:Key="SF.Size.Var.WriteBoxHeight">26</sys:Double>
    <sys:Double x:Key="SF.Size.Var.RowIconSize">26</sys:Double>
    <sys:Double x:Key="SF.Size.Var.FilterTabFont">13</sys:Double>
    <sys:Double x:Key="SF.Size.Var.WriteBtnFont">11</sys:Double>

    <CornerRadius x:Key="SF.Size.Var.WriteBoxRadius">4</CornerRadius>
    <CornerRadius x:Key="SF.Size.Var.HintRadius">8</CornerRadius>
    <CornerRadius x:Key="SF.Size.Var.BadgeRadius">3</CornerRadius>
    <Thickness x:Key="SF.Size.Var.WriteBoxPadding">8,0,8,0</Thickness>
    <Thickness x:Key="SF.Size.Var.RowPadding">0,6,0,6</Thickness>

</ResourceDictionary>