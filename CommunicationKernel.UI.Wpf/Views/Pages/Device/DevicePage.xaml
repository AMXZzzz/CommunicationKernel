<Page x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Device.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:device="clr-namespace:CommunicationKernel.UI.Wpf.Views.Pages.Device"
      xmlns:models="clr-namespace:CommunicationKernel.UI.Wpf.Core.Models"
      xmlns:controls="clr-namespace:CommunicationKernel.UI.Wpf.Views.Controls"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="DevicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <device:DeviceToolBar x:Name="toolBar"
                              Grid.Row="0"
                              Margin="0,0,0,12"/>

        <!-- 设备列表 -->
        <ScrollViewer x:Name="deviceScroll"
                      Grid.Row="2"
                      Margin="16,0,16,16"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="deviceList"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Left"
                          Width="{Binding ViewportWidth, ElementName=deviceScroll}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type models:DeviceInfo}">
                        <device:DeviceCard Device="{Binding}"
                                          Margin="0,0,16,16"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type device:AddDeviceMarker}">
                        <device:AddDeviceCard Margin="0,0,16,16"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"/>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>

        <!-- 遮罩 + 编辑面板 / 主题消息框 -->
        <Border x:Name="editOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource SF.Brush.Overlay}"
                Visibility="Collapsed"
                MouseLeftButtonDown="EditOverlay_MouseLeftButtonDown">
            <Grid>
                <device:DeviceEditPanel x:Name="editPanel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       MouseLeftButtonDown="Panel_MouseLeftButtonDown"/>

                <controls:AppMessageDialog x:Name="msgDialog"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           MouseLeftButtonDown="Panel_MouseLeftButtonDown"/>
            </Grid>
        </Border>
    </Grid>
</Page>