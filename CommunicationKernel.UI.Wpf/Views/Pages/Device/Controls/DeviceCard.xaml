<!-- 自定义控件：PLC 设备卡片（对齐 plc_card_style.html） -->
<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Device.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource SF.ControlsSize.PLCBarWidth}"
             Height="{StaticResource SF.ControlsSize.PLCBarHeight}"
             Margin="0 0 16 16">

    <!-- ==================== 卡片外框 ==================== -->
    <Border BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Accent.Default}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel LastChildFill="True">

            <!-- ==================== 标题栏 ==================== -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SF.Brush.Bg.Hover}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="10 10 0 0"
                    Padding="16 14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：色条 + 名称 / 型号 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentBar"
                                Width="3"
                                Height="28"
                                CornerRadius="2"
                                Margin="0 0 10 0"
                                VerticalAlignment="Center"
                                Background="{StaticResource SF.Brush.Accent.Default}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="devicenName"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                            <TextBlock x:Name="plcModelName"
                                       Text="{Binding Model}"
                                       FontSize="11"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：状态灯（颜色仍由代码 ApplyStatusVisual 设置） -->
                    <Ellipse x:Name="plcStatusLight"
                             Grid.Column="1"
                             Width="10"
                             Height="10"
                             Fill="{StaticResource SF.Brush.Text.Secondary}"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ==================== 内容区 ==================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 信息行：左标签固定文案，右数据绑定 -->
                <StackPanel Grid.Row="0" Margin="16 14 16 0">

                    <!-- IP -->
                    <Grid Margin="0 0 0 10">
                        <TextBlock Text="IP 地址"
                                   FontSize="13"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="ipAddress"
                                   Text="{Binding Ip}"
                                   FontSize="13"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 协议 -->
                    <Grid Margin="0 0 0 10">
                        <TextBlock Text="协议"
                                   FontSize="13"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="protocolName"
                                   Text="{Binding Protocol}"
                                   FontSize="13"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 当前状态（文字绑定；颜色由代码改 Foreground） -->
                    <Grid>
                        <TextBlock Text="当前状态"
                                   FontSize="13"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="plcCurrentState"
                                   Text="{Binding StatusText}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- 底部按钮：Content/Style 由代码按状态切换 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 删除复选框 -->
                    <CheckBox x:Name="chkSelect"
                              Style="{StaticResource SF.Style.DarkCheckBox}"
                              Visibility="Collapsed"
                              VerticalAlignment="Center"
                              Margin="16 0 0 0"
                              Checked="ChkSelect_Changed"
                              Unchecked="ChkSelect_Changed"/>

                    <!-- 编辑按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnPrimary"
                                Content="连接"
                                Style="{StaticResource SF.Style.PrimaryButton}"/>
                        <Button x:Name="btnEdit"
                                Content="编辑"
                                Style="{StaticResource SF.Style.DarkButton}"/>
                 
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>