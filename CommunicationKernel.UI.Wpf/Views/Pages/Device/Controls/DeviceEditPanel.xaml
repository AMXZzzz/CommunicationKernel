<!--
  文件: DeviceEditPanel.xaml
  层级: UI 层 — WPF Views
  作用: 设备新增/编辑弹层：协议、TCP/串口参数、轨道类型。
-->
<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Device.DeviceEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="panelTranslate" X="0" Y="0"/>
        </Border.RenderTransform>
        <DockPanel>
            <!-- ==================== 标题栏整条可拖动 ==================== -->
            <Border x:Name="titleBar"
                    DockPanel.Dock="Top"
                    Background="{StaticResource SF.Brush.Bg.Hover}"
                    CornerRadius="10,10,0,0"
                    Padding="14,12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    LostMouseCapture="TitleBar_LostMouseCapture">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="3" Height="16"
                                Background="{StaticResource SF.Brush.Accent.Default}"
                                CornerRadius="1"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtTitle"
                                   Text="编辑设备"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    </StackPanel>
                    <!-- 关闭按钮单独接收点击，不参与拖动 -->
                    <Button Content="×"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="16"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- ==================== 底栏 ==================== -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SF.Brush.Bg.App}"
                    CornerRadius="0,0,10,10"
                    Padding="16,12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}">
                <Grid>
                    <Button x:Name="btnDelete"
                            Content="删除设备"
                            Style="{StaticResource SF.Style.DangerButton}"
                            Height="32"
                            HorizontalAlignment="Left"
                            Click="BtnDelete_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Style="{StaticResource SF.Style.DarkButton}"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="BtnClose_Click"/>
                        <Button x:Name="btnSave"
                                Content="保存"
                                Style="{StaticResource SF.Style.PrimaryButton}"
                                Height="32"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 表单 ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel>
                    <!-- 设备名称 -->
                    <TextBlock Margin="0,0,0,4">
                        <Run Text="设备名称"
                             Foreground="{StaticResource SF.Brush.Text.Secondary}"
                             FontSize="12"/>
                        <Run Text=" *"
                             Foreground="{StaticResource SF.Brush.Status.Error}"
                             FontSize="12"/>
                    </TextBlock>
                    <TextBox x:Name="txtName"
                             Style="{StaticResource SF.Style.DialogTextBox}"/>

                    <!-- 品牌/型号 -->
                    <TextBlock Text="品牌 / 型号"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="txtModel"
                             Style="{StaticResource SF.Style.DialogTextBox}"/>

                    <!-- 协议 -->
                    <TextBlock Margin="0,12,0,4">
                        <Run Text="协议"
                             Foreground="{StaticResource SF.Brush.Text.Secondary}"
                             FontSize="12"/>
                        <Run Text=" *"
                             Foreground="{StaticResource SF.Brush.Status.Error}"
                             FontSize="12"/>
                    </TextBlock>
                    <ComboBox x:Name="cmbProtocol"
                              Style="{StaticResource SF.Style.ComboBox}"
                              SelectionChanged="CmbProtocol_SelectionChanged"/>
                    <!-- 说明所选协议决定了下方出现哪些连接参数，
                         避免"切换协议后字段变了"显得突兀 -->
                    <TextBlock x:Name="txtTransportHint"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               Text=""/>

                    <!-- 连接方式：仅当所选协议支持多种介质时出现。
                         典型场景是 Modbus RTU —— 既可直连 RS-485，
                         也可经 TCP 转串口透传装置走以太网。 -->
                    <StackPanel x:Name="panelTransport" Visibility="Collapsed">
                        <TextBlock Margin="0,12,0,4">
                            <Run Text="连接方式"
                                 Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                 FontSize="12"/>
                            <Run Text=" *"
                                 Foreground="{StaticResource SF.Brush.Status.Error}"
                                 FontSize="12"/>
                        </TextBlock>
                        <ComboBox x:Name="cmbTransport"
                                  Style="{StaticResource SF.Style.ComboBox}"
                                  SelectionChanged="CmbTransport_SelectionChanged"/>
                    </StackPanel>

                    <!-- TCP 连接参数：IP + 端口。由所选协议的 TransportKind 决定是否显示 -->
                    <StackPanel x:Name="panelTcp">
                        <TextBlock Margin="0,12,0,4">
                            <Run Text="IP 地址"
                                 Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                 FontSize="12"/>
                            <Run Text=" *"
                                 Foreground="{StaticResource SF.Brush.Status.Error}"
                                 FontSize="12"/>
                        </TextBlock>
                        <TextBox x:Name="txtIp"
                                 Style="{StaticResource SF.Style.DialogTextBox}"
                                 FontFamily="Consolas"/>

                        <TextBlock Margin="0,12,0,4">
                            <Run Text="端口"
                                 Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                 FontSize="12"/>
                            <Run Text=" *"
                                 Foreground="{StaticResource SF.Brush.Status.Error}"
                                 FontSize="12"/>
                        </TextBlock>
                        <TextBox x:Name="txtPort"
                                 Style="{StaticResource SF.Style.DialogTextBox}"
                                 FontFamily="Consolas"/>
                    </StackPanel>

                    <!-- 串口连接参数：串口号 + 波特率。仅串口类协议显示 -->
                    <StackPanel x:Name="panelSerial" Visibility="Collapsed">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="串口号"
                                         Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                         FontSize="12"/>
                                    <Run Text=" *"
                                         Foreground="{StaticResource SF.Brush.Status.Error}"
                                         FontSize="12"/>
                                </TextBlock>
                                <!-- IsEditable：清单来自宿主机器，但仍允许手工输入。
                                     宿主尚未连上、或设备是热插拔上来的时候，
                                     清单可能是空的或过时的，不能因此堵死配置。 -->
                                <ComboBox x:Name="cmbSerialPort"
                                          IsEditable="True"
                                          FontFamily="Consolas"
                                          SelectionChanged="OnSerialPortSelected"
                                          ToolTip="下拉项来自 EngineHost.App 所在机器（Windows 形如 COM3，树莓派形如 /dev/ttyUSB0）；也可直接输入"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="波特率"
                                         Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                         FontSize="12"/>
                                    <Run Text=" *"
                                         Foreground="{StaticResource SF.Brush.Status.Error}"
                                         FontSize="12"/>
                                </TextBlock>
                                <TextBox x:Name="txtBaudRate"
                                         Style="{StaticResource SF.Style.DialogTextBox}"
                                         FontFamily="Consolas"
                                         ToolTip="例如 9600 / 19200 / 115200"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 站号：仅需要站号的协议显示；提示文案来自协议描述符 -->
                    <StackPanel x:Name="panelStation" Margin="0,12,0,0">
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="站号"
                                 Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                 FontSize="12"/>
                            <Run x:Name="runStationHint"
                                 Text=""
                                 Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                 FontSize="11"/>
                        </TextBlock>
                        <TextBox x:Name="txtStationNo"
                                 Style="{StaticResource SF.Style.DialogTextBox}"
                                 FontFamily="Consolas"/>
                        <TextBlock Text="作为本设备所有变量的默认站号"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    </StackPanel>

                    <!-- 该协议不需要站号时的说明。
                         字段无声消失会被误解为功能缺失，因此用一行说明替代空白。 -->
                    <TextBlock x:Name="txtStationNotApplicable"
                               Visibility="Collapsed"
                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               Text="该协议无需站号：机架/槽位已固定在协议内部，变量地址直接填写即可。"/>

                    <!-- 轨道类型 -->
                    <TextBlock Text="轨道类型"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnLaneSingle"
                                Grid.Column="0"
                                Content="单轨"
                                Height="32"
                                Margin="0"
                                Click="BtnLaneSingle_Click"
                                Style="{StaticResource SF.Style.DarkButton}"/>
                        <Button x:Name="btnLaneDual"
                                Grid.Column="2"
                                Content="双轨"
                                Height="32"
                                Margin="0"
                                Click="BtnLaneDual_Click"
                                Style="{StaticResource SF.Style.PrimaryButton}"/>
                    </Grid>

                    <!-- 当前状态（只读） -->
                    <TextBlock Text="当前状态"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               Margin="0,14,0,6"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="statusDot"
                                     Width="8" Height="8"
                                     Fill="{StaticResource SF.Brush.Status.Success}"
                                     Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtStatus"
                                       Text="RUN"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SF.Brush.Status.Success}"/>
                        </StackPanel>
                        <TextBlock Text="只读 · 连接后更新"
                                   FontSize="11"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>