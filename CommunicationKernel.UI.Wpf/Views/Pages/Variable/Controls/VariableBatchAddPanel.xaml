<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Variable.Controls.VariableBatchAddPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900"
             MaxHeight="560">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <DockPanel>
            <!-- ==================== 标题 ==================== -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SF.Brush.Bg.Hover}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="16"
                                CornerRadius="2"
                                Margin="0,0,8,0"
                                Background="{StaticResource SF.Brush.Accent.Default}"/>
                        <TextBlock Text="批量添加变量"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                        <TextBlock x:Name="txtSub"
                                   Margin="10,0,0,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    </StackPanel>
                    <Button Content="×"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="16"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- ==================== 底栏 ==================== -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SF.Brush.Bg.App}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12"
                    CornerRadius="0,0,10,10">
                <Grid>
                    <TextBlock x:Name="txtCount"
                               Text="当前 0 行"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Style="{StaticResource SF.Style.DarkButton}"
                                Click="BtnClose_Click"/>
                        <Button Content="全部添加"
                                Style="{StaticResource SF.Style.PrimaryButton}"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 表体 ==================== -->
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <Button Content="+ 再加一行"
                            Style="{StaticResource SF.Style.DarkButton}"
                            Click="BtnAddOne_Click"/>
                    <Button Content="+ 再加 5 行"
                            Style="{StaticResource SF.Style.DarkButton}"
                            Click="BtnAddFive_Click"/>
                    <TextBlock Text="也可从 Excel 粘贴多行后导入（后续）"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="listRows">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <StackPanel>
                                    <!-- 表头 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="1" Text="显示名称" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="2" Text="地址" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="3" Text="类型" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="4" Text="读写" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="5" Text="单位" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="6" Text="分类" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="7" Text="用途说明" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                    </Grid>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Index}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,4,0"
                                             Height="32"
                                             Style="{StaticResource SF.Style.DialogTextBox}"/>

                                    <TextBox Grid.Column="2"
                                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"
                                             Margin="0,0,4,0"
                                             Height="32"
                                             Style="{StaticResource SF.Style.DialogTextBox}"/>

                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding DataTypeOptions}"
                                              SelectedItem="{Binding DataType}"
                                              Margin="0,0,4,0"
                                              Height="32"
                                              Style="{StaticResource SF.Style.ComboBox}"/>

                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding AccessOptions}"
                                              SelectedItem="{Binding AccessText}"
                                              Margin="0,0,4,0"
                                              Height="32"
                                              Style="{StaticResource SF.Style.ComboBox}"/>

                                    <TextBox Grid.Column="5"
                                             Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,4,0"
                                             Height="32"
                                             Style="{StaticResource SF.Style.DialogTextBox}"/>

                                    <ComboBox Grid.Column="6"
                                              ItemsSource="{Binding CategoryOptions}"
                                              SelectedItem="{Binding Category}"
                                              Margin="0,0,4,0"
                                              Height="32"
                                              Style="{StaticResource SF.Style.ComboBox}"/>

                                    <TextBox Grid.Column="7"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,4,0"
                                             Height="32"
                                             Style="{StaticResource SF.Style.DialogTextBox}"/>

                                    <Button Grid.Column="8"
                                            Content="×"
                                            Width="28" Height="28"
                                            Tag="{Binding}"
                                            Click="BtnRemoveRow_Click"
                                            Background="{StaticResource SF.Brush.Bg.Hover}"
                                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                            BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                            BorderThickness="1"
                                            Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>