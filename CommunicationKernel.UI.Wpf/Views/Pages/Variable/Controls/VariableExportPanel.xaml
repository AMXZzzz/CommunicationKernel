<!--
  文件: VariableExportPanel.xaml
  层级: UI 层 — WPF Views
  作用: 导出变量弹层：范围、字段勾选、JSON 文件名。
-->
<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Variable.Controls.VariableExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">

    

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <DockPanel>
            <!-- 标题 -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SF.Brush.Bg.Hover}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                Background="{StaticResource SF.Brush.Accent.Default}"/>
                        <TextBlock Text="导出变量"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    </StackPanel>
                    <Button Content="×" Width="28" Height="28"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FontSize="16"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 底栏 -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SF.Brush.Bg.App}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource SF.Style.DarkButton}"
                            Click="BtnClose_Click"/>
                    <Button Content="导出"
                            Style="{StaticResource SF.Style.PrimaryButton}"
                            Click="BtnExport_Click"/>
                </StackPanel>
            </Border>

            <!-- 表单 -->
            <StackPanel Margin="20,18">
                <TextBlock Text="导出范围" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Button x:Name="btnScopeCurrent" Content="当前设备"
                            Height="36" Margin="0,0,6,0"
                            Click="BtnScope_Click" Tag="Current"/>
                    <Button x:Name="btnScopeAll" Content="全部设备"
                            Height="36"
                            Click="BtnScope_Click" Tag="All"/>
                </UniformGrid>
                <TextBlock x:Name="txtScopeHint" FontSize="11" Margin="0,0,0,16"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                <TextBlock Text="导出格式" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Button Content="CSV" Height="36" Margin="0,0,6,0"
                            IsEnabled="False" Style="{StaticResource SF.Style.DarkButton}"
                            ToolTip="后续开放"/>
                    <Button Content="Excel" Height="36" Margin="0,0,6,0"
                            IsEnabled="False" Style="{StaticResource SF.Style.DarkButton}"
                            ToolTip="后续开放"/>
                    <Button x:Name="btnFmtJson" Content="JSON" Height="36"
                            Click="BtnFormat_Click" Tag="Json"/>
                </UniformGrid>

                <TextBlock Text="包含字段" FontSize="12" Margin="0,0,0,10"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <WrapPanel Margin="0,0,0,16">
                    <CheckBox x:Name="chkName" Content="显示名称" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                    <CheckBox x:Name="chkAddress" Content="地址" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                    <CheckBox x:Name="chkType" Content="类型" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                    <CheckBox x:Name="chkAccess" Content="读写" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                    <CheckBox x:Name="chkUnit" Content="单位" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                    <CheckBox x:Name="chkCategory" Content="分类" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                    <CheckBox x:Name="chkDesc" Content="用途说明" IsChecked="True"
                              Style="{StaticResource SF.Style.DarkCheckBox}"/>
                </WrapPanel>

                <TextBlock Text="文件名" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBox x:Name="txtFileName"
                         Style="{StaticResource SF.Style.DialogTextBox}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>