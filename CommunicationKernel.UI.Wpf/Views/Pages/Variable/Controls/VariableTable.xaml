<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Variable.Controls.VariableTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}">

    <DockPanel>
        <!-- 筛选 -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
                BorderThickness="0,0,0,1"
                Background="{StaticResource SF.Brush.Var.HeaderBg}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="tabAll" Content="全部 (0)" IsChecked="True"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="All"/>
                <RadioButton x:Name="tabRead" Content="只读 (0)"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="Read"/>
                <RadioButton x:Name="tabWrite" Content="可写 (0)"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="Write"/>
                <RadioButton x:Name="tabStatus" Content="状态点 (0)"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="状态点"/>
                <RadioButton x:Name="tabData" Content="监控数据 (0)"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="监控数据"/>
            </StackPanel>
        </Border>

        <!-- 底栏 -->
        <Border DockPanel.Dock="Bottom" CornerRadius="8"
                Background="{StaticResource SF.Brush.Var.HeaderBg}"
                BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtFtAll" Text="共 0 个变量"
                               Style="{StaticResource SF.Style.VarFooterText}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtFtRead" Text="只读 0"
                               Style="{StaticResource SF.Style.VarFooterText}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtFtWrite" Text="可写 0"
                               Style="{StaticResource SF.Style.VarFooterText}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtFtLive" Text=""
                               Style="{StaticResource SF.Style.VarFooterText}"/>
                </StackPanel>
                <Button x:Name="btnHint" Content="^"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SF.Style.VarHintToggleBtn}"
                        Click="BtnHint_Click" ToolTip="读写说明"/>
            </Grid>
        </Border>

        <!-- 说明 -->
        <Border x:Name="hintBar" DockPanel.Dock="Bottom" CornerRadius="8"
                Visibility="Collapsed"
                Background="{StaticResource SF.Brush.Var.HintBg}"
                BorderBrush="{StaticResource SF.Brush.Var.HintBorder}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock FontSize="12" LineHeight="22" TextWrapping="Wrap"
                       Foreground="{StaticResource SF.Brush.Text.Secondary}">
                <Run Text="· "/><Run Text="R" FontWeight="SemiBold"
                                      Foreground="{StaticResource SF.Brush.Var.Addr}"/>
                <Run Text=" 只读 — 仅实时显示，供 MES 监控使用"/><LineBreak/>
                <Run Text="· "/><Run Text="W" FontWeight="SemiBold"
                                      Foreground="{StaticResource SF.Brush.Var.Addr}"/>
                <Run Text=" 只写 — 可下发到 PLC"/><LineBreak/>
                <Run Text="· "/><Run Text="R/W" FontWeight="SemiBold"
                                      Foreground="{StaticResource SF.Brush.Var.Addr}"/>
                <Run Text=" 读写 — 既显示当前值，也可修改后写入"/><LineBreak/>
                <Run Text="· 可写变量在「实时值」列可直接改数，点「写入」下发到 PLC"/>
            </TextBlock>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0"
                      Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel>
                <!-- 表头 -->
                <Border Margin="0,0,0,8" Padding="10,8"
                        Background="{StaticResource SF.Brush.Var.HeaderBg}"
                        BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="显示名称" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="地址" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="类型" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="读写" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="实时值" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="6" Text="写入" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="7" Text="单位" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="8" Text="分类" Style="{StaticResource SF.Style.VarHeaderText}"/>
                        <TextBlock Grid.Column="9" Text="操作" Style="{StaticResource SF.Style.VarHeaderText}"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="listRows" Focusable="False" FocusVisualStyle="{x:Null}"
                              ItemContainerStyle="{StaticResource SF.Style.VarRowPresenter}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
                                    BorderThickness="0,0,0,1" Padding="10,6"
                                    ToolTipService.InitialShowDelay="600"
                                    ToolTipService.ShowDuration="20000"
                                    ToolTipService.BetweenShowDelay="200">
                                <Border.Style>
                                    <StaticResource ResourceKey="SF.Style.VarRowBorder"/>
                                </Border.Style>
                                <Border.ToolTip>
                                    <ToolTip Style="{StaticResource SF.Style.VarRowToolTip}"
                                             Visibility="{Binding DescToolTipVisibility}">
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="用途说明" FontSize="11" Margin="0,0,0,4"
                                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Index}" VerticalAlignment="Center"
                                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Address}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SF.Brush.Var.Addr}"/>

                                    <!-- 类型徽章：纯 XAML DataTrigger -->
                                    <Border Grid.Column="3" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <StaticResource ResourceKey="SF.Style.VarTypeBadgeBorder"/>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DataType}" FontSize="11"
                                                   Style="{StaticResource SF.Style.VarTypeBadgeText}"/>
                                    </Border>

                                    <!-- 读写徽章 -->
                                    <Border Grid.Column="4" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <StaticResource ResourceKey="SF.Style.VarAccessBadgeBorder"/>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AccessText}" FontSize="10" FontWeight="SemiBold"
                                                   Style="{StaticResource SF.Style.VarAccessBadgeText}"/>
                                    </Border>

                                    <!-- 实时值（始终显示） -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding ValueText}"
                                               FontFamily="Consolas" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>

                                    <!-- 写入（独立列，仅可写变量显示） -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding WriteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" Height="26"
                                                 Visibility="{Binding WriteEditorVisibility}"
                                                 Style="{StaticResource SF.Style.DialogTextBox}"
                                                 Tag="{Binding Id}"
                                                 PreviewKeyDown="WriteTextBox_PreviewKeyDown"/>
                                        <Button Content="写入"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource SF.Style.VarWriteBtn}"
                                                Visibility="{Binding WriteEditorVisibility}"
                                                Tag="{Binding Id}" Click="BtnWrite_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="7" Text="{Binding UnitText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                                    <!-- 分类徽章 -->
                                    <Border Grid.Column="8" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{StaticResource SF.Brush.Var.Category.Bg}">
                                        <TextBlock Text="{Binding Category}" FontSize="11"
                                                   Foreground="{StaticResource SF.Brush.Var.Category.Fg}"/>
                                    </Border>

                                    <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✎" Style="{StaticResource SF.Style.VarRowIcon}"
                                                Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="编辑"/>
                                        <Button Content="×" Style="{StaticResource SF.Style.VarRowIcon}"
                                                Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="删除"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="txtEmpty" Text="该设备暂无变量" Visibility="Collapsed"
                           Margin="0,24,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>