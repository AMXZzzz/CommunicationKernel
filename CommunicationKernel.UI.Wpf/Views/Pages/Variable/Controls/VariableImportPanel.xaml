<!--
  文件: VariableImportPanel.xaml
  层级: UI 层 — WPF Views
  作用: 导入变量弹层：文件选择、范围、预览与清空确认。
-->
<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Variable.Controls.VariableImportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <DockPanel>
            <!-- 标题 -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SF.Brush.Bg.Hover}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                Background="{StaticResource SF.Brush.Accent.Default}"/>
                        <TextBlock Text="导入变量" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    </StackPanel>
                    <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="16"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 底栏 -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SF.Brush.Bg.App}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SF.Style.DarkButton}"
                            Click="BtnClose_Click"/>
                    <Button x:Name="btnImport" Content="开始导入"
                            Style="{StaticResource SF.Style.PrimaryButton}"
                            IsEnabled="False"
                            Click="BtnImport_Click"/>
                </StackPanel>
            </Border>

            <!-- 表单 -->
            <StackPanel Margin="20,18">
                <TextBlock Text="导入目标" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <Button x:Name="btnScopeCurrent" Content="当前设备" Height="36" Margin="0,0,4,0"
                            Click="BtnScope_Click" Tag="Current"/>
                    <Button x:Name="btnScopeAll" Content="全部设备" Height="36"
                            Click="BtnScope_Click" Tag="All"/>
                </UniformGrid>
                <TextBlock x:Name="txtScopeHint" FontSize="11" Margin="0,0,0,14"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                <TextBlock Text="文件格式" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="CSV / Excel" Height="36" Margin="0,0,4,0" IsEnabled="False"
                            Style="{StaticResource SF.Style.DarkButton}" ToolTip="后续开放"/>
                    <Button x:Name="btnFmtJson" Content="JSON" Height="36"
                            Style="{StaticResource SF.Style.PrimaryButton}"/>
                </UniformGrid>

                <TextBlock Text="选择文件" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <Border BorderBrush="{StaticResource SF.Brush.Border.Default}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="20,24"
                        Background="{StaticResource SF.Brush.Bg.App}"
                        Cursor="Hand"
                        MouseLeftButtonUp="DropZone_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock Text="点击选择文件" FontSize="13" Margin="0,8,0,4"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock Text="一期支持 .json" FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="txtFileName" Text="未选择文件" FontSize="12" Margin="0,10,0,0"
                                   FontFamily="Consolas" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SF.Brush.Accent.Default}"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="chkClear" Content="导入前清空目标范围内已有变量"
                          IsChecked="False" Margin="0,14,0,14"
                          Style="{StaticResource SF.Style.DarkCheckBox}"
                          Foreground="{StaticResource SF.Brush.Text.Primary}"/>

                <TextBlock Text="预检结果" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <Border Background="{StaticResource SF.Brush.Bg.App}"
                        BorderBrush="{StaticResource SF.Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,12"
                        MinHeight="56">
                    <TextBlock x:Name="txtPreview" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               Text="请先选择 JSON 文件"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>