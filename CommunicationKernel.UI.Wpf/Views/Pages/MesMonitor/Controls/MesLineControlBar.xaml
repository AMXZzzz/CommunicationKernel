<!--
  文件: MesLineControlBar.xaml
  层级: UI 层 — WPF Views
  作用: 整线控制栏：状态、启停复位、报警摘要入口。
-->
<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.MesMonitor.Controls.MesLineControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 整线控制栏 -->
    <Border Background="{StaticResource SF.Brush.Bg.Surface}" 
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16 10"
            Margin="0 0 0 12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 整线状态 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="0 0 16 0">
                <TextBlock Text="整线状态: "
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           VerticalAlignment="Center" Margin="0 0 16 0"/>
                <Border Background="{StaticResource SF.Brush.Mes.AlarmBg}" 
                        BorderBrush="{StaticResource SF.Brush.Mes.AlarmBorder}" 
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12 3">

                        <TextBlock Text="报警中"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        
                </Border>
            </StackPanel>
            
            <!-- 启动,停止,复位 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 8 0">
                <Button Content="▶ 启动" Style="{StaticResource SF.Style.PrimaryButton}" />
                <Button Content="■ 停止" Style="{StaticResource SF.Style.DangerButton}" />
                <Button Content="↺ 复位" Style="{StaticResource SF.Style.DangerButton}" />
            </StackPanel>
            
            <!-- 报警摘要 -->
            <Border Grid.Column="2"
                    Background="{StaticResource SF.Brush.Bg.App}"
                    BorderBrush="{StaticResource SF.Brush.Mes.AlarmBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 6"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MouseLeftButtonUp="AlarmPanel_Click">

                <StackPanel Orientation="Horizontal">
                    <!-- 报警叹号 -->
                    <Border Width="24" Height="24" 
                            Background="{StaticResource SF.Brush.Mes.AlarmBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.AlarmBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0 0 10 0"
                            MouseLeftButtonUp="AlarmPanel_Click">
                        <TextBlock Text="!"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 报警信息 -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AOI NG报警 · 待确认"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="1 条活动报警"
                                   FontSize="11"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
