<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.MesMonitor.Controls.MesFlowTrack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14 12"
            Margin="0 0 0 12">
        <StackPanel>
            <!-- 标题行 -->
            <Grid Margin="0 0 0 12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SMT 联机线体"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource SF.Brush.Bg.Hover}"
                            CornerRadius="4"
                            Padding="8 2"
                            Margin="10 0 0 0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}">
                            <Run Text="设备来自 "/>
                            <Run Text="设备管理"
                                 Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                            <Run Text=" · 7台"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="切换产线"
                            Style="{StaticResource SF.Style.DarkButton}"
                            Margin="0 0 6 0"/>
                    <Button Content="编辑布局"
                            Style="{StaticResource SF.Style.DarkButton}"/>
                </StackPanel>
            </Grid>

            <!-- 流程节点 -->
            <!-- 流程节点 + 连接线 -->
            <Grid Height="110">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 底层：连接线（在节点中线高度） ===== -->
                <!-- 上板机 → 印刷机 · 绿 -->
                <Border Grid.Column="0" Grid.ColumnSpan="2"
            Height="2" VerticalAlignment="Center"
            Margin="40 0"
            Background="{StaticResource SF.Brush.Status.Success}"/>
                <!-- 印刷机 → SPI · 绿 -->
                <Border Grid.Column="1" Grid.ColumnSpan="2"
            Height="2" VerticalAlignment="Center"
            Margin="40 0"
            Background="{StaticResource SF.Brush.Status.Success}"/>
                <!-- SPI → 贴片机 · 绿 -->
                <Border Grid.Column="2" Grid.ColumnSpan="2"
            Height="2" VerticalAlignment="Center"
            Margin="40 0"
            Background="{StaticResource SF.Brush.Status.Success}"/>
                <!-- 贴片机 → 回流焊 · 绿 -->
                <Border Grid.Column="3" Grid.ColumnSpan="2"
            Height="2" VerticalAlignment="Center"
            Margin="40 0"
            Background="{StaticResource SF.Brush.Status.Success}"/>
                <!-- 回流焊 → AOI · 绿 -->
                <Border Grid.Column="4" Grid.ColumnSpan="2"
            Height="2" VerticalAlignment="Center"
            Margin="40 0"
            Background="{StaticResource SF.Brush.Status.Error}"/>
                <!-- AOI → 下板机 · 灰（离线） -->
                <Border Grid.Column="5" Grid.ColumnSpan="2"
        Height="2" VerticalAlignment="Center"
        Margin="40 0"
        Background="{StaticResource SF.Brush.Border.Default}"/>

                <!-- ===== 上层：7 个节点 ===== -->
                <!-- 上板机 -->
                <Border Grid.Column="0" Margin="6 0"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Status.Success}"
            BorderThickness="1" CornerRadius="7" Padding="8 8"
            VerticalAlignment="Center" Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Status.Success}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="上板机" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagSingleBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="单轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.TagSingleFg}"/>
                            </Border>
                            <TextBlock Text="RUN" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Status.Success}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="250.0" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 印刷机 -->
                <Border Grid.Column="1" Margin="6 0"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Status.Success}"
            BorderThickness="1" CornerRadius="7" Padding="8 8"
            VerticalAlignment="Center" Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Status.Success}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="印刷机" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="双轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                            </Border>
                            <TextBlock Text="RUN" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Status.Success}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="250/250" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SPI -->
                <Border Grid.Column="2" Margin="6 0"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Status.Success}"
            BorderThickness="1" CornerRadius="7" Padding="8 8"
            VerticalAlignment="Center" Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Status.Success}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SPI" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="双轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                            </Border>
                            <TextBlock Text="RUN" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Status.Success}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="250/250" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 贴片机 -->
                <Border Grid.Column="3" Margin="6 0"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Status.Success}"
            BorderThickness="1" CornerRadius="7" Padding="8 8"
            VerticalAlignment="Center" Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Status.Success}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="贴片机" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="双轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                            </Border>
                            <TextBlock Text="RUN" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Status.Success}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="268/265" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Mes.WidthAdjusting}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 回流焊 -->
                <Border Grid.Column="4" Margin="6 0"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Status.Success}"
            BorderThickness="1" CornerRadius="7" Padding="8 8"
            VerticalAlignment="Center" Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Status.Success}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="回流焊" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagSingleBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="单轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.TagSingleFg}"/>
                            </Border>
                            <TextBlock Text="RUN" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Status.Success}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="250.0" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AOI -->
                <Border Grid.Column="5" Margin="6 0"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Status.Error}"
            BorderThickness="1" CornerRadius="7" Padding="8 8"
            VerticalAlignment="Center" Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Status.Error}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AOI" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="双轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                            </Border>
                            <TextBlock Text="ALARM" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Status.Error}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="超时" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Status.Error}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 下板机 -->
                <Border Grid.Column="6" Margin="6 0"
        Background="{StaticResource SF.Brush.Bg.Surface}"
        BorderBrush="{StaticResource SF.Brush.Border.Default}"
        BorderThickness="1"
        CornerRadius="7"
        Padding="8 8"
        VerticalAlignment="Center"
        Cursor="Hand">
                    <Grid>
                        <Ellipse Width="7" Height="7"
                     Fill="{StaticResource SF.Brush.Text.Secondary}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="下板机" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"
                           HorizontalAlignment="Center"/>
                            <Border Background="{StaticResource SF.Brush.Mes.TagSingleBg}"
                        CornerRadius="2" Padding="5 0" Margin="0 3 0 3"
                        HorizontalAlignment="Center">
                                <TextBlock Text="单轨" FontSize="9"
                               Foreground="{StaticResource SF.Brush.Mes.TagSingleFg}"/>
                            </Border>
                            <TextBlock Text="离线" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="—" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>