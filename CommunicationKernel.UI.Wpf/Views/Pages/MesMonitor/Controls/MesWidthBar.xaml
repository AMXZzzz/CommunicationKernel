<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.MesMonitor.Controls.MesWidthBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource SF.Brush.Mes.WidthBarBg}"
            BorderBrush="{StaticResource SF.Brush.Mes.WidthBarBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14 10"
            Margin="0 0 0 12">
        <StackPanel>
            <!-- 第一行：标题 + 模式 + 输入 + 下发 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0 0 14 0">
                    <Border Width="24" Height="24"
                            Background="{StaticResource SF.Brush.Mes.WidthIconBg}"
                            CornerRadius="5"
                            Margin="0 0 6 0">
                        <TextBlock Text="↔"
                                   FontSize="13"
                                   Foreground="{StaticResource SF.Brush.Text.OnAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PCB轨道宽度"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 模式切换 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0 0 14 0">
                    <Border Background="{StaticResource SF.Brush.Mes.ModeOnBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.ModeOnBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="11 3"
                            Margin="0 0 3 0"
                            Cursor="Hand">
                        <TextBlock Text="同步双轨"
                                   FontSize="12"
                                   Foreground="{StaticResource SF.Brush.Text.OnAccent}"/>
                    </Border>
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthInputBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="11 3"
                            Margin="0 0 3 0"
                            Cursor="Hand">
                        <TextBlock Text="仅轨道1"
                                   FontSize="12"
                                   Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                    </Border>
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthInputBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="11 3"
                            Cursor="Hand">
                        <TextBlock Text="仅轨道2"
                                   FontSize="12"
                                   Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                    </Border>
                </StackPanel>

                <!-- T1 / T2 输入 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="T1"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"
                               VerticalAlignment="Center"
                               Margin="0 0 5 0"/>
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthInputBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Width="68" Height="26"
                            Margin="0 0 5 0">
                        <TextBox Text="280.0"
                                 Background="Transparent"
                                 Foreground="{StaticResource SF.Brush.Mes.WidthValue}"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontFamily="Consolas"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"
                                 CaretBrush="{StaticResource SF.Brush.Mes.WidthValue}"/>
                    </Border>
                    <TextBlock Text="mm"
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"
                               VerticalAlignment="Center"
                               Margin="0 0 14 0"/>

                    <TextBlock Text="T2"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"
                               VerticalAlignment="Center"
                               Margin="0 0 5 0"/>
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthInputBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Width="68" Height="26"
                            Margin="0 0 5 0">
                        <TextBox Text="280.0"
                                 Background="Transparent"
                                 Foreground="{StaticResource SF.Brush.Mes.WidthValue}"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontFamily="Consolas"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"
                                 CaretBrush="{StaticResource SF.Brush.Mes.WidthValue}"/>
                    </Border>
                    <TextBlock Text="mm"
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 一键下发 -->
                <Button Grid.Column="3"
                        Content="一键下发"
                        Style="{StaticResource SF.Style.PrimaryButton}"
                        VerticalAlignment="Center"
                        Margin="13 0 0 0"/>
            </Grid>

            <!-- 分隔线 -->
            <Border Height="1"
                    Background="{StaticResource SF.Brush.Mes.WidthBarBorder}"
                    Margin="0 10 0 0"/>

            <!-- 各工位实时宽度 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                           Style="{StaticResource SF.Style.ScrollViewer.HorizontalBar}"
                          Margin="0 10 0 0">
                <StackPanel Orientation="Horizontal">
                    <!-- 上板机 -->
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthBarBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10 6"
                            Margin="0 0 8 0"
                            MinWidth="100">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 3">
                                <TextBlock Text="上板机" FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                                <Border Background="{StaticResource SF.Brush.Mes.TagSingleBg}"
                                        CornerRadius="2" Padding="4 0" Margin="4 0 0 0">
                                    <TextBlock Text="单" FontSize="9"
                                               Foreground="{StaticResource SF.Brush.Mes.TagSingleFg}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="250.0" FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SF.Brush.Mes.WidthValue}"/>
                        </StackPanel>
                    </Border>

                    <!-- 印刷机 -->
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthBarBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10 6"
                            Margin="0 0 8 0"
                            MinWidth="100">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 3">
                                <TextBlock Text="印刷机" FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                                <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                                        CornerRadius="2" Padding="4 0" Margin="4 0 0 0">
                                    <TextBlock Text="双" FontSize="9"
                                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="T1 " FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"/>
                                <TextBlock Text="250.0" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" Margin="0 0 8 0"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthValue}"/>
                                <TextBlock Text="T2 " FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"/>
                                <TextBlock Text="250.0" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 贴片机 · 调整中 -->
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthBarBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10 6"
                            Margin="0 0 8 0"
                            MinWidth="100">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 3">
                                <TextBlock Text="贴片机" FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                                <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                                        CornerRadius="2" Padding="4 0" Margin="4 0 0 0">
                                    <TextBlock Text="双" FontSize="9"
                                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="T1 " FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"/>
                                <TextBlock Text="268.4" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" Margin="0 0 8 0"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthAdjusting}"/>
                                <TextBlock Text="T2 " FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"/>
                                <TextBlock Text="265.1" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthAdjusting}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AOI · 错误 -->
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.AlarmBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10 6"
                            Margin="0 0 8 0"
                            MinWidth="100">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 3">
                                <TextBlock Text="AOI" FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                                <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                                        CornerRadius="2" Padding="4 0" Margin="4 0 0 0">
                                    <TextBlock Text="双" FontSize="9"
                                               Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="T1 " FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"/>
                                <TextBlock Text="—" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" Margin="0 0 8 0"
                                           Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"/>
                                <TextBlock Text="T2 " FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.WidthMuted}"/>
                                <TextBlock Text="—" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 下板机 · 离线 -->
                    <Border Background="{StaticResource SF.Brush.Mes.WidthInputBg}"
                            BorderBrush="{StaticResource SF.Brush.Mes.WidthBarBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10 6"
                            Opacity="0.45"
                            MinWidth="100">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 3">
                                <TextBlock Text="下板机" FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Mes.ModeOffFg}"/>
                                <Border Background="{StaticResource SF.Brush.Mes.TagSingleBg}"
                                        CornerRadius="2" Padding="4 0" Margin="4 0 0 0">
                                    <TextBlock Text="单" FontSize="9"
                                               Foreground="{StaticResource SF.Brush.Mes.TagSingleFg}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="—" FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SF.Brush.Mes.WidthValue}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>