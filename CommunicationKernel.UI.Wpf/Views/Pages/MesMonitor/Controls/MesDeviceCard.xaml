<!--
  文件: MesDeviceCard.xaml
  层级: UI 层 — WPF Views
  作用: MES 设备状态卡片：名称、轨道、状态徽章、监控数据。
-->
<UserControl x:Class="CommunicationKernel.UI.Wpf.Views.Pages.MesMonitor.Controls.MesDeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0 0 10 10">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="7">
        <StackPanel>
            <!-- 头部 -->
            <Border Background="{StaticResource SF.Brush.Bg.Hover}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0 0 0 1"
                    Padding="12 9">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BrandBar"
                                Width="3" Height="22"
                                Background="{StaticResource SF.Brush.Accent.Default}"
                                CornerRadius="2"
                                Margin="0 0 8 0"
                                VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtName"
                                           Text="上板机"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                <Border x:Name="laneBadge"
                                        Background="{StaticResource SF.Brush.Mes.TagSingleBg}"
                                        CornerRadius="2"
                                        Padding="5 1"
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="txtLane"
                                               Text="单轨"
                                               FontSize="9"
                                               Foreground="{StaticResource SF.Brush.Mes.TagSingleFg}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtSub"
                                       Text="Siemens S7-1200 · 192.168.0.10"
                                       FontSize="10"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                       Margin="0 1 0 0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border x:Name="statusBadge"
                                Background="{StaticResource SF.Brush.Mes.LiveBg}"
                                CornerRadius="3"
                                Padding="7 2"
                                Margin="0 0 6 0">
                            <TextBlock x:Name="txtStatus"
                                       Text="RUN"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SF.Brush.Mes.LiveFg}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- 设置按钮 -->
                        <!-- 设置按钮 -->
                        <Border x:Name="btnConfig"
        Width="22" Height="22"
        Background="Transparent"
        BorderBrush="{StaticResource SF.Brush.Text.Secondary}"
        BorderThickness="1"
        CornerRadius="4"
        Cursor="Hand"
        VerticalAlignment="Center"
        ToolTip="配置状态点与数据">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Text.Secondary}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Accent.Default}"/>
                                            <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="⚙️"
               FontSize="11"
               Foreground="{StaticResource SF.Brush.Text.Secondary}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 状态点（先静态） -->
            <StackPanel Margin="12 7">
                <TextBlock Text="状态点"
                           FontSize="10"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           Margin="0 0 0 4"/>
                <StackPanel x:Name="statusChips" Orientation="Horizontal">
                    <Border Background="{StaticResource SF.Brush.Mes.LiveBg}"
                            BorderBrush="{StaticResource SF.Brush.Status.Success}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7 2"
                            Margin="0 0 4 0">
                        <TextBlock Text="运行中" FontSize="10"
                                   Foreground="{StaticResource SF.Brush.Mes.LiveFg}"/>
                    </Border>
                    <Border Background="{StaticResource SF.Brush.Bg.App}"
                            BorderBrush="{StaticResource SF.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7 2">
                        <TextBlock Text="缺板报警" FontSize="10"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 监控数据（先静态） -->
            <StackPanel Margin="12 0 12 7">
                <TextBlock Text="监控数据"
                           FontSize="10"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           Margin="0 0 0 4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="上板计数" FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="1" Text="DB1.DBD0" FontSize="10"
                               FontFamily="Consolas" Margin="0 0 12 0"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="2" Text="3842" FontSize="11"
                               FontFamily="Consolas" FontWeight="SemiBold" Margin="0 0 12 0"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    <TextBlock Grid.Column="3" Text="pcs" FontSize="10"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </Grid>
                <Border BorderBrush="{StaticResource SF.Brush.Border.Default}"
                        BorderThickness="0 1 0 0"
                        Margin="0 6 0 0"
                        Padding="0 6 0 0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="轨道" FontSize="11"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock Text="250.0 mm" FontSize="11"
                                   FontFamily="Consolas" FontWeight="SemiBold"
                                   Margin="3 0 0 0"
                                   Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 页脚 -->
            <Border Background="{StaticResource SF.Brush.Bg.App}" Padding="12 4">
                <Grid>
                    <TextBlock x:Name="txtTime" Text="02:42:15" FontSize="10"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Text="设备管理" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>