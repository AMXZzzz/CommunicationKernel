<!--
  文件: DataMonitorPage.xaml
  层级: UI 层 — WPF Views
  作用: MES 数据监控页：顶栏、整线控制、调宽、流程、设备卡片、告警弹层。
-->
<Page x:Class="CommunicationKernel.UI.Wpf.Views.Pages.MesMonitor.DataMonitorPage"
      xmlns:mes="clr-namespace:CommunicationKernel.UI.Wpf.Views.Pages.MesMonitor.Controls"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="MES监控">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 数据监控内容 -->
            <RowDefinition Height="23*"/>
            <RowDefinition Height="58*"/>
        </Grid.RowDefinitions>

        <!-- =============== 顶部工具栏 =============== -->
        <mes:MESControlsTitleBar Grid.Row="0" />


        <!-- =============== 内容滚动区域 =============== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8" Grid.RowSpan="2">

            <!-- 滚动内容排布 -->
            <StackPanel>
                <!-- ① 整线控制 -->
                <mes:MesLineControlBar x:Name="lineControl" />

                <!-- ② 一键调宽 PCB 轨道宽度  -->
                <mes:MesWidthBar/>

                <!-- ③ 产线流程 -->
                <mes:MesFlowTrack/>

                <!-- ④ 设备监控卡片区（由 DataMonitorViewModel.MonitoredDevices 驱动） -->
                <!-- 标题行 -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    <TextBlock Text="设备卡片根据 "
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                            CornerRadius="3" Padding="7 1">
                        <TextBlock Text="设备管理" FontSize="10"
                                   Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                    </Border>
                    <TextBlock Text=" 自动生成 · 点击 ⚙ 配置状态点与数据"
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </StackPanel>

                <!-- 动态卡片列表：绑定到 DataMonitorViewModel.MonitoredDevices -->
                <ItemsControl ItemsSource="{Binding MonitoredDevices}">
                    <ItemsControl.ItemsPanel>
                        <!-- 以 3 列网格均匀排列设备卡片 -->
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!-- 每个 DeviceInfo 渲染为一张 MesDeviceCard -->
                        <DataTemplate>
                            <mes:MesDeviceCard
                                DeviceName="{Binding Name}"
                                DeviceSub="{Binding Protocol}"
                                DeviceLane="{Binding Lane}"
                                IsDualLane="{Binding IsDualLane}"
                                DeviceStatusText="{Binding StatusText}"
                                DeviceStatusKind="{Binding StatusType}"
                                Width="300"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 无设备时的空状态提示 -->
                <TextBlock Text="暂无设备 — 请前往「设备管理」添加设备"
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0 24 0 0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- 默认隐藏，仅当 MonitoredDevices 为空时显示 -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MonitoredDevices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>


            </StackPanel>

        </ScrollViewer>

        <!-- ===== 活动报警 Popup（列表 + 详情） ===== -->
        <Popup x:Name="alarmPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Placement="Center">
            <Border Background="Transparent">
                <Grid>
                    <!-- 列表 -->
                    <mes:MesAlarmPanel x:Name="alarmPanel"/>

                    <!-- 详情（默认隐藏） -->
                    <mes:MesAlarmDetail x:Name="alarmDetail"
                                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>