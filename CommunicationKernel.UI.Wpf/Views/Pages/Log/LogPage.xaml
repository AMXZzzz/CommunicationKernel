<!--
  文件: LogPage.xaml
  层级: UI 层 — WPF Views
  作用: 通讯日志页：顶栏清空按钮 + 虚拟化日志列表。
-->
<Page x:Class="CommunicationKernel.UI.Wpf.Views.Pages.Log.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="通讯日志"
      Background="{StaticResource SF.Brush.Bg.App}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="通讯日志"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SF.Brush.Text.Primary}"/>
            <Button DockPanel.Dock="Right"
                    Content="清空"
                    Style="{StaticResource SF.Style.DarkButton}"
                    Click="BtnClear_Click"/>
        </DockPanel>

        <!-- 列表 -->
        <Border Grid.Row="1"
                Background="{StaticResource SF.Brush.Bg.Surface}"
                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="8">
            <ListBox x:Name="listLog"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding TimeText}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                            <!-- 级别：按 Level 着色 -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LevelText}"
                                       FontSize="12"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource SF.Brush.Text.Primary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource SF.Brush.Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource SF.Brush.Status.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource SF.Brush.Status.Error}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource SF.Brush.Text.Secondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source}"
                                       FontSize="12"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Message}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Page>