<!--
    文件: MainWindow.xaml
    层级: UI 层 — WPF 主窗口
    作用: 无边框深色主窗口，顶栏 + 左侧 NavSidebar + Frame 导航区域。
         WindowChrome 允许原生缩放，鼠标拖拽实现移动。
-->
<Window x:Class="CommunicationKernel.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CommunicationKernel.UI.Wpf.Views.Controls"
        Title="Communication Kernel"
        WindowStyle="None"
        Height="{StaticResource SF.ControlsSize.MainWindowsHeight}"
        Width="{StaticResource SF.ControlsSize.MainWindowsWidth}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SF.Brush.Bg.App}">

    <!-- 原生窗口装饰（允许缩放边框、取消玻璃特效） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶栏（自适应高度） -->
            <RowDefinition Height="Auto"/>
            <!-- 主体区域 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SF.Brush.Bg.TopBar}"
                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <!-- 左：标题 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 中：当前状态 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 右：状态灯 + 窗口按钮 -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用名称 + 版本 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Communication Kernel"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    <TextBlock Text=" V1.0"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 当前连接状态文字（居中） -->
                <TextBlock x:Name="txtCurrentDevice"
                           Grid.Column="1"
                           Text="未连接 Host.App"
                           FontSize="13"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- 右侧：状态灯 + 窗口控制按钮 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 在线状态指示灯 -->
                    <Ellipse x:Name="statusIndicator"
                             Width="10" Height="10"
                             Fill="{StaticResource SF.Brush.Text.Secondary}"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtStatus"
                               Text="未连接"
                               FontSize="12"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <!-- 最小化 -->
                    <Button Content="─"
                            Click="BtnMinimize_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <!-- 最大化/还原 -->
                    <Button x:Name="btnMaximize"
                            Content="□"
                            Click="BtnMaximize_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <!-- 关闭 -->
                    <Button Content="✕"
                            Click="BtnClose_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体：侧栏 + 内容 Frame ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 侧栏（宽度由 NavSidebar 自身动画控制） -->
                <ColumnDefinition Width="Auto"/>
                <!-- 页面内容区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NavSidebar：RadioButton 驱动的可折叠侧边栏 -->
            <controls:NavSidebar x:Name="navSidebar"
                                 Grid.Column="0"/>

            <!-- Frame：Page 导航容器，隐藏内置导航 UI -->
            <Border Grid.Column="1"
                    Background="{StaticResource SF.Brush.Bg.App}">
                <!-- JournalOwnership=OwnsJournal + 每次导航后清空日志：
                     否则 Frame 会持有全部历史 Page 实例（本应用页面为瞬态，
                     每次导航新建），造成实例无限累积 -->
                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal"
                       Navigated="MainFrame_Navigated"/>
            </Border>
        </Grid>
    </Grid>
</Window>
