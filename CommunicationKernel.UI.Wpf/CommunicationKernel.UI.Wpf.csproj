<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       文件: CommunicationKernel.UI.Wpf.csproj
       层级: UI 层 — WPF 桌面客户端
       作用: 通过 gRPC 连接 Host.App，提供桌面端监控与配置界面。
       依赖: Grpc.Net.Client + Google.Protobuf + Grpc.Tools（生成客户端 stub）
       ======================================================================== -->

  <PropertyGroup>
    <!-- 目标框架：net8.0-windows，启用 WPF -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWpf>true</UseWpf>
    <!-- 启用隐式 using（System, System.Threading.Tasks 等自动引入） -->
    <!-- 禁用可空引用类型注释（与旧项目风格保持一致） -->
    <!-- 可空引用检查由 Directory.Build.props 统一开启。
         存量文件以 #nullable disable 逐文件豁免，改造完一个即摘除一个，
         新文件默认受检——这是防止继续劣化的棘轮。 -->
    <!-- 输出类型为 WinExe，避免出现控制台黑窗口 -->
    <OutputType>WinExe</OutputType>
    <!-- 继承 Directory.Build.props 的 TreatWarningsAsErrors=true -->
    <AssemblyName>CommunicationKernel.UI.Wpf</AssemblyName>
    <RootNamespace>CommunicationKernel.UI.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Logging — ILogger / ILoggerFactory -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Microsoft.Extensions.DependencyInjection — IoC 容器 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Microsoft.Extensions.Hosting — 宿主生命周期管理 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共享 gRPC 客户端。
         proto 代码生成、通道管理、DTO 全部在该库内完成，
         本项目不再自行引用 Grpc.Tools 生成一份 stub——
         两份生成代码会产生同名类型，且与 Blazor 端各自漂移。 -->
    <ProjectReference Include="..\CommunicationKernel.Host.Sdk\CommunicationKernel.Host.Sdk.csproj" />
  </ItemGroup>

</Project>
