﻿<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- 只依赖引擎；路由层与抽象层由引擎传递引用。
         本项目现在是"引擎 + gRPC 端点"的薄壳，业务逻辑全在 Engine 内。 -->
    <ProjectReference Include="..\CommunicationKernel.Engine.Runtime\CommunicationKernel.Engine.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约文件位于解决方案根目录 Protos\，由服务端与所有客户端共用。
         曾经每个项目各存一份副本，导致 Web 端契约长期滞后于服务端。 -->
    <Protobuf Include="..\Protos\V1\engine_host.proto"
              ProtoRoot=".."
              GrpcServices="Server"
              Link="Protos\V1\engine_host.proto" />
  </ItemGroup>

  <!-- ==========================================================================
       插件部署
       ==========================================================================
       宿主在运行时从 $(OutDir)plugins 目录扫描 *.dll 发现协议与传输插件
       （见 appsettings.json 的 EngineRuntime:PluginDirectory）。
       此处只建立「构建顺序」依赖，不产生编译期引用——
       ReferenceOutputAssembly=false 保证宿主代码无法直接使用插件类型，
       从而守住「宿主不持有任何具体协议知识」这条架构约束。
       ========================================================================== -->
  <ItemGroup>
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Modbus\CommunicationKernel.Plugins.Protocol.Modbus.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Panasonic\CommunicationKernel.Plugins.Protocol.Panasonic.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Protocol.Siemens.S7\CommunicationKernel.Plugins.Protocol.Siemens.S7.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Transport.Tcp\CommunicationKernel.Plugins.Transport.Tcp.csproj" />
    <PluginProject Include="..\CommunicationKernel.Plugins.Transport.SerialPort\CommunicationKernel.Plugins.Transport.SerialPort.csproj" />

    <!--
      GlobalPropertiesToRemove：插件是类库，不带 RuntimeIdentifier。
      宿主以 -r linux-arm64 发布时，若把 RID 传播给插件工程，
      MSBuild 会去 bin/Release/net8.0/linux-arm64/ 找它们的输出——
      那个目录根本不存在，发布直接失败（树莓派部署因此完全不可行）。
    -->
    <ProjectReference Include="@(PluginProject)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun" />
  </ItemGroup>

  <!--
    将插件程序集及其第三方私有依赖复制到 plugins 目录。

    关键约束：绝不复制 CommunicationKernel.* 共享契约程序集。
    PluginLoadContext 使用 AssemblyDependencyResolver 优先在插件目录内解析依赖；
    若共享契约（如 Communication.Protocol.dll）也出现在 plugins 下，
    插件会加载到自己那一份，其 IProtocolDriverFactory 与宿主的将是两个不同类型，
    IsAssignableFrom 判定失败 → 所有插件工厂静默注册不上。
    共享契约必须回落到默认加载上下文（即宿主主输出目录）才能保证类型标识一致。
  -->
  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <!-- 取各插件工程的主输出程序集路径（此时它们已由 ProjectReference 保证构建完成） -->
    <!-- RemoveProperties 同上：查询插件输出路径时必须按「无 RID 的类库」解析 -->
    <MSBuild Projects="@(PluginProject)"
             Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginAssembly" />
    </MSBuild>

    <Copy SourceFiles="@(_PluginAssembly)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />

    <Message Importance="high"
             Text="已部署 @(_PluginAssembly->Count()) 个插件到 $(OutDir)plugins" />
  </Target>

  <!--
    复制插件的第三方私有依赖（如串口插件的 System.IO.Ports）。
    使用目标批处理（Outputs 元数据）令每批只含一个插件目录，
    这样 ItemGroup 的 Include 通配符才能在执行期正确展开——
    Copy 任务本身不做通配符匹配。
    Exclude 排除 CommunicationKernel.* ：共享契约必须由默认加载上下文提供，
    详见上方 CopyPluginsToOutput 的说明。
  -->
  <Target Name="CopyPluginThirdPartyDeps"
          AfterTargets="CopyPluginsToOutput"
          Outputs="%(_PluginAssembly.Identity)">
    <ItemGroup>
      <_PluginDep Remove="@(_PluginDep)" />
      <_PluginRuntimeAsset Remove="@(_PluginRuntimeAsset)" />
      <_PluginDepsJson Remove="@(_PluginDepsJson)" />

      <!--
        插件的私有依赖：第三方程序集（如串口插件的 System.IO.Ports）。

        排除清单精确到「宿主也加载的四个共享契约」而非按 CommunicationKernel.*
        前缀一刀切。这四个契约必须由默认加载上下文提供：若它们出现在 plugins
        目录下，插件会加载到自己那一份，其 IProtocolDriverFactory 与宿主的
        将是两个不同类型，IsAssignableFrom 判定失败 →
        所有插件工厂静默注册不上，且不抛任何异常。

        注：曾经还需要放行 Plugins.Modbus.Core 这类「插件私有共享库」，
        三个 Modbus 插件合并成单一程序集后已无此类依赖。
      -->
      <_PluginDep Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)*.dll"
                  Exclude="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Core.Abstractions.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Communication.Protocol.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Communication.Transport.dll;
                           %(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)CommunicationKernel.Plugin.Loader.dll" />

      <!-- deps.json：AssemblyDependencyResolver 据此选择 RID 专属实现，
           缺失则只能加载到会抛 PlatformNotSupportedException 的外观程序集 -->
      <_PluginDepsJson Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)%(_PluginAssembly.Filename).deps.json" />

      <!-- RID 专属运行时资产（如 runtimes\win\lib\net8.0\System.IO.Ports.dll），
           必须保持目录结构，解析器按 RID 路径查找 -->
      <_PluginRuntimeAsset Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)runtimes\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_PluginDep)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(_PluginDepsJson)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_PluginDepsJson.FullPath)')" />

    <Copy SourceFiles="@(_PluginRuntimeAsset)"
          DestinationFiles="@(_PluginRuntimeAsset->'$(OutDir)plugins\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    把 plugins 目录一并带进发布产物。

    上面两个目标挂在 Build 上，拷贝目的地是 $(OutDir)；而 dotnet publish
    的输出目录是 $(PublishDir)，两者不同——不补这一步，发布产物里没有任何插件，
    宿主启动后加载到 0 个协议，且不报错（插件加载失败是静默的）。
    树莓派部署正是走 publish 路径，因此这一步是该场景的必需项。

    直接从已就绪的 $(OutDir)plugins 复制：publish 在 build 之后执行，
    那里的内容已经过上面两个目标的正确处理（含 RID 资产与排除规则）。
  -->
  <Target Name="CopyPluginsToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_DeployedPluginFile Include="$(OutDir)plugins\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_DeployedPluginFile)"
          DestinationFiles="@(_DeployedPluginFile->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="high"
             Text="已将 @(_DeployedPluginFile->Count()) 个插件文件复制到发布目录 $(PublishDir)plugins" />
  </Target>

</Project>
