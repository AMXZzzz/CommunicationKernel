<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  文件: Properties/PublishProfiles/树莓派-linux-arm.pubxml
  作用: 发布到 32 位树莓派（Raspberry Pi OS 32 位版）。

  与 树莓派-linux-arm64.pubxml 的唯一差别是 RuntimeIdentifier。
  两者的说明与注意事项完全一致，详见那个文件的文件头。

  怎么确认该用哪个:
    在树莓派上执行 uname -m
      aarch64  → 用 linux-arm64
      armv7l   → 用本文件（linux-arm）
  ============================================================================
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>

    <PublishUrl>bin\Release\net8.0\publish\linux-arm\</PublishUrl>
    <TargetFramework>net8.0</TargetFramework>

    <!-- 32 位 ARM Linux -->
    <RuntimeIdentifier>linux-arm</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
