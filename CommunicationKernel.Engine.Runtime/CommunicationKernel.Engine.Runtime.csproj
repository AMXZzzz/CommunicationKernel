<Project Sdk="Microsoft.NET.Sdk">

  <!--
    通信内核引擎 —— SDK 化的核心载体。

    这里是"可嵌入"的边界：任何应用（跨平台 UI、后台服务、树莓派上的
    控制程序）只需引用本项目即可直连 PLC，无需 gRPC 中转、无需 ASP.NET。

    刻意使用 Microsoft.NET.Sdk 而非 .Web：
    引擎此前住在 Web SDK 项目里，导致任何嵌入式消费者都被拖进整个
    ASP.NET Core。而该耦合是假的——引擎三个文件的 ASP.NET / gRPC
    引用数均为 0，真正需要它们的只有 gRPC 服务层。

    CI 中有一个作业专门校验本项目的依赖闭包不含 Microsoft.AspNetCore.*。
  -->

  <PropertyGroup>
    <!-- 类库不指定 RuntimeIdentifier：RID 只在最终发布应用时指定 -->
    <IsPackable>true</IsPackable>

    <!-- 打包库必须生成 XML 文档：消费者只能通过 IntelliSense 了解这些 API，
         没有文档时连 length 的单位是字节还是寄存器都无从得知。
         必须写在工程内而非 Directory.Build.targets——后者导入得太晚，
         SDK 那时已经决定不生成文档了。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CommunicationKernel.Engine.Runtime</PackageId>
    <Description>工业 PLC 通讯内核。可嵌入上位机进程直连 PLC（Modbus TCP/RTU/ASCII、松下 MEWTOCOL、西门子 S7），不依赖 ASP.NET，可在 Linux 与树莓派上运行。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommunicationKernel.Core.Abstractions\CommunicationKernel.Core.Abstractions.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Communication.Protocol\CommunicationKernel.Communication.Protocol.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Communication.Transport\CommunicationKernel.Communication.Transport.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Plugin.Loader\CommunicationKernel.Plugin.Loader.csproj" />
    <ProjectReference Include="..\CommunicationKernel.Engine.Router\CommunicationKernel.Engine.Router.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
