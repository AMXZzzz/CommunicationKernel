@* -----------------------------------------------------------------------------
   文件: Components/Pages/Index.razor
   层级: UI 层 — MES 监控
   作用: 以 Host 真实路由 + 本地配置为数据源展示在线状态。
         整线健康由路由在线率推导，不做假的产线启停。
   ----------------------------------------------------------------------------- *@

@page "/"
@inject HostSession Session
@inject WebDeviceStore Devices
@implements IDisposable

<PageTitle>MES 监控 — CommunicationKernel</PageTitle>

<div class="page page-mes">
    <div class="toolbar">
        <h2 class="page-title">MES 监控</h2>
        <button class="btn ghost" type="button" @onclick="RefreshAsync" disabled="@_busy">刷新</button>
        <div class="toolbar-right">
            @if (Session.Online)
            {
                @* 脉冲徽标只在真的连着 Host 时出现——离线还闪「实时」是假信号 *@
                <span class="live">实时</span>
            }
            <span class="toolbar-count">在线 @OnlineCount / @Cards.Count</span>
        </div>
    </div>

    <div class="page-body">
    <div class="health-strip @HealthClass">
        <div class="health-main">
            <span class="health-dot"></span>
            <span class="health-label">整线健康</span>
            <span class="health-val">@HealthText</span>
        </div>
        <div class="health-meta">
            在线 @OnlineCount / @Cards.Count
            @if (!Session.Online)
            {
                <span>· Host 离线</span>
            }
        </div>
    </div>

    <div class="summary-bar">
        <div class="summary-card">
            <div class="summary-label">在线 / 总计</div>
            <div class="summary-value">
                <span class="val-green">@OnlineCount</span>
                <span class="val-sep"> / </span>
                <span>@Cards.Count</span>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Host.App</div>
            <div class="summary-value @(Session.Online ? "val-green" : "val-red")">
                @(Session.Online ? "在线" : "离线")
            </div>
            <div class="summary-sub">@Session.Address</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">报警</div>
            <div class="summary-value @(HasAlarm ? "val-red" : "val-green")">
                @(HasAlarm ? OfflineCount + " 台离线" : "正常")
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-label">协议</div>
            <div class="summary-value">@ProtocolCount</div>
            <div class="summary-sub">当前路由涉及</div>
        </div>
    </div>

    @if (Alarms.Count > 0)
    {
        <div class="alarm-panel">
            <div class="alarm-hd">离线 / 故障（来自 WatchRouteStatus，不是模拟）</div>
            @foreach (MesCard card in Alarms)
            {
                RouteStatusDto? st = Session.GetStatus(card.RouteId);
                <div class="alarm-row">
                    <span class="alarm-name">@card.Name</span>
                    <span class="mono">@card.RouteId</span>
                    <span class="alarm-msg">@(st?.ErrorCode) @(st?.ErrorMessage)</span>
                </div>
            }
        </div>
    }

    <div class="section-row">
        <div class="section-title">设备状态</div>
        <span class="toolbar-count">卡片来自宿主路由 + 本地待对账配置</span>
    </div>

    @if (Cards.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">暂无设备</div>
            <div class="empty-hint">到「设备管理」注册 PLC 路由。本地已保存的配置会在 Host 恢复后自动对账。</div>
            <a class="btn primary" href="/devices">去添加设备</a>
        </div>
    }
    else
    {
        <div class="device-grid">
            @foreach (MesCard card in Cards)
            {
                RouteStatusDto? st = Session.GetStatus(card.RouteId);
                bool online = st?.Online == true;
                <div class="mes-card @(online ? "is-on" : "is-off")">
                    <div class="mes-hd">
                        <span class="proto-bar @UiHelpers.ProtocolBarClass(card.ProtocolId)"></span>
                        <div class="mes-titles">
                            <div class="card-name">@card.Name</div>
                            <div class="card-proto">@card.ProtocolId</div>
                        </div>
                        <span class="card-status @(online ? "online" : "offline")">@(online ? "在线" : "离线")</span>
                        <span class="card-led @(online ? "online" : "offline")"></span>
                    </div>
                    <div class="mes-body">
                        <div class="kv"><span>路由</span><span class="mono">@card.RouteId</span></div>
                        <div class="kv"><span>连接</span><span class="addr">@card.Endpoint</span></div>
                        <div class="kv"><span>传输</span><span>@card.TransportKind</span></div>
                        @if (!card.OnHost)
                        {
                            <div class="kv"><span>状态</span><span>本地待对账</span></div>
                        }
                        @if (st is not null && !string.IsNullOrWhiteSpace(st.ErrorMessage) && !online)
                        {
                            <div class="kv err"><span>错误</span><span>@st.ErrorCode · @st.ErrorMessage</span></div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
</div>

@code {
    private bool _busy;
    private List<MesCard> _cards = new();

    private IReadOnlyList<MesCard> Cards => _cards;
    private IReadOnlyList<MesCard> Alarms => _cards.Where(c => !Session.IsRouteOnline(c.RouteId)).ToList();
    private int OnlineCount => _cards.Count(c => Session.IsRouteOnline(c.RouteId));
    private int OfflineCount => _cards.Count - OnlineCount;
    private bool HasAlarm => OfflineCount > 0 && _cards.Count > 0;
    private int ProtocolCount => _cards.Select(c => c.ProtocolId).Where(p => p.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private string HealthText
    {
        get
        {
            if (!Session.Online) return "Host 离线";
            if (Cards.Count == 0) return "待命";
            if (OfflineCount == 0) return "运行";
            return "告警";
        }
    }

    private string HealthClass
    {
        get
        {
            if (!Session.Online) return "is-down";
            if (Cards.Count == 0) return "is-idle";
            if (OfflineCount == 0) return "is-run";
            return "is-alarm";
        }
    }

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Rebuild();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Rebuild();
        StateHasChanged();
    });

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            await Session.ProbeAsync().ConfigureAwait(true);
            if (Session.Online)
                await Session.RefreshRoutesAsync().ConfigureAwait(true);
            Rebuild();
        }
        finally
        {
            _busy = false;
        }
    }

    private void Rebuild() => _cards = BuildCards();

    private List<MesCard> BuildCards()
    {
        Dictionary<string, WebDeviceRecord> local = Devices.GetAll()
            .ToDictionary(d => d.RouteId, d => d, StringComparer.OrdinalIgnoreCase);
        Dictionary<string, MesCard> map = new(StringComparer.OrdinalIgnoreCase);

        foreach (RouteDto r in Session.Routes)
        {
            local.TryGetValue(r.RouteId, out WebDeviceRecord? rec);
            map[r.RouteId] = ToCard(r, rec, onHost: true);
        }

        foreach (WebDeviceRecord rec in local.Values)
        {
            if (map.ContainsKey(rec.RouteId)) continue;
            map[rec.RouteId] = ToCard(null, rec, onHost: false);
        }

        return map.Values.ToList();
    }

    private static MesCard ToCard(RouteDto? r, WebDeviceRecord? rec, bool onHost)
    {
        string id = r?.RouteId ?? rec?.RouteId ?? string.Empty;
        string name = rec is not null && !string.IsNullOrWhiteSpace(rec.Name) ? rec.Name : id;
        string protocol = r?.ProtocolId ?? rec?.ProtocolId ?? string.Empty;
        string transport = r?.TransportKind ?? rec?.TransportKind ?? string.Empty;
        bool serial = string.Equals(transport, "Serial", StringComparison.OrdinalIgnoreCase);
        string endpoint = serial
            ? (r?.SerialPort ?? rec?.SerialPort ?? "串口")
            : (r is not null ? r.Address + ":" + r.Port : (rec?.Address ?? "") + ":" + (rec?.Port ?? 0));
        return new MesCard(id, name, protocol, transport, endpoint, onHost);
    }

    public void Dispose() => Session.Changed -= OnChanged;

    private sealed record MesCard(
        string RouteId,
        string Name,
        string ProtocolId,
        string TransportKind,
        string Endpoint,
        bool OnHost);
}
