@* -----------------------------------------------------------------------------
   文件: Components/Pages/SettingsPage.razor
   层级: UI 层 — 系统设置页（Blazor）
   作用: 显示 Host.App 连接配置和连接测试，以及应用版本信息。
   路由: /settings
   ----------------------------------------------------------------------------- *@

@page "/settings"
@rendermode InteractiveServer

@inject HostClient Client

<PageTitle>系统设置 — CommunicationKernel</PageTitle>

<div class="page-set">
    <h2 class="page-title">系统设置</h2>

    <!-- 连接设置卡片 -->
    <div class="settings-card">
        <h3>Host.App 连接</h3>

        <label>gRPC 服务地址</label>
        <input @bind="ServerAddress" placeholder="http://localhost:5000" />

        <div class="form-actions">
            <button class="btn primary" @onclick="TestConnectionAsync" disabled="@IsTesting">
                @(IsTesting ? "测试中..." : "测试连接")
            </button>
        </div>

        <!-- 连接状态 -->
        <div class="connect-status @ConnectStatusClass" style="margin-top:12px">
            @ConnectStatus
        </div>

        @if (!string.IsNullOrEmpty(HostVersion)) {
            <div class="setting-hint">Host 版本: @HostVersion</div>
        }
    </div>

    <!-- 关于卡片 -->
    <div class="settings-card">
        <h3>关于</h3>
        <p class="setting-desc">CommunicationKernel 通讯调试工具</p>
        <p class="setting-hint">.NET 8 · gRPC · Blazor Server · 企业级分层架构</p>
    </div>
</div>

@code {

    // -------------------------------------------------------------------------
    // 状态
    // -------------------------------------------------------------------------

    private string ServerAddress       { get; set; } = "http://localhost:5000";
    private bool   IsTesting           { get; set; }
    private string ConnectStatus       { get; set; } = "未测试";
    private string ConnectStatusClass  { get; set; } = "status-muted";
    private string HostVersion         { get; set; } = string.Empty;

    // -------------------------------------------------------------------------
    // 操作
    // -------------------------------------------------------------------------

    /// <summary>连接测试：调用 Health RPC，更新状态显示。</summary>
    private async Task TestConnectionAsync() {
        IsTesting     = true;
        ConnectStatus = "连接中...";
        ConnectStatusClass = "status-warn";

        try {
            var (ok, version, routeCount) = await Client.HealthAsync().ConfigureAwait(false);

            if (ok) {
                // 连接成功
                ConnectStatus      = $"已连接 · {routeCount} 条路由";
                ConnectStatusClass = "status-ok";
                HostVersion        = version;
            }
            else {
                // 服务端异常
                ConnectStatus      = "服务异常";
                ConnectStatusClass = "status-error";
                HostVersion        = string.Empty;
            }
        }
        catch (Exception ex) {
            // 网络不可达
            ConnectStatus      = $"连接失败: {ex.Message}";
            ConnectStatusClass = "status-error";
            HostVersion        = string.Empty;
        }
        finally {
            IsTesting = false;
        }
    }
}
