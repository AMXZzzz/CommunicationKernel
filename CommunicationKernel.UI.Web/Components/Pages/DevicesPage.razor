@* -----------------------------------------------------------------------------
   文件: Components/Pages/DevicesPage.razor
   层级: UI 层 — 设备管理
   作用: 协议清单来自 QueryProtocols，串口来自 QuerySerialPorts，禁止内置协议名。
   职责: 本页只负责渲染与交互编排。所有设备操作一律经 IWebDeviceService，
         不得直接持有 Session.Client 发 gRPC——那会把传输细节焊进视图。
   ----------------------------------------------------------------------------- *@

@page "/devices"
@inject HostSession Session
@inject WebDeviceStore Store
@inject IWebDeviceService Devices
@inject AppLogStore Log
@inject ILogger<DevicesPage> Logger
@implements IDisposable

<PageTitle>设备管理 — CommunicationKernel</PageTitle>

<div class="page page-dev">
    <div class="toolbar">
        <h2 class="page-title">设备管理</h2>
        <button class="btn ghost" type="button" @onclick="RefreshAsync" disabled="@_busy">刷新</button>
        <button class="btn ghost" type="button" @onclick="ConnectAllAsync" disabled="@(_busy || !Session.Online)">一键连接</button>
        @* 添加设备不需要 Host 在线：它只写本地配置，不建连接 *@
        <button class="btn primary" type="button" @onclick="OpenAdd" disabled="@_busy">添加设备</button>
        <div class="toolbar-right">
            @if (_busy) { <span class="busy-hint">处理中…</span> }
            <span class="toolbar-count">@OnlineCount / @Rows.Count 在线</span>
        </div>
    </div>

    <div class="page-body">
        @if (!string.IsNullOrEmpty(_banner))
        {
            <div class="status-msg @_bannerClass">@_banner</div>
        }

        @if (Rows.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-title">还没有路由</div>
                <div class="empty-hint">添加设备只写本地配置，不需要 Host 在线，也不会立刻建连接。<br />配好后到现场可达时再点「连接」。</div>
                <button class="btn primary" type="button" @onclick="OpenAdd" disabled="@_busy">添加设备</button>
            </div>
        }
        else
        {
            <div class="device-grid">
                @foreach (DeviceRow row in Rows)
                {
                    bool online = Session.IsRouteOnline(row.RouteId);
                    <div class="mes-card @(online ? "is-on" : "is-off")">
                        <div class="mes-hd">
                            <span class="proto-bar @UiHelpers.ProtocolBarClass(row.ProtocolId)"></span>
                            <div class="mes-titles">
                                <div class="card-name">@row.Name</div>
                                <div class="card-proto">@row.ProtocolId</div>
                            </div>
                            @* LED 与文字徽标并存：LED 供扫视整屏找异常，文字供确认 *@
                            <span class="card-status @(online ? "online" : "offline")">@(online ? "在线" : "离线")</span>
                            <span class="card-led @(online ? "online" : "offline")"></span>
                        </div>
                        <div class="mes-body">
                            <div class="kv"><span>路由</span><span class="mono">@row.RouteId</span></div>
                            <div class="kv"><span>连接</span><span class="addr">@row.Endpoint</span></div>
                            <div class="kv"><span>站号</span><span>@(string.IsNullOrEmpty(row.Station) ? "—" : row.Station)</span></div>
                            <div class="kv">
                                <span>字节序</span>
                                <span class="mono" title="@ByteOrderHint(row.ByteOrder)">@row.ByteOrder</span>
                            </div>
                            @if (!row.OnHost)
                            {
                                <div class="kv err"><span>宿主</span><span>本地待对账</span></div>
                            }
                        </div>
                        @* 连接是显式动作，不在「添加设备」时顺带发生——
                           PLC 未上电时也要能把设备先配好摆在这里 *@
                        <div class="card-ft">
                            @if (row.OnHost)
                            {
                                <button class="btn ghost" type="button"
                                        @onclick="() => DisconnectAsync(row)" disabled="@_busy">断开</button>
                            }
                            else
                            {
                                <button class="btn primary" type="button"
                                        @onclick="() => ConnectAsync(row)"
                                        disabled="@(_busy || !Session.Online)">连接</button>
                            }
                            <button class="btn ghost" type="button" @onclick="() => OpenEdit(row)" disabled="@_busy">编辑</button>
                            <button class="btn danger card-del" type="button"
                                    @onclick="() => AskRemove(row)" disabled="@_busy" title="删除设备">删除</button>
                        </div>
                    </div>
                }

                @* 新增入口同时放在网格末尾：新卡片会出现在这个位置，
                   操作与结果因此在同一处，不必先去顶部工具栏 *@
                <button class="add-card" type="button" @onclick="OpenAdd" disabled="@_busy">
                    <span class="plus">+</span>
                    <span>添加设备</span>
                </button>
            </div>
        }
    </div>

    @if (_showForm)
    {
        <div class="add-form-overlay" @onclick="CloseForm">
            <div class="add-form" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>@(IsEditing ? "编辑设备" : "添加设备")</h3>
                    <button class="close-btn" type="button" @onclick="CloseForm">×</button>
                </div>

                @if (_protocols.Count == 0)
                {
                    <p class="setting-hint">
                        宿主未返回任何协议插件，无法选择协议。请确认 Host.App 已启动、plugins 目录中有协议插件。
                    </p>
                }
                else
                {
                    <label>显示名称</label>
                    <input @bind="_name" placeholder="例如 贴片机-1" />

                    <label>路由 ID *</label>
                    @if (IsEditing)
                    {
                        @* 路由 ID 是设备的身份，改了等于换一台设备：
                           宿主侧已注册的那条会变成没人认领的孤儿路由。
                           要改就删掉重建。 *@
                        <input value="@_routeId" readonly title="路由 ID 是设备身份，不可修改；如需更改请删除后重建" />
                    }
                    else
                    {
                        <input @bind="_routeId" placeholder="plc-001" />
                    }

                    <label>协议 *</label>
                    <select value="@_protocolId" @onchange="OnProtocolChanged">
                        @foreach (ProtocolDescriptorDto p in _protocols)
                        {
                            <option value="@p.ProtocolId">@p.DisplayName</option>
                        }
                    </select>

                    <label>传输介质</label>
                    <select value="@_transportKind" @onchange="OnTransportChanged">
                        @foreach (string t in Transports)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>

                    @if (IsSerial)
                    {
                        <label>串口（宿主机器）</label>
                        @if (_ports.Count > 0)
                        {
                            <select @bind="_serialPort">
                                @foreach (SerialPortDto port in _ports)
                                {
                                    <option value="@port.PortName">@port.Display</option>
                                }
                            </select>
                        }
                        <input @bind="_serialPort" placeholder="/dev/ttyUSB0 或 COM3" />
                        <label>波特率</label>
                        <select @bind="_baudRate">
                            @foreach (int b in BaudRates)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                        <label>最小 I/O 间隔 (ms)</label>
                        <input type="number" @bind="_minIo" min="0" />
                    }
                    else
                    {
                        <label>IP 地址 *</label>
                        <input @bind="_address" placeholder="192.168.1.10" />
                        <label>端口</label>
                        <input type="number" @bind="_port" />
                    }

                    @if (NeedsStation)
                    {
                        <label>站号 @(SelectedProtocol?.StationHint)</label>
                        <input @bind="_station" placeholder="1" />
                    }

                    @* 字节序按设备配：Modbus 规范只规定 16 位寄存器内部是大端，
                       跨寄存器的 32 位值怎么摆没有规定，同样是 Modbus，
                       不同品牌可能是 ABCD 也可能是 CDAB *@
                    <label>字节序</label>
                    <select @bind="_byteOrder">
                        @foreach (string o in ByteOrders)
                        {
                            <option value="@o">@o — @ByteOrderHint(o)</option>
                        }
                    </select>
                    <p class="hint-line">
                        读数正确但数值明显不对（例如写 8 读回 2048、或 32 位值高低半截颠倒）就是这里配错了。
                        默认 ABCD 适用于绝大多数设备。
                    </p>

                    <p class="setting-hint form-note">
                        保存只写本地配置，<b>不会建立连接</b>。设备会以离线卡片出现，
                        到现场可达时再点卡片上的「连接」，或用工具栏的「一键连接」。
                    </p>

                    <div class="form-actions">
                        <button class="btn ghost" type="button" @onclick="CloseForm">取消</button>
                        <button class="btn primary" type="button" @onclick="SaveDeviceAsync" disabled="@_busy">保存</button>
                        @if (!IsEditing && Session.Online)
                        {
                            <button class="btn ghost" type="button" @onclick="SaveAndConnectAsync" disabled="@_busy">保存并连接</button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (_pendingRemove is not null)
    {
        <div class="add-form-overlay center" @onclick="() => _pendingRemove = null">
            <div class="add-form confirm-box" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>删除设备</h3>
                    <button class="close-btn" type="button" @onclick="() => _pendingRemove = null">×</button>
                </div>
                <p>
                    将删除 <span class="mono">@_pendingRemove.RouteId</span> 的本地配置@(_pendingRemove.OnHost ? "，并从宿主注销该路由" : "")。
                    此操作不可恢复。
                </p>
                <p class="setting-hint">只是想让它下线的话，用卡片上的「断开」——配置会保留。</p>
                <div class="form-actions">
                    <button class="btn ghost" type="button" @onclick="() => _pendingRemove = null">取消</button>
                    <button class="btn danger" type="button" @onclick="ConfirmRemoveAsync" disabled="@_busy">确认删除</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly int[] BaudRates = { 9600, 19200, 38400, 57600, 115200 };

    /// <summary>可选字节序，顺序按现场常见程度排。</summary>
    private static readonly string[] ByteOrders = { "ABCD", "CDAB", "BADC", "DCBA" };

    /// <summary>字节序的中文说明，供下拉项与卡片提示复用。</summary>
    private static string ByteOrderHint(string order) => order switch
    {
        "ABCD" => "大端（标准）",
        "CDAB" => "字交换",
        "BADC" => "字节交换",
        "DCBA" => "小端（全反序）",
        _ => "未知",
    };

    private bool _busy;
    private bool _showForm;
    private string _banner = string.Empty;
    private string _bannerClass = "status-info";
    private DeviceRow? _pendingRemove;
    private List<ProtocolDescriptorDto> _protocols = new();
    private List<SerialPortDto> _ports = new();

    private string _name = string.Empty;
    private string _routeId = string.Empty;
    private string _protocolId = string.Empty;
    private string _transportKind = "Tcp";
    private string _address = string.Empty;
    private int _port = 502;
    private string _station = "1";
    private string _serialPort = string.Empty;
    private int _baudRate = 9600;
    private int _minIo = 15;
    private string _byteOrder = "ABCD";

    /// <summary>编辑中的路由 ID；为空表示当前是「新增」。</summary>
    private string _editingRouteId = string.Empty;

    private bool IsEditing => !string.IsNullOrEmpty(_editingRouteId);

    private ProtocolDescriptorDto? SelectedProtocol =>
        _protocols.FirstOrDefault(p => string.Equals(p.ProtocolId, _protocolId, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<string> Transports
    {
        get
        {
            ProtocolDescriptorDto? p = SelectedProtocol;
            if (p?.SupportedTransports is { Count: > 0 })
                return p.SupportedTransports;
            return new[] { "Tcp" };
        }
    }

    private bool IsSerial =>
        string.Equals(_transportKind, "Serial", StringComparison.OrdinalIgnoreCase);

    private bool NeedsStation => SelectedProtocol?.RequiresStation != false;

    private IReadOnlyList<DeviceRow> Rows => BuildRows();

    /// <summary>当前在线的路由数，供工具栏显示「在线 / 总计」。</summary>
    /// <remarks>
    /// 只报总台数看不出问题——十台里掉了一台，数字依旧是十。
    /// 在线数才是操作员真正要扫的那个值。
    /// </remarks>
    private int OnlineCount => Rows.Count(r => Session.IsRouteOnline(r.RouteId));

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            if (Session.Online)
                await Session.RefreshRoutesAsync().ConfigureAwait(true);
            _banner = Session.Online ? "共 " + Rows.Count + " 台（含本地未上线路由）" : "Host 离线，显示本地配置";
            _bannerClass = "status-info";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "刷新设备失败");
            _banner = "刷新失败: " + ex.Message;
            _bannerClass = "status-error";
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// 把所有「本地已配置、宿主侧还没有」的设备一次性推上去。
    /// </summary>
    /// <remarks>
    /// 复用对账逻辑：它做的正是「逐条补注册缺失路由」。
    /// 现场上电顺序不固定，逐台点连接很繁琐，这里给一个批量入口。
    /// </remarks>
    private async Task ConnectAllAsync()
    {
        _busy = true;
        try
        {
            int before = Rows.Count(r => r.OnHost);
            await Session.ReconcileNowAsync().ConfigureAwait(true);
            int after = Rows.Count(r => r.OnHost);
            int total = Rows.Count;

            _banner = "一键连接完成：" + after + " / " + total + " 台已连接"
                    + (after > before ? "（本次新增 " + (after - before) + " 台）" : "");
            // 没有全部连上不算失败——现场本就允许部分设备还没上电
            _bannerClass = after == total ? "status-ok" : "status-warn";
        }
        finally { _busy = false; }
    }

    /// <summary>连接单台设备：此时才向宿主注册路由并真正建链。</summary>
    /// <remarks>
    /// 本方法只做两件事：调服务、把结果翻译成横幅文案。
    /// 配置查找、注册调用、失败分类与日志都在 <see cref="IWebDeviceService"/> 里。
    /// </remarks>
    private async Task ConnectAsync(DeviceRow row)
    {
        _busy = true;
        try
        {
            DeviceOperationResult result = await Devices.ConnectAsync(row.RouteId).ConfigureAwait(true);

            if (result.Success)
            {
                _banner = row.Name + " 已连接";
                _bannerClass = "status-ok";
            }
            else
            {
                // 失败性质决定措辞与颜色：连不上要去检查现场，配置错要去改参数。
                // 两种情况都保留本地配置，设备仍在列表里可重试。
                bool unreachable = result.FailureKind == RegisterFailureKind.Unreachable;
                _banner = row.Name + (unreachable
                    ? " 连接失败（目标不可达）：" + result.ErrorMessage + "。设备保留在列表中，可稍后重试。"
                    : " 连接失败：[" + result.ErrorCode + "] " + result.ErrorMessage + "。请点「编辑」检查配置。");
                _bannerClass = unreachable ? "status-warn" : "status-error";
            }

            await Session.RefreshRoutesAsync().ConfigureAwait(true);
        }
        finally { _busy = false; }
    }

    /// <summary>断开单台设备：从宿主注销路由，本地配置保留。</summary>
    private async Task DisconnectAsync(DeviceRow row)
    {
        _busy = true;
        try
        {
            DeviceOperationResult result = await Devices.DisconnectAsync(row.RouteId).ConfigureAwait(true);
            if (result.Success)
            {
                _banner = row.Name + " 已断开（配置保留）";
                _bannerClass = "status-ok";
            }
            else
            {
                _banner = "断开失败: [" + result.ErrorCode + "] " + result.ErrorMessage;
                _bannerClass = "status-error";
            }
            await Session.RefreshRoutesAsync().ConfigureAwait(true);
        }
        finally { _busy = false; }
    }

    private List<DeviceRow> BuildRows()
    {
        Dictionary<string, WebDeviceRecord> local = Store.GetAll()
            .ToDictionary(d => d.RouteId, d => d, StringComparer.OrdinalIgnoreCase);
        List<DeviceRow> rows = new();
        HashSet<string> seen = new(StringComparer.OrdinalIgnoreCase);
        foreach (RouteDto r in Session.Routes)
        {
            seen.Add(r.RouteId);
            local.TryGetValue(r.RouteId, out WebDeviceRecord? rec);
            rows.Add(ToRow(r, rec, onHost: true));
        }
        foreach (WebDeviceRecord rec in Store.GetAll())
        {
            if (seen.Contains(rec.RouteId)) continue;
            rows.Add(ToRow(null, rec, onHost: false));
        }
        return rows;
    }

    private static DeviceRow ToRow(RouteDto? r, WebDeviceRecord? rec, bool onHost)
    {
        string id = r?.RouteId ?? rec?.RouteId ?? string.Empty;
        string name = rec is not null && !string.IsNullOrWhiteSpace(rec.Name) ? rec.Name : id;
        string protocol = r?.ProtocolId ?? rec?.ProtocolId ?? string.Empty;
        string transport = r?.TransportKind ?? rec?.TransportKind ?? string.Empty;
        string station = r?.Station ?? rec?.Station ?? string.Empty;
        bool serial = string.Equals(transport, "Serial", StringComparison.OrdinalIgnoreCase);
        string endpoint = serial
            ? (r?.SerialPort ?? rec?.SerialPort ?? "串口")
            : (r is not null ? r.Address + ":" + r.Port : (rec?.Address ?? "") + ":" + (rec?.Port ?? 0));
        // 字节序只存在于本地配置：宿主的 RouteDto 不带它（引擎不解释数值语义）
        string byteOrder = string.IsNullOrWhiteSpace(rec?.ByteOrder) ? "ABCD" : rec!.ByteOrder;
        return new DeviceRow(id, name, protocol, transport, station, endpoint, onHost, byteOrder);
    }

    private async Task OpenAdd()
    {
        ResetForm();
        _editingRouteId = string.Empty;
        _showForm = true;

        await LoadFormChoicesAsync().ConfigureAwait(true);

        // 新增时给一份默认选择；编辑时不能这么做，会覆盖掉设备原有的协议
        if (_protocols.Count > 0)
        {
            _protocolId = _protocols[0].ProtocolId;
            _transportKind = _protocols[0].DefaultTransport;
        }
        if (_ports.Count > 0 && string.IsNullOrWhiteSpace(_serialPort))
            _serialPort = _ports[0].PortName;
    }

    /// <summary>打开编辑表单，用本地已存配置回填。</summary>
    private async Task OpenEdit(DeviceRow row)
    {
        WebDeviceRecord? rec = Store.GetAll()
            .FirstOrDefault(d => string.Equals(d.RouteId, row.RouteId, StringComparison.OrdinalIgnoreCase));
        if (rec is null)
        {
            // 宿主上有、本地没有配置的路由（别处注册的）无法在此编辑
            _banner = row.RouteId + " 没有本地配置，无法编辑。可先「断开」再重新添加。";
            _bannerClass = "status-warn";
            return;
        }

        ResetForm();
        _editingRouteId = rec.RouteId;
        _routeId        = rec.RouteId;
        _name           = rec.Name;
        _protocolId     = rec.ProtocolId;
        _transportKind  = rec.TransportKind;
        _address        = rec.Address;
        _port           = rec.Port;
        _station        = rec.Station;
        _serialPort     = rec.SerialPort;
        _baudRate       = rec.BaudRate > 0 ? rec.BaudRate : 9600;
        _minIo          = rec.MinIoIntervalMs;
        _byteOrder      = rec.ByteOrder;
        _showForm       = true;

        await LoadFormChoicesAsync().ConfigureAwait(true);
    }

    /// <summary>
    /// 拉取协议清单与宿主串口清单。
    /// </summary>
    /// <remarks>
    /// Host 离线时两者都会是空列表——这不是错误：添加设备本就不要求宿主在线。
    /// 但没有协议清单就选不了协议，因此表单会给出提示。
    /// </remarks>
    private async Task LoadFormChoicesAsync()
    {
        _busy = true;
        try
        {
            _protocols = (await Devices.GetProtocolsAsync().ConfigureAwait(true)).ToList();
            _ports = (await Devices.GetSerialPortsAsync().ConfigureAwait(true)).ToList();
        }
        catch (Exception ex)
        {
            _banner = "加载协议清单失败: " + ex.Message;
            _bannerClass = "status-error";
        }
        finally { _busy = false; }
    }

    private void ResetForm()
    {
        _name = string.Empty;
        _routeId = string.Empty;
        _protocolId = string.Empty;
        _transportKind = "Tcp";
        _address = string.Empty;
        _port = 502;
        _station = "1";
        _serialPort = string.Empty;
        _baudRate = 9600;
        _minIo = 15;
        _byteOrder = "ABCD";
        _editingRouteId = string.Empty;
        _protocols = new List<ProtocolDescriptorDto>();
        _ports = new List<SerialPortDto>();
    }

    private void OnProtocolChanged(ChangeEventArgs e)
    {
        _protocolId = e.Value?.ToString() ?? string.Empty;
        ProtocolDescriptorDto? p = SelectedProtocol;
        if (p is not null)
            _transportKind = p.DefaultTransport;
        NormalizeForTransport();
    }

    private void OnTransportChanged(ChangeEventArgs e)
    {
        _transportKind = e.Value?.ToString() ?? "Tcp";
        NormalizeForTransport();
    }

    /// <summary>
    /// 切换介质后，把被另一种介质清零的字段补回可用默认值。
    /// </summary>
    /// <remarks>
    /// 保存时按介质取舍字段：串口路由存 Port=0，TCP 路由存 BaudRate=0。
    /// 于是把一台串口设备改成 TCP 时，回填进表单的 Port 就是 0，
    /// 不补默认值会直接存出 <c>127.0.0.1:0</c> 这种连不上的端点，
    /// 而错误信息只说「invalid TCP endpoint」，看不出是端口被清零了。
    /// </remarks>
    private void NormalizeForTransport()
    {
        if (IsSerial)
        {
            if (_baudRate <= 0) _baudRate = 9600;
            if (_minIo < 0) _minIo = 15;
        }
        else if (_port <= 0)
        {
            _port = 502;
        }
    }

    private void CloseForm() => _showForm = false;

    // ========================================================================
    // 保存：只写本地配置，不建连接
    // ========================================================================

    /// <summary>
    /// 保存设备配置。<b>不会建立连接。</b>
    /// </summary>
    /// <remarks>
    /// 配置与连接分离，是因为现场的时间顺序就是分离的：
    /// 设备清单在 PLC 上电前就要录好，网关、网线、供电往往还没到位。
    /// 把注册塞进保存里，等于「PLC 不通电就没法建设备」。
    /// 连接由卡片上的「连接」或工具栏「一键连接」显式触发。
    /// </remarks>
    private async Task SaveDeviceAsync() => await SaveAsync(thenConnect: false).ConfigureAwait(true);

    /// <summary>保存后立即连接，供 PLC 已经在线时少点一次。</summary>
    private async Task SaveAndConnectAsync() => await SaveAsync(thenConnect: true).ConfigureAwait(true);

    private async Task SaveAsync(bool thenConnect)
    {
        if (string.IsNullOrWhiteSpace(_routeId))
        {
            _banner = "路由 ID 为必填";
            _bannerClass = "status-error";
            return;
        }
        if (string.IsNullOrWhiteSpace(_protocolId))
        {
            _banner = "请选择协议";
            _bannerClass = "status-error";
            return;
        }
        if (!IsSerial && string.IsNullOrWhiteSpace(_address))
        {
            _banner = "TCP 路由必须填写 IP";
            _bannerClass = "status-error";
            return;
        }
        if (!IsSerial && _port <= 0)
        {
            // 存出端口 0 会在连接时报「invalid TCP endpoint」，
            // 那条信息看不出是端口的问题，必须在这里拦下
            _banner = "TCP 端口必须大于 0";
            _bannerClass = "status-error";
            return;
        }
        if (IsSerial && string.IsNullOrWhiteSpace(_serialPort))
        {
            _banner = "串口路由必须填写端口名（来自宿主机器）";
            _bannerClass = "status-error";
            return;
        }

        string routeId = _routeId.Trim();

        // 新增时不能撞已有 ID：同一 ID 会直接覆盖掉另一台设备的配置
        if (!IsEditing &&
            Store.GetAll().Any(d => string.Equals(d.RouteId, routeId, StringComparison.OrdinalIgnoreCase)))
        {
            _banner = "路由 ID " + routeId + " 已存在，请换一个";
            _bannerClass = "status-error";
            return;
        }

        string transport = IsSerial ? "Serial" : "Tcp";
        WebDeviceRecord record = new()
        {
            RouteId = routeId,
            Name = string.IsNullOrWhiteSpace(_name) ? routeId : _name.Trim(),
            ProtocolId = _protocolId,
            TransportKind = transport,
            Address = IsSerial ? string.Empty : _address.Trim(),
            Port = IsSerial ? 0 : _port,
            Station = NeedsStation ? _station.Trim() : string.Empty,
            SerialPort = IsSerial ? _serialPort.Trim() : string.Empty,
            BaudRate = IsSerial ? _baudRate : 0,
            MinIoIntervalMs = IsSerial ? Math.Max(0, _minIo) : 0,
            ByteOrder = _byteOrder,
        };

        // 编辑一台已连接的设备：宿主拒绝重复 RouteId，改参数必须先注销再注册。
        // 不重连的话，界面显示的是新参数、实际跑的还是旧参数——这种分叉最难排查。
        bool wasConnected = Rows.Any(r =>
            string.Equals(r.RouteId, routeId, StringComparison.OrdinalIgnoreCase) && r.OnHost);

        Store.Upsert(record);
        Log.Info("Devices", (IsEditing ? "已更新配置 " : "已保存配置 ") + routeId);
        CloseForm();

        if (IsEditing && wasConnected)
        {
            // 改了配置且原本连着：先断再连，让新参数生效。
            // 断开失败也继续尝试连接——多半是宿主已经没有这条路由了。
            _busy = true;
            try
            {
                await Devices.DisconnectAsync(routeId).ConfigureAwait(true);
            }
            finally { _busy = false; }

            await ConnectAsync(ToRow(null, record, onHost: false)).ConfigureAwait(true);
            return;
        }

        if (thenConnect && Session.Online)
        {
            await ConnectAsync(ToRow(null, record, onHost: false)).ConfigureAwait(true);
            return;
        }

        _banner = "已保存 " + record.Name + "（未连接）。点卡片上的「连接」或工具栏「一键连接」建立连接。";
        _bannerClass = "status-info";
        await Session.RefreshRoutesAsync().ConfigureAwait(true);
    }

    private void AskRemove(DeviceRow row) => _pendingRemove = row;

    private async Task ConfirmRemoveAsync()
    {
        if (_pendingRemove is null) return;
        DeviceRow row = _pendingRemove;
        _pendingRemove = null;
        await RemoveAsync(row).ConfigureAwait(true);
    }

    private async Task RemoveAsync(DeviceRow row)
    {
        _busy = true;
        try
        {
            // 宿主离线、或宿主本来就没有这条路由，服务都会返回成功——
            // 这里要的终态是"它不在宿主上"，不是"必须亲手注销一次"。
            DeviceOperationResult result =
                await Devices.UnregisterForDeleteAsync(row.RouteId).ConfigureAwait(true);

            if (!result.Success)
            {
                // 注销失败就不删本地配置，否则界面上设备消失而宿主仍持有连接，
                // 且该 RouteId 再也无法重新注册
                _banner = "宿主注销失败: [" + result.ErrorCode + "] " + result.ErrorMessage + "（本地配置保留）";
                _bannerClass = "status-warn";
                return;
            }

            Store.Remove(row.RouteId);
            _banner = "已删除 " + row.Name;
            _bannerClass = "status-ok";
            Log.Info("Devices", "删除设备 " + row.RouteId);
            if (Session.Online)
                await Session.RefreshRoutesAsync().ConfigureAwait(true);
        }
        finally { _busy = false; }
    }

    public void Dispose() => Session.Changed -= OnChanged;

    private sealed record DeviceRow(
        string RouteId, string Name, string ProtocolId, string TransportKind,
        string Station, string Endpoint, bool OnHost, string ByteOrder);
}
