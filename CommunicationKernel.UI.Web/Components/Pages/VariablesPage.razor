@* -----------------------------------------------------------------------------
   文件: Components/Pages/VariablesPage.razor
   层级: UI 层 — 变量配置页（Blazor）
   作用: 管理 PLC 变量读写，支持逐条和批量操作。
   路由: /variables
   ----------------------------------------------------------------------------- *@

@page "/variables"
@rendermode InteractiveServer

@inject EngineHostGrpcClient Client

<PageTitle>变量配置 — CommunicationKernel</PageTitle>

<div class="page-var">

    <!-- 工具栏 -->
    <div class="toolbar">
        <h2 class="page-title">变量配置</h2>
        <button class="btn primary" @onclick="ReadAllAsync"
                disabled="@(Variables.Count == 0 || IsBusy)">
            ▶ 批量读取
        </button>
        <button class="btn ghost" @onclick="ShowAddForm">＋ 添加变量</button>
        @if (IsBusy) {
            <span class="busy-hint">处理中...</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage)) {
        <div class="status-msg @StatusColor">@StatusMessage</div>
    }

    <!-- 变量表格 -->
    <table class="data-table">
        <thead>
            <tr>
                <th>名称</th>
                <th>路由 ID</th>
                <th>地址</th>
                <th>长度(B)</th>
                <th>当前值</th>
                <th>写入值</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Variables) {
                <!-- 错误行添加红色背景样式 -->
                <tr class="@(row.IsError ? "row-error" : string.Empty)">
                    <td>@row.Name</td>
                    <td class="addr">@row.RouteId</td>
                    <td class="mono">@row.Address</td>
                    <td>@row.Length</td>
                    <!-- 当前值以等宽绿色显示 -->
                    <td class="val-green mono">@row.Value</td>
                    <td>
                        <!-- 写入值输入框，@bind 双向绑定 -->
                        <input class="write-input" @bind="row.WriteValue"
                               placeholder="十六进制值" />
                    </td>
                    <td>
                        <!-- 读取此行 -->
                        <button class="btn-sm ghost"
                                @onclick="() => ReadOneAsync(row)"
                                disabled="@IsBusy">
                            读取
                        </button>
                        <!-- 写入此行 -->
                        <button class="btn-sm primary"
                                @onclick="() => WriteOneAsync(row)"
                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(row.WriteValue))">
                            写入
                        </button>
                        <!-- 删除此行 -->
                        <button class="btn-sm danger"
                                @onclick="() => DeleteRow(row)">
                            删除
                        </button>
                    </td>
                </tr>
            }
            @if (!Variables.Any()) {
                <tr>
                    <td colspan="7" class="empty-cell">暂无变量，点击「添加变量」。</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- 添加变量表单 -->
    @if (ShowForm) {
        <div class="add-form-overlay" @onclick="HideAddForm">
            <div class="add-form" @onclick:stopPropagation>
                <div class="form-hd">
                    <h3>添加变量</h3>
                    <button class="close-btn" @onclick="HideAddForm">✕</button>
                </div>

                <label>变量名 *</label>
                <input @bind="EditName" placeholder="例如: 传送带速度" />

                <label>路由 ID *</label>
                <input @bind="EditRouteId" placeholder="例如: plc-001" />

                <label>协议地址 *</label>
                <input @bind="EditAddress" placeholder="例如: DB10.DBW0 / 40001" />

                <label>读取长度 (字节)</label>
                <input type="number" @bind="EditLength" />

                <div class="form-actions">
                    <button class="btn ghost" @onclick="HideAddForm">取消</button>
                    <button class="btn primary" @onclick="AddVariable"
                            disabled="@(string.IsNullOrWhiteSpace(EditName))">
                        添加
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {

    // -------------------------------------------------------------------------
    // 变量行模型
    // -------------------------------------------------------------------------

    /// <summary>变量行数据容器，Blazor 通过 StateHasChanged 刷新。</summary>
    private sealed class VariableRow {
        public string Name       { get; init; } = string.Empty;
        public string RouteId    { get; set;  } = string.Empty;
        public string Address    { get; set;  } = string.Empty;
        public int    Length     { get; set;  } = 2;
        public string Value      { get; set;  } = "--";
        public string WriteValue { get; set;  } = string.Empty;
        public bool   IsError    { get; set;  }
        public string LastUpdated { get; set; } = string.Empty;
    }

    // -------------------------------------------------------------------------
    // 状态
    // -------------------------------------------------------------------------

    private List<VariableRow> Variables    { get; set; } = new();
    private bool              IsBusy       { get; set; }
    private string            StatusMessage { get; set; } = string.Empty;
    private string            StatusColor   { get; set; } = string.Empty;
    private bool              ShowForm      { get; set; }

    // 表单字段
    private string EditName    { get; set; } = string.Empty;
    private string EditRouteId { get; set; } = string.Empty;
    private string EditAddress { get; set; } = string.Empty;
    private int    EditLength  { get; set; } = 2;

    // -------------------------------------------------------------------------
    // 操作
    // -------------------------------------------------------------------------

    /// <summary>读取单行变量。</summary>
    private async Task ReadOneAsync(VariableRow row) {
        IsBusy = true;
        try {
            ReadResultDto r = await Client.ReadAsync(row.RouteId, row.Address, row.Length)
                .ConfigureAwait(false);

            if (r.Success) {
                // 字节数组 → 十六进制字符串
                row.Value    = r.Data.Length > 0
                    ? BitConverter.ToString(r.Data).Replace('-', ' ')
                    : "(空)";
                row.IsError  = false;
                row.LastUpdated = DateTime.Now.ToString("HH:mm:ss");
            }
            else {
                row.Value   = $"ERR:{r.ErrorCode}";
                row.IsError = true;
            }
        }
        finally {
            IsBusy = false;
        }
    }

    /// <summary>写入单行变量：解析 WriteValue 十六进制字符串并写入。</summary>
    private async Task WriteOneAsync(VariableRow row) {
        // 解析十六进制（去空格后按两位切割）
        if (!TryParseHex(row.WriteValue, out byte[] data)) {
            StatusMessage = "写入值格式错误，请输入十六进制，例如: 00 FF 01";
            StatusColor   = "status-error";
            return;
        }

        IsBusy = true;
        try {
            WriteResultDto r = await Client.WriteAsync(row.RouteId, row.Address, data)
                .ConfigureAwait(false);

            if (r.Success) {
                StatusMessage = $"写入成功: {row.Name} @ {row.Address}";
                StatusColor   = "status-ok";
                row.IsError   = false;
            }
            else {
                StatusMessage = $"写入失败: [{r.ErrorCode}] {r.ErrorMessage}";
                StatusColor   = "status-error";
                row.IsError   = true;
            }
        }
        finally {
            IsBusy = false;
        }
    }

    /// <summary>批量读取所有变量（顺序执行，不并发）。</summary>
    private async Task ReadAllAsync() {
        IsBusy = true;
        int success = 0;
        try {
            foreach (VariableRow row in Variables) {
                ReadResultDto r = await Client.ReadAsync(row.RouteId, row.Address, row.Length)
                    .ConfigureAwait(false);

                if (r.Success) {
                    row.Value   = r.Data.Length > 0 ? BitConverter.ToString(r.Data).Replace('-', ' ') : "(空)";
                    row.IsError = false;
                    success++;
                }
                else {
                    row.Value   = $"ERR:{r.ErrorCode}";
                    row.IsError = true;
                }
            }
            StatusMessage = $"批量读取完成: {success}/{Variables.Count} 成功";
            StatusColor   = success == Variables.Count ? "status-ok" : "status-warn";
        }
        finally {
            IsBusy = false;
        }
    }

    private void AddVariable() {
        if (string.IsNullOrWhiteSpace(EditName))
            return;
        Variables.Add(new VariableRow {
            Name    = EditName,
            RouteId = EditRouteId,
            Address = EditAddress,
            Length  = EditLength,
        });
        HideAddForm();
    }

    private void DeleteRow(VariableRow row) => Variables.Remove(row);

    private void ShowAddForm() => ShowForm = true;

    private void HideAddForm() {
        ShowForm   = false;
        EditName   = string.Empty;
        EditAddress = string.Empty;
    }

    // -------------------------------------------------------------------------
    // 辅助
    // -------------------------------------------------------------------------

    private static bool TryParseHex(string input, out byte[] data) {
        string clean = input.Replace(" ", "").Trim();
        if (clean.Length == 0 || clean.Length % 2 != 0) { data = Array.Empty<byte>(); return false; }
        try {
            data = Enumerable.Range(0, clean.Length / 2)
                .Select(i => Convert.ToByte(clean.Substring(i * 2, 2), 16)).ToArray();
            return true;
        }
        catch { data = Array.Empty<byte>(); return false; }
    }
}
