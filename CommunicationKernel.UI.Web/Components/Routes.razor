@* -----------------------------------------------------------------------------
   文件: Components/Routes.razor
   层级: UI 层 — Blazor 路由
   作用: 扫描 @page 组件；未匹配时走同一套工业布局。
   ----------------------------------------------------------------------------- *@

<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h2,h1" />
    </Found>
    <NotFound>
        <PageTitle>页面未找到</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="empty-state">
                <div class="empty-title">页面不存在</div>
                <div class="empty-hint">请从左侧导航进入 MES 监控、设备或变量页。</div>
                <a class="btn primary" href="/">返回监控</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
