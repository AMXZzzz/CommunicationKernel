@* -----------------------------------------------------------------------------
   文件: Components/Layout/MainLayout.razor
   层级: UI 层 — 主布局
   作用: 顶栏 / 侧栏 / 状态栏。Host 在线状态来自 HostSession，不再靠 CascadingParameter。
   ----------------------------------------------------------------------------- *@

@inherits LayoutComponentBase
@inject HostSession Session
@inject NavigationManager Nav
@implements IDisposable

<div class="app-shell">
    <header class="titlebar">
        <button class="nav-toggle" type="button" @onclick="ToggleNav" aria-label="导航">
            <span></span><span></span><span></span>
        </button>
        <svg class="app-mark" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4" width="18" height="3" rx="1"/>
            <rect x="3" y="10.5" width="12" height="3" rx="1"/>
            <rect x="3" y="17" width="16" height="3" rx="1"/>
        </svg>
        <span class="app-name">CommunicationKernel</span>
        <span class="title-status">@PageTitle</span>
        <div class="titlebar-right">
            <span class="status-dot @(Session.Online ? "online" : "offline")"></span>
            <span class="status-text">
                @(Session.Online ? "Host 已连接" : "Host 离线")
            </span>
            <span class="status-addr" title="@Session.Address">@ShortAddress</span>
        </div>
    </header>

    @if (!Session.Online)
    {
        <div class="offline-banner">
            无法连接 Host.App（@Session.Address）。请确认宿主已启动，或到「系统设置」修改地址。
        </div>
    }

    <div class="main-area">
        <nav class="sidebar @(NavOpen ? "open" : null)">
            <div class="menu-header">导航</div>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All" @onclick="CloseNav">MES 监控</NavLink>
            <NavLink class="nav-item" href="/devices" @onclick="CloseNav">设备管理</NavLink>
            <NavLink class="nav-item" href="/variables" @onclick="CloseNav">变量配置</NavLink>
            <NavLink class="nav-item" href="/log" @onclick="CloseNav">通讯日志</NavLink>
            <NavLink class="nav-item" href="/settings" @onclick="CloseNav">系统设置</NavLink>
        </nav>
        @if (NavOpen)
        {
            <div class="nav-backdrop" @onclick="CloseNav"></div>
        }
        <main class="page-content">
            @Body
        </main>
    </div>

    <footer class="statusbar">
        <span>@(Session.Online ? "就绪 · " + Session.RouteCount + " 条路由" : (Session.LastError.Length > 0 ? Session.LastError : "未连接"))</span>
        <span class="version">Host @Session.HostVersion</span>
    </footer>
</div>

@code {
    private bool NavOpen { get; set; }

    private string PageTitle => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0] switch
    {
        "" or "/" => "MES 监控",
        "devices" => "设备管理",
        "variables" => "变量配置",
        "log" => "通讯日志",
        "settings" => "系统设置",
        _ => "通讯调试工具",
    };

    private string ShortAddress
    {
        get
        {
            string a = Session.Address ?? string.Empty;
            return a.Replace("http://", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("https://", "", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleNav() => NavOpen = !NavOpen;
    private void CloseNav() => NavOpen = false;

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
