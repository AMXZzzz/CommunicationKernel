{
  // ---------------------------------------------------------------------------
  // 文件: UI.Web/appsettings.json
  // 层级: UI 层 — Blazor Server
  // 作用: Web UI 连接 Host.App 的默认地址；可用环境变量覆盖。
  // ---------------------------------------------------------------------------
  "Host.App": {
    // 未配置时 Program.cs 回落 http://localhost:5000
    "Address": "http://localhost:5000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
