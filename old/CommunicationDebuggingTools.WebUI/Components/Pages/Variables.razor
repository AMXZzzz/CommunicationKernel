@page "/variables"
@implements IDisposable
@using CommunicationDebuggingTools.Core.Enums
@using CommunicationDebuggingTools.Core.Models
@using System.IO
@using System.Text
@inject Services.EngineGateway Gateway
@inject IJSRuntime JS

<PageTitle>变量配置</PageTitle>

<div class="page-titlebar">
    <div>
        <h3>变量配置</h3>
        <div class="page-subtitle">统一管理变量读写、质量与批量导入导出</div>
    </div>
    <div class="status-chip @(Gateway.IsConnected ? "ok" : "error")">
        @(Gateway.IsConnected ? "EngineHost 在线" : "EngineHost 离线")
    </div>
</div>

<div class="var-layout">
    <div class="device-panel">
        <div class="panel-hd">
            <span>设备列表</span>
            <span class="count">@Gateway.Devices.Count</span>
        </div>
        <div class="device-list">
            @foreach (var device in Gateway.Devices) {
                <div class="dev-item @(device.Id == _selectedDeviceId ? "active" : "")" @onclick="() => SelectDevice(device.Id)">
                    <div class="n">
                        <span class="dot @(device.IsConnected ? "on" : "off")"></span>
                        @device.Name
                    </div>
                    <div class="sub">@(string.IsNullOrWhiteSpace(device.Model) ? device.Protocol : device.Model)</div>
                    <div class="tag-count">@GetDeviceVariableCount(device.Id) 个变量</div>
                </div>
            }
        </div>
    </div>

    <div class="var-panel">
        <div class="var-hd">
            <div class="var-hd-main">
                <div class="dev-name">@SelectedDeviceName</div>
                <div class="dev-meta">@SelectedDeviceMeta</div>
            </div>
            <div class="actions">
                <button class="t-btn" @onclick="ExportCsvAsync">↓ 导出 CSV</button>
                <label class="t-btn" style="cursor:pointer;display:inline-flex;align-items:center;">
                    ↑ 导入 CSV
                    <InputFile OnChange="ImportCsvAsync" accept=".csv" style="display:none;" />
                </label>
                <button class="t-btn primary" @onclick="OpenAddDialog">+ 添加变量</button>
            </div>
        </div>

        <div class="tabs">
            @foreach (var tab in VariableTabs) {
                <div class="tab @(string.Equals(_activeTab, tab.Key, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                     @onclick="() => SetActiveTab(tab.Key)">@tab.Label (@GetTabCount(tab.Key))</div>
            }
        </div>

        <div class="var-body">
            <table class="var-table">
                <thead>
                <tr>
                    @if (_isSelectMode) {
                        <th style="width:42px;">选</th>
                    }
                    <th>#</th>
                    <th>显示名称</th>
                    <th>地址</th>
                    <th>类型</th>
                    <th>读写</th>
                    <th>实时值</th>
                    <th style="min-width:130px;">写入</th>
                    <th>单位</th>
                    <th>分类</th>
                    <th>操作</th>
                </tr>
                </thead>
                <tbody>
                @{ var rowIndex = 0; }
                @foreach (var v in GetVisibleVariables()) {
                    rowIndex++;
                    <tr>
                        @if (_isSelectMode) {
                            <td>
                                <input type="checkbox"
                                       checked="@_selectedIds.Contains(v.Id)"
                                       @onchange="args => ToggleSelect(v.Id, args)" />
                            </td>
                        }
                        <td>@rowIndex</td>
                        <td class="name">@v.Name</td>
                        <td class="addr">@v.Address</td>
                        <td><span class="type @GetTypeCssClass(v.DataType)">@v.DataType</span></td>
                        <td><span class="rw @GetAccessCssClass(v.Access)">@GetAccessText(v.Access)</span></td>
                        <td>
                            <!-- 实时值：始终显示，只读变量也看到当前值 -->
                            <span class="live-val @GetLiveValueClass(v)">@GetLiveValueText(v)</span>
                        </td>
                        <td>
                            <!-- 写入：独立列，只对可写变量显示编辑器 -->
                            @if (v.Access != VariableAccess.ReadOnly) {
                                <div class="write-inline">
                                    <input class="write-input"
                                           value="@GetWriteBufferValue(v.Id)"
                                           placeholder="输入值"
                                           @oninput="args => SetWriteBufferValue(v.Id, args.Value?.ToString())"
                                           @onkeydown="args => HandleWriteKeyDown(v.Id, args)" />
                                    <button class="write-btn" @onclick="() => WriteAsync(v.Id)">写入</button>
                                </div>
                            }
                        </td>
                        <td>@GetUnitText(v)</td>
                        <td><span class="cat @GetCategoryCssClass(v)">@GetCategoryText(v)</span></td>
                        <td>
                            <div class="row-btns">
                                <button class="row-btn" @onclick="() => Edit(v)">✎</button>
                                <button class="row-btn del" @onclick="() => ConfirmSingleDelete(v.Id)">×</button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="hint-bar @(_showHint ? "show" : string.Empty)">
            <div class="hint-body">
                · <b>R</b> 只读 — 仅实时显示，供监控使用<br>
                · <b>W</b> 只写 — 可下发到设备<br>
                · <b>R/W</b> 读写 — 既显示也可写入
            </div>
        </div>

        <div class="var-ft">
            <span>共 @GetVisibleVariables().Count() 个变量</span>
            <span>只读 @GetReadOnlyCount()</span>
            <span>可写 @GetWriteableCount()</span>
            <span>实时刷新中</span>
            <button class="expand-btn @(_showHint ? "open" : string.Empty)" @onclick="ToggleHint">^</button>
        </div>
    </div>
</div>

@if (_showEditDialog) {
    <div class="overlay">
        <div class="dialog-panel dialog-edit">
            <h4>@(_editingId == null ? "新增变量" : "编辑变量")</h4>
            <div class="grid-2" style="margin-bottom:12px;">
                <div class="field">
                    <label>所属设备</label>
                    <select @bind="_editor.DeviceId">
                        @foreach (var d in Gateway.Devices) {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>变量名称</label>
                    <input @bind="_editor.Name" />
                </div>
                <div class="field">
                    <label>地址</label>
                    <input @bind="_editor.Address" />
                </div>
                <div class="field">
                    <label>数据类型</label>
                    <select @bind="_editor.DataType">
                        @foreach (var dt in Enum.GetValues<VariableDataType>()) {
                            <option value="@dt">@dt</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>变量类型</label>
                    <select @bind="_editor.Category">
                        @foreach (var type in VariableTypeOptions) {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>访问权限</label>
                    <select @bind="_editor.Access">
                        @foreach (var ac in Enum.GetValues<VariableAccess>()) {
                            <option value="@ac">@ac</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>长度</label>
                    <input type="number" @bind="_editor.Length" />
                </div>
            </div>
            <div class="btn-row">
                <button class="primary" @onclick="SaveAsync">@(_editingId == null ? "新增变量" : "保存修改")</button>
                <button @onclick="CloseEditDialog">取消</button>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm) {
    <div class="overlay">
        <div class="dialog-panel">
            <h4>删除确认</h4>
            <p>@_deleteMessage</p>
            <div class="btn-row">
                <button class="danger" @onclick="DeleteConfirmedAsync">确认删除</button>
                <button @onclick="CloseDeleteDialog">取消</button>
            </div>
        </div>
    </div>
}

@code {
    private VariableEditor _editor = new();
    private string? _editingId;
    private string? _notice;
    private bool _noticeIsError;
    private readonly Dictionary<string, string> _writeBuffer = new();
    // _writeBufferDirty: 记录用户手动编辑过的行，状态刷新时不覆盖
    private readonly HashSet<string> _writeBufferDirty = new(StringComparer.OrdinalIgnoreCase);

    private static readonly (string Key, string Label)[] VariableTabs = [
        ("all", "全部"),
        ("readonly", "只读"),
        ("writeonly", "可写"),
        ("status", "状态点"),
        ("data", "监控数据")
    ];

    private static readonly string[] VariableTypeOptions = [
        "状态点",
        "监控数据"
    ];

    private bool _isSelectMode;
    private readonly HashSet<string> _selectedIds = new(StringComparer.OrdinalIgnoreCase);
    private bool _showEditDialog;
    private bool _showDeleteConfirm;
    private bool _deleteIsBatch;
    private string? _deleteId;
    private string _deleteMessage = string.Empty;
    private string? _selectedDeviceId;
    private string _activeTab = "all";
    private bool _showHint = true;

    protected override void OnInitialized () {
        Gateway.StateChanged += OnGatewayStateChanged;
        SyncWriteBuffer();
        EnsureSelectedDevice();
        PickDefaultDevice();
    }

    public void Dispose () {
        Gateway.StateChanged -= OnGatewayStateChanged;
    }

    private async Task SaveAsync () {
        ClearNotice();
        try {
            if (string.IsNullOrWhiteSpace(_editor.Name) || string.IsNullOrWhiteSpace(_editor.Address)) {
                SetError("变量名称和地址不能为空");
                return;
            }
            if (string.IsNullOrWhiteSpace(_editor.DeviceId)) {
                SetError("请先选择设备");
                return;
            }

            var entity = _editor.ToEntity(_editingId);
            if (string.IsNullOrWhiteSpace(_editingId)) {
                await Gateway.AddVariableAsync(entity);
                SetOk("新增变量成功");
            } else {
                await Gateway.UpdateVariableAsync(entity);
                SetOk("保存变量成功");
            }
            CloseEditDialog();
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void OpenAddDialog () {
        _editingId = null;
        _editor = new VariableEditor();
        PickDefaultDevice();
        _showEditDialog = true;
    }

    private void Edit (VariableItem v) {
        _editingId = v.Id;
        _editor = VariableEditor.From(v);
        _showEditDialog = true;
    }

    private void CloseEditDialog () {
        _editingId = null;
        _editor = new VariableEditor();
        PickDefaultDevice();
        _showEditDialog = false;
    }

    private void EnterSelectMode () {
        _isSelectMode = true;
        _selectedIds.Clear();
    }

    private void CancelSelectMode () {
        _isSelectMode = false;
        _selectedIds.Clear();
    }

    private void ToggleSelect (string id, ChangeEventArgs args) {
        bool isChecked = args.Value is bool b && b;
        if (isChecked) {
            _selectedIds.Add(id);
        } else {
            _selectedIds.Remove(id);
        }
    }

    private void ConfirmSingleDelete (string id) {
        _deleteIsBatch = false;
        _deleteId = id;
        _deleteMessage = "确认删除该变量？";
        _showDeleteConfirm = true;
    }

    private void ConfirmBatchDelete () {
        if (_selectedIds.Count == 0) {
            SetError("请先选择要删除的变量");
            return;
        }

        _deleteIsBatch = true;
        _deleteId = null;
        _deleteMessage = $"确认删除选中的 {_selectedIds.Count} 个变量？";
        _showDeleteConfirm = true;
    }

    private async Task DeleteConfirmedAsync () {
        ClearNotice();
        try {
            if (_deleteIsBatch) {
                var ids = _selectedIds.ToList();
                foreach (var id in ids) {
                    await Gateway.RemoveVariableAsync(id);
                }
                _selectedIds.Clear();
                _isSelectMode = false;
                SetOk("批量删除完成");
            } else if (!string.IsNullOrWhiteSpace(_deleteId)) {
                await Gateway.RemoveVariableAsync(_deleteId);
                SetOk("删除变量成功");
            }

            CloseDeleteDialog();
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void CloseDeleteDialog () {
        _showDeleteConfirm = false;
        _deleteId = null;
        _deleteMessage = string.Empty;
    }

    private void SelectDevice (string deviceId) {
        _selectedDeviceId = deviceId ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(_selectedDeviceId)) {
            _editor.DeviceId = _selectedDeviceId;
        }
    }

    private void SetActiveTab (string key) {
        _activeTab = string.IsNullOrWhiteSpace(key) ? "all" : key;
    }

    private void ToggleHint () {
        _showHint = !_showHint;
    }


    private IEnumerable<VariableItem> GetVisibleVariables () {
        IEnumerable<VariableItem> variables = Gateway.Variables;
        if (!string.IsNullOrWhiteSpace(_selectedDeviceId)) {
            variables = variables.Where(v => string.Equals(v.DeviceId, _selectedDeviceId, StringComparison.OrdinalIgnoreCase));
        }

        return _activeTab switch {
            "readonly" => variables.Where(v => v.Access == VariableAccess.ReadOnly),
            "writeonly" => variables.Where(v => v.Access == VariableAccess.WriteOnly),
            "status" => variables.Where(IsStatusPointVariable),
            "data" => variables.Where(v => !IsStatusPointVariable(v)),
            _ => variables
        };
    }

    private int GetTabCount (string key) {
        IEnumerable<VariableItem> variables = Gateway.Variables;
        if (!string.IsNullOrWhiteSpace(_selectedDeviceId)) {
            variables = variables.Where(v => string.Equals(v.DeviceId, _selectedDeviceId, StringComparison.OrdinalIgnoreCase));
        }

        return key switch {
            "readonly" => variables.Count(v => v.Access == VariableAccess.ReadOnly),
            "writeonly" => variables.Count(v => v.Access == VariableAccess.WriteOnly),
            "status" => variables.Count(IsStatusPointVariable),
            "data" => variables.Count(v => !IsStatusPointVariable(v)),
            _ => variables.Count()
        };
    }

    private int GetDeviceVariableCount (string deviceId) {
        return Gateway.Variables.Count(v => string.Equals(v.DeviceId, deviceId, StringComparison.OrdinalIgnoreCase));
    }

    private int GetReadOnlyCount () {
        return GetVisibleVariables().Count(v => v.Access == VariableAccess.ReadOnly);
    }

    private int GetWriteableCount () {
        return GetVisibleVariables().Count(v => v.Access != VariableAccess.ReadOnly);
    }

    private string SelectedDeviceName => GetSelectedDevice()?.Name ?? "变量配置";

    private string SelectedDeviceMeta {
        get {
            var device = GetSelectedDevice();
            if (device == null) {
                return "请选择左侧设备查看变量";
            }

            return $"{device.Model} · {device.Ip}:{device.Port} · {device.Protocol}";
        }
    }

    private CommunicationDebuggingTools.Core.Models.DeviceInfo? GetSelectedDevice () {
        if (!string.IsNullOrWhiteSpace(_selectedDeviceId)) {
            var selected = Gateway.Devices.FirstOrDefault(d => string.Equals(d.Id, _selectedDeviceId, StringComparison.OrdinalIgnoreCase));
            if (selected != null) {
                return selected;
            }
        }

        return Gateway.Devices.FirstOrDefault();
    }

    private static bool IsStatusPointVariable (VariableItem variable) {
        return variable?.DataType == VariableDataType.Bool;
    }


    private async Task WriteAsync (string id) {
        ClearNotice();
        try {
            _writeBuffer.TryGetValue(id, out var val);
            var result = await Gateway.WriteVariableAsync(id, val ?? "");
            SetNotice(result.Success ? "写入成功" : result.ErrorMessage, !result.Success);
            if (result.Success) {
                _writeBufferDirty.Remove(id);
            }
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task RefreshAsync () {
        ClearNotice();
        try {
            await Gateway.RefreshNowAsync();
            SetOk("刷新完成");
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task ExportCsvAsync () {
        ClearNotice();
        try {
            var sb = new StringBuilder();
            sb.AppendLine("Id,DeviceId,Name,Address,DataType,Access,Length,Unit,Category,Description,ScanRateMs,IsPollingEnabled");
            foreach (var v in Gateway.Variables) {
                sb.AppendLine(string.Join(",", new[] {
                    CsvEscape(v.Id),
                    CsvEscape(v.DeviceId),
                    CsvEscape(v.Name),
                    CsvEscape(v.Address),
                    CsvEscape(v.DataType.ToString()),
                    CsvEscape(v.Access.ToString()),
                    CsvEscape(v.Length.ToString()),
                    CsvEscape(v.Unit),
                    CsvEscape(v.Category),
                    CsvEscape(v.Description),
                    CsvEscape(v.ScanRateMs.ToString()),
                    CsvEscape(v.IsPollingEnabled.ToString())
                }));
            }

            string fileName = $"variables-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("cdtDownload.downloadTextFile", fileName, sb.ToString(), "text/csv;charset=utf-8;");
            SetOk("导出成功");
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task ImportCsvAsync (InputFileChangeEventArgs e) {
        ClearNotice();
        try {
            var file = e.File;
            if (file == null) {
                SetError("未选择文件");
                return;
            }

            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, true);
            string content = await reader.ReadToEndAsync();
            var lines = content.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n', StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1) {
                SetError("CSV 内容为空");
                return;
            }

            var header = ParseCsvLine(lines[0]);
            var index = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            for (int i = 0; i < header.Count; i++) {
                index[header[i]] = i;
            }

            int imported = 0;
            int failed = 0;
            for (int i = 1; i < lines.Length; i++) {
                var cols = ParseCsvLine(lines[i]);
                if (cols.Count == 0) continue;

                try {
                    string id = GetCol(cols, index, "Id");
                    string deviceId = GetCol(cols, index, "DeviceId");
                    string name = GetCol(cols, index, "Name");
                    string address = GetCol(cols, index, "Address");
                    if (string.IsNullOrWhiteSpace(deviceId) || string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(address)) {
                        failed++;
                        continue;
                    }

                    var dataType = ParseEnum(GetCol(cols, index, "DataType"), VariableDataType.Int16);
                    var item = new VariableItem {
                        Id = string.IsNullOrWhiteSpace(id) ? Guid.NewGuid().ToString("N") : id,
                        DeviceId = deviceId,
                        Name = name,
                        Address = address,
                        DataType = dataType,
                        Access = ParseEnum(GetCol(cols, index, "Access"), VariableAccess.ReadWrite),
                        Length = ParseInt(GetCol(cols, index, "Length"), 0),
                        Unit = GetCol(cols, index, "Unit"),
                        Category = NormalizeVariableType(GetCol(cols, index, "Category"), dataType),
                        Description = GetCol(cols, index, "Description"),
                        ScanRateMs = ParseInt(GetCol(cols, index, "ScanRateMs"), 1000),
                        IsPollingEnabled = ParseBool(GetCol(cols, index, "IsPollingEnabled"), true)
                    };

                    bool exists = Gateway.Variables.Any(x => x.Id == item.Id);
                    if (exists) {
                        await Gateway.UpdateVariableAsync(item);
                    } else {
                        await Gateway.AddVariableAsync(item);
                    }
                    imported++;
                } catch {
                    failed++;
                }
            }

            await Gateway.RefreshNowAsync();
            SetNotice($"导入完成：成功 {imported} 条，失败 {failed} 条", failed > 0);
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private static string CsvEscape (string value) {
        string v = value ?? string.Empty;
        if (v.Contains('"')) v = v.Replace("\"", "\"\"");
        if (v.Contains(',') || v.Contains('\n') || v.Contains('\r') || v.Contains('"')) {
            return $"\"{v}\"";
        }
        return v;
    }

    private static List<string> ParseCsvLine (string line) {
        var result = new List<string>();
        if (line == null) return result;

        var sb = new StringBuilder();
        bool inQuotes = false;
        for (int i = 0; i < line.Length; i++) {
            char c = line[i];
            if (c == '"') {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"') {
                    sb.Append('"');
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }
            } else if (c == ',' && !inQuotes) {
                result.Add(sb.ToString());
                sb.Clear();
            } else {
                sb.Append(c);
            }
        }
        result.Add(sb.ToString());
        return result;
    }

    private static string GetCol (IReadOnlyList<string> cols, IReadOnlyDictionary<string, int> index, string key) {
        if (!index.TryGetValue(key, out int idx)) return string.Empty;
        if (idx < 0 || idx >= cols.Count) return string.Empty;
        return cols[idx]?.Trim() ?? string.Empty;
    }

    private static int ParseInt (string value, int fallback) {
        return int.TryParse(value, out var n) ? n : fallback;
    }

    private static bool ParseBool (string value, bool fallback) {
        return bool.TryParse(value, out var b) ? b : fallback;
    }

    private static T ParseEnum<T> (string value, T fallback) where T : struct {
        return Enum.TryParse<T>(value, true, out var parsed) ? parsed : fallback;
    }

    private void OnGatewayStateChanged () {
        _ = InvokeAsync(() => {
            SyncWriteBuffer();
            EnsureSelectedDevice();
            PickDefaultDevice();
            StateHasChanged();
        });
    }

    private string GetWriteBufferValue (string id) {
        if (!_writeBuffer.TryGetValue(id, out var value)) {
            return string.Empty;
        }

        return value;
    }

    private void HandleWriteKeyDown (string id, KeyboardEventArgs args) {
        if (string.Equals(args?.Key, "Enter", StringComparison.OrdinalIgnoreCase)) {
            _ = WriteAsync(id);
        }
    }

    private void SetWriteBufferValue (string id, string? value) {
        if (string.IsNullOrWhiteSpace(id)) {
            return;
        }

        _writeBuffer[id] = value ?? string.Empty;
        _writeBufferDirty.Add(id);
    }



    private void SyncWriteBuffer () {
        // 刷新缓冲区：跳过用户已手动编辑的行，其余同步最新实时值
        foreach (var item in Gateway.Variables) {
            if (item == null || string.IsNullOrWhiteSpace(item.Id)) continue;
            if (_writeBufferDirty.Contains(item.Id)) continue;
            _writeBuffer[item.Id] = item.LastValue?.ToString() ?? string.Empty;
        }
    }


    private void EnsureSelectedDevice () {
        if (!string.IsNullOrWhiteSpace(_selectedDeviceId) && Gateway.Devices.Any(d => string.Equals(d.Id, _selectedDeviceId, StringComparison.OrdinalIgnoreCase))) {
            return;
        }

        _selectedDeviceId = Gateway.Devices.FirstOrDefault()?.Id ?? string.Empty;
    }

    private void PickDefaultDevice () {
        if (!string.IsNullOrWhiteSpace(_editor.DeviceId)) return;
        _editor.DeviceId = !string.IsNullOrWhiteSpace(_selectedDeviceId) ? _selectedDeviceId : Gateway.Devices.FirstOrDefault()?.Id ?? string.Empty;
    }

    private static string GetAccessText (VariableAccess access) {
        return access switch {
            VariableAccess.ReadOnly => "R",
            VariableAccess.WriteOnly => "W",
            _ => "R/W"
        };
    }

    private static string GetAccessCssClass (VariableAccess access) {
        return access switch {
            VariableAccess.ReadOnly => "r",
            VariableAccess.WriteOnly => "w",
            _ => "rw"
        };
    }

    private static string GetTypeCssClass (VariableDataType type) {
        return type switch {
            VariableDataType.Bool => "bool",
            VariableDataType.Float or VariableDataType.Double => "float",
            VariableDataType.String => "string",
            _ => string.Empty
        };
    }

    private static string NormalizeVariableType (string variableType, VariableDataType dataType) {
        if (dataType == VariableDataType.Bool) {
            return "状态点";
        }

        if (string.IsNullOrWhiteSpace(variableType) || string.Equals(variableType, "状态点", StringComparison.OrdinalIgnoreCase)) {
            return "监控数据";
        }

        return variableType.Trim();
    }

    private static string GetCategoryText (VariableItem variable) {
        if (variable == null) {
            return "监控数据";
        }

        if (IsStatusPointVariable(variable)) {
            return "状态点";
        }

        if (string.IsNullOrWhiteSpace(variable.Category) || string.Equals(variable.Category, "状态点", StringComparison.OrdinalIgnoreCase)) {
            return "监控数据";
        }

        return variable.Category;
    }

    private static string GetCategoryCssClass (VariableItem variable) {
        if (IsStatusPointVariable(variable)) {
            return "status";
        }

        string category = variable?.Category ?? string.Empty;
        if (category.Contains("宽度", StringComparison.OrdinalIgnoreCase)) {
            return "width";
        }

        return "data";
    }

    private static string GetUnitText (VariableItem variable) {
        return string.IsNullOrWhiteSpace(variable?.Unit) ? "—" : variable.Unit;
    }

    private static string GetLiveValueText (VariableItem variable) {
        return variable?.LastValue?.ToString() ?? string.Empty;
    }

    private static string GetLiveValueClass (VariableItem variable) {
        if (variable?.DataType == VariableDataType.Bool) {
            string value = variable.LastValue?.ToString() ?? string.Empty;
            if (value.Equals("true", StringComparison.OrdinalIgnoreCase) || value == "1" || value.Equals("on", StringComparison.OrdinalIgnoreCase)) {
                return "bool-on";
            }
        }

        return string.Empty;
    }

    private void SetOk (string msg) => SetNotice(msg, false);
    private void SetError (string msg) => SetNotice(msg, true);
    private void SetNotice (string msg, bool isError) {
        _notice = msg;
        _noticeIsError = isError;
    }
    private void ClearNotice () {
        _notice = null;
        _noticeIsError = false;
    }

    private sealed class VariableEditor {
        public string DeviceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public VariableDataType DataType { get; set; } = VariableDataType.Int16;
        public string Category { get; set; } = "监控数据";
        public VariableAccess Access { get; set; } = VariableAccess.ReadWrite;
        public int Length { get; set; }

        public VariableItem ToEntity (string? id) {
            return new VariableItem {
                Id = id ?? Guid.NewGuid().ToString("N"),
                DeviceId = DeviceId,
                Name = Name?.Trim() ?? string.Empty,
                Address = Address?.Trim() ?? string.Empty,
                DataType = DataType,
                Category = NormalizeVariableType(Category, DataType),
                Access = Access,
                Length = Length
            };
        }

        public static VariableEditor From (VariableItem v) {
            return new VariableEditor {
                DeviceId = v.DeviceId,
                Name = v.Name,
                Address = v.Address,
                DataType = v.DataType,
                Category = NormalizeVariableType(v.Category, v.DataType),
                Access = v.Access,
                Length = v.Length
            };
        }
    }
}
