@inherits LayoutComponentBase
@implements IDisposable
@inject Services.EngineGateway Gateway
@inject Services.WebUiSettingsStore SettingsStore

<div class="titlebar">
    <div class="title-left">Communication Debugging Tools V0.1</div>
    <div class="title-center">
        <span class="dot @(Gateway.IsConnected ? "online" : "offline")"></span>
        <span>@(Gateway.IsConnected ? "EngineHost在线" : "EngineHost离线")</span>
    </div>
    <div class="title-right">
        <span>中 / EN</span>
        <span>全屏</span>
        <span class="win-btn"></span>
        <span class="win-btn"></span>
        <span class="win-btn close"></span>
    </div>
</div>

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main">
        <section class="content">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    发生未处理异常。
    <a href="." class="reload">重新加载</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync () {
        Gateway.StateChanged += OnGatewayStateChanged;
        await Gateway.InitializeAsync(SettingsStore.Load().HostAddress);
    }

    public void Dispose () {
        Gateway.StateChanged -= OnGatewayStateChanged;
    }

    private void OnGatewayStateChanged () {
        _ = InvokeAsync(StateHasChanged);
    }
}
