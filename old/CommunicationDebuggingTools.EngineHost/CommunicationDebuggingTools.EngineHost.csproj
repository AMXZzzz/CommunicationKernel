<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CommunicationDebuggingTools.EngineHost</RootNamespace>
    <AssemblyName>CommunicationDebuggingTools.EngineHost</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CommunicationDebuggingTools.Contracts\CommunicationDebuggingTools.Contracts.csproj" />
    <ProjectReference Include="..\CommunicationDebuggingTools.Business\CommunicationDebuggingTools.Business.csproj" />
    <ProjectReference Include="..\CommunicationDebuggingTools.Core\CommunicationDebuggingTools.Core.csproj" />
  </ItemGroup>
  <!-- 与 WPF 相同：构建后复制协议插件 -->
  <Target Name="CopyPlugins" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)plugins" />
    <ItemGroup>
      <_PluginDlls Include="$(SolutionDir)Plugin.ModbusTcp\bin\$(Configuration)\net8.0\Plugin.ModbusTcp.dll"
                   Condition="Exists('$(SolutionDir)Plugin.ModbusTcp\bin\$(Configuration)\net8.0\Plugin.ModbusTcp.dll')" />
      <_PluginDlls Include="$(SolutionDir)Plugin.Panasonic\bin\$(Configuration)\net8.0\Plugin.Panasonic.dll"
                   Condition="Exists('$(SolutionDir)Plugin.Panasonic\bin\$(Configuration)\net8.0\Plugin.Panasonic.dll')" />
      <_PluginDlls Include="$(SolutionDir)Plugin.SiemensS7\bin\$(Configuration)\net8.0\Plugin.SiemensS7.dll"
                   Condition="Exists('$(SolutionDir)Plugin.SiemensS7\bin\$(Configuration)\net8.0\Plugin.SiemensS7.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginDlls)" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
