<UserControl x:Class="CommunicationDebuggingTools.Views.Controls.NavSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:device="clr-namespace:CommunicationDebuggingTools.Views.Pages.Device"
             xmlns:monitor="clr-namespace:CommunicationDebuggingTools.Views.Pages.Monitor"
             xmlns:variable="clr-namespace:CommunicationDebuggingTools.Views.VariableConfigPage"
             xmlns:log="clr-namespace:CommunicationDebuggingTools.Views.Pages.Log"
             xmlns:settings="clr-namespace:CommunicationDebuggingTools.Views.Pages.Settings">

    <Border x:Name="SidebarBorder"
            ClipToBounds="True"
            Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="0,0,1,0">
        <Border.Style>
            <Style TargetType="Border">
                <!-- 默认展开；不要再在 Border 上写 Width= 属性 -->
                <Setter Property="Width"
                        Value="{StaticResource SF.ControlsSize.SidebarExpanded}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleSidebar}"
                                 Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     To="{StaticResource SF.ControlsSize.SidebarCollapsed}"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     To="{StaticResource SF.ControlsSize.SidebarExpanded}"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <ToggleButton x:Name="btnToggleSidebar"
                          DockPanel.Dock="Top"
                          Content="☰  菜单"
                          Height="42"
                          Background="Transparent"
                          Foreground="{StaticResource SF.Brush.Text.Primary}"
                          BorderThickness="0"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          Padding="12,0"
                          Cursor="Hand"
                          FontSize="14"
                          FocusVisualStyle="{x:Null}"/>

            <StackPanel Margin="0,8,0,0">
                <RadioButton Content="MES监控"
                             Tag="{x:Type monitor:DataMonitorPage}"
                             GroupName="Nav"
                             IsChecked="True"
                             Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                             Checked="Nav_Checked"/>
                <RadioButton Content="变量配置"
                             Tag="{x:Type variable:VariableConfigPage}"
                             GroupName="Nav"
                             Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                             Checked="Nav_Checked"/>
                <RadioButton Content="设备管理"
                             Tag="{x:Type device:DevicePage}"
                             GroupName="Nav"
                             Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                             Checked="Nav_Checked"/>
                <RadioButton Content="日志记录"
                             Tag="{x:Type log:LogPage}"
                             GroupName="Nav"
                             Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                             Checked="Nav_Checked"/>
                <RadioButton Content="系统设置"
                             Tag="{x:Type settings:SettingsPage}"
                             GroupName="Nav"
                             Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                             Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>