<UserControl x:Class="CommunicationDebuggingTools.Views.VariableConfigPage.Controls.VariableDeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <!-- 标题 -->
            <Border DockPanel.Dock="Top"
                    Padding="16,12"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="设备列表"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource SF.Brush.Bg.Hover}"
                            CornerRadius="8"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtCount"
                                   Text="0"
                                   FontSize="11"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 列表：自带滚动，响应滚轮 -->
            <ListBox x:Name="listDevices"
                     BorderThickness="0"
                     Background="{StaticResource SF.Brush.Bg.App}"
                     Padding="8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="ListDevices_SelectionChanged"
                     FocusVisualStyle="{x:Null}">

                <!-- 用深色纵向滚动条模板 -->
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          Style="{StaticResource SF.Style.ScrollViewer.VerticalBar}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            BorderThickness="1"
                                            BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource SF.Brush.Bg.TopBar}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource SF.Brush.Border.Default}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource SF.Brush.Var.DeviceSelectedBg}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource SF.Brush.Var.DeviceSelectedBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8"
                                     VerticalAlignment="Top"
                                     Margin="0,4,10,0"
                                     Fill="{Binding StatusBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding SubTitle}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                <TextBlock Text="{Binding VariableCountText}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>