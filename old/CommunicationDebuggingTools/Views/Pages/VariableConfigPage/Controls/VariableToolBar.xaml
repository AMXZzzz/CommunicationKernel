<UserControl x:Class="CommunicationDebuggingTools.Views.VariableConfigPage.Controls.VariableToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：导入 / 导出 / 实时刷新 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="导入"
                        Style="{StaticResource SF.Style.DarkButton}"
                        Click="BtnImport_Click"/>
                <Button Content="导出"
                        Style="{StaticResource SF.Style.DarkButton}"
                        Click="BtnExport_Click"/>
                <!-- 绿色实时刷新（可用 Success 色；无独立样式时先用 Primary 再换资源） -->
                <Button x:Name="btnLive"
                        Content="● 实时刷新"
                        Style="{StaticResource SF.Style.PrimaryButton}"
                        Background="{StaticResource SF.Brush.Status.Success}"
                        BorderBrush="{StaticResource SF.Brush.Status.Success}"
                        Click="BtnLive_Click"/>
            </StackPanel>

            <!-- 右：实时状态 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Opacity="1"
                        Background="{StaticResource SF.Brush.Var.HeaderBg}"
                        BorderBrush="{StaticResource SF.Brush.Var.PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,3"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                 Fill="{StaticResource SF.Brush.Status.Success}"
                                 VerticalAlignment="Center"/>
                        
                        <TextBlock Text="实时"
                                   FontSize="11"
                                   Foreground="{StaticResource SF.Brush.Status.Success}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="500ms"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>