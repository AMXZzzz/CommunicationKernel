<Page x:Class="CommunicationDebuggingTools.Views.Pages.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="系统设置">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="560">

            <!-- 标题 -->
            <TextBlock Text="系统设置"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource SF.Brush.Text.Primary}"
                       Margin="0,0,0,24"/>

            <!-- ─── EngineHost 连接 ─── -->
            <Border Background="{StaticResource SF.Brush.Bg.Card}"
                    CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="EngineHost 连接"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"
                               Margin="0,0,0,12"/>

                    <StackPanel x:Name="pnlRemote" Margin="0,0,0,0">

                        <TextBlock Text="EngineHost 地址"
                                   FontSize="12"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtAddress"
                                     Grid.Column="0"
                                     Text="http://127.0.0.1:5100"
                                     FontSize="13"
                                     Padding="10,8"
                                     Margin="0,0,8,0"/>

                            <Button x:Name="btnTest"
                                    Grid.Column="1"
                                    Content="测试连接"
                                    Click="BtnTest_Click"
                                    Padding="16,8"/>
                        </Grid>

                        <!-- 测试结果 -->
                        <TextBlock x:Name="lblTestResult"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                        <!-- 模式说明 -->
                        <Border Background="{StaticResource SF.Brush.Bg.App}"
                                CornerRadius="6" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                           TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">纯远程架构</Run>
                                    <Run>：EngineHost 是唯一通讯宿主，本客户端与 Web/移动端均通过 gRPC 远程操作。</Run>
                                </TextBlock>
                                <TextBlock Text="适用于跨平台场景（Web / Mac / Android）—— 业务升级只需更新 EngineHost 进程。"
                                           FontSize="11"
                                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ─── 保存 ─── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblRestart"
                           Grid.Column="0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           Visibility="Collapsed"/>

                <Button x:Name="btnSave"
                        Grid.Column="1"
                        Content="保存设置（重启生效）"
                        Click="BtnSave_Click"
                        Padding="16,8"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
