<UserControl x:Class="CommunicationDebuggingTools.Views.Pages.MESMonitor.Controls.MesAlarmPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Mes.AlarmBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>

            <!-- ===== 标题栏 ===== -->
            <Border Background="{StaticResource SF.Brush.Mes.AlarmBg}"
                    CornerRadius="10 10 0 0"
                    Padding="14 12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 感叹号圆 -->
                        <Border Width="28" Height="28"
                                Background="{StaticResource SF.Brush.Mes.AlarmBg}"
                                BorderBrush="{StaticResource SF.Brush.Mes.AlarmBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Margin="0 0 10 0">
                            <TextBlock Text="!"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="活动报警"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SF.Brush.Mes.AlarmFg}"/>
                            <TextBlock Text="共 2 条 · 需确认后可复位"
                                       FontSize="11"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 关闭 -->
                    <TextBlock Text="×"
                               FontSize="16"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               Padding="6"
                               MouseLeftButtonDown="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- ===== 报警列表 ===== -->
            <StackPanel Margin="0 4 0 0">

                <!-- 严重：AOI NG -->
                <Border BorderBrush="{StaticResource SF.Brush.Border.Default}"
                        BorderThickness="0 0 0 1"
                        Padding="12 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧红条 -->
                        <Border Grid.Column="0"
                                Background="{StaticResource SF.Brush.Mes.AlarmFg}"
                                CornerRadius="2"
                                Margin="0 0 10 0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource SF.Brush.Mes.AlarmFg}"
                                         Margin="0 0 8 0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="AOI NG报警 · 待确认"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="设备：AOI  192.168.0.60  02:42:10"
                                       FontSize="11"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                       Margin="16 4 0 0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="确认"
                                    Style="{StaticResource SF.Style.DangerButton}"
                                    Height="28" Width="56" FontSize="12"
                                    Margin="0 0 0 4"/>
                            <Button Content="详情"
                                    Style="{StaticResource SF.Style.DarkButton}"
                                    Height="28" Width="56" FontSize="12"
                                    Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 警告：贴片机飞达 -->
                <Border BorderBrush="{StaticResource SF.Brush.Border.Default}"
                        BorderThickness="0 0 0 1"
                        Padding="12 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SF.Brush.Status.Warning}"
                                CornerRadius="2"
                                Margin="0 0 10 0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource SF.Brush.Status.Warning}"
                                         Margin="0 0 8 0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="贴片机飞达缺料预警"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="设备：贴片机  192.168.0.40  02:38:22"
                                       FontSize="11"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                       Margin="16 4 0 0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="确认"
                                    Style="{StaticResource SF.Style.DangerButton}"
                                    Height="28" Width="56" FontSize="12"
                                    Margin="0 0 0 4"/>
                            <Button Content="详情"
                                    Style="{StaticResource SF.Style.DarkButton}"
                                    Height="28" Width="56" FontSize="12"
                                    Margin="0" Click="BtnDetail_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===== 底部操作 ===== -->
            <Border Padding="14 12"
                    CornerRadius="0 0 10 10"
                    Background="{StaticResource SF.Brush.Bg.App}">
                <Grid>
                    <TextBlock Text="严重 1 · 警告 1"
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="全部确认"
                                Style="{StaticResource SF.Style.DarkButton}"
                                Height="32" FontSize="12"
                                Margin="0 0 8 0"/>
                        <Button Content="↻ 整线复位"
                                Style="{StaticResource SF.Style.PrimaryButton}"
                                Height="32" FontSize="12"
                                Margin="0 0 8 0"/>
                        <Button Content="关闭"
                                Style="{StaticResource SF.Style.DangerButton}"
                                Height="32" FontSize="12"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>