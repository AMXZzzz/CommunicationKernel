<Page x:Class="CommunicationDebuggingTools.Views.Pages.Monitor.DataMonitorPage"
      xmlns:mes="clr-namespace:CommunicationDebuggingTools.Views.Pages.MESMonitor.Controls"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="MES监控">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 数据监控内容 -->
            <RowDefinition Height="23*"/>
            <RowDefinition Height="58*"/>
        </Grid.RowDefinitions>

        <!-- =============== 顶部工具栏 =============== -->
        <mes:MESControlsTitleBar Grid.Row="0" />


        <!-- =============== 内容滚动区域 =============== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8" Grid.RowSpan="2">

            <!-- 滚动内容排布 -->
            <StackPanel>
                <!-- ① 整线控制 -->
                <mes:MesLineControlBar x:Name="lineControl" />

                <!-- ② 一键调宽 PCB 轨道宽度  -->
                <mes:MesWidthBar/>

                <!-- ③ 产线流程 -->
                <mes:MesFlowTrack/>

                <!-- ④ 设备监控卡片（下一步） -->
                <!-- 设备卡片提示 -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    
                    <TextBlock Text="设备卡片根据 "
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    
                    <Border Background="{StaticResource SF.Brush.Mes.TagDualBg}"
                            CornerRadius="3" Padding="7 1">
                        <TextBlock Text="设备管理" FontSize="10"
                                   Foreground="{StaticResource SF.Brush.Mes.WidthTitle}"/>
                    </Border>
                    
                    <TextBlock Text=" 自动生成 · 点击 ⚙ 配置状态点与数据"
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </StackPanel>

                <UniformGrid Columns="3">
                    <mes:MesDeviceCard x:Name="card1"/>
                    <mes:MesDeviceCard x:Name="card2"/>
                    <mes:MesDeviceCard x:Name="card3"/>
                </UniformGrid>


            </StackPanel>

        </ScrollViewer>

        <!-- ===== 活动报警 Popup（列表 + 详情） ===== -->
        <Popup x:Name="alarmPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Placement="Center">
            <Border Background="Transparent">
                <Grid>
                    <!-- 列表 -->
                    <mes:MesAlarmPanel x:Name="alarmPanel"/>

                    <!-- 详情（默认隐藏） -->
                    <mes:MesAlarmDetail x:Name="alarmDetail"
                                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>