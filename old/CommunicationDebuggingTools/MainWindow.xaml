<Window x:Class="CommunicationDebuggingTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CommunicationDebuggingTools.Views.Controls"
        Title="MainWindow"
        WindowStyle="None"
        Height="{StaticResource SF.ControlsSize.MainWindowsHeight}"
        Width="{StaticResource SF.ControlsSize.MainWindowsWidth}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SF.Brush.Bg.App}">

    <!-- ==================== 自定义窗口铬 ==================== -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SF.Brush.Bg.TopBar}"
                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Communication Debugging Tools"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    <TextBlock Text="V0.1"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="txtCurrentDevice"
                           Grid.Column="1"
                           Text="未连接设备"
                           FontSize="13"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="statusIndicator"
                             Width="10" Height="10"
                             Fill="{StaticResource SF.Brush.Text.Secondary}"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatus"
                               Text="未连接"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="中 / EN"
                            Click="BtnLanguage_Click"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand"
                            Margin="0,0,4,0"/>
                    <Button x:Name="btnFullscreen"
                            Content="全屏"
                            Click="BtnFullscreen_Click"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand"
                            Margin="0,0,8,0"/>
                    <Button Content="─"
                            Click="BtnMinimize_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="□"
                            Click="BtnMaximize_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="✕"
                            Click="BtnClose_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体：侧栏 UserControl + 内容 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:NavSidebar x:Name="navSidebar"
                                 Grid.Column="0"/>

            <Border Grid.Column="1"
                    Background="{StaticResource SF.Brush.Bg.App}">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>