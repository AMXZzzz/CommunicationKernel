<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  文件: Properties/PublishProfiles/树莓派-linux-arm64.pubxml
  作用: 发布到 64 位树莓派（Raspberry Pi OS 64 位 / Ubuntu arm64）。

  在 VS 里怎么用:
    右键 CommunicationKernel.EngineHostingServiceApp → 发布 → 选中本配置 → 点「发布」。

  为什么不用「配置管理器 → 新建平台」:
    那里的 ARM32/ARM64 是 MSBuild 的「平台」概念（对应 Any CPU / x64 / ARM64），
    描述的是程序集本身的目标架构，主要影响 Windows 上的本机互操作。
    它不决定 dotnet publish 产出哪个运行时的产物，
    也和自包含开关没有任何关系。在那里建 ARM64 平台，
    发布出来的仍然是依赖框架的 Windows 产物，拷到树莓派上根本起不来。

    真正起作用的是本文件里的这两项：
      RuntimeIdentifier  ← 对应命令行的 -r linux-arm64
      SelfContained      ← 对应命令行的自包含开关（true）

  注意: XML 注释里不能出现连续两个减号，所以上面提到命令行开关时用了文字描述。

  32 位系统请改用同目录下的 树莓派-linux-arm.pubxml。
  拿不准是哪种：在树莓派上执行 uname -m，aarch64 即 64 位。
  ============================================================================
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>

    <!-- 解决方案平台保持 Any CPU：目标架构由下面的 RuntimeIdentifier 决定，
         不需要、也不应该为此新建 ARM64 平台。 -->
    <LastUsedPlatform>Any CPU</LastUsedPlatform>

    <PublishUrl>bin\Release\net8.0\publish\linux-arm64\</PublishUrl>
    <TargetFramework>net8.0</TargetFramework>

    <!-- 目标运行时：64 位 ARM Linux。搞错时程序在树莓派上报 exec 格式错误，
         错误信息不会提示你 RID 不对，很容易往别处查。 -->
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>

    <!-- 自包含：产物自带 .NET 运行时，树莓派上不必预装。
         代价是体积约 100 MB。改成 false 则需要先在树莓派上装 .NET 8 运行时。 -->
    <SelfContained>true</SelfContained>

    <!-- 单文件打包关闭。
         本项目按 plugins/ 目录发现协议插件，打成单文件会让插件与共享契约的
         目录布局失效——四个共享契约必须与主程序同层，插件必须在 plugins/ 下。 -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- ReadyToRun 关闭：需要在目标架构上预编译，交叉发布时收益有限且易出问题。
         树莓派上启动慢一两秒可以接受。 -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- 保留裁剪关闭：插件靠反射加载，裁剪会把"看起来没人调用"的类型删掉，
         表现为协议插件静默注册不上。 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
