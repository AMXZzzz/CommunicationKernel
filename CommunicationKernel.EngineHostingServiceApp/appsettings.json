{
  // ---------------------------------------------------------------------------
  // 文件: EngineHostingServiceApp/appsettings.json
  // 层级: EngineHostingServiceApp
  // 作用: 宿主默认配置。命令行 --urls / 环境变量 ASPNETCORE_URLS 会覆盖监听地址。
  // ---------------------------------------------------------------------------
  "Kestrel": {
    "Endpoints": {
      // gRPC 明文 HTTP/2。必须是 Http2（不能 Http1AndHttp2）：
      // 明文没有 TLS ALPN，Kestrel 无法协商，会退回 HTTP/1.1，gRPC 全部被拒。
      "Grpc": {
        "Url": "http://localhost:5000",
        "Protocols": "Http2"
      }
    }
  },
  "EngineRuntime": {
    // 相对路径按宿主基目录解析；也可写成绝对路径
    "PluginDirectory": "plugins",
    // 串口帧间最小静默间隔（毫秒）。解析失败时代码回落 15
    "DefaultSerialMinIoIntervalMs": 15
  }
}
